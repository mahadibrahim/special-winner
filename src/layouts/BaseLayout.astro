---
import '@/styles/globals.css';
import Navigation from '@/components/navigation';
import Footer from '@/components/footer';
import RegistrationRibbon from '@/components/registration-ribbon';
import PostHog from '@/components/posthog.astro';
import GoogleTagManager from '@/components/google-tag-manager.astro';
import GoogleTagManagerNoscript from '@/components/google-tag-manager-noscript.astro';
import { isSoccerOneHost } from "@/lib/organization/soccerone-routing";
// Chrome imports ship both brands' scoped CSS in every bundle (~3-4 KB gz, accepted); brand-specific element rules in soccerone-tokens.css must stay scoped to html[data-brand]. Note: prerendered pages bake data-brand at build time (always "aspire") — keep shared booking surfaces SSR.
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { AppToaster } from '@/components/ui/app-toaster';
import { getBrandTheme } from '@/lib/branding/themes';
import { resolveOgOrigin, toAbsoluteUrl } from '@/lib/branding/og';
import { resolveNavUser } from '@/lib/branding/nav-user';
import { resolveCanonicalUrl } from '@/lib/seo/canonical';

const theme = getBrandTheme(Astro.locals.brandId);

interface Props {
  title: string;
  description?: string;
  /** Override the brand's default share card. Absolute path or absolute URL. */
  ogImage?: string;
  /** Alt text for og:image:alt. Defaults to the brand's card alt. */
  ogImageAlt?: string;
  /** Per-brand favicon path. Defaults to the theme favicon. */
  favicon?: string;
  /** Override the auto-derived canonical URL. Absolute URL. */
  canonical?: string;
  bodyClass?: string;
  navigation?: boolean;
  footer?: boolean;
  /** Set for pages that must not be indexed (e.g. unlisted merch stores). */
  noindex?: boolean;
}

const {
  title,
  description = theme.defaultDescription,
  ogImage = theme.ogImage,
  ogImageAlt = theme.ogImageAlt,
  favicon = theme.favicon,
  canonical,
  bodyClass = "min-h-screen flex flex-col bg-cream text-ink antialiased",
  navigation = true,
  footer = true,
  noindex = false,
} = Astro.props;

// Link-preview (og:*/twitter:*) tags need ABSOLUTE URLs or iMessage/WhatsApp
// drop the image. SSR uses the real request origin (correct per brand domain);
// prerendered pages (always Aspire, Astro.url.origin = build-time localhost)
// fall back to the Aspire canonical origin.
const PRERENDER_ORIGIN = import.meta.env.PUBLIC_APP_URL || "https://aspiresportsohio.com";
const ogOrigin = resolveOgOrigin(Astro.isPrerendered, Astro.url.origin, PRERENDER_ORIGIN);
const ogImageUrl = toAbsoluteUrl(ogImage, ogOrigin);

// Canonical uses the brand's canonical host (not the raw request origin) so
// preview deploys / apex-vs-www / the SoccerOne long-form path all collapse to
// the one production URL we want indexed. og:url is aligned to it.
const canonicalUrl =
  canonical ?? resolveCanonicalUrl(theme.id, Astro.url.pathname, PRERENDER_ORIGIN);

// Shared pages hardcode "… — Aspire Sports" titles. The tab/og title is
// chrome-level brand identity, so swap the brand name per theme rather
// than touching every page. Aspire path is an exact no-op.
const brandedTitle =
  theme.id === "aspire" ? title : title.replace(/Aspire Sports/g, theme.displayName);

// GTM container — per-brand, keyed off the request host (brands share one
// org, so the org slug can't distinguish them). Aspire is the default
// (preserves byte-identical behavior on every non-SoccerOne request).
// SoccerOne uses a separate container when PUBLIC_GTM_CONTAINER_SOCCERONE
// is set; otherwise it also falls back to Aspire's container.
const ASPIRE_GTM_CONTAINER = "GTM-N35VVNXC";
const SOCCERONE_GTM_CONTAINER = import.meta.env.PUBLIC_GTM_CONTAINER_SOCCERONE || ASPIRE_GTM_CONTAINER;
const gtmContainerId = isSoccerOneHost(Astro.url.hostname)
  ? SOCCERONE_GTM_CONTAINER
  : ASPIRE_GTM_CONTAINER;

// Brand skin: custom-property overrides. MUST live on the html element —
// :root custom properties substitute on the declaring element, so an
// override on body or a wrapper would re-theme Tailwind utilities but
// NOT hand-authored var(--*) consumers (split-brain). html[data-brand]
// outranks the globals.css :root block by specificity.
const brandCss = theme.cssVars
  ? `html[data-brand="${theme.id}"]{${Object.entries(theme.cssVars)
      .map(([k, v]) => `${k}:${v}`)
      .join(";")}}`
  : null;

// On SSR pages the middleware has already validated the session, so hand
// the auth state to Navigation and skip its client-side /api/auth/me round
// trip (each one is a full function invocation + several DB queries). On
// prerendered pages auth state is unknowable at build time — leave the prop
// unset so Navigation falls back to fetching. `null` therefore means
// "known anonymous", absent means "unknown, go fetch".
// `navUser` is undefined when the page is prerendered OR opted into edge
// caching (setMarketingEdgeCache sets Netlify-CDN-Cache-Control before this
// layout renders). Undefined => Navigation resolves auth client-side, so the
// cached HTML carries no per-user data. See resolveNavUser.
const navUser = resolveNavUser({
  isPrerendered: Astro.isPrerendered,
  edgeCached: Astro.response.headers.has("Netlify-CDN-Cache-Control"),
  user: Astro.locals.user,
});
---
<!DOCTYPE html>
<html lang="en" data-brand={theme.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={brandedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={theme.displayName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={brandedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {theme.fontsHref && <link href={theme.fontsHref} rel="stylesheet" />}
    {brandCss && <style is:inline set:html={brandCss} />}
    <script is:inline>
      // Recover from stale-deploy chunk loads: a tab opened before a deploy
      // can dynamic-import a hashed chunk that no longer exists ("Importing a
      // module script failed"). Vite surfaces that as vite:preloadError —
      // reload once to pick up the new build. The timestamp guard stops a
      // reload loop when the page is genuinely broken; sessionStorage is
      // try/caught because some privacy modes deny it.
      window.addEventListener("vite:preloadError", function (event) {
        var KEY = "stale-chunk-reload-at";
        try {
          if (Date.now() - Number(sessionStorage.getItem(KEY) || 0) < 60000) return;
          sessionStorage.setItem(KEY, String(Date.now()));
        } catch (_) {
          return;
        }
        event.preventDefault();
        window.location.reload();
      });
    </script>
    <title>{brandedTitle}</title>
    <PostHog />
    <GoogleTagManager containerId={gtmContainerId} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <GoogleTagManagerNoscript containerId={gtmContainerId} />
    {navigation && theme.chrome === "aspire" && <RegistrationRibbon client:idle />}
    {navigation && (theme.chrome === "soccerone" ? <SoccerOneHeader /> : <Navigation client:idle {...(navUser !== undefined ? { initialUser: navUser } : {})} />)}
    <slot />
    {footer && (theme.chrome === "soccerone" ? <SoccerOneFooter /> : <Footer />)}
    <AppToaster client:load />
  </body>
</html>
