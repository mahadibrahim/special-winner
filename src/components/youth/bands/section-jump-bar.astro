---
// Sticky jump bar for youth long-form pages (mockup: .jump). A row of mono
// uppercase pill links pinned to the top of the viewport; the active pill
// tracks which section is in view via IntersectionObserver.
interface JumpItem {
  href: string;
  label: string;
}

interface Props {
  items: JumpItem[];
}

const { items } = Astro.props;
---

<nav class="sticky top-0 z-50 bg-royal" aria-label="Section navigation">
  <div class="max-w-[1080px] mx-auto px-6 sm:px-9 flex gap-1.5 overflow-x-auto py-2">
    {
      items.map((item, i) => (
        <a
          href={item.href}
          data-jump-link={item.href}
          data-active={i === 0 ? "true" : undefined}
          class="font-mono text-[11.5px] tracking-[0.14em] uppercase text-cream no-underline px-4 py-[9px] rounded-full whitespace-nowrap transition-colors hover:bg-cream/15 data-[active=true]:bg-cream data-[active=true]:text-royal data-[active=true]:font-medium data-[active=true]:hover:bg-cream"
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>

<script>
  // Dependency-free active-pill tracking. No-ops if an anchor target is
  // missing from the page (e.g. a jump item points at a section that isn't
  // rendered yet) rather than throwing.
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-jump-link]");

  if (links.length > 0 && "IntersectionObserver" in window) {
    const targets: { link: HTMLAnchorElement; el: Element }[] = [];

    links.forEach((link) => {
      const href = link.getAttribute("data-jump-link") ?? "";
      if (!href.startsWith("#") || href.length < 2) return;
      const el = document.getElementById(href.slice(1));
      if (el) targets.push({ link, el });
    });

    if (targets.length > 0) {
      const setActive = (activeLink: HTMLAnchorElement) => {
        links.forEach((link) => {
          if (link === activeLink) link.setAttribute("data-active", "true");
          else link.removeAttribute("data-active");
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          if (visible.length === 0) return;

          const topmost = visible.reduce((a, b) =>
            a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
          );
          const match = targets.find((t) => t.el === topmost.target);
          if (match) setActive(match.link);
        },
        { rootMargin: "-15% 0px -70% 0px", threshold: 0 },
      );

      targets.forEach(({ el }) => observer.observe(el));
    }
  }
</script>
