---
// Full-bleed color-blocked band with a fixed-width photo slot and a text
// column (mockup: .srow — pathway step detail rows and cross-promo bands
// share this shape). `flip` mirrors which side the photo sits on.
//
// The photo slot renders a decorative sport motif (slot-graphic.astro) until
// real photography exists — owner decision 2026-08-18: graphics now, photos
// swapped in later.
import SlotGraphic from "./slot-graphic.astro";

export type FeatureBandTone = "royal" | "emerald" | "red" | "amber" | "navy";

interface Props {
  tone: FeatureBandTone;
  id?: string;
  /** 0–4, cycles the slot graphic so adjacent bands don't repeat. */
  graphicVariant?: number;
  title: string;
  kicker?: string;
  hook?: string;
  body: string;
  cta?: { href: string; label: string };
  flip?: boolean;
}

const { tone, id, graphicVariant = 0, title, kicker, hook, body, cta, flip = false } = Astro.props;

// Gradient placeholders are composed from tokens only — no literal oklch()
// values — via color-mix(in oklch, var(--x), var(--navy-deep) N%). `amber`
// gets ink text for contrast per the mockup's .srow.academy override.
const TONE = {
  royal: {
    band: "bg-royal",
    photo:
      "linear-gradient(135deg, var(--royal-bright), color-mix(in oklch, var(--royal), var(--navy-deep) 35%))",
    text: "text-cream",
    accent: "text-cream/85",
    body: "text-cream/90",
    ctaBg: "bg-cream",
    ctaText: "text-ink",
  },
  emerald: {
    band: "bg-emerald",
    photo:
      "linear-gradient(135deg, var(--emerald-bright), color-mix(in oklch, var(--emerald), var(--navy-deep) 35%))",
    text: "text-cream",
    accent: "text-cream/85",
    body: "text-cream/90",
    ctaBg: "bg-cream",
    ctaText: "text-ink",
  },
  red: {
    band: "bg-brand-red",
    photo:
      "linear-gradient(135deg, color-mix(in oklch, var(--brand-red), var(--navy-deep) 10%), color-mix(in oklch, var(--brand-red), var(--navy-deep) 45%))",
    text: "text-cream",
    accent: "text-cream/85",
    body: "text-cream/90",
    ctaBg: "bg-cream",
    ctaText: "text-ink",
  },
  amber: {
    band: "bg-ochre",
    photo:
      "linear-gradient(135deg, var(--ochre), color-mix(in oklch, var(--ochre), var(--navy-deep) 30%))",
    text: "text-ink",
    accent: "text-ink-2/80",
    body: "text-ink-2/90",
    ctaBg: "bg-navy-deep",
    ctaText: "text-cream",
  },
  navy: {
    band: "bg-navy-deep",
    photo:
      "linear-gradient(135deg, var(--royal-bright), color-mix(in oklch, var(--navy-deep), var(--royal) 25%))",
    text: "text-cream",
    accent: "text-emerald-bright",
    body: "text-cream/90",
    ctaBg: "bg-cream",
    ctaText: "text-ink",
  },
} as const satisfies Record<FeatureBandTone, Record<string, string>>;

const t = TONE[tone];
const colsClass = flip ? "md:grid-cols-[1fr_340px]" : "md:grid-cols-[340px_1fr]";
const photoOrder = flip ? "md:order-2" : "md:order-1";
const textOrder = flip ? "md:order-1" : "md:order-2";
---

<section id={id} class={`${t.band} ${t.text}`}>
  <div class={`grid ${colsClass} items-stretch min-h-[220px] md:min-h-[280px]`}>
    <div
      class={`${photoOrder} relative overflow-hidden min-h-[150px]`}
      style={`background:${t.photo}`}
    >
      <SlotGraphic variant={graphicVariant} />
    </div>
    <div class={`${textOrder} px-6 sm:px-9 md:px-[56px] py-10 md:py-[48px] flex flex-col justify-center`}>
      {kicker && <p class={`font-mono text-[11px] tracking-[0.16em] uppercase ${t.accent} mb-2`}>{kicker}</p>}
      <h3 class="font-display font-semibold text-[32px] leading-tight">{title}</h3>
      {hook && <p class={`font-mono text-[11px] tracking-[0.16em] uppercase mt-[6px] ${t.accent}`}>{hook}</p>}
      <p class={`text-[14.5px] max-w-[62ch] mt-[14px] ${t.body}`}>{body}</p>
      {
        cta && (
          <div class="mt-[22px]">
            <a
              href={cta.href}
              class={`inline-block font-semibold text-[13.5px] px-[19px] py-[11px] rounded-[9px] no-underline ${t.ctaBg} ${t.ctaText}`}
            >
              {cta.label}
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
