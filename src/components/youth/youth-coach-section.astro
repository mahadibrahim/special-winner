---
// "How we coach" — Saad Abdul-Salaam and the method. One component because the
// owner wants the coaching story prominent on the hub, classes AND camps, and
// three inline copies of a bio with verified career facts would drift.
//
// Copy discipline (owner-directed): the philosophy is the subject and he is
// the evidence — no oppositional language about other clubs, and his club
// history is stated as biography only, never implying any club endorses
// Aspire. Content lives in landing-content.ts.
//
// Layout: mockup's `.coach` pull-quote treatment (circular portrait, large
// italic serif quote, credential chips, bio, tie line) — see
// docs/superpowers/specs/2026-08-18-youth-classes-v2-mockup.html. The quote
// is OWNER-COMMISSIONED (2026-08-18, COACH.quote) and renders as a real
// quotation; the bio paragraph is owner-provided verbatim.
import { COACH, SPORTS } from "@/lib/youth/landing-content"

interface Props {
  /** Section id for aria-labelledby uniqueness per page. */
  headingId?: string
}
const { headingId = "youth-coach-h" } = Astro.props

// Split COACH.quote on the emphasis phrase so it can carry the mockup's red
// accent without hardcoding the rest of the sentence here — the copy itself
// still lives entirely in landing-content.ts.
const EMPHASIS = "full potential"
const quoteParts = COACH.quote.split(EMPHASIS)
---

<section class="bg-cream-2 px-6 sm:px-9 py-12 sm:py-[76px] border-b border-border" aria-labelledby={headingId}>
  <div class="max-w-[1080px] mx-auto">
    <h2 id={headingId} class="sr-only">How we coach</h2>
    <div class="grid sm:grid-cols-[190px_1fr] gap-8 sm:gap-11 items-start">
      {/* TEMP portrait (owner-supplied 2026-08-18, public/images/staff/) —
          swap the file in place when the real Aspire photo shoot happens;
          no code change needed. Renders ungraded: this is a bio headshot,
          not marketing imagery. */}
      <img
        src="/images/staff/saad-abdul-salaam.webp"
        alt={`${COACH.name}, ${COACH.role}`}
        width="180"
        height="180"
        loading="lazy"
        class="w-[180px] h-[180px] rounded-full object-cover object-top outline outline-4 outline-paper -outline-offset-1 shadow-[0_2px_14px_rgba(0,0,0,0.12)] bg-navy-deep"
      />
      <div>
        <blockquote
          class="font-display italic font-medium text-ink leading-[1.3] tracking-[-0.01em] max-w-[44ch]"
          style="font-size: clamp(1.5rem, 3vw, 2.3rem);"
        >
          “{quoteParts.length > 1 ? (
            <>
              {quoteParts[0]}<em class="text-brand-red not-italic font-medium">{EMPHASIS}</em>{quoteParts.slice(1).join(EMPHASIS)}
            </>
          ) : (
            COACH.quote
          )}”
        </blockquote>
        <div class="mt-[18px] text-sm text-ink-2">
          <b class="text-ink font-semibold">{COACH.name}</b> · {COACH.role}{
            SPORTS.length > 1 ? ` — ${COACH.sport}` : ""
          }
        </div>
        <dl class="flex gap-2 flex-wrap mt-[14px]">
          {COACH.credits.map((c) => (
            <div class="font-mono text-[10px] tracking-[0.1em] uppercase bg-paper border border-border rounded-full px-3 py-1.5 text-ink-2">
              <dt class="sr-only">{c.label}</dt>
              <dd class="inline">{c.value} · {c.label}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-[15px] text-ink-2 leading-relaxed max-w-[75ch]">{COACH.bio}</p>
      </div>
    </div>
  </div>
</section>
