---
// "How we coach" — Saad Abdul-Salaam and the method. One component because the
// owner wants the coaching story prominent on the hub, classes AND camps, and
// three inline copies of a bio with verified career facts would drift.
//
// Copy discipline (owner-directed): the philosophy is the subject and he is
// the evidence — no oppositional language about other clubs, and his club
// history is stated as biography only, never implying any club endorses
// Aspire. Content lives in landing-content.ts.
//
// Layout: mockup's `.coach` pull-quote treatment (circular portrait, large
// italic serif line, credential chips, tie line) — see
// docs/superpowers/specs/2026-08-18-youth-classes-v2-mockup.html. One
// deliberate departure from the mockup: the method line renders as a plain
// <p>, NOT a <blockquote> with curly quotes. The owner has not blessed
// framing this as a direct quotation, so it renders as attributed prose —
// same visual weight, no quote semantics.
import { COACH, SPORTS } from "@/lib/youth/landing-content"

interface Props {
  /** Section id for aria-labelledby uniqueness per page. */
  headingId?: string
}
const { headingId = "youth-coach-h" } = Astro.props

// Split COACH.method on "same thing" so that one phrase can carry the
// mockup's red emphasis without hardcoding the rest of the sentence here —
// the copy itself still lives entirely in landing-content.ts.
const EMPHASIS = "same thing"
const methodParts = COACH.method.split(EMPHASIS)
---

<section class="bg-cream-2 px-6 sm:px-9 py-12 sm:py-[76px] border-b border-border" aria-labelledby={headingId}>
  <div class="max-w-[1080px] mx-auto">
    <h2 id={headingId} class="sr-only">How we coach</h2>
    <div class="grid sm:grid-cols-[190px_1fr] gap-8 sm:gap-11 items-start max-w-[720px]">
      {/* Placeholder block until a real photograph of Saad exists — the trust
          slot needs one more than anything else on these pages. */}
      <div
        class="w-[180px] h-[180px] rounded-full flex items-center justify-center outline outline-4 outline-paper -outline-offset-1 shadow-[0_2px_14px_rgba(0,0,0,0.12)]"
        style="background: linear-gradient(160deg, var(--royal), var(--navy-deep));"
        aria-hidden="true"
      >
        <span class="font-mono text-[9.5px] tracking-[0.12em] text-cream/55">PHOTO · SAAD</span>
      </div>
      <div>
        <p
          class="font-display italic font-medium text-ink leading-[1.3] tracking-[-0.01em] max-w-[26ch]"
          style="font-size: clamp(1.5rem, 2.8vw, 2.1rem);"
        >
          {methodParts.length > 1 ? (
            <>
              {methodParts[0]}<em class="text-brand-red not-italic font-medium">{EMPHASIS}</em>{methodParts.slice(1).join(EMPHASIS)}
            </>
          ) : (
            COACH.method
          )}
        </p>
        <div class="mt-[18px] text-sm text-ink-2">
          <b class="text-ink font-semibold">{COACH.name}</b> · {COACH.role}{
            SPORTS.length > 1 ? ` — ${COACH.sport}` : ""
          }
        </div>
        <dl class="flex gap-2 flex-wrap mt-[14px]">
          {COACH.credits.map((c) => (
            <div class="font-mono text-[10px] tracking-[0.1em] uppercase bg-paper border border-border rounded-full px-3 py-1.5 text-ink-2">
              <dt class="sr-only">{c.label}</dt>
              <dd class="inline">{c.value} · {c.label}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-sm text-ink-2 max-w-[56ch]">
          Your kid's coach — whichever step of the pathway they're on — trains under him.
        </p>
      </div>
    </div>
  </div>
</section>
