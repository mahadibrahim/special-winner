---
// Youth SPORT landing page body (/youth/soccer, /youth/futsal) — the second
// step of the sport-first youth funnel, in the Broadsheet (v2) band
// language. The hub routes a parent to a sport; this page shows everything
// Aspire runs in that sport — leagues, classes, camps — and carries the
// coaching story, which is sport-specific evidence.
//
// Band order: hero (photo + scrim, offering tiles tinted with the SPORT
// color — sport answers "which game", sport-colors.ts) → intro (sand) →
// leagues (ink, accent quadrant pair) → classes (sand, step cards with the
// age anchors) → camps (ink) → FAQs → coaching (shared CoachBand) →
// pricing (sand) → closer (orange).
import LandingFaq from "@/components/landing/landing-faq.tsx";
import CoachBand from "@/components/youth/bands/coach-band.astro";
import { sportColor } from "@/lib/design/sport-colors";
import type { YouthSportPage } from "@/lib/youth/sport-pages";
import { LEAGUE_KINDS, PATHWAY, CAMPS, PRICING } from "@/lib/youth/landing-content";

interface Props {
  sport: YouthSportPage;
}
const { sport } = Astro.props;
const tint = sportColor({ slug: sport.slug });

const HERO_IMAGE = "/images/stock/youth-training.jpg";

// "Aspire Micros" -> "micros" — stable anchor for age-query landings
// (/youth/soccer#micros). Renaming a pathway step changes the anchor;
// the naming decision doc owns renames.
const stepSlug = (name: string) => name.replace(/^Aspire /, "").toLowerCase();

const tiles = [
  {
    label: "Leagues",
    href: `/youth/leagues/${sport.slug}`,
    cta: `youth-${sport.slug}-leagues`,
    statusLabel: "Now enrolling",
    meta: "Games at the weekend, by age group",
    open: true,
  },
  {
    label: "Classes",
    href: "/youth/classes",
    cta: `youth-${sport.slug}-classes`,
    statusLabel: "Now enrolling",
    meta: "Small-group training, five steps",
    open: true,
  },
  {
    label: "Camps",
    href: "/youth/camps",
    cta: `youth-${sport.slug}-camps`,
    statusLabel: "Booking soon",
    meta: "Day camps, year-round",
    open: false,
  },
];
---

<main id="main-content" class="flex-1">
  {/* ---------- Hero: what can my kid do in this sport, right now --------- */}
  <section class="band-ink relative overflow-hidden">
    <img
      src={HERO_IMAGE}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-[center_30%]"
      style="filter:grayscale(1) contrast(1.08) brightness(.96)"
    />
    <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
    <div class="relative max-w-[1080px] mx-auto px-6 sm:px-12 pt-28 lg:pt-32 pb-12 flex flex-col gap-5">
      <h1 class="display-xl text-on-ink max-w-[760px]">{sport.heroTitle}</h1>
      <p class="body-l text-on-ink-2 max-w-[520px]" style="text-wrap:pretty">{sport.heroSubhead}</p>

      <div class="grid sm:grid-cols-3 gap-3.5 pt-2">
        {tiles.map((t) =>
          t.open ? (
            <a
              href={t.href}
              data-landing-cta={t.cta}
              class="relative p-5 text-ink overflow-hidden no-underline block"
              style={`background:${tint}`}
            >
              <div class="data text-ink/80">● {t.statusLabel}</div>
              <div class="display-s text-ink mt-1.5" style="font-size:1.5rem">{t.label}</div>
              <div class="font-mono text-xs text-ink mt-1">{t.meta}</div>
              <span class="absolute right-4 bottom-4 font-bold text-lg text-ink" aria-hidden="true">→</span>
            </a>
          ) : (
            <a
              href={t.href}
              data-landing-cta={t.cta}
              class="relative p-5 bg-ink-lift border border-rule-on-ink no-underline block"
            >
              <div class="data text-on-ink-muted">{t.statusLabel}</div>
              <div class="display-s text-on-ink mt-1.5" style="font-size:1.5rem">{t.label}</div>
              <div class="font-mono text-xs text-on-ink-2 mt-1">{t.meta}</div>
              <span class="absolute right-4 bottom-4 font-bold text-lg text-on-ink-2" aria-hidden="true">→</span>
            </a>
          ),
        )}
      </div>

      <p class="text-sm text-on-ink-muted">
        Different sport?
        <a href="/youth" class="text-primary-bright underline underline-offset-2">Back to youth sports →</a>
      </p>
    </div>
  </section>

  {/* ---------- Editorial intro — the crawlable substance ------------------ */}
  <section class="band-sand border-b border-rule px-6 sm:px-12 py-10" aria-label={`About youth ${sport.name.toLowerCase()}`}>
    <div class="max-w-[1080px] mx-auto">
      <div class="max-w-[680px] space-y-4">
        {sport.intro.map((p) => (
          <p class="body-copy text-on-sand-2">{p}</p>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Leagues — two kinds, then into the sport's league pages ---- */}
  <section class="band-ink px-6 sm:px-12 py-14" aria-labelledby={`youth-${sport.slug}-leagues-h`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
      <div class="flex flex-col gap-2.5 max-w-[560px]">
        <h2 id={`youth-${sport.slug}-leagues-h`} class="display-l">Leagues</h2>
        <p class="body-s text-on-ink-2">
          Two kinds, depending on the time of year and what your player needs.
        </p>
      </div>

      <div class="quadrants quadrants--accent grid-cols-1 md:grid-cols-2">
        {LEAGUE_KINDS.map((k) => (
          <div class="flex flex-col gap-2.5 p-6">
            <h3 class="display-s m-0">{k.name}</h3>
            <p class="data text-on-ink-muted m-0">{k.when}</p>
            <p class="body-s text-on-ink-2 m-0">{k.body}</p>
            <dl class="flex gap-8 mt-2 pt-3 border-t border-rule-on-ink m-0">
              {k.facts.map((f) => (
                <div>
                  <dt class="label text-on-ink-muted" style="font-size:0.65rem">{f.label}</dt>
                  <dd class="text-on-ink font-semibold text-[14px] mt-0.5 ml-0">{f.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>

      <div>
        <a
          href={`/youth/leagues/${sport.slug}`}
          data-youth-cta={`${sport.slug}-leagues`}
          class="btn btn--primary no-underline"
        >
          See {sport.name.toLowerCase()} age groups
        </a>
      </div>
    </div>
  </section>

  {/* ---------- Classes — the pathway, rendered as the five steps ---------- */}
  <section class="band-sand px-6 sm:px-12 py-14" aria-labelledby={`youth-${sport.slug}-classes-h`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
      <div class="flex flex-col gap-2.5 max-w-[620px]">
        <h2 id={`youth-${sport.slug}-classes-h`} class="display-l">Classes</h2>
        <p class="body-s text-on-sand-2">
          Training in small groups — one pathway that starts with your toddler on the floor beside
          you and runs to an invitation-only group.
        </p>
      </div>

      <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
        {PATHWAY.map((s, i) => (
          <div
            id={stepSlug(s.name)}
            class:list={["step-card flex flex-col gap-2 scroll-mt-28", i === PATHWAY.length - 1 && "step-card--invert"]}
          >
            <h3 class="display-s m-0">{s.name.replace("Aspire ", "")}</h3>
            <p class:list={["data m-0", i === PATHWAY.length - 1 ? "text-primary-bright" : "text-primary-text"]}>
              {s.ages}
            </p>
            <p class:list={["body-s m-0", i === PATHWAY.length - 1 ? "text-on-ink-2" : "text-on-sand-2"]}>
              {s.blurb}
            </p>
          </div>
        ))}
      </div>

      <div>
        <a href="/youth/classes" data-youth-cta={`${sport.slug}-classes`} class="btn btn--outline no-underline">
          See the pathway
        </a>
      </div>
    </div>
  </section>

  {/* ---------- Camps ----------------------------------------------------- */}
  <section class="band-ink px-6 sm:px-12 py-14" aria-labelledby={`youth-${sport.slug}-camps-h`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-5">
      <h2 id={`youth-${sport.slug}-camps-h`} class="display-l">Camps</h2>
      <p class="body-copy text-on-ink-2 max-w-[620px]">{CAMPS.lede}</p>
      <div>
        <a href="/youth/camps" data-youth-cta={`${sport.slug}-camps`} class="btn btn--on-ink no-underline">
          See camp dates
        </a>
      </div>
    </div>
  </section>

  {/* ---------- Sport FAQs — no JSON-LD (owned by the SEO branch) ---------- */}
  <LandingFaq
    client:visible
    id={`${sport.slug}-faq`}
    heading={`Youth ${sport.name.toLowerCase()} FAQs`}
    items={sport.faqs}
  />

  {/* ---------- The coaching story — sport-specific evidence --------------- */}
  {sport.hasCoach && <CoachBand headingId={`youth-${sport.slug}-coach-h`} />}

  {/* ---------- Pricing — indicative only ---------------------------------- */}
  <section class="band-sand px-6 sm:px-12 py-14" aria-labelledby={`youth-${sport.slug}-cost-h`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-2.5">
      <h2 id={`youth-${sport.slug}-cost-h`} class="display-l">{PRICING.heading}</h2>
      <p class="body-copy text-on-sand-2 max-w-[640px]">{PRICING.body}</p>
    </div>
  </section>

  {/* ---------- Closer — the orange band ----------------------------------- */}
  <section class="band-orange px-6 sm:px-12 py-16" aria-labelledby={`youth-${sport.slug}-close-h`}>
    <div class="max-w-[1080px] mx-auto flex flex-wrap items-center justify-between gap-8">
      <div class="flex flex-col gap-2.5">
        <h2 id={`youth-${sport.slug}-close-h`} class="display-xl" style="font-size:clamp(2.5rem,5vw,4rem)">
          Ready when they are.
        </h2>
        <p class="body-l font-medium text-ink">
          See what's open in {sport.name.toLowerCase()} — registration takes a few minutes.
        </p>
      </div>
      <a
        href={`/youth/leagues/${sport.slug}`}
        data-youth-cta={`${sport.slug}-close`}
        class="btn btn--ink no-underline whitespace-nowrap !text-primary-bright hover:!text-ink"
      >
        See what's open
      </a>
    </div>
  </section>
</main>

<script>
  import { track } from "@/lib/analytics/track";

  // Delegated so island-hydrated CTAs still get tracked (classes precedent).
  document.addEventListener("click", (e) => {
    const el = e.target instanceof Element ? e.target.closest<HTMLElement>("[data-landing-cta], [data-youth-cta]") : null;
    if (!el) return;
    if (el.dataset.landingCta) track("landing_hero_cta_click", { cta: el.dataset.landingCta });
    else track("youth_hub_section_cta_clicked", { section: el.dataset.youthCta ?? "" });
  });
</script>
