---
// Shared body for every youth sport league landing page (/youth/leagues/<sport>),
// in the Broadsheet (v2) band language.
//
// Two-path composition (2026-08-18): the page's job is to route a visitor into
// ONE of two doors — a club team entering whole (competitive, winter), or one
// kid signing up alone (developmental, the rest of the year) — and then let
// either book without leaving the page. Every band below serves that.
// Design: docs/superpowers/specs/2026-08-18-youth-leagues-two-path-design.md
//
// The ROYAL/EMERALD pair survives the v2 conversion on the hero tiles and the
// #types cards: it is the two-door wayfinding coding (the door you tap is
// visibly the door you land on), semantic like sportColor — not band chrome.
// Everything around it converts: ochre deadline banner (tertiary-highlight
// role), photo hero + scrim, sticky orange in-page nav, sand/ink/paper band
// alternation, orange closer. The "how it works" numerals retire (the numeral
// rule) — the quadrant grid carries the three steps.
//
// Soccer and futsal differ only in slug, display name and hero title — the
// lookup, table, calendar, venues and FAQs are identical, because they are
// about the age-group system and Aspire's policies rather than about a sport.
//
// No Director of Coaching and no developmental pathway story here — those live
// on classes/camps, where coaching is the product being bought. Leagues stay
// facts pages (owner decision).
import CategoryFinder from "@/components/landing/category-finder.tsx"
import TileFactsLine from "@/components/landing/tile-facts-line"
import SeasonCalendarBand, { type CalendarTermConfig } from "@/components/landing/season-calendar-band.tsx"
import LandingFaq, { type LandingFaqItem } from "@/components/landing/landing-faq.tsx"
import InpageNav from "@/components/youth/bands/inpage-nav.astro"
import AgeLookupInline from "@/components/youth/age-lookup-inline.astro"
import { getVenueFacts, VENUE_SLUGS } from "@/lib/locations/venue-facts"
import { type DivisionRowModel } from "@/lib/leagues/division-row-model"
import { type YouthLeaguePageData } from "@/lib/leagues/youth-league-page-data"
import { BUSINESS_TIMEZONE } from "@/lib/time/business-timezone"
import {
  YOUTH_LEAGUE_FAQS, YOUTH_CALENDAR_TERMS, VENUE_DISPLAY_NAMES,
} from "@/lib/leagues/youth-league-content"
import { YOUTH_LEAGUE_SPORTS } from "@/lib/leagues/youth-sports"
import {
  COMMITMENT_FACTS, DEADLINE_BANNER, CLUB_TEAM_PROMISES, CLUB_CARD, LEAGUE_TYPE_CARDS,
} from "@/lib/youth/league-page-content"

interface Props {
  /** Sport slug as stored on `sports.slug` — scopes every catalog read. */
  sportSlug: string
  /** The WHOLE h1, e.g. "Indoor youth soccer leagues." */
  heroTitle: string
  /**
   * Catalog data, loaded by the PAGE via `fetchYouthLeaguePageData`. It cannot
   * be fetched here: the page must know whether the catalog read succeeded
   * before it decides to opt into edge caching, and by the time a child
   * component renders Astro has already flushed the response headers.
   */
  data: YouthLeaguePageData
  faqs?: LandingFaqItem[]
  calendarTerms?: CalendarTermConfig[]
}
const {
  sportSlug,
  heroTitle,
  data,
  faqs = YOUTH_LEAGUE_FAQS,
  calendarTerms = YOUTH_CALENDAR_TERMS,
} = Astro.props

const FINDER_ID = `youth-${sportSlug}-divisions`
const basePath = `/youth/leagues/${sportSlug}`

const {
  currentTerm,
  upcomingTerms,
  pastTerms,
  openRows,
  competitiveRows,
  developmentalRows,
  bannerDeadline,
  bannerTermLabel,
  bannerTermSlug,
} = data

// Deadline dates are business-timezone facts: a 11:59pm ET cutoff serializes
// as the next day in UTC, and this renders on a UTC server.
const shortDate = (iso: string): string | null => {
  const d = new Date(iso)
  if (Number.isNaN(d.getTime())) return null
  return d.toLocaleDateString("en-US", {
    month: "short", day: "numeric", timeZone: BUSINESS_TIMEZONE,
  })
}
const bannerCloses = bannerDeadline ? shortDate(bannerDeadline) : null
const bannerMessage = [
  bannerTermLabel,
  bannerCloses ? `team entry closes ${bannerCloses}` : "registration open",
  DEADLINE_BANNER.urgency,
]
  .filter(Boolean)
  .join(" · ")

// A different image from the hub's so the two pages don't read as one repeated.
const HERO_IMAGE = "/images/stock/five-aside-turf.jpg"

// Which venues render is derived from `offerings.youth`, never a hardcoded
// list, so this stays correct when a venue's youth status changes.
const venueSlugs = VENUE_SLUGS.filter((slug) => getVenueFacts(slug)?.offerings.youth)
const venueNames = venueSlugs.map((slug) => VENUE_DISPLAY_NAMES[slug] ?? slug)

/** "a", "a and b", "a, b and c" — no Oxford comma, matching the site's voice. */
const listJoin = (items: string[]): string =>
  items.length <= 1
    ? (items[0] ?? "")
    : `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`

// Highway sentence composed from the venues' owner-supplied `highwayAccess`
// lines rather than authored here, so adding a venue can't leave a stale road
// list behind. Falls back to the raw lines if they ever stop naming an
// interstate.
const highwayLines = venueSlugs
  .map((slug) => getVenueFacts(slug)?.highwayAccess)
  .filter((h): h is string => Boolean(h))
const highwayRoads = [...new Set(highwayLines.flatMap((h) => h.match(/I-\d+/g) ?? []))]
const highwaySentence =
  highwayRoads.length > 0
    ? `${venueSlugs.length > 1 ? "Both are" : "It's"} easy on and off ${listJoin(highwayRoads)}.`
    : highwayLines.length > 0
      ? `${listJoin(highwayLines)}.`
      : null

const whereSentence =
  venueNames.length > 0 ? `League play runs at ${listJoin(venueNames)}.` : null

const commitmentNote = [
  whereSentence,
  highwaySentence,
  "Your division's home venue is set before the season, and the exact schedule comes before week 1.",
  "If a game ever moves, we notify every family by text and email as soon as it's scheduled — never day-of.",
]
  .filter(Boolean)
  .join(" ")

const venuesLede = [
  whereSentence,
  highwaySentence,
  "Your division's home venue is set before the season.",
]
  .filter(Boolean)
  .join(" ")

// The crosslink names the OTHER live league sport, so soccer points at futsal
// and futsal points back — derived from the registry, never hardcoded.
const otherSport = Object.values(YOUTH_LEAGUE_SPORTS).find((s) => s.slug !== sportSlug)

// The public org address. Same address footer.tsx, /privacy, /terms and
// /refund-policy all render, not a new one invented here.
const CONTACT_EMAIL = "hello@aspiresportsohio.com"

// Each card shows ONE door of a row: the competitive card sells the team
// entry, the developmental card sells the per-kid spot. A dual-mode division
// is listed in both cards, each time with its own price and its own
// mode-scoped link — so `rowPath` picks the door the card is about.
type CardKey = "competitive" | "developmental"
const rowPath = (r: DivisionRowModel, key: CardKey) =>
  key === "competitive" ? r.team : r.solo
// Row pill: "Enter team · $850 →" / "Book · $110 →". A sold-out row gets no
// price and no arrow — same contract as YouthDivisionTable, where the anchor
// is replaced by a muted non-interactive pill.
const rowPill = (r: DivisionRowModel, key: CardKey) => {
  const path = rowPath(r, key)
  if (r.soldOut || !path) return "Sold out"
  const verb = key === "competitive" ? "Enter team" : "Book"
  return `${verb} · $${path.price.toLocaleString("en-US")} →`
}
// The count is PLAYER capacity, so it rides the per-kid card only — printing
// it beside "Enter team" would read as a team count the schema cannot back.
// Never on a sold-out row.
const rowMeta = (r: DivisionRowModel, key: CardKey) =>
  [
    r.meta,
    r.termLabel,
    key === "developmental" && r.spotsLeft != null && !r.soldOut
      ? `${r.spotsLeft} spots left`
      : null,
  ]
    .filter(Boolean)
    .join(" · ")

// Royal/emerald = the two-door wayfinding pair (see header comment).
const TYPE_CARDS = [
  {
    key: "competitive" as const,
    tone: "bg-royal",
    copy: LEAGUE_TYPE_CARDS.competitive,
    rows: competitiveRows,
  },
  {
    key: "developmental" as const,
    tone: "bg-emerald",
    copy: LEAGUE_TYPE_CARDS.developmental,
    rows: developmentalRows,
  },
]

// League info — two cards only. Rules & regulations and the reschedule policy
// are owner-authoring work (tracked), and a card that links nowhere is worse
// than no card.
const INFO_CARDS = [
  {
    kicker: "Live all season",
    title: "Schedules & standings",
    body: "Your division's schedule and table, updated after every game day.",
    go: "Find your division →",
    href: currentTerm ? `${basePath}/${currentTerm.slug}` : "#calendar",
    cta: "league-info-schedules",
  },
  {
    kicker: "Money",
    title: "Refund policy",
    body: "Full refund 14 or more days out; case by case inside 14 days.",
    go: "Read the policy →",
    href: "/refund-policy",
    cta: "league-info-refunds",
  },
]

// No numerals (the numeral rule) — sequence is carried by document order.
const HOW_STEPS = [
  {
    title: "Pick the age group",
    body: "Every division shows its ages right on the row — or use the birthday lookup above.",
  },
  {
    title: "Three-minute signup",
    body: "Register your kid and pay online — no account or password needed up front.",
  },
  {
    title: "You're set",
    body: "Schedule, coach intro, and any updates land by email and text before week 1.",
  },
]

const hasSeasonLinks = Boolean(currentTerm || upcomingTerms.length > 0 || pastTerms.length > 0)
const NAV_ITEMS = [
  { href: "#types", label: "League types" },
  { href: "#open", label: "Book now" },
  { href: "#commitment", label: "The commitment" },
  { href: "#teams", label: "Club teams" },
  { href: "#info", label: "League info" },
  { href: "#venues", label: "Venues" },
  { href: "#calendar", label: "Calendar" },
  { href: "#faq", label: "FAQs" },
]
---

<main id="main-content" class="flex-1">
  {/* ---------- Deadline banner — live term + the act-by date -------------
      Ochre = the tertiary-highlight role (camps precedent); the orange band
      budget belongs to the in-page nav and the closer. Keeps the testid and
      analytics hooks; points at on-page booking (#open) — the term links
      live in #calendar, where the crawlable-archive contract is satisfied.
      pt clears the fixed site header: this banner is the FIRST flow element
      on the page. */}
  {openRows.length > 0 && (
    <div class="bg-ochre text-ink px-6 sm:px-12 pt-16 lg:pt-20" data-testid="now-registering">
      <div class="max-w-[1080px] mx-auto flex items-center justify-between gap-4 flex-wrap py-3">
        <span class="text-[13.5px] font-semibold">● {bannerMessage}</span>
        <a
          href="#open"
          data-hero-banner-cta
          data-term={bannerTermSlug ?? ""}
          data-youth-cta="league-deadline-banner"
          class="label no-underline text-ink border-b-2 border-ink pb-0.5 whitespace-nowrap"
        >
          {DEADLINE_BANNER.cta}
        </a>
      </div>
    </div>
  )}

  {/* ---------- Hero — the two doors, above the fold ---------------------- */}
  <section class="band-ink relative overflow-hidden">
    <img
      src={HERO_IMAGE}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-[center_30%]"
      style="filter:grayscale(1) contrast(1.08) brightness(.96)"
    />
    <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
    <div class:list={["relative max-w-[1080px] mx-auto px-6 sm:px-12 pb-14 flex flex-col gap-5", openRows.length > 0 ? "pt-16" : "pt-28 lg:pt-32"]}>
      <h1 class="display-xl text-on-ink max-w-[760px]">{heroTitle}</h1>
      <p class="body-l text-on-ink-2 max-w-[560px]" style="text-wrap:pretty">
        U6 to U19, all year — <strong class="font-bold text-on-ink">competitive winter leagues for
        club teams</strong>, and <strong class="font-bold text-on-ink">developmental leagues</strong>
        where individual players sign up and we build the teams.
      </p>

      {/* The two path tiles. Same royal/emerald tones as the #types cards
          they scroll to, so the door you tap is visibly the door you land on. */}
      <div class="grid gap-3.5 pt-2" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
        <a
          href="#types"
          data-youth-cta="league-path-competitive"
          class="relative block bg-royal text-cream px-5 pt-4 pb-4 no-underline"
        >
          <h2 class="display-s text-cream m-0" style="font-size:1.5rem">Competitive leagues</h2>
          <div class="data text-cream/85 mt-1.5">For club teams · Winter · Nov – late Mar</div>
          <span class="absolute right-4 bottom-3 font-bold text-lg text-cream" aria-hidden="true">→</span>
        </a>
        <a
          href="#types"
          data-youth-cta="league-path-developmental"
          class="relative block bg-emerald text-cream px-5 pt-4 pb-4 no-underline"
        >
          <h2 class="display-s text-cream m-0" style="font-size:1.5rem">Developmental leagues</h2>
          <div class="data text-cream/85 mt-1.5">For individual players · Spring, summer &amp; fall</div>
          <span class="absolute right-4 bottom-3 font-bold text-lg text-cream" aria-hidden="true">→</span>
        </a>
      </div>

      <p class="text-[13.5px] text-on-ink-muted">
        Every game indoors, one game a week, Saturdays &amp; Sundays.
        {otherSport && (
          <Fragment>
            {" "}Also at Aspire:{" "}
            <a
              href={`/youth/leagues/${otherSport.slug}`}
              data-youth-cta={`league-crosslink-${otherSport.slug}`}
              class="text-primary-bright underline underline-offset-2"
            >
              youth {otherSport.name.toLowerCase()} →
            </a>
          </Fragment>
        )}
      </p>
    </div>
  </section>

  <InpageNav items={NAV_ITEMS} />

  {/* ---------- League types — divisions bookable INSIDE the cards --------
      The whole two-path thesis: the card that explains a door also contains
      the live rows for that door, so understanding and booking are one
      motion instead of two scroll positions. */}
  <section id="types" class="band-sand scroll-mt-36 px-6 sm:px-12 py-16" aria-labelledby={`youth-${sportSlug}-types`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
      <div class="flex flex-col gap-2.5 max-w-[640px]">
        <h2 id={`youth-${sportSlug}-types`} class="display-l">Two kinds of league</h2>
        <p class="body-copy text-on-sand-2">
          Same indoor turf, same weekend game days — a different door depending on whether a whole
          team is coming, or one kid is. Book from right here.
        </p>
      </div>

      <div class="grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
        {TYPE_CARDS.map((card) => (
          <div class={`${card.tone} text-cream px-7 pt-7 pb-[26px] flex flex-col`}>
            <h3 class="display-s m-0" style="font-size:1.5rem">{card.copy.heading}</h3>
            <p class="data text-cream/85 mt-2">{card.copy.kicker}</p>
            <p class="body-s text-cream/90 mt-2.5">{card.copy.body}</p>
            {card.copy.urgency && (
              <span class="self-start data bg-cream/15 px-3 py-2 mt-3.5">
                {card.copy.urgency}
              </span>
            )}

            <dl class="flex flex-wrap gap-x-8 gap-y-3 mt-5 pt-4 border-t border-cream/25 text-[12.5px]">
              {card.copy.facts.map((f) => (
                <div>
                  <dt class="label text-cream/70" style="font-size:0.65rem">{f.label}</dt>
                  <dd class="font-semibold mt-0.5 ml-0">{f.value}</dd>
                </div>
              ))}
            </dl>

            {/* Live rows. With nothing open in this lane the block is omitted
                entirely — an empty rows area under a "book from right here"
                promise reads as a broken page. */}
            {card.rows.length > 0 && (
              <div class="mt-4 border-t border-cream/25 pt-1.5">
                {card.rows.map((row) => {
                  const path = rowPath(row, card.key)
                  const RowTag = row.soldOut || !path ? "div" : "a"
                  return (
                    // Sold out is a state, not a destination — the row keeps
                    // its shape but drops the link and the analytics hook,
                    // matching YouthDivisionTable's muted pill.
                    <RowTag
                      href={row.soldOut || !path ? undefined : path.href}
                      data-youth-cta={row.soldOut || !path ? undefined : `league-row-${card.key}`}
                      data-division-inline-row={card.key}
                      data-division-sold-out={row.soldOut ? "true" : undefined}
                      class="flex justify-between items-center gap-2.5 py-[9px] border-b border-cream/15 last:border-b-0 text-cream no-underline"
                    >
                      <span>
                        <span class="font-semibold text-sm">{row.group}</span><br />
                        <span class="font-mono text-[10.5px] text-cream/80">{rowMeta(row, card.key)}</span>
                      </span>
                      <span
                        class={`font-mono text-[10px] tracking-[0.1em] uppercase px-3 py-[7px] whitespace-nowrap ${
                          row.soldOut || !path ? "bg-cream/20 text-cream/70" : "bg-cream text-ink"
                        }`}
                      >
                        {rowPill(row, card.key)}
                      </span>
                    </RowTag>
                  )
                })}
              </div>
            )}

            <div class="mt-3.5 text-[13px]">
              <a
                href={card.rows.length > 0 ? "#open" : "#calendar"}
                data-youth-cta={`league-types-all-${card.key}`}
                class="text-cream font-semibold underline underline-offset-2"
              >
                {card.rows.length > 0 ? card.copy.allLink : "Get notified when the next one opens ↓"}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Book — paper band, birthday lookup + the division table --- */}
  <section id="open" class="band-paper scroll-mt-36 border-y border-rule px-6 sm:px-12 py-16">
    <div class="max-w-[1080px] mx-auto flex flex-col gap-6">
      <div class="flex flex-col gap-2.5 max-w-[560px]">
        <h2 class="display-l">Every open division</h2>
        {/* Live status line, computed client-side — this page opts into edge
            caching (setMarketingEdgeCache, called by the route's frontmatter),
            so the line must not bake in at render time. Sport-scoped to agree
            with the table below. */}
        <TileFactsLine client:visible audience="youth" programTypes={["league"]} sport={sportSlug} tone="ink" />
      </div>
      <div>
        <AgeLookupInline finderId={FINDER_ID} sportKey={sportSlug} />
        <CategoryFinder
          client:load
          audience="youth"
          programTypes={["league"]}
          sport={sportSlug}
          title="Open divisions"
          descriptor="Every open division, one click to checkout."
          sectionId={FINDER_ID}
          layout="table"
          levelChips
          ageChips
          cardVariant="youth-band"
          headerHidden
        />
      </div>
    </div>
  </section>

  {/* ---------- The commitment — what a season actually asks of a family -- */}
  <section id="commitment" class="band-sand scroll-mt-36 px-6 sm:px-12 py-16" aria-labelledby={`youth-${sportSlug}-commitment`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
      <h2 id={`youth-${sportSlug}-commitment`} class="display-l">The commitment, up front</h2>
      <dl class="grid gap-x-8 gap-y-[26px] m-0" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
        {COMMITMENT_FACTS.map((f) => (
          <div>
            <dt class="label text-on-sand-muted">{f.label}</dt>
            <dd class="font-semibold text-[16px] leading-snug text-on-sand mt-1.5 ml-0">
              {f.value}
              {f.sub && <span class="block font-normal text-[11px] text-on-sand-muted">{f.sub}</span>}
            </dd>
          </div>
        ))}
        {venueSlugs.length > 0 && (
          <div class="sm:col-span-2">
            <dt class="label text-on-sand-muted">Where</dt>
            <dd class="font-semibold text-[16px] leading-snug text-on-sand mt-1.5 ml-0">
              {venueSlugs.map((slug, i) => (
                <Fragment>
                  {i > 0 && " or "}
                  <a
                    href={`/locations/${slug}`}
                    data-youth-cta="league-commitment-venue"
                    class="text-inherit underline underline-offset-[3px] decoration-1"
                  >
                    {VENUE_DISPLAY_NAMES[slug] ?? slug}
                  </a>
                </Fragment>
              ))}
            </dd>
          </div>
        )}
      </dl>
      <p class="text-[13px] text-on-sand-muted m-0">{commitmentNote}</p>
    </div>
  </section>

  {/* ---------- Club teams — the second door, spelled out ----------------- */}
  <section id="teams" class="band-ink scroll-mt-36 px-6 sm:px-12 py-16" aria-labelledby={`youth-${sportSlug}-teams`}>
    <div class="max-w-[1080px] mx-auto grid md:grid-cols-[1.4fr_1fr] gap-11 items-start">
      <div>
        <h2 id={`youth-${sportSlug}-teams`} class="display-l">Bringing a whole team?</h2>
        <p class="body-copy text-on-ink-2 mt-3.5">
          Winter entry is built for club teams — keep your squad together and playing through the
          cold months without giving your coaches another admin job.
        </p>
        <ul class="mt-4 list-none pl-0">
          {CLUB_TEAM_PROMISES.map((promise) => (
            <li class="relative pl-[22px] mt-2 text-sm text-on-ink-2">
              <span class="absolute left-0 text-primary-bright font-semibold" aria-hidden="true">—</span>
              {promise}
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-ink-lift border border-rule-on-ink p-[26px]">
        <h3 class="display-s text-on-ink m-0">{CLUB_CARD.heading}</h3>
        <p class="data text-primary-bright mt-1.5">Competitive entry · Nov – late Mar</p>
        <p class="body-s text-on-ink-2 mt-2">{CLUB_CARD.body}</p>
        <div class="flex flex-col gap-2.5 mt-[18px]">
          <a href="#open" data-youth-cta="league-club-enter" class="btn btn--primary no-underline justify-center">
            {CLUB_CARD.enterCta}
          </a>
          <a
            href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Winter team entry — youth ${sportSlug}`)}`}
            data-youth-cta="league-club-email"
            class="btn btn--on-ink no-underline justify-center"
          >
            {CLUB_CARD.emailCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- League info ------------------------------------------------ */}
  <section id="info" class="band-sand scroll-mt-36 px-6 sm:px-12 py-16" aria-labelledby={`youth-${sportSlug}-info`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
      <h2 id={`youth-${sportSlug}-info`} class="display-l">League info, all of it</h2>
      <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
        {INFO_CARDS.map((card) => (
          <a
            href={card.href}
            data-youth-cta={card.cta}
            class="block bg-paper border border-rule p-[22px] no-underline"
          >
            <div class="label text-on-sand-muted" style="font-size:0.65rem">{card.kicker}</div>
            <h3 class="display-s text-on-sand mt-2 m-0">{card.title}</h3>
            <p class="body-s text-on-sand-2 mt-1.5">{card.body}</p>
            <span class="inline-block label text-primary-text mt-3">{card.go}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Venues ---------------------------------------------------- */}
  <section id="venues" class="band-paper scroll-mt-36 border-y border-rule px-6 sm:px-12 py-16" aria-labelledby={`youth-${sportSlug}-venues`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
      <div class="flex flex-col gap-2.5 max-w-[640px]">
        <h2 id={`youth-${sportSlug}-venues`} class="display-l">Where you'll play</h2>
        <p class="body-copy text-on-sand-2">{venuesLede}</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {venueSlugs.map((slug) => {
          const vf = getVenueFacts(slug)
          return vf ? (
            <a
              href={`/locations/${slug}`}
              data-youth-cta={`league-venue-${slug}`}
              class="group border border-rule bg-sand overflow-hidden flex flex-col sm:flex-row no-underline"
            >
              {vf.photos[0] && (
                <img src={vf.photos[0].src} alt={vf.photos[0].alt} loading="lazy" class="sm:w-44 h-32 sm:h-auto object-cover" style="filter:grayscale(1) contrast(1.08) brightness(.96)" />
              )}
              <div class="p-5">
                <div class="display-s text-on-sand group-hover:text-primary-text">{VENUE_DISPLAY_NAMES[slug] ?? slug}</div>
                {vf.highwayAccess && (
                  <div class="font-mono text-[11px] text-on-sand-muted mt-1">{vf.highwayAccess}</div>
                )}
                <p class="body-s text-on-sand-2 mt-1">{vf.tagline}</p>
                <span class="inline-block label text-primary-text mt-2.5" style="font-size:0.65rem">Venue details &amp; directions →</span>
              </div>
            </a>
          ) : null
        })}
      </div>
    </div>
  </section>

  {/* ---------- How it works — quadrant grid, no numerals ----------------- */}
  <section class="band-ink px-6 sm:px-12 py-16" aria-labelledby={`youth-${sportSlug}-how`}>
    <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
      <h2 id={`youth-${sportSlug}-how`} class="display-l">How it works, for parents</h2>
      <div class="quadrants quadrants--accent grid-cols-1 sm:grid-cols-3">
        {HOW_STEPS.map((s) => (
          <div class="flex flex-col gap-2 p-6">
            <div class="font-black text-[19px] uppercase" style="font-stretch:84%">{s.title}</div>
            <p class="body-s text-on-ink-muted m-0">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Calendar + the crawlable term archive ---------------------
      The term links are server-rendered <a>s — same hrefs as before the
      recompose. They are the only inbound path to the term pages, every
      division page beneath them, their Event JSON-LD and the completed-term
      standings archive. Islands render nothing into the HTML, so this list
      cannot move inside one. */}
  <div id="calendar" class="scroll-mt-36">
    {hasSeasonLinks && (
      <section class="band-sand px-6 sm:px-12 pt-16" aria-labelledby={`youth-${sportSlug}-seasons`}>
        <div class="max-w-[1080px] mx-auto">
          <h2 id={`youth-${sportSlug}-seasons`} class="label text-on-sand-muted">
            All seasons
          </h2>
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[14px] mt-2.5 list-none pl-0">
            {currentTerm && (
              <li>
                <a href={`${basePath}/${currentTerm.slug}`} class="text-ink hover:text-primary-text font-semibold no-underline">
                  {currentTerm.label} <span class="data text-primary-text ml-1" style="font-size:0.6rem">Open now</span>
                </a>
              </li>
            )}
            {upcomingTerms.map((t) => (
              <li>
                <a href={`${basePath}/${t.slug}`} class="text-on-sand-2 hover:text-primary-text no-underline">
                  {t.label} <span class="data text-on-sand-muted ml-1" style="font-size:0.6rem">Coming up</span>
                </a>
              </li>
            ))}
            {pastTerms.map((t) => (
              <li>
                <a href={`${basePath}/${t.slug}`} class="text-on-sand-2 hover:text-primary-text no-underline">
                  {t.label} <span class="data text-on-sand-muted ml-1" style="font-size:0.6rem">Final standings</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
    <SeasonCalendarBand
      client:visible
      audience="youth"
      programTypes={["league"]}
      pageKey={`youth-${sportSlug}`}
      cardsSectionId={FINDER_ID}
      heading="The season calendar."
      descriptor="Seasons run back-to-back all year — leave your email and you'll hear the moment the next one opens."
      futureTerms={calendarTerms}
    />
  </div>

  {/* ---------- FAQs — orange accent per the Broadsheet page accent ------- */}
  <LandingFaq client:visible id="faq" heading="Questions parents ask." items={faqs} />

  {/* ---------- Cross-links — ink-lift pair ------------------------------- */}
  <section class="band-ink-lift border-t border-rule-on-ink" aria-label="More at Aspire">
    <div class="grid sm:grid-cols-2 gap-px bg-rule-on-ink">
      <div class="bg-ink-lift px-6 sm:px-12 py-11 flex flex-col gap-3">
        <h2 class="display-m">Training between seasons</h2>
        <p class="body-s text-on-ink-muted max-w-[420px]">
          Small-group classes from 18 months to nineteen years — a coach who explains, and one
          pathway so your kid never has to start over.
        </p>
        <a href="/youth/classes" data-youth-cta="crosslink-classes" class="label no-underline pt-1">
          See youth classes →
        </a>
      </div>
      <div class="bg-ink-lift px-6 sm:px-12 py-11 flex flex-col gap-3">
        <h2 class="display-m">Camps, all year long</h2>
        <p class="body-s text-on-ink-muted max-w-[420px]">
          Day camps on school breaks, plus specialty camps through the year — coached rather than
          supervised, by the same people they see all year.
        </p>
        <a href="/youth/camps" data-youth-cta="crosslink-camps" class="label no-underline pt-1">
          See camp dates →
        </a>
      </div>
    </div>
  </section>

  {/* ---------- Closer — the orange band ----------------------------------- */}
  <section class="band-orange px-6 sm:px-12 py-16" aria-labelledby={`youth-${sportSlug}-close-h`}>
    <div class="max-w-[1080px] mx-auto flex flex-wrap items-center justify-between gap-8">
      <div class="flex flex-col gap-2.5">
        <h2 id={`youth-${sportSlug}-close-h`} class="display-xl" style="font-size:clamp(2.5rem,5vw,4rem)">
          See you on game day.
        </h2>
        <p class="body-l font-medium text-ink">
          Whole team or one kid — book straight from this page in a few minutes.
        </p>
      </div>
      <div class="flex flex-col items-start sm:items-end gap-3">
        <a href="#open" data-youth-cta="league-close-book" class="btn btn--ink no-underline whitespace-nowrap !text-primary-bright hover:!text-ink">
          Book now
        </a>
        <a href="#teams" data-youth-cta="league-close-team" class="label no-underline text-ink border-b-2 border-ink pb-0.5">
          Competitive team entry →
        </a>
      </div>
    </div>
  </section>
</main>

<script>
  import { trackLandingCtaClicked } from "@/lib/analytics/events"
  import { track } from "@/lib/analytics/track"

  // Without this the deadline banner — the page's top-of-funnel CTA — fires
  // nothing, so tier 4 -> 5 conversion is invisible.
  document.querySelectorAll<HTMLAnchorElement>("[data-hero-banner-cta]").forEach((el) => {
    el.addEventListener("click", () => trackLandingCtaClicked({ term: el.dataset.term ?? "" }))
  })

  // Band CTAs fire the shared youth-section event — delegated so
  // island-hydrated CTAs still get tracked (classes precedent).
  document.addEventListener("click", (e) => {
    const el = e.target instanceof Element ? e.target.closest<HTMLElement>("[data-youth-cta]") : null
    if (!el) return
    track("youth_hub_section_cta_clicked", { section: el.dataset.youthCta ?? "" })
  })
</script>
