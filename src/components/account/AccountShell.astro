---
type ActiveSection = "profile" | "notifications" | "security" | "consents" | "invoices";

interface Props {
  active: ActiveSection;
  title?: string;
}

const { active, title } = Astro.props;

const navItems: Array<{ key: ActiveSection; label: string; href: string }> = [
  { key: "profile",       label: "Profile",        href: "/account/profile" },
  { key: "notifications", label: "Notifications",  href: "/account/notifications" },
  { key: "security",      label: "Security",       href: "/account/security" },
  { key: "consents",      label: "Consents",       href: "/account/consents" },
  { key: "invoices",      label: "Invoices",       href: "/account/invoices" },
];
---

<div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
  <!-- Left nav -->
  <nav
    aria-label="Account sections"
    class="flex-shrink-0 lg:w-48"
  >
    <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted mb-3">
      Account
    </p>
    <ul class="flex flex-row flex-wrap gap-1 lg:flex-col lg:gap-0.5">
      {navItems.map((item) => {
        const isActive = item.key === active;
        return (
          <li>
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "block px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                isActive
                  ? "bg-cream-2 text-ink border border-border"
                  : "text-ink-muted hover:text-ink hover:bg-cream-2",
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Page body -->
  <div class="flex-1 min-w-0">
    {title && (
      <h1 class="text-2xl font-bold text-ink mb-6">{title}</h1>
    )}
    <slot />
  </div>
</div>
