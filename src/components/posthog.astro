---
// PostHog client snippet — analytics + session replay + error tracking.
//
// PII posture for Aspire Sports:
//   - Replays record page text and form inputs as-is. Passwords are masked;
//     card details are unreachable (Stripe Elements are cross-origin iframes);
//     avatar/media images are blocked.
//   - Everything else is captured, INCLUDING child PII (names, DOBs, coach and
//     medical notes) on the dashboard, rosters, tagger, and admin pages. Treat
//     PostHog project access as access to that data.
//   - To withhold a specific surface: `ph-no-capture` class or
//     `data-ph-no-capture` attr blocks the element from replays entirely.

// Authed account holder for client-side identify-on-load. On SSR pages the
// middleware already validated the session, so we can identify immediately
// rather than waiting for a form submit — this is what links a returning
// session (incl. magic-link logins, whose server redirect never identifies
// the browser) to the person. Null on prerendered pages (no request user at
// build time); those are anonymous marketing pages and identity carries over
// from any SSR page the user hits in the same session.
// Also null on edge-cached pages: the response header signals that this page
// will be served from CDN to every visitor, so we must not bake per-user PII
// (email, id) into the HTML. PostHog will defer identify() to the next
// authenticated SSR page the user visits in the same session.
const edgeCached = Astro.response.headers.has("Netlify-CDN-Cache-Control");
const phUser = (!Astro.isPrerendered && !edgeCached && Astro.locals.user)
  ? {
      id: Astro.locals.user.id,
      email: Astro.locals.user.email,
      firstName: Astro.locals.user.firstName,
      lastName: Astro.locals.user.lastName,
    }
  : null;
---
<script is:inline define:vars={{ apiKey: import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN, apiHost: import.meta.env.PUBLIC_POSTHOG_HOST, phUser }}>
  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId captureException".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
  if (apiKey) {
    // Route ingestion through our own domain (/ingest, proxied to PostHog
    // in netlify.toml) so content/tracker blockers — which blocklist
    // *.i.posthog.com — can't silently drop events. Localhost has no proxy,
    // so fall back to the direct host (apiHost) there for local testing.
    var isLocalHost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    var resolvedApiHost = isLocalHost ? apiHost : '/ingest';
    posthog.init(apiKey, {
      api_host: resolvedApiHost,
      // PostHog app origin — needed when api_host is the relative proxy path
      // so toolbar/replay links still resolve to the cloud UI.
      ui_host: 'https://us.posthog.com',
      defaults: '2026-01-30',
      capture_pageview: true,
      capture_pageleave: true,
      autocapture: {
        // No element_allowlist: clickmaps/heatmaps are built from $autocapture
        // events, so restricting to a/button/input/select/textarea silently
        // drops every click on a card, tile, or div — which is most of the
        // dashboard and program-browse UI, and made the heatmaps look empty.
        dom_event_allowlist: ['click', 'submit', 'change'],
      },
      // Heatmaps (pointer/rage-click/scroll depth) — independent of autocapture
      // and of replay masking.
      capture_heatmaps: true,
      // Session replay — text and inputs are recorded as-is. Only the things
      // that are genuinely unsafe to keep are withheld:
      //   - password inputs (masked below; never useful in a replay)
      //   - card details: Stripe Elements are cross-origin iframes, so the
      //     recorder cannot see inside them at all. The blockSelector entry is
      //     belt-and-suspenders, not the actual mechanism.
      //   - uploaded photos (avatar/media URLs) stay blocked.
      // Anything else — including kids' names, DOBs, and coach/medical notes on
      // the dashboard, rosters, and admin pages — WILL appear in replays. That
      // is a deliberate call; if it needs to change, add `ph-mask` to those
      // elements and set maskTextClass rather than reinstating a global mask.
      session_recording: {
        maskAllInputs: false,
        maskInputOptions: {
          password: true,
        },
        // CSS selectors below are blocked from recording entirely. Add
        // `data-ph-no-capture` to any element that should never appear in
        // replays.
        blockClass: 'ph-no-capture',
        blockSelector: '[data-ph-no-capture], iframe[src*="stripe.com"], .stripe-element, img[src*="cloudinary"], img[src*="mock-r2"]',
      },
      // Error tracking: capture unhandled errors + promise rejections.
      capture_exceptions: true,
      // Drop exceptions thrown by scripts Meta's in-app browser (Instagram/
      // Facebook webview) injects into our pages — sendDataToNative /
      // sendPageHideMessage calling window.webkit.messageHandlers (iOS) or a
      // torn-down postMessage bridge (Android, "Java object is gone"), and
      // _AutofillCallbackHandler — Meta's autofill bridge, referenced by an
      // injected script but never defined outside the native shell ("Can't
      // find variable" on iOS, "is not defined" on Android). They are not our
      // code, fire as the visitor leaves the page, and were the top "errors"
      // in the project by user count. Everything else passes through
      // untouched.
      before_send: function (event) {
        if (!event || event.event !== '$exception') return event;
        try {
          var list = (event.properties && event.properties.$exception_list) || [];
          for (var i = 0; i < list.length; i++) {
            var msg = String((list[i] && list[i].value) || '');
            var frames = ((list[i] && list[i].stacktrace) || {}).frames || [];
            var fns = '';
            for (var j = 0; j < frames.length; j++) fns += ' ' + ((frames[j] && frames[j].function) || '');
            if (
              msg.indexOf('window.webkit.messageHandlers') !== -1 ||
              msg.indexOf('Java object is gone') !== -1 ||
              msg.indexOf('_AutofillCallbackHandler') !== -1 ||
              /sendDataToNative|sendPageHideMessage/.test(fns)
            ) {
              return null;
            }
          }
        } catch (_) { /* never block capture on filter errors */ }
        return event;
      },
      // Don't send `$ip` or `$set` enrichments by default (privacy).
      ip: false,
      property_denylist: ['$ip'],
    });

    // Brand super-property — attached to every captured event so the two
    // brands sharing one org can be segmented apart. Brand is purely
    // host-derived (source of truth: isSoccerOneHost in
    // lib/organization/soccerone-routing.ts); compute it from the hostname
    // rather than SSR locals so it's correct on prerendered pages too
    // (those bake a single brand at build time).
    var brand = /(^|\.)gosoccerone\.com$/i.test(window.location.hostname)
      ? 'soccerone'
      : 'aspire';
    posthog.register({ brand: brand });

    // Identify the account holder when the server already knows who they are.
    if (phUser && phUser.id) {
      posthog.identify(phUser.id, {
        email: phUser.email,
        firstName: phUser.firstName,
        lastName: phUser.lastName,
      });
    }
  } else {
    // No apiKey (dev/CI without PostHog token): the official snippet only
    // installs method stubs (capture, identify, captureException, …) inside
    // posthog.init, so calling them on the bare `[]` value throws TypeError
    // and breaks any handler that fires PostHog events. Install a permissive
    // noop layer so call sites can use plain `posthog?.method(...)` safely.
    const noop = function () { /* swallowed */ };
    Object.assign(window.posthog, {
      init: noop,
      capture: noop,
      identify: noop,
      captureException: noop,
      get_session_id: noop,
      alias: noop,
      reset: noop,
      register: noop,
      register_once: noop,
      group: noop,
      opt_in_capturing: noop,
      opt_out_capturing: noop,
      set_config: noop,
      isFeatureEnabled: function () { return false; },
      onFeatureFlags: noop,
      getFeatureFlag: noop,
      getFeatureFlagPayload: noop,
      reloadFeatureFlags: noop,
      people: { set: noop, set_once: noop },
    });
  }
</script>
