---
// SoccerOne — chain header. Dark anthracite + lime-green accent.
// Anton display font, DM Sans body. Two-facility pill selector.
const { currentFacility = "" } = Astro.props;
---

<header class="so-header" id="so-header">
  <div class="so-header-inner">

    <!-- Wordmark -->
    <a href="/soccerone" class="so-wordmark" aria-label="SoccerOne home">
      <span class="wm-soccer">SOCCER</span><span class="wm-one">ONE</span>
      <span class="wm-tagline">CBus</span>
    </a>

    <!-- Facility selector pill (desktop center) -->
    <div class="facility-selector" role="group" aria-label="Select facility">
      <a
        href="/soccerone/worthington"
        class={`facility-tab ${currentFacility === 'worthington' ? 'facility-tab--active' : ''}`}
        aria-current={currentFacility === 'worthington' ? 'page' : undefined}
      >
        <span class="tab-name">WORTHINGTON</span>
        <span class="tab-sub">3 FIELDS</span>
      </a>
      <a
        href="/soccerone/downtown"
        class={`facility-tab ${currentFacility === 'downtown' ? 'facility-tab--active' : ''}`}
        aria-current={currentFacility === 'downtown' ? 'page' : undefined}
      >
        <span class="tab-name">DOWNTOWN</span>
        <span class="tab-sub">1 FIELD</span>
      </a>
      <span class="facility-future" title="More locations coming 2026–2027">
        + Future locations
      </span>
    </div>

    <!-- Nav links -->
    <nav class="so-nav" aria-label="Main navigation">
      <a href="/soccerone/leagues" class="so-nav-link">Leagues</a>
      <a href="/soccerone/pickup" class="so-nav-link">Pickup</a>
      <a href="/soccerone/rent" class="so-nav-link">Rent</a>
      <a href="/soccerone/memberships" class="so-nav-link">Members</a>
    </nav>

    <!-- CTA -->
    <a href="/soccerone/rent" class="so-header-cta">Book Field</a>

    <!-- Mobile toggle -->
    <button class="so-mobile-btn" id="so-mobile-btn" aria-label="Open navigation">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="so-mobile-drawer" id="so-mobile-drawer" aria-hidden="true">
    <!-- Facility selector mobile -->
    <div class="mobile-facility-row">
      <a href="/soccerone/worthington" class={`mobile-facility-btn ${currentFacility === 'worthington' ? 'active' : ''}`}>
        WORTHINGTON &mdash; 3 FIELDS
      </a>
      <a href="/soccerone/downtown" class={`mobile-facility-btn ${currentFacility === 'downtown' ? 'active' : ''}`}>
        DOWNTOWN &mdash; 1 FIELD
      </a>
      <span class="mobile-future">+ Future locations</span>
    </div>
    <a href="/soccerone/leagues" class="mobile-nav-link">Leagues</a>
    <a href="/soccerone/pickup" class="mobile-nav-link">Pickup</a>
    <a href="/soccerone/rent" class="mobile-nav-link">Rent a Field</a>
    <a href="/soccerone/memberships" class="mobile-nav-link">Memberships</a>
    <a href="/soccerone/rent" class="mobile-cta">Book a Field Now</a>
    <span class="mobile-powered">
      Powered by <a href="/">Aspire Sports</a>
    </span>
  </div>
</header>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');

  .so-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: #0a0a0d;
    border-bottom: 1px solid rgba(163,230,53,0.2);
    font-family: 'DM Sans', sans-serif;
  }

  .so-header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Wordmark */
  .so-wordmark {
    display: flex;
    align-items: baseline;
    gap: 0;
    text-decoration: none;
    flex-shrink: 0;
    position: relative;
  }
  .wm-soccer {
    font-family: 'Anton', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: #ffffff;
    line-height: 1;
  }
  .wm-one {
    font-family: 'Anton', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: #a3e635;
    line-height: 1;
  }
  .wm-tagline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5625rem;
    font-weight: 500;
    color: rgba(163,230,53,0.6);
    letter-spacing: 0.1em;
    margin-left: 0.375rem;
    align-self: flex-end;
    margin-bottom: 2px;
    text-transform: uppercase;
  }

  /* Facility selector */
  .facility-selector {
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0 auto;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(163,230,53,0.2);
    border-radius: 6px;
    padding: 3px;
  }

  .facility-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 0.4rem 1.25rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    border: 1px solid transparent;
  }

  .facility-tab--active {
    background: #a3e635;
    border-color: #a3e635;
  }

  .tab-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
    transition: color 0.15s;
    white-space: nowrap;
  }
  .facility-tab--active .tab-name { color: #0a0a0d; }

  .tab-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
    transition: color 0.15s;
  }
  .facility-tab--active .tab-sub { color: rgba(10,10,13,0.6); }

  .facility-tab:hover:not(.facility-tab--active) {
    background: rgba(163,230,53,0.08);
    border-color: rgba(163,230,53,0.2);
  }
  .facility-tab:hover:not(.facility-tab--active) .tab-name { color: #a3e635; }
  .facility-tab:hover:not(.facility-tab--active) .tab-sub { color: rgba(163,230,53,0.5); }

  .facility-future {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.625rem;
    font-weight: 500;
    color: rgba(255,255,255,0.2);
    letter-spacing: 0.04em;
    padding: 0.4rem 0.875rem;
    white-space: nowrap;
    cursor: default;
    border-left: 1px solid rgba(255,255,255,0.08);
    margin-left: 2px;
  }

  /* Nav */
  .so-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .so-nav-link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    text-transform: uppercase;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }
  .so-nav-link:hover {
    color: #a3e635;
    background: rgba(163,230,53,0.06);
  }

  /* CTA */
  .so-header-cta {
    flex-shrink: 0;
    background: #a3e635;
    color: #0a0a0d;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.5rem 1.125rem;
    border-radius: 4px;
    transition: background 0.15s, transform 0.1s;
    white-space: nowrap;
  }
  .so-header-cta:hover {
    background: #bef264;
    transform: translateY(-1px);
  }

  /* Mobile button */
  .so-mobile-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }
  .so-mobile-btn span {
    display: block;
    width: 22px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Mobile drawer */
  .so-mobile-drawer {
    display: none;
    flex-direction: column;
    background: #0e0e10;
    border-top: 1px solid rgba(163,230,53,0.15);
    padding: 1.25rem 1.5rem 1.5rem;
    gap: 0;
  }
  .so-mobile-drawer.open {
    display: flex;
  }

  .mobile-facility-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .mobile-facility-btn {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.625rem 1rem;
    border-radius: 4px;
    border: 1px solid rgba(163,230,53,0.25);
    color: rgba(255,255,255,0.6);
    transition: background 0.15s, color 0.15s;
  }
  .mobile-facility-btn.active {
    background: #a3e635;
    color: #0a0a0d;
    border-color: #a3e635;
  }
  .mobile-future {
    font-size: 0.625rem;
    color: rgba(255,255,255,0.25);
    letter-spacing: 0.04em;
    padding-left: 1rem;
  }

  .mobile-nav-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .mobile-nav-link:hover { color: #a3e635; }

  .mobile-cta {
    margin-top: 1rem;
    display: block;
    background: #a3e635;
    color: #0a0a0d;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    padding: 1rem;
    border-radius: 4px;
  }

  .mobile-powered {
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.25);
    text-align: center;
    margin-top: 1rem;
  }
  .mobile-powered a {
    color: rgba(163,230,53,0.5);
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .facility-selector { display: none; }
  }
  @media (max-width: 900px) {
    .so-nav { display: none; }
    .so-header-cta { display: none; }
    .so-mobile-btn { display: flex; }
    .facility-selector { display: none; }
  }
</style>

<script>
  const btn = document.getElementById('so-mobile-btn');
  const drawer = document.getElementById('so-mobile-drawer');
  btn?.addEventListener('click', () => {
    const isOpen = drawer?.classList.toggle('open');
    drawer?.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
  });
</script>
