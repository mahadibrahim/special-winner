---
// SoccerOne — chain header. Dark anthracite + lime-green accent.
// Anton display font, DM Sans body. Two-facility pill selector.
//
// The tokens import here is the single distribution point: every
// SoccerOne page renders this header, so every page gets the brand
// custom properties (src/styles/soccerone-tokens.css).
import '@/styles/soccerone-tokens.css';
const { currentFacility = "" } = Astro.props;
---

<header class="so-header" id="so-header">
  <div class="so-header-inner">

    <!-- Wordmark -->
    <a href="/" class="so-wordmark" aria-label="SoccerOne home">
      <span class="wm-soccer">SOCCER</span><span class="wm-one">ONE</span>
      <span class="wm-tagline">CBus</span>
    </a>

    <!-- Facility selector pill (desktop center) -->
    <div class="facility-selector" role="group" aria-label="Select facility">
      <a
        href="/worthington"
        class={`facility-tab ${currentFacility === 'worthington' ? 'facility-tab--active' : ''}`}
        aria-current={currentFacility === 'worthington' ? 'page' : undefined}
      >
        <span class="tab-name">WORTHINGTON</span>
        <span class="tab-sub">2 FIELDS</span>
      </a>
      <a
        href="/downtown"
        class={`facility-tab ${currentFacility === 'downtown' ? 'facility-tab--active' : ''}`}
        aria-current={currentFacility === 'downtown' ? 'page' : undefined}
      >
        <span class="tab-name">DOWNTOWN</span>
        <span class="tab-sub">1 FIELD</span>
      </a>
      <span class="facility-future" title="More locations coming 2026–2027">
        + Future locations
      </span>
    </div>

    <!-- Nav links -->
    <nav class="so-nav" aria-label="Main navigation">
      <a href="/leagues" class="so-nav-link">Leagues</a>
      <a href="/pickup" class="so-nav-link">Pickup</a>
      <a href="/rent" class="so-nav-link">Rent</a>
      <a href="/signin" class="so-nav-link">Sign In</a>
    </nav>

    <!-- CTA -->
    <a href="/rent" class="so-header-cta">Book Field</a>

    <!-- Mobile toggle -->
    <button class="so-mobile-btn" id="so-mobile-btn" aria-label="Open navigation">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="so-mobile-drawer" id="so-mobile-drawer" aria-hidden="true">
    <!-- Facility selector mobile -->
    <div class="mobile-facility-row">
      <a href="/worthington" class={`mobile-facility-btn ${currentFacility === 'worthington' ? 'active' : ''}`}>
        WORTHINGTON &mdash; 2 FIELDS
      </a>
      <a href="/downtown" class={`mobile-facility-btn ${currentFacility === 'downtown' ? 'active' : ''}`}>
        DOWNTOWN &mdash; 1 FIELD
      </a>
      <span class="mobile-future">+ Future locations</span>
    </div>
    <a href="/leagues" class="mobile-nav-link">Leagues</a>
    <a href="/pickup" class="mobile-nav-link">Pickup</a>
    <a href="/rent" class="mobile-nav-link">Rent a Field</a>
    <a href="/signin" class="mobile-nav-link">Sign In</a>
    <a href="/rent" class="mobile-cta">Book a Field Now</a>
    <span class="mobile-powered">
      Powered by <a href="/">Aspire Sports</a>
    </span>
  </div>
</header>

<style>
  /* Fonts load once via each page's head <link> (preconnect + stylesheet)
     — the @import that used to live here double-fetched the same family
     set on every page. */

  .so-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--so-ink);
    border-bottom: 1px solid var(--so-lime-a20);
    font-family: var(--so-font-body);
  }

  .so-header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Wordmark */
  .so-wordmark {
    display: flex;
    align-items: baseline;
    gap: 0;
    text-decoration: none;
    flex-shrink: 0;
    position: relative;
  }
  .wm-soccer {
    font-family: var(--so-font-display);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: #ffffff;
    line-height: 1;
  }
  .wm-one {
    font-family: var(--so-font-display);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: var(--so-lime);
    line-height: 1;
  }
  .wm-tagline {
    font-family: var(--so-font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    color: var(--so-lime-a60);
    letter-spacing: 0.1em;
    margin-left: 0.375rem;
    align-self: flex-end;
    margin-bottom: 2px;
    text-transform: uppercase;
  }

  /* Facility selector */
  .facility-selector {
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0 auto;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--so-lime-a20);
    border-radius: var(--so-radius-md);
    padding: 3px;
  }

  .facility-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 0.4rem 1.25rem;
    border-radius: var(--so-radius-sm);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    border: 1px solid transparent;
  }

  .facility-tab--active {
    background: var(--so-lime);
    border-color: var(--so-lime);
  }

  .tab-name {
    font-family: var(--so-font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
    transition: color 0.15s;
    white-space: nowrap;
  }
  .facility-tab--active .tab-name { color: var(--so-ink); }

  .tab-sub {
    font-family: var(--so-font-mono);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
    transition: color 0.15s;
  }
  .facility-tab--active .tab-sub { color: rgba(10,10,13,0.6); }

  .facility-tab:hover:not(.facility-tab--active) {
    background: var(--so-lime-a08);
    border-color: var(--so-lime-a20);
  }
  .facility-tab:hover:not(.facility-tab--active) .tab-name { color: var(--so-lime); }
  .facility-tab:hover:not(.facility-tab--active) .tab-sub { color: var(--so-lime-a50); }

  .facility-future {
    font-family: var(--so-font-body);
    font-size: 0.625rem;
    font-weight: 500;
    color: rgba(255,255,255,0.2);
    letter-spacing: 0.04em;
    padding: 0.4rem 0.875rem;
    white-space: nowrap;
    cursor: default;
    border-left: 1px solid rgba(255,255,255,0.08);
    margin-left: 2px;
  }

  /* Nav */
  .so-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .so-nav-link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: var(--so-radius-sm);
    text-transform: uppercase;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }
  .so-nav-link:hover {
    color: var(--so-lime);
    background: var(--so-lime-a06);
  }

  /* CTA */
  .so-header-cta {
    flex-shrink: 0;
    background: var(--so-lime);
    color: var(--so-ink);
    font-family: var(--so-font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.5rem 1.125rem;
    border-radius: var(--so-radius-sm);
    transition: background 0.15s, transform 0.1s;
    white-space: nowrap;
  }
  .so-header-cta:hover {
    background: var(--so-lime-bright);
    transform: translateY(-1px);
  }

  /* Mobile button */
  .so-mobile-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }
  .so-mobile-btn span {
    display: block;
    width: 22px;
    height: 2px;
    background: #ffffff;
    border-radius: var(--so-radius-xs);
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Mobile drawer */
  .so-mobile-drawer {
    display: none;
    flex-direction: column;
    background: var(--so-surface);
    border-top: 1px solid var(--so-lime-a15);
    padding: 1.25rem 1.5rem 1.5rem;
    gap: 0;
  }
  .so-mobile-drawer.open {
    display: flex;
  }

  .mobile-facility-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .mobile-facility-btn {
    font-family: var(--so-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.625rem 1rem;
    border-radius: var(--so-radius-sm);
    border: 1px solid var(--so-lime-a25);
    color: rgba(255,255,255,0.6);
    transition: background 0.15s, color 0.15s;
  }
  .mobile-facility-btn.active {
    background: var(--so-lime);
    color: var(--so-ink);
    border-color: var(--so-lime);
  }
  .mobile-future {
    font-size: 0.625rem;
    color: rgba(255,255,255,0.25);
    letter-spacing: 0.04em;
    padding-left: 1rem;
  }

  .mobile-nav-link {
    font-family: var(--so-font-body);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .mobile-nav-link:hover { color: var(--so-lime); }

  .mobile-cta {
    margin-top: 1rem;
    display: block;
    background: var(--so-lime);
    color: var(--so-ink);
    font-family: var(--so-font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    padding: 1rem;
    border-radius: var(--so-radius-sm);
  }

  .mobile-powered {
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.25);
    text-align: center;
    margin-top: 1rem;
  }
  .mobile-powered a {
    color: var(--so-lime-a50);
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .facility-selector { display: none; }
  }
  @media (max-width: 900px) {
    .so-nav { display: none; }
    .so-header-cta { display: none; }
    .so-mobile-btn { display: flex; }
    .facility-selector { display: none; }
  }
</style>

<script>
  const btn = document.getElementById('so-mobile-btn');
  const drawer = document.getElementById('so-mobile-drawer');
  btn?.addEventListener('click', () => {
    const isOpen = drawer?.classList.toggle('open');
    drawer?.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
  });
</script>
