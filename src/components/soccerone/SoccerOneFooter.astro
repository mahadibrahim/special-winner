---
// SoccerOne footer — dark anthracite, lime accent, two-facility chain
import { SOCCERONE_CONTACT_EMAIL } from '@/lib/soccerone/contact';
---

<footer class="so-footer">
  <!-- Diagonal accent bar -->
  <div class="footer-accent-bar" aria-hidden="true">
    <div class="accent-diagonal"></div>
    <div class="accent-stat">
      <span class="as-num">4</span>
      <span class="as-label">FIELDS ACROSS COLUMBUS</span>
    </div>
    <div class="accent-stat">
      <span class="as-num">2</span>
      <span class="as-label">LOCATIONS OPEN NOW</span>
    </div>
    <div class="accent-stat">
      <span class="as-num">7AM–11PM</span>
      <span class="as-label">DAILY</span>
    </div>
    <div class="accent-cta">
      <a href="/soccerone/rent" class="accent-btn">Book a Field</a>
    </div>
  </div>

  <!-- Main grid -->
  <div class="footer-main">

    <!-- Brand -->
    <div class="footer-brand">
      <div class="brand-wordmark">
        <span class="bw-soccer">SOCCER</span><span class="bw-one">ONE</span>
      </div>
      <p class="brand-sub">Indoor soccer in Columbus, OH.<br />Worthington · Downtown · Expanding.</p>

      <!-- Location chips -->
      <div class="location-chips">
        <a href="/soccerone/worthington" class="loc-chip loc-chip--live">
          <span class="loc-dot"></span>
          Worthington — 3 Fields
        </a>
        <a href="/soccerone/downtown" class="loc-chip loc-chip--live">
          <span class="loc-dot"></span>
          Downtown — 1 Field
        </a>
        <span class="loc-chip loc-chip--soon">
          + Future locations
        </span>
      </div>

      <!-- Social icons removed until the accounts exist (all three were
           dead href="#" placeholders). Restore the .social-row markup from
           git history (SoccerOneFooter.astro, pre-2026-06-11) and add real
           profile URLs when the Zernio-managed accounts go live. -->
    </div>

    <!-- Play -->
    <div class="footer-col">
      <h3 class="fcol-heading">Play</h3>
      <ul class="fcol-links">
        <li><a href="/soccerone/leagues">Adult Coed League</a></li>
        <li><a href="/soccerone/leagues">Adult Premier League</a></li>
        <li><a href="/soccerone/pickup">Drop-In Pickup</a></li>
        <li><a href="/soccerone#programs">Youth Programs</a></li>
        <li><a href="/soccerone/rent">Field Rentals</a></li>
        <li><a href="/soccerone/memberships">Memberships</a></li>
      </ul>
    </div>

    <!-- Locations -->
    <div class="footer-col">
      <h3 class="fcol-heading">Locations</h3>
      <ul class="fcol-links">
        <li><a href="/soccerone/worthington">Worthington — 3 Fields</a></li>
        <li><a href="/soccerone/downtown">Downtown Columbus</a></li>
        <li class="future-loc">Coming: West Side</li>
        <li class="future-loc">Coming: Dublin</li>
      </ul>
      <div class="fcol-address">
        <strong>Worthington</strong>
        535 Lakeview Plaza Blvd, OH 43085
      </div>
      <div class="fcol-address">
        <strong>Downtown</strong>
        980 E Starr Ave, OH 43201
      </div>
    </div>

    <!-- Help -->
    <div class="footer-col">
      <h3 class="fcol-heading">Help</h3>
      <ul class="fcol-links">
        <li><a href={`mailto:${SOCCERONE_CONTACT_EMAIL}`}>Email Us</a></li>
        <li><a href="/refund-policy">Refund Policy</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/dashboard">My Account</a></li>
        <li><a href="/signin">Sign In</a></li>
      </ul>
    </div>

  </div>

  <!-- Bottom strip -->
  <div class="footer-strip">
    <span class="footer-copy">&copy; 2026 SoccerOne LLC. All rights reserved.</span>
    <span class="footer-powered">
      Powered by <a href="/">Aspire Sports</a> &mdash; the platform built for facilities like yours.
      <a href="/soccerone">Become a partner &rarr;</a>
    </span>
  </div>
</footer>

<style>
  .so-footer {
    background: #060608;
    border-top: 1px solid var(--so-lime-a15);
    font-family: var(--so-font-body);
  }

  /* Accent bar */
  .footer-accent-bar {
    background: var(--so-lime);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 3rem;
    padding: 1.25rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .accent-diagonal {
    position: absolute;
    right: 380px;
    top: 0;
    bottom: 0;
    width: 60px;
    background: rgba(0,0,0,0.07);
    transform: skewX(-12deg);
    pointer-events: none;
  }

  .accent-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .as-num {
    font-family: var(--so-font-display);
    font-size: 1.875rem;
    color: var(--so-ink);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .as-label {
    font-family: var(--so-font-mono);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: rgba(10,10,13,0.6);
  }

  .accent-cta {
    flex-shrink: 0;
    margin-left: auto;
  }

  .accent-btn {
    display: inline-block;
    background: var(--so-ink);
    color: var(--so-lime);
    font-family: var(--so-font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.625rem 1.5rem;
    border-radius: var(--so-radius-sm);
    transition: background 0.15s;
    white-space: nowrap;
  }
  .accent-btn:hover { background: #1a1a1e; }

  /* Main grid */
  .footer-main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3.5rem 2rem 2.5rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr 1fr;
    gap: 3rem;
  }

  /* Brand column */
  .brand-wordmark {
    font-family: var(--so-font-display);
    font-size: 2.25rem;
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
    line-height: 1;
  }
  .bw-soccer { color: #ffffff; }
  .bw-one { color: var(--so-lime); }

  .brand-sub {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.4);
    line-height: 1.55;
    margin: 0 0 1.5rem;
  }

  .location-chips {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .loc-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: var(--so-radius-sm);
    text-decoration: none;
    transition: background 0.15s;
    width: fit-content;
  }
  .loc-chip--live {
    background: var(--so-lime-a08);
    color: var(--so-lime-a80);
    border: 1px solid var(--so-lime-a20);
  }
  .loc-chip--live:hover { background: var(--so-lime-a14); color: var(--so-lime); }
  .loc-chip--soon {
    background: rgba(255,255,255,0.03);
    color: rgba(255,255,255,0.25);
    border: 1px solid rgba(255,255,255,0.08);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    cursor: default;
  }

  .loc-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--so-lime);
    box-shadow: 0 0 6px var(--so-lime);
    flex-shrink: 0;
  }

  .social-row {
    display: flex;
    gap: 0.625rem;
  }
  .social-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--so-radius-sm);
    border: 1px solid rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .social-icon:hover { border-color: var(--so-lime); color: var(--so-lime); }

  /* Columns */
  .footer-col { display: flex; flex-direction: column; }

  .fcol-heading {
    font-family: var(--so-font-mono);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--so-lime);
    margin: 0 0 1rem;
  }

  .fcol-links {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .fcol-links a {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.15s;
  }
  .fcol-links a:hover { color: #ffffff; }

  .future-loc {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.2);
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .fcol-address {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.35);
    line-height: 1.5;
    margin-bottom: 0.875rem;
  }
  .fcol-address strong {
    color: rgba(255,255,255,0.5);
    display: block;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 1px;
  }

  /* Bottom strip */
  .footer-strip {
    border-top: 1px solid rgba(255,255,255,0.07);
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-copy { font-size: 0.8125rem; color: rgba(255,255,255,0.25); }
  .footer-powered { font-size: 0.8125rem; color: rgba(255,255,255,0.25); }
  .footer-powered a { color: var(--so-lime-a50); text-decoration: none; transition: color 0.15s; }
  .footer-powered a:hover { color: var(--so-lime); }

  @media (max-width: 1100px) {
    .footer-main { grid-template-columns: 1.5fr 1fr 1fr; gap: 2rem; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-accent-bar { padding: 1rem 1.5rem; gap: 1.5rem; }
    .accent-diagonal { display: none; }
  }

  @media (max-width: 700px) {
    .footer-main { grid-template-columns: 1fr 1fr; padding: 2.5rem 1.5rem 2rem; }
    .footer-strip { flex-direction: column; align-items: flex-start; padding: 1rem 1.5rem; }
    .footer-accent-bar { flex-wrap: wrap; gap: 1rem; }
    .accent-stat { min-width: 80px; }
  }
</style>
