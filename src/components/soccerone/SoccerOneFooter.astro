---
// SoccerOne footer — dark navy, three-column, powered-by strip
---

<footer class="so-footer">
  <!-- Main columns -->
  <div class="footer-grid">
    <!-- Brand column -->
    <div class="footer-brand">
      <div class="footer-wordmark">
        <span class="fw-soccer">Soccer</span><span class="fw-one">One</span>
      </div>
      <p class="footer-tagline">Powell's premier indoor soccer complex. Year-round leagues, pickup, rentals, and youth programs for every level.</p>
      <div class="social-row">
        <!-- Instagram -->
        <a href="#" class="social-icon" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="3.5"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
          </svg>
        </a>
        <!-- Facebook -->
        <a href="#" class="social-icon" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <!-- X/Twitter -->
        <a href="#" class="social-icon" aria-label="X (Twitter)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <!-- YouTube -->
        <a href="#" class="social-icon" aria-label="YouTube">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" stroke="none" fill="currentColor"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Play column -->
    <div class="footer-col">
      <h3 class="footer-col-heading">Play</h3>
      <ul class="footer-links">
        <li><a href="/soccerone#leagues">Adult Coed League</a></li>
        <li><a href="/soccerone#leagues">Adult Premier League</a></li>
        <li><a href="/soccerone/pickup">Drop-In Pickup</a></li>
        <li><a href="/soccerone#programs">Youth Programs</a></li>
        <li><a href="/soccerone/rent">Field Rentals</a></li>
        <li><a href="/soccerone#birthday">Birthday Parties</a></li>
        <li><a href="/soccerone/memberships">Memberships</a></li>
      </ul>
    </div>

    <!-- About column -->
    <div class="footer-col">
      <h3 class="footer-col-heading">About</h3>
      <ul class="footer-links">
        <li><a href="/soccerone#about">Our Story</a></li>
        <li><a href="/soccerone#fields">The Fields</a></li>
        <li><a href="/soccerone#contact">Contact Us</a></li>
        <li><a href="/soccerone#coaches">Coaching Staff</a></li>
        <li><a href="/soccerone#careers">Work With Us</a></li>
      </ul>
    </div>

    <!-- Help column -->
    <div class="footer-col">
      <h3 class="footer-col-heading">Help</h3>
      <ul class="footer-links">
        <li><a href="/soccerone#faq">FAQ</a></li>
        <li><a href="/refund-policy">Refund Policy</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Service</a></li>
        <li><a href="/dashboard">My Account</a></li>
        <li><a href="/signin">Sign In</a></li>
      </ul>
    </div>
  </div>

  <!-- Powered-by strip -->
  <div class="footer-strip">
    <span class="footer-copy">&copy; 2026 SoccerOne LLC. All rights reserved.</span>
    <span class="footer-powered">
      Powered by&nbsp;
      <a href="/" class="aspire-link">Aspire Sports</a>
      &nbsp;&mdash; the multi-tenant sports platform built for facilities like yours.&nbsp;
      <a href="/soccerone" class="aspire-link">Partner with us &rarr;</a>
    </span>
  </div>
</footer>

<style>
  .so-footer {
    background: #061220;
    border-top: 2px solid #facc15;
    font-family: 'Inter', 'Space Grotesk', sans-serif;
    margin-top: 0;
  }

  .footer-grid {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .footer-wordmark {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 0.875rem;
  }

  .fw-soccer { color: #ffffff; }
  .fw-one { color: #facc15; }

  .footer-tagline {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 280px;
  }

  .social-row {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .social-icon:hover {
    border-color: #facc15;
    color: #facc15;
    background: rgba(250,204,21,0.06);
  }

  .footer-col-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #facc15;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  .footer-strip {
    border-top: 1px solid rgba(255,255,255,0.1);
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.35);
  }

  .footer-powered {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.35);
  }

  .aspire-link {
    color: rgba(250,204,21,0.7);
    text-decoration: none;
    transition: color 0.15s;
  }

  .aspire-link:hover {
    color: #facc15;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
