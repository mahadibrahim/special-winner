---
import { SKILL_LEVELS } from "@/lib/leagues/adult-soccer-content"
---
<section class="so-llv" aria-label="Find your level">
  <h2 class="so-llv-h">Find your level.</h2>
  <p class="so-llv-sub">Four tiers, so you're matched — not mismatched. Not sure? Most new players start at C or D.</p>
  <div class="so-llv-grid">
    {SKILL_LEVELS.map((lv) => (
      <div class="so-llv-card">
        <div class="so-llv-top">
          <span class="so-llv-bars">
            {[1,2,3,4].map((n) => <span class={`so-llv-bar ${n <= lv.bars ? "f" : ""}`}></span>)}
          </span>
          <span class="so-llv-letter">{lv.key.toUpperCase()}</span>
          <span class="so-llv-tag">{lv.label.toUpperCase()}</span>
        </div>
        <p class="so-llv-desc">{lv.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .so-llv {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }
  .so-llv-h {
    font-family: var(--so-font-display);
    text-transform: uppercase;
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .so-llv-sub {
    color: rgba(255,255,255,0.55);
    font-size: 0.9rem;
    margin-bottom: 1.75rem;
    max-width: 520px;
  }
  .so-llv-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .so-llv-card {
    border: 1px solid var(--so-lime-a15);
    border-radius: var(--so-radius-md);
    padding: 1.4rem 1.25rem;
    background: var(--so-surface);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .so-llv-top {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .so-llv-bars {
    display: flex;
    gap: 4px;
  }
  .so-llv-bar {
    width: 22px;
    height: 6px;
    border-radius: 2px;
    background: var(--so-lime-a15);
  }
  .so-llv-bar.f {
    background: var(--so-lime);
  }
  .so-llv-letter {
    font-family: var(--so-font-display);
    font-size: 3.5rem;
    color: #fff;
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .so-llv-tag {
    font-family: var(--so-font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--so-lime);
  }
  .so-llv-desc {
    color: rgba(255,255,255,0.55);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .so-llv-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .so-llv-grid { grid-template-columns: 1fr; }
  }
</style>
