---
// Yard-sign style directional line maps, per venue. Adapted from the
// SoccerOne maps for the same buildings, recolored to Aspire tokens.
// Worthington: I-270 along the south, venue NE of the I-270/US-23
// interchange at Exit 23. Downtown: I-71 on the west, E 5th Ave exit,
// St Clair south to E Starr — the long building north of Starr Ave.
// Renders nothing for venues without a drawn map.
const { slug } = Astro.props as { slug: string };
const hasMap = slug === "worthington";
const hasDowntownMap = slug === "downtown";
---

{
  hasMap && (
    <div
      class="rounded-2xl bg-ink p-4 sm:p-6"
      aria-label="Directional map"
      data-testid="venue-line-map"
    >
      <svg viewBox="0 0 460 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto block">
        {/* I-270 arc — south */}
        <path d="M20 250 Q 230 292 440 250" stroke="#EFE8DC" stroke-width="5" stroke-linecap="round" opacity="0.9" />
        <rect x="330" y="238" width="62" height="24" rx="4" fill="#EFE8DC" />
        <text x="361" y="255" fill="#211C15" font-family="monospace" font-size="13" font-weight="700" text-anchor="middle">I-270</text>
        {/* US-23 vertical on the west side */}
        <path d="M110 15 L110 268" stroke="#EFE8DC" stroke-width="4" stroke-linecap="round" opacity="0.9" />
        <rect x="84" y="150" width="52" height="22" rx="4" fill="#EFE8DC" />
        <text x="110" y="166" fill="#211C15" font-family="monospace" font-size="12" font-weight="700" text-anchor="middle">US-23</text>
        {/* Exit marker at the interchange */}
        <circle cx="110" cy="258" r="6" fill="#E05D2B" />
        <text x="128" y="262" fill="#EFE8DC" font-family="monospace" font-size="11">EXIT 23</text>
        {/* Cross streets */}
        <path d="M110 70 L330 70" stroke="#EFE8DC" stroke-width="2.5" opacity="0.75" />
        <text x="220" y="62" fill="#EFE8DC" font-family="monospace" font-size="10" text-anchor="middle">CAMPUS VIEW BLVD</text>
        <path d="M330 70 L330 140" stroke="#EFE8DC" stroke-width="2.5" opacity="0.75" />
        <text x="342" y="108" fill="#EFE8DC" font-family="monospace" font-size="10">SANCUS BLVD</text>
        <path d="M330 140 L246 140" stroke="#EFE8DC" stroke-width="2.5" opacity="0.75" />
        <text x="288" y="158" fill="#EFE8DC" font-family="monospace" font-size="10" text-anchor="middle">LAKEVIEW PLAZA</text>
        {/* Route: north on US-23, east on Campus View, south on Sancus, west on Lakeview */}
        <path d="M110 252 L110 70 L330 70 L330 140 L256 140" stroke="#E05D2B" stroke-width="3.5" stroke-dasharray="1 8" stroke-linecap="round" />
        {/* Pin */}
        <circle cx="246" cy="140" r="9" fill="#E05D2B" />
        <circle cx="246" cy="140" r="3.5" fill="#211C15" />
        <text x="246" y="122" fill="#FAF6EF" font-family="monospace" font-size="14" font-weight="700" text-anchor="middle" letter-spacing="2">ASPIRE</text>
        {/* North indicator */}
        <text x="435" y="24" fill="#EFE8DC" opacity="0.5" font-family="monospace" font-size="12" text-anchor="middle">N ↑</text>
      </svg>
      <p class="font-mono text-[10px] tracking-widest uppercase text-cream/60 mt-3">
        I-270 to the south · venue NE of Exit 23
      </p>
    </div>
  )
}

{
  hasDowntownMap && (
    <div
      class="rounded-2xl bg-ink p-4 sm:p-6"
      aria-label="Directional map"
      data-testid="venue-line-map"
    >
      <svg viewBox="0 0 460 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto block">
        {/* I-670 along the south + the railroad */}
        <path d="M20 262 Q 230 292 440 258" stroke="#EFE8DC" stroke-width="5" stroke-linecap="round" opacity="0.9" />
        <rect x="330" y="248" width="62" height="24" rx="4" fill="#EFE8DC" />
        <text x="361" y="265" fill="#211C15" font-family="monospace" font-size="13" font-weight="700" text-anchor="middle">I-670</text>
        <path d="M120 300 Q 260 210 440 205" stroke="#EFE8DC" stroke-width="2" stroke-dasharray="7 5" opacity="0.4" />
        <text x="395" y="196" fill="#EFE8DC" opacity="0.5" font-family="monospace" font-size="9">RAIL</text>
        {/* I-71 west edge */}
        <path d="M46 15 L46 292" stroke="#EFE8DC" stroke-width="5" stroke-linecap="round" opacity="0.9" />
        <rect x="22" y="120" width="48" height="22" rx="4" fill="#EFE8DC" />
        <text x="46" y="136" fill="#211C15" font-family="monospace" font-size="12" font-weight="700" text-anchor="middle">I-71</text>
        {/* E 5th Ave across the top */}
        <path d="M46 55 L440 55" stroke="#EFE8DC" stroke-width="3" opacity="0.85" />
        <text x="250" y="47" fill="#EFE8DC" font-family="monospace" font-size="10" text-anchor="middle">E 5TH AVE</text>
        <circle cx="46" cy="55" r="6" fill="#E05D2B" />
        <text x="60" y="40" fill="#EFE8DC" font-family="monospace" font-size="10">5TH AVE EXIT</text>
        {/* St Clair south */}
        <path d="M210 55 L210 235" stroke="#EFE8DC" stroke-width="2.5" opacity="0.75" />
        <text x="222" y="150" fill="#EFE8DC" font-family="monospace" font-size="10">ST CLAIR AVE</text>
        {/* Starr Ave east */}
        <path d="M210 200 L360 200" stroke="#EFE8DC" stroke-width="2.5" opacity="0.75" />
        <text x="292" y="218" fill="#EFE8DC" font-family="monospace" font-size="10" text-anchor="middle">E STARR AVE</text>
        {/* Route: exit at 5th, east to St Clair, south to Starr, east to the door */}
        <path d="M46 55 L210 55 L210 200 L316 200" stroke="#E05D2B" stroke-width="3.5" stroke-dasharray="1 8" stroke-linecap="round" />
        {/* The long building footprint north of Starr */}
        <rect x="300" y="176" width="52" height="14" rx="2" fill="#EFE8DC" opacity="0.25" stroke="#EFE8DC" stroke-opacity="0.6" stroke-width="1" />
        <circle cx="326" cy="200" r="9" fill="#E05D2B" />
        <circle cx="326" cy="200" r="3.5" fill="#211C15" />
        <text x="326" y="166" fill="#FAF6EF" font-family="monospace" font-size="14" font-weight="700" text-anchor="middle" letter-spacing="2">ASPIRE</text>
        {/* North indicator */}
        <text x="435" y="24" fill="#EFE8DC" opacity="0.5" font-family="monospace" font-size="12" text-anchor="middle">N ↑</text>
      </svg>
      <p class="font-mono text-[10px] tracking-widest uppercase text-cream/60 mt-3">
        Two minutes off I-71 · the long building north of Starr Ave
      </p>
    </div>
  )
}
