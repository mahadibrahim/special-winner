---
/**
 * EditorialHead — shared <head> fragment for the editorial design system.
 * Include this inside <head> on every page to get consistent font loading
 * with optimal performance (preconnect + font-display: swap).
 *
 * Usage:
 *   <head>
 *     <EditorialHead />
 *     <title>Page Title — Aspire Sports</title>
 *   </head>
 */
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Editorial typography — Newsreader (display) + IBM Plex Sans (body) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>
