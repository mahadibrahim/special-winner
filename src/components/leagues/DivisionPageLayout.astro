---
// Shared render for the per-division league pages. The route files
// (/adult/leagues/<sport>/[term]/[division].astro) load data via
// loadDivisionPage() and pass sport-specific copy in as props — everything
// factual (night, venue, price, dates, status) comes from the catalog row.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getVenueFacts } from "@/lib/locations/venue-facts";
import { breadcrumbJsonLd } from "@/lib/seo/breadcrumbs";
import { seasonsToLeagueEvents } from "@/lib/seo/events";
import { CAPTAIN_DEPOSIT_DOLLARS } from "@/lib/registrations/team-deposit";
import type { DivisionPageData } from "@/lib/leagues/division-page-data";
import type { DivisionAudience } from "@/lib/leagues/division-slug";

interface Props {
  data: DivisionPageData;
  /** URL base, e.g. "/adult/leagues/soccer" — term + division append to it. */
  basePath: string;
  /** Breadcrumb label for the sport tier, e.g. "Soccer". */
  sportCrumb: string;
  term: string;
  division: string;
  /**
   * Sport-specific "Format" fact value, e.g. "Indoor 7v7 · two 24-min halves".
   * Null omits the "Format" fact entirely — no roster/ball/field claims to make.
   */
  formatValue: string | null;
  /**
   * Sport-specific "Games" fact value, e.g. "7 games in 7 weeks · no playoffs".
   * Null omits the "Games" fact entirely.
   */
  gamesValue: string | null;
  /** "How the league works" bullet list (the sport's FORMAT_FACTS). Empty renders no bullets. */
  formatFacts: string[];
  /** Skill-tier explainer for lettered divisions; null for sports without tiers. */
  levelDescription?: string | null;
  /** One line of the meta description carrying the sport's format facts. Empty string omits it. */
  descriptionFormatLine: string;
  /** Defaults to "adult" so the existing indexed adult pages render byte-identically. */
  audience?: DivisionAudience;
}
const {
  data, basePath, sportCrumb, term, division,
  formatValue, gamesValue, formatFacts, levelDescription = null, descriptionFormatLine,
  audience = "adult",
} = Astro.props;
const audienceWord = audience === "youth" ? "Youth" : "Adult";
const leaguesLabel = `${audienceWord} Leagues`;
const leaguesHref = audience === "youth" ? "/youth/leagues" : "/adult/leagues";
const {
  season, naming, termLabel, sportName, dayName, timeWindow,
  isOpen, isForming, isCompleted, soloPrice, teamList, teamNow, teamEarlyBird,
  isAgeDivision, cityState, addressLine, siblings,
} = data;

const vf = getVenueFacts(season.location.slug);

const TZ = Astro.locals.organization?.timezone ?? "America/New_York";
const fmtShort = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const fmtDeadline = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: TZ });

const descriptionBits = [
  `${naming.label} ${audience === "youth" ? "youth" : "adult indoor"} ${sportName.toLowerCase()}${dayName ? ` on ${dayName}s` : ""} at ${season.location.name}`,
  `${termLabel}: ${fmtShort(season.startDate)}–${fmtShort(season.endDate)}`,
  descriptionFormatLine,
  soloPrice != null ? `Sign up solo ($${soloPrice}) or bring a team` : "Bring a team",
].filter((bit) => bit);
const pageDescription = `${descriptionBits.join(". ")}.`;

const ORIGIN = import.meta.env.PUBLIC_APP_URL || "https://aspiresportsohio.com";
const pageUrl = `${ORIGIN}${basePath}/${term}/${division}`;
const breadcrumbSchema = breadcrumbJsonLd([
  { name: "Home", url: `${ORIGIN}/` },
  { name: leaguesLabel, url: `${ORIGIN}${leaguesHref}` },
  { name: sportCrumb, url: `${ORIGIN}${basePath}` },
  { name: termLabel, url: `${ORIGIN}${basePath}/${term}` },
  { name: naming.headline, url: pageUrl },
]);
const eventSchema = seasonsToLeagueEvents([season], ORIGIN);

const facts: { label: string; value: string }[] = [
  dayName ? { label: "Night", value: timeWindow ? `${dayName}s · ${timeWindow}` : `${dayName}s` } : null,
  { label: "Venue", value: season.location.name },
  { label: "Season", value: `${fmtShort(season.startDate)} – ${fmtShort(season.endDate)}` },
  formatValue ? { label: "Format", value: formatValue } : null,
  gamesValue ? { label: "Games", value: gamesValue } : null,
  isAgeDivision
    ? { label: "Eligibility", value: `Ages ${season.minAge}+` }
    : levelDescription
      ? audience === "youth"
        ? { label: "Age group", value: levelDescription }
        : { label: "Level", value: naming.label }
      : null,
].filter((f): f is { label: string; value: string } => f !== null);
---

<BaseLayout title={naming.title} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    {eventSchema.length > 0 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(eventSchema)} />
    )}
  </Fragment>

  <main id="main-content" class="pt-24 pb-16">
    <div class="max-w-[860px] mx-auto px-5 sm:px-8">
      <nav class="text-[12px] text-ink-muted mb-6" aria-label="Breadcrumb">
        <a href={leaguesHref} class="hover:text-primary">{leaguesLabel}</a>
        <span aria-hidden="true"> / </span>
        <a href={basePath} class="hover:text-primary">{sportCrumb}</a>
        <span aria-hidden="true"> / </span>
        <a href={`${basePath}/${term}`} class="hover:text-primary">{termLabel}</a>
        <span aria-hidden="true"> / </span>
        <span class="text-ink">{naming.headline}</span>
      </nav>

      <header class="mb-8">
        <h1
          class="font-display text-ink mb-3"
          style="font-size: clamp(1.9rem, 4.5vw, 3rem); line-height: 1.08; letter-spacing: -0.02em;"
        >
          {naming.headline} {audienceWord} {sportName} League
        </h1>
        <p class="text-lg text-ink-2 max-w-2xl">
          {termLabel} at {season.location.name}{cityState ? ` — ${cityState}` : ""}.
          {isCompleted
            ? " This season has wrapped — final standings live on the season page."
            : isForming
              ? " This division is forming — join the interest list and we'll email you when registration opens."
              : ""}
        </p>
        {levelDescription && !isAgeDivision && audience !== "youth" && (
          <p class="text-[14px] text-ink-muted mt-2 max-w-2xl">{levelDescription}</p>
        )}
        {isAgeDivision && (
          <p class="text-[14px] text-ink-muted mt-2 max-w-2xl">
            An age-qualified division — every player is {season.minAge}+ so the pace and the parity match.
          </p>
        )}
      </header>

      <dl class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-border border border-border rounded-xl overflow-hidden mb-8">
        {facts.map((f) => (
          <div class="bg-paper px-4 py-3">
            <dt class="font-mono text-[10px] tracking-widest uppercase text-ink-muted">{f.label}</dt>
            <dd class="text-[14px] font-semibold text-ink mt-0.5">{f.value}</dd>
          </div>
        ))}
      </dl>

      {isOpen && (soloPrice != null || teamNow != null) && (
        <section class="mb-8" aria-label="Pricing and registration">
          <div class="grid sm:grid-cols-2 gap-3">
            {soloPrice != null && (
              <div class="border border-border rounded-xl bg-paper p-5 flex flex-col">
                <div class="font-mono text-[10px] tracking-widest uppercase text-ink-muted">Sign up solo</div>
                <div class="text-3xl font-semibold text-ink mt-1">${soloPrice.toLocaleString()}</div>
                <p class="text-[13px] text-ink-2 mt-1.5 flex-1">
                  No team? We place you — free agents go onto balanced squads by skill and schedule.
                </p>
                <a
                  href={`/register/${season.id}?mode=individual`}
                  class="mt-4 inline-flex items-center justify-center px-5 py-3 bg-ink text-cream text-sm font-semibold rounded-lg hover:bg-primary transition-colors"
                >
                  Sign Up Solo
                </a>
              </div>
            )}
            {teamNow != null && (
              <div class="border border-border rounded-xl bg-paper p-5 flex flex-col">
                <div class="font-mono text-[10px] tracking-widest uppercase text-ink-muted">Per team</div>
                <div class="text-3xl font-semibold text-ink mt-1">
                  ${teamNow.toLocaleString()}
                  {teamEarlyBird && <small class="text-[12px] font-normal text-ink-muted"> early bird</small>}
                </div>
                <p class="text-[13px] text-ink-2 mt-1.5 flex-1">
                  {teamEarlyBird && season.earlyBirdDeadline && teamList != null
                    ? `$${teamList.toLocaleString()} after ${fmtDeadline(season.earlyBirdDeadline)} · `
                    : ""}
                  ${CAPTAIN_DEPOSIT_DOLLARS} down holds your team's spot — get a team together and pay the rest before game 1.
                </p>
                <a
                  href={`/register/${season.id}?mode=team`}
                  class="mt-4 inline-flex items-center justify-center px-5 py-3 bg-primary text-cream text-sm font-semibold rounded-lg hover:bg-ink transition-colors"
                >
                  Bring a Team
                </a>
              </div>
            )}
          </div>
          {season.registrationCloses && (
            <p class="text-[12.5px] text-ink-muted mt-2.5">
              Registration closes {fmtDeadline(season.registrationCloses)}.
            </p>
          )}
        </section>
      )}

      {isForming && (
        <section class="mb-8 border border-border rounded-xl bg-paper p-5">
          <p class="text-[14px] text-ink-2">
            Registration for this division hasn't opened yet.
            <a href={`${basePath}/${term}#divisions`} class="text-primary font-semibold hover:underline">
              Join the interest list on the season page →
            </a>
          </p>
        </section>
      )}

      {isCompleted && (
        <section class="mb-8 border border-border rounded-xl bg-paper p-5">
          <p class="text-[14px] text-ink-2">
            This season is complete.
            <a href={`${basePath}/${term}#divisions`} class="text-primary font-semibold hover:underline">
              See final standings →
            </a>
          </p>
        </section>
      )}

      {formatFacts.length > 0 && (
        <section class="mb-8">
          <h2 class="font-display text-2xl text-ink mb-3">How the league works</h2>
          <ul class="space-y-1.5 text-[14px] text-ink-2 list-disc pl-5">
            {formatFacts.map((f) => <li>{f}</li>)}
          </ul>
        </section>
      )}

      <section class="mb-8">
        <h2 class="font-display text-2xl text-ink mb-3">Where you'll play</h2>
        <div class="border border-border rounded-xl bg-paper p-5">
          <div class="font-semibold text-ink">{season.location.name}</div>
          <p class="text-[13.5px] text-ink-2 mt-0.5">{addressLine}</p>
          {vf && <p class="text-[13.5px] text-ink-muted mt-1.5">{vf.tagline}</p>}
          <a href={`/locations/${season.location.slug}`} class="inline-block text-[13px] font-semibold text-primary mt-2.5 hover:underline">
            Venue details &amp; directions →
          </a>
        </div>
      </section>

      {siblings.length > 0 && (
        <section class="border-t border-border pt-8">
          <h2 class="font-display text-xl text-ink mb-1.5">Other {termLabel} divisions</h2>
          <p class="text-[13px] text-ink-muted mb-4">
            Different night, level, or side of town?
            <a href={`${basePath}/${term}`} class="text-primary font-semibold hover:underline">Compare them all →</a>
          </p>
          <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-1.5 text-[14px]">
            {siblings.map((sib) => (
              <li>
                <a href={`${basePath}/${term}/${sib.slug}`} class="text-ink-2 hover:text-primary">
                  {sib.headline} · {sib.venueName}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
