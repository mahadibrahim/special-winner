---
// src/components/landing/category-hero.astro
// Reusable bold-catalog hero for category pages (pickup, tournaments,
// youth/leagues, youth/camps). Mirrors the hero on /adult/leagues: full-bleed
// video, layered oklch overlay, display headline, sport/format tiles, and an
// optional cross-link. Live tiles either link out (when `href` is set) or
// scroll-and-filter the finder section identified by `finderId`.
import { tileLinksOut, type HeroTile } from "@/lib/landing/hero-tiles"

interface Props {
  title: string
  subhead: string
  /** mp4 sources, highest quality first. */
  videoSources: string[]
  poster: string
  tiles: HeroTile[]
  /** Finder <section> id the tiles scroll to / filter (e.g. "sessions"). */
  finderId: string
  crosslink?: { prompt: string; href: string; label: string }
}
const { title, subhead, videoSources, poster, tiles, finderId, crosslink } = Astro.props
---

<section class="band-ink relative overflow-hidden px-9" style="background:var(--ink-deep)">
  <video autoplay muted loop playsinline aria-hidden="true" class="absolute inset-0 w-full h-full object-cover z-0" style="filter:grayscale(1) contrast(1.08) brightness(.96)" poster={poster}>
    {videoSources.map((src) => <source src={src} type="video/mp4" />)}
  </video>
  <div class="hero-scrim absolute inset-0 z-[1]" aria-hidden="true"></div>
  <div class="relative z-[2] max-w-[1080px] mx-auto px-6 sm:px-3 pt-28 lg:pt-32 pb-8">
    <h1 class="display-xl text-on-ink max-w-[760px]">{title}</h1>
    <p class="mt-3 body-l text-on-ink-2 max-w-[540px]" style="text-wrap:pretty">{subhead}</p>

    <div class="grid sm:grid-cols-3 gap-3 mt-6">
      {tiles.map((t) =>
        tileLinksOut(t) ? (
          <a href={t.href} data-sport-tile data-sport={t.key} data-state="live" class="relative rounded-2xl p-4 text-ink overflow-hidden" style={t.color ? `background:${t.color}` : undefined}>
            <div class="font-mono text-[9px] tracking-widest uppercase opacity-80">{t.statusLabel}</div>
            <div class="display-s mt-1.5" style="font-size:1.5rem">{t.label}</div>
            <div class="font-mono text-xs">{t.meta}</div>
            <span class="absolute right-4 bottom-4 font-semibold text-lg">→</span>
          </a>
        ) : t.state === "live" && t.fallbackHref ? (
          // Scroll-filter tile with a safety net: the script intercepts the
          // click and filters the finder as usual, but lets the navigation
          // through when the finder's catalog is empty (or JS never ran).
          <a href={t.fallbackHref} data-sport-tile data-sport={t.key} data-state="live" data-finder={finderId} class="relative rounded-2xl p-4 text-ink overflow-hidden" style={t.color ? `background:${t.color}` : undefined}>
            <div class="font-mono text-[9px] tracking-widest uppercase opacity-80">{t.statusLabel}</div>
            <div class="display-s mt-1.5" style="font-size:1.5rem">{t.label}</div>
            <div class="font-mono text-xs">{t.meta}</div>
            <span class="absolute right-4 bottom-4 font-semibold text-lg">→</span>
          </a>
        ) : t.state === "live" ? (
          <button type="button" data-sport-tile data-sport={t.key} data-state="live" data-finder={finderId} class="relative text-left rounded-2xl p-4 text-ink overflow-hidden cursor-pointer" style={t.color ? `background:${t.color}` : undefined}>
            <div class="font-mono text-[9px] tracking-widest uppercase opacity-80">{t.statusLabel}</div>
            <div class="display-s mt-1.5" style="font-size:1.5rem">{t.label}</div>
            <div class="font-mono text-xs">{t.meta}</div>
            <span class="absolute right-4 bottom-4 font-semibold text-lg">→</span>
          </button>
        ) : (
          <div data-sport-tile data-sport={t.key} data-state="coming_soon" class="p-4 border border-rule-on-ink text-on-ink-2 bg-ink-lift">
            <div class="font-mono text-[9px] tracking-widest uppercase opacity-80">{t.statusLabel}</div>
            <div class="display-s mt-1.5" style="font-size:1.5rem">{t.label}</div>
            <div class="font-mono text-xs">{t.meta}</div>
          </div>
        ),
      )}
    </div>

    {crosslink && (
      <p class="mt-5 text-sm text-cream/70">
        {crosslink.prompt}{" "}
        <a href={crosslink.href} class="text-primary-bright underline underline-offset-2 hover:text-cream transition-colors">{crosslink.label}</a>
      </p>
    )}
  </div>
</section>

<script>
  import { trackCatalogSportTileClicked } from "@/lib/analytics/events"
  import { dispatchFinderFilter } from "@/lib/landing/finder-filter"

  document.querySelectorAll<HTMLElement>("[data-sport-tile]").forEach((el) => {
    el.addEventListener("click", (e) => {
      const state = (el.dataset.state as "live" | "coming_soon") ?? "live"
      trackCatalogSportTileClicked({ sport: el.dataset.sport ?? "", state })
      // A live tile with a data-finder attr scroll-filters the finder. When
      // the tile is an anchor (fallbackHref set) and the finder has loaded an
      // EMPTY catalog, we let the navigation through instead — filtering a
      // finder with nothing in it is a dead end. While the finder is still
      // loading we prefer the in-page filter (its skeletons are visible).
      const finderId = el.dataset.finder
      if (state === "live" && finderId) {
        const section = document.getElementById(finderId)
        const finderEmpty = Boolean(section?.querySelector("[data-finder-empty]"))
        if (el instanceof HTMLAnchorElement && finderEmpty) return
        e.preventDefault()
        dispatchFinderFilter({ key: el.dataset.sport ?? "", sectionId: finderId })
      }
    })
  })
</script>
