---
// src/components/landing/hub-hero.astro
// Broadsheet hero for the audience hubs (/adult). Video bg (brand-graded —
// marketing footage never appears raw, same recipe as .graded) + display
// capitals + subhead. No eyebrow (project preference). Hub cards render
// below via <CategoryCard> in the page.
interface Props {
  title: string
  subhead: string
  videoSources: string[]
  poster: string
}
const { title, subhead, videoSources, poster } = Astro.props
---

<section class="band-ink relative overflow-hidden" style="background:var(--ink-deep)">
  <video
    autoplay muted loop playsinline aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover z-0 opacity-55"
    style="filter:grayscale(1) contrast(1.08) brightness(.96)"
    poster={poster}
  >
    {videoSources.map((src) => <source src={src} type="video/mp4" />)}
  </video>
  <div class="hero-scrim absolute inset-0 z-[1]" aria-hidden="true"></div>
  <div class="relative z-[2] max-w-[1080px] mx-auto px-6 sm:px-12 pt-28 lg:pt-32 pb-11">
    <h1 class="display-xl text-on-ink max-w-[760px]">{title}</h1>
    <p class="mt-4 body-l text-on-ink-2 max-w-[560px]" style="text-wrap:pretty">{subhead}</p>
  </div>
</section>
