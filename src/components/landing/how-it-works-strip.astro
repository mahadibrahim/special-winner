---
// src/components/landing/how-it-works-strip.astro
// Three-step "how it works" strip for category landing pages. Fully static —
// heading and step copy come in via props so /adult/leagues and /youth/leagues
// each author their own sequence. The v1 numbered markers are retired: the
// Broadsheet numeral rule holds that "ordered" is not an exemption — the
// sequence is carried by document order and the ink rule above each step.
//
// Aspire-brand pages only — do not import into SoccerOne-brand pages (cream
// tokens invert under the SoccerOne theme).

interface Step {
  title: string
  body: string
}

interface Props {
  heading: string
  steps: Step[]
}

const { heading, steps } = Astro.props
---

<section class="py-12 lg:py-16">
  <div class="max-w-[1080px] mx-auto px-6 sm:px-9">
    <h2 class="display-l text-ink">{heading}</h2>
    <div class="mt-8 grid sm:grid-cols-3 gap-8">
      {steps.map((step) => (
        <div class="border-t-2 border-ink pt-4">
          <h3 class="display-s text-ink">{step.title}</h3>
          <p class="text-sm text-ink-muted mt-2 leading-relaxed">{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
