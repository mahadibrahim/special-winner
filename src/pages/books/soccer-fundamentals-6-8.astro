import "../../styles/book.css";
import { CURRICULUM_CONTENT } from "@/lib/curriculum/content";

const STAGE_SLUGS = new Set(["discovery", "fundamentals"]);

const discoveryStage = CURRICULUM_CONTENT.stages.find((s) => s.slug === "discovery")!;
const fundamentalsStage = CURRICULUM_CONTENT.stages.find((s) => s.slug === "fundamentals")!;

