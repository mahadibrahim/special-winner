  .filter((a) => a.sport === "soccer" && (a.appropriateStages ?? []).some((s) => STAGE_SLUGS.has(s)))
  .sort((a, b) => a.name.localeCompare(b.name));

const soccerSessionPlans = CURRICULUM_CONTENT.sessionPlans.filter(
  (p) => p.sport === "soccer" && p.stage === "fundamentals",
);

const skillNameBySlug = new Map(soccerSkills.map((s) => [s.slug, s.name]));

// Curated, sport/stage-scoped principle set for Chapter 1 ("How Children
// Learn Soccer"): generic (stage/sport undefined) principles plus any
// scoped specifically to soccer and/or discovery|fundamentals. Excludes
// principles scoped to other sports (basketball's "Lower the Hoop", etc.)
// or later stages (skill-building/development/etc.).
const PRINCIPLE_ORDER = [
  "Fun is Non-Negotiable",
  "Play is the Teacher",
  "Movement First",
  "Every Ball, Every Player",
  "Questions Over Instructions",
  "Game-Based Learning",
  "Psychological Safety",
  "Individual Development Paths",
  "Development Over Winning",
  "Ask, Don't Tell",
  "Small-Sided is Superior",
  "Ball Mastery First",
];
const principles = PRINCIPLE_ORDER.map((title) =>
  CURRICULUM_CONTENT.coachGuidance.principles.find((p) => p.title === title),
).filter((p): p is Record<string, unknown> => Boolean(p));

// Chapter 6 resources: parent-communication topics, natural-key title match.
const PARENT_RESOURCE_TITLES = [
  "Partnering with Parents: Building Trust and Alignment",
  "The Post-Game Conversation: What Parents Should Say",
];
const parentResources = PARENT_RESOURCE_TITLES.map((title) =>
  CURRICULUM_CONTENT.coachGuidance.resources.find((r) => r.title === title),
).filter((r): r is Record<string, unknown> => Boolean(r));

/** Minimal markdown -> HTML for coachGuidance resource `content` fields
 * (headers, `-` lists, blank-line paragraphs, `**bold**`). Content is
 * static, trusted, and authored in the repo — no user input reaches this. */
function inline(s: string): string {
  return s.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
}
function markdownToHtml(md: string): string {
  const lines = md.split("\n");
  let html = "";
  let inList = false;
  const closeList = () => {
    if (inList) {
      html += "</ul>";
      inList = false;
    }
  };
  for (const raw of lines) {
    const line = raw.trim();
    if (line === "") {
      closeList();
      continue;
    }
    if (line.startsWith("# ")) {
      // Top-level markdown title duplicates the resource's own <h3>; skip it.
      continue;
    }
    if (line.startsWith("### ")) {
      closeList();
      html += `<h5>${inline(line.slice(4))}</h5>`;
      continue;
    }
    if (line.startsWith("## ")) {
      closeList();
      html += `<h4>${inline(line.slice(3))}</h4>`;
      continue;
    }
    if (line.startsWith("- ")) {
      if (!inList) {
        html += "<ul>";
        inList = true;
      }
      html += `<li>${inline(line.slice(2))}</li>`;
      continue;
    }
    closeList();
    html += `<p>${inline(line)}</p>`;
  }
  closeList();
  return html;
}

/** Activities carry a short `description` (1-2 sentences) plus a
 * `howToPlay` field. For most activities howToPlay IS the short summary
 * (single short paragraph); a handful carry a long, phase-by-phase live
 * coaching script (2000+ chars) intended for a coach's private notes, not
 * a parent/coach-facing print page. Print the concise version either way
 * and let coachingPoints/commonMistakes/variations carry the actionable
 * detail (already cue-sized, print-friendly bullets). */
function playSummary(a: { description?: string; howToPlay: string }): string {
  return a.howToPlay.length > 400 ? (a.description ?? a.howToPlay.slice(0, 300) + "…") : a.howToPlay;
}

/** A handful of activities carry structured, newline-separated `makeEasier`/
 * `makeHarder` text ("SIGNS THEY'RE STRUGGLING:\n• ...\n• ...\nSOLUTIONS:\n• ...")
 * rather than the one-line version most activities use. Render label lines
 * (ending in `:`) as mini-headers and `•`/`-` lines as a real <ul> instead of
 * dumping the whole block into one unbroken paragraph — both more readable
 * and less likely to force an oversized break-inside:avoid block off the
 * bottom of a page. */
function bulletBlockToHtml(text: string): string {
  const lines = text
    .split("\n")
    .map((l) => l.trim())
    .filter(Boolean);
  let html = "";
  let inList = false;
  const closeList = () => {
    if (inList) {
      html += "</ul>";
      inList = false;
    }
  };
  for (const line of lines) {
    if (line.startsWith("•") || line.startsWith("- ")) {
      if (!inList) {
        html += "<ul>";
        inList = true;
      }
      html += `<li>${line.replace(/^[•-]\s*/, "")}</li>`;
      continue;
    }
    closeList();
    html += line.endsWith(":") ? `<p class="mini-label">${line}</p>` : `<p>${line}</p>`;
  }
  closeList();
  return html;
}

function pct(weight: string): string {
  return `${Math.round(parseFloat(weight) * 100)}%`;
}
