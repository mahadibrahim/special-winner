---
export const prerender = true;
/**
 * Mini-Book: The Path to Better Passing (Soccer)
 * Evidence-Based Youth Development Guide
 */
import { passingMiniBook } from '../../data/minibooks/soccer-passing';
import '../../styles/print-guide.css';
import '../../styles/minibook.css';

const book = passingMiniBook;

// Helper to get player story by placement
const getPlayerStory = (placement: string) =>
  book.playerStories?.find(s => s.placement === placement);

// Helper to get coach wisdom by placement
const getCoachWisdom = (placement: string) =>
  book.coachWisdom?.find(w => w.placement === placement);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{book.meta.title} | Aspire Sports</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  </head>

  <body>
    <div class="minibook guide-soccer">
      <!-- Cover Page -->
      <section class="minibook-cover">
        <div class="minibook-cover-top">
          <img src="/images/logo-black.png" alt="Aspire Sports" class="minibook-logo" />
          <span class="minibook-series">Evidence-Based Youth Development</span>
        </div>

        <div class="minibook-cover-main">
          <div class="minibook-sport-icon">Soccer</div>
          <h1 class="minibook-title">{book.meta.title}</h1>
          <p class="minibook-subtitle">{book.meta.subtitle}</p>
        </div>

        <div class="minibook-cover-bottom">
          <div class="minibook-tagline">{book.introduction.hook}</div>
        </div>
      </section>

      <!-- Half-Title Page -->
      <section class="minibook-half-title">
        <div class="half-title-content">
          <h1 class="half-title-text">{book.meta.title}</h1>
        </div>
      </section>

      <!-- Title Page -->
      <section class="minibook-title-page">
        <div class="title-page-header">
          <img src="/images/logo-black.png" alt="Aspire Sports" class="title-page-logo" />
          <span class="title-page-series">Evidence-Based Youth Development Series</span>
        </div>

        <div class="title-page-main">
          <div class="title-page-sport">Soccer</div>
          <h1 class="title-page-title">{book.meta.title}</h1>
          <p class="title-page-subtitle">{book.meta.subtitle}</p>
        </div>

        <div class="title-page-credits">
          <div class="title-page-author">
            <span class="credit-label">Written by</span>
            <span class="credit-name">Mahad Ibrahim</span>
          </div>
          <div class="title-page-publisher">
            <img src="/images/logo-black.png" alt="Aspire Sports" class="publisher-logo" />
          </div>
        </div>
      </section>

      <!-- Copyright Page -->
      <section class="minibook-copyright">
        <div class="copyright-content">
          <p class="copyright-title">{book.meta.title}</p>
          <p class="copyright-subtitle">{book.meta.subtitle}</p>

          <div class="copyright-legal">
            <p>Copyright © 2026 Mahad Ibrahim. All rights reserved.</p>
            <p>No part of this publication may be reproduced, distributed, or transmitted in any form or by any means, including photocopying, recording, or other electronic or mechanical methods, without the prior written permission of the publisher, except in the case of brief quotations embodied in critical reviews and certain other noncommercial uses permitted by copyright law.</p>
          </div>

          <div class="copyright-details">
            <p><strong>Published by</strong> Aspire Sports</p>
            <p><strong>Website</strong> aspiresports.com</p>
          </div>

          <div class="copyright-edition">
            <p>First Edition: January 2026</p>
          </div>

          <div class="copyright-disclaimer">
            <p><strong>Disclaimer:</strong> The information in this book is intended for educational purposes only. While based on scientific research, individual results may vary. Always consult with qualified coaches and medical professionals regarding your child's specific needs and abilities.</p>
          </div>
        </div>
      </section>

      <!-- Table of Contents -->
      <section class="minibook-toc-page">
        <h2 class="toc-page-title">Contents</h2>

        <div class="toc-entries">
          <div class="toc-entry">
            <span class="toc-entry-title">Part One: The Science of Passing</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">7</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Motor Learning Fundamentals</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">9</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">The Role of Perception</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">13</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Constraints-Led Approach</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">17</span>
          </div>

          <div class="toc-entry">
            <span class="toc-entry-title">Part Two: The Mental Game</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">23</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Vision and Awareness</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">25</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Composure Under Pressure</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">29</span>
          </div>

          <div class="toc-entry">
            <span class="toc-entry-title">Part Three: Reading the Game</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">35</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">When to Pass</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">37</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Pass Selection</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">41</span>
          </div>

          <div class="toc-entry">
            <span class="toc-entry-title">Part Four: The Practice</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">47</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Foundation Stage (Ages 4–6)</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">49</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Development Stage (Ages 7–9)</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">55</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Skill Stage (Ages 10–12)</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">61</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">Refinement Stage (Ages 13+)</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">67</span>
          </div>

          <div class="toc-entry">
            <span class="toc-entry-title">Part Five: The Parent's Role</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">73</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">What to Do</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">75</span>
          </div>
          <div class="toc-entry toc-entry-sub">
            <span class="toc-entry-title">What to Avoid</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">79</span>
          </div>

          <div class="toc-entry">
            <span class="toc-entry-title">Resources & References</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">83</span>
          </div>

          <div class="toc-entry">
            <span class="toc-entry-title">About Aspire Sports</span>
            <span class="toc-entry-dots"></span>
            <span class="toc-entry-page">89</span>
          </div>
        </div>

        <div class="toc-promise">
          <p>{book.introduction.promise}</p>
        </div>

        <div class="different-box">
          <h4>What Makes This Different</h4>
          <ul>
            {book.introduction.whatMakesThisDifferent.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Part One: Science Foundation -->
      <section class="section-divider">
        <span class="section-divider-number">Part One</span>
        <h2 class="section-divider-title">{book.scienceFoundation.title.replace('Part One: ', '')}</h2>
        <p class="section-divider-subtitle">{book.scienceFoundation.subtitle}</p>
        <div class="section-divider-icon">✦</div>
      </section>

      {book.scienceFoundation.sections.map((section, index) => (
        <section class="minibook-section">
          <h2 class="minibook-section-title">{section.title}</h2>

          <div class="section-content" set:html={section.content.split('\n\n').map(p => `<p>${p.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}</p>`).join('')} />

          {section.keyResearch && (
            <div class="research-box">
              <div class="research-header">
                <span class="research-icon">✦</span>
                <span class="research-label">Research Finding</span>
              </div>
              <blockquote class="research-finding">"{section.keyResearch.finding}"</blockquote>
              <cite class="research-citation">{section.keyResearch.citation}</cite>
            </div>
          )}

          {section.parentTakeaway && (
            <div class="parent-takeaway">
              <span class="takeaway-label">Parent Takeaway</span>
              <p>{section.parentTakeaway}</p>
            </div>
          )}

          {section.implications && (
            <div class="implications-list">
              <h4>Implications</h4>
              <ul>
                {section.implications.map(imp => <li>{imp}</li>)}
              </ul>
            </div>
          )}

          {section.scanningDevelopment && (
            <div class="scanning-levels">
              <h4>Scanning Development Progression</h4>
              <table class="guide-table">
                <thead>
                  <tr>
                    <th>Level</th>
                    <th>Characteristic</th>
                    <th>How to Develop</th>
                  </tr>
                </thead>
                <tbody>
                  {section.scanningDevelopment.map(level => (
                    <tr>
                      <td><strong>{level.level}</strong></td>
                      <td>{level.characteristic}</td>
                      <td>{level.development}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.practicalExample && (
            <div class="comparison-box">
              <div class="comparison-item comparison-traditional">
                <span class="comparison-label">Traditional Approach</span>
                <p>{section.practicalExample.traditional}</p>
              </div>
              <div class="comparison-item comparison-modern">
                <span class="comparison-label">Evidence-Based Approach</span>
                <p>{section.practicalExample.constraintsLed}</p>
              </div>
              <div class="comparison-why">
                <strong>Why it works:</strong> {section.practicalExample.why}
              </div>
            </div>
          )}

          {section.forPassing && (
            <div class="cue-comparison-table">
              <h4>Better Coaching Cues</h4>
              <table class="guide-table">
                <thead>
                  <tr>
                    <th>Instead of saying...</th>
                    <th>Try saying...</th>
                  </tr>
                </thead>
                <tbody>
                  {section.forPassing.map(item => (
                    <tr>
                      <td class="internal-cue">{item.instead}</td>
                      <td class="external-cue">{item.say}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.variabilityPrinciples && (
            <div class="implications-list">
              <h4>Variability Principles</h4>
              <ul>
                {section.variabilityPrinciples.map(p => <li>{p}</li>)}
              </ul>
            </div>
          )}

          {section.applicationForParents && (
            <div class="parent-takeaway">
              <span class="takeaway-label">For Parents</span>
              <p>{section.applicationForParents}</p>
            </div>
          )}
        </section>
      ))}

      <!-- Player Story Interlude: After Science -->
      {getPlayerStory('after-science') && (
        <section class="minibook-section interlude interlude-player">
          <div class="interlude-header">
            <span class="interlude-label">Player Story</span>
          </div>
          <h2 class="interlude-title">{getPlayerStory('after-science')!.title}</h2>
          <p class="interlude-subtitle">{getPlayerStory('after-science')!.subtitle}</p>
          <div class="interlude-content" set:html={getPlayerStory('after-science')!.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          {getPlayerStory('after-science')!.quote && (
            <blockquote class="interlude-quote">
              "{getPlayerStory('after-science')!.quote.text}"
              <cite>— {getPlayerStory('after-science')!.quote.attribution}</cite>
            </blockquote>
          )}
        </section>
      )}

      <!-- Coach Wisdom Interlude: After Science -->
      {getCoachWisdom('after-science') && (
        <section class="minibook-section interlude interlude-coach">
          <div class="interlude-header">
            <span class="interlude-label">Coach's Perspective</span>
          </div>
          <h2 class="interlude-title">{getCoachWisdom('after-science')!.title}</h2>
          <p class="interlude-coach-info">{getCoachWisdom('after-science')!.coach} — {getCoachWisdom('after-science')!.role}</p>
          <div class="interlude-content" set:html={getCoachWisdom('after-science')!.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          {getCoachWisdom('after-science')!.quote && (
            <blockquote class="interlude-quote">
              "{getCoachWisdom('after-science')!.quote.text}"
              <cite>— {getCoachWisdom('after-science')!.quote.attribution}</cite>
            </blockquote>
          )}
          {getCoachWisdom('after-science')!.keyPrinciple && (
            <div class="interlude-principle">
              <strong>Key Principle:</strong> {getCoachWisdom('after-science')!.keyPrinciple}
            </div>
          )}
        </section>
      )}

      <!-- Part Two: Mental Game -->
      <section class="section-divider">
        <span class="section-divider-number">Part Two</span>
        <h2 class="section-divider-title">{book.mentalGame.title.replace('Part Two: ', '')}</h2>
        <p class="section-divider-subtitle">{book.mentalGame.subtitle}</p>
        <div class="section-divider-icon">✦</div>
      </section>

      <section class="minibook-section">
        <p class="section-intro">{book.mentalGame.introduction}</p>
      </section>

      {book.mentalGame.sections.map(section => (
        <section class="minibook-section">
          <h2 class="minibook-section-title">{section.title}</h2>

          <div class="section-content" set:html={section.content.split('\n\n').map(p => `<p>${p.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}</p>`).join('')} />

          {section.keyResearch && (
            <div class="research-box">
              <div class="research-header">
                <span class="research-icon">✦</span>
                <span class="research-label">Research Finding</span>
              </div>
              <blockquote class="research-finding">"{section.keyResearch.finding}"</blockquote>
              <cite class="research-citation">{section.keyResearch.citation}</cite>
            </div>
          )}

          {section.developingVision && (
            <div class="implications-list">
              <h4>Developing Vision</h4>
              <ul>
                {section.developingVision.map(item => <li>{item}</li>)}
              </ul>
            </div>
          )}

          {section.parentCoachBehaviors && (
            <div class="behaviors-grid">
              <div class="behaviors-do">
                <h4>✓ What Promotes Good Passing Mindset</h4>
                <ul>
                  {section.parentCoachBehaviors.promotes.map(item => <li>{item}</li>)}
                </ul>
              </div>
              <div class="behaviors-avoid">
                <h4>✗ What Undermines It</h4>
                <ul>
                  {section.parentCoachBehaviors.undermines.map(item => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          )}

          {section.buildingComposure && (
            <div class="strategies-list">
              <h4>Building Composure</h4>
              {section.buildingComposure.map(strategy => (
                <div class="strategy-item">
                  <h5>{strategy.technique}</h5>
                  <p>{strategy.description}</p>
                  <span class="strategy-research">Research: {strategy.research}</span>
                </div>
              ))}
            </div>
          )}

          {section.rhythmDevelopment && (
            <div class="implications-list">
              <h4>Developing Game Rhythm</h4>
              <ul>
                {section.rhythmDevelopment.map(item => <li>{item}</li>)}
              </ul>
            </div>
          )}
        </section>
      ))}

      <!-- Player Story Interlude: After Mental -->
      {getPlayerStory('after-mental') && (
        <section class="minibook-section interlude interlude-player">
          <div class="interlude-header">
            <span class="interlude-label">Player Story</span>
          </div>
          <h2 class="interlude-title">{getPlayerStory('after-mental')!.title}</h2>
          <p class="interlude-subtitle">{getPlayerStory('after-mental')!.subtitle}</p>
          <div class="interlude-content" set:html={getPlayerStory('after-mental')!.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          {getPlayerStory('after-mental')!.quote && (
            <blockquote class="interlude-quote">
              "{getPlayerStory('after-mental')!.quote.text}"
              <cite>— {getPlayerStory('after-mental')!.quote.attribution}</cite>
            </blockquote>
          )}
        </section>
      )}

      <!-- Part Three: Tactical Awareness -->
      <section class="section-divider">
        <span class="section-divider-number">Part Three</span>
        <h2 class="section-divider-title">{book.tacticalAwareness.title.replace('Part Three: ', '')}</h2>
        <p class="section-divider-subtitle">{book.tacticalAwareness.subtitle}</p>
        <div class="section-divider-icon">✦</div>
      </section>

      <section class="minibook-section">
        <p class="section-intro">{book.tacticalAwareness.introduction}</p>
      </section>

      {book.tacticalAwareness.sections.map(section => (
        <section class="minibook-section">
          <h2 class="minibook-section-title">{section.title}</h2>

          <div class="section-content" set:html={section.content.split('\n\n').map(p => `<p>${p.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}</p>`).join('')} />

          {section.keyResearch && (
            <div class="research-box">
              <div class="research-header">
                <span class="research-icon">✦</span>
                <span class="research-label">Research Finding</span>
              </div>
              <blockquote class="research-finding">"{section.keyResearch.finding}"</blockquote>
              <cite class="research-citation">{section.keyResearch.citation}</cite>
            </div>
          )}

          {section.decisionQuestions && (
            <div class="decision-tree">
              <h4>The Passing Decision Framework</h4>
              <div class="decision-flow">
                {Object.entries(section.decisionQuestions).map(([key, node]) => (
                  <div class="decision-node">
                    <div class="decision-question">{node.ask}</div>
                    <div class="decision-why">{node.why}</div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {section.passTypes && (
            <div class="pass-types">
              <h4>Types of Passes</h4>
              <table class="guide-table">
                <thead>
                  <tr>
                    <th>Pass Type</th>
                    <th>When to Use</th>
                    <th>Development</th>
                  </tr>
                </thead>
                <tbody>
                  {section.passTypes.map(pass => (
                    <tr>
                      <td><strong>{pass.type}</strong></td>
                      <td>{pass.when}</td>
                      <td>{pass.develop}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.receivingPrinciples && (
            <div class="receiving-principles">
              <h4>Receiving to Pass</h4>
              {section.receivingPrinciples.map(principle => (
                <div class="principle-item">
                  <h5>{principle.principle}</h5>
                  <p>{principle.description}</p>
                  <span class="principle-benefit"><strong>Benefit:</strong> {principle.benefit}</span>
                </div>
              ))}
            </div>
          )}

          {section.zones && (
            <div class="field-zones">
              <h4>Passing by Zone</h4>
              <div class="zones-grid">
                {section.zones.map(zone => (
                  <div class={`zone-card zone-${zone.riskLevel?.toLowerCase().replace(' ', '-')}`}>
                    <h5>{zone.zone}</h5>
                    <div class="zone-approach"><strong>{zone.approach}</strong></div>
                    <p>{zone.principle}</p>
                    <span class="zone-advice"><em>{zone.advice}</em></span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {section.keyPatterns && (
            <div class="patterns-list">
              <h4>Key Passing Patterns</h4>
              {section.keyPatterns.map(pattern => (
                <div class="pattern-item">
                  <h5>{pattern.pattern}</h5>
                  <p>{pattern.description}</p>
                  <span class="pattern-why"><strong>Why:</strong> {pattern.why}</span>
                </div>
              ))}
              {section.developmentNote && (
                <p class="development-note"><em>{section.developmentNote}</em></p>
              )}
            </div>
          )}
        </section>
      ))}

      <!-- Player Story Interlude: After Tactical -->
      {getPlayerStory('after-tactical') && (
        <section class="minibook-section interlude interlude-player">
          <div class="interlude-header">
            <span class="interlude-label">Player Story</span>
          </div>
          <h2 class="interlude-title">{getPlayerStory('after-tactical')!.title}</h2>
          <p class="interlude-subtitle">{getPlayerStory('after-tactical')!.subtitle}</p>
          <div class="interlude-content" set:html={getPlayerStory('after-tactical')!.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          {getPlayerStory('after-tactical')!.quote && (
            <blockquote class="interlude-quote">
              "{getPlayerStory('after-tactical')!.quote.text}"
              <cite>— {getPlayerStory('after-tactical')!.quote.attribution}</cite>
            </blockquote>
          )}
        </section>
      )}

      <!-- Coach Wisdom Interlude: Before Progression -->
      {getCoachWisdom('before-progression') && (
        <section class="minibook-section interlude interlude-coach">
          <div class="interlude-header">
            <span class="interlude-label">Coach's Perspective</span>
          </div>
          <h2 class="interlude-title">{getCoachWisdom('before-progression')!.title}</h2>
          <p class="interlude-coach-info">{getCoachWisdom('before-progression')!.coach} — {getCoachWisdom('before-progression')!.role}</p>
          <div class="interlude-content" set:html={getCoachWisdom('before-progression')!.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          {getCoachWisdom('before-progression')!.quote && (
            <blockquote class="interlude-quote">
              "{getCoachWisdom('before-progression')!.quote.text}"
              <cite>— {getCoachWisdom('before-progression')!.quote.attribution}</cite>
            </blockquote>
          )}
          {getCoachWisdom('before-progression')!.keyPrinciple && (
            <div class="interlude-principle">
              <strong>Key Principle:</strong> {getCoachWisdom('before-progression')!.keyPrinciple}
            </div>
          )}
        </section>
      )}

      <!-- Part Four: Technical Progression -->
      <section class="section-divider">
        <span class="section-divider-number">Part Four</span>
        <h2 class="section-divider-title">{book.technicalProgression.title.replace('Part Four: ', '')}</h2>
        <p class="section-divider-subtitle">{book.technicalProgression.subtitle}</p>
        <div class="section-divider-icon">✦</div>
      </section>

      <section class="minibook-section">
        <p class="section-intro">{book.technicalProgression.introduction}</p>
      </section>

      {book.technicalProgression.stages.map((stage, stageIndex) => (
        <>
          <section class="minibook-section stage-section">
            <div class="stage-header">
              <h2 class="stage-name">{stage.name}</h2>
              <span class="stage-ages">{stage.ages}</span>
            </div>
            <p class="stage-focus"><strong>Focus:</strong> {stage.focus}</p>
            <p class="stage-research"><strong>Research Basis:</strong> {stage.researchBasis}</p>

            <div class="stage-principles">
              <h4>Guiding Principles</h4>
              <ul>
                {stage.principles.map(p => <li>{p}</li>)}
              </ul>
            </div>

            <div class="stage-activities">
              <h4>Activities</h4>
              {stage.activities.map(activity => (
                <div class="activity-card">
                  <div class="activity-header">
                    <h5>{activity.name}</h5>
                    {activity.time && <span class="activity-time">{activity.time}</span>}
                  </div>
                  <p class="activity-description">{activity.description}</p>
                  <div class="activity-details">
                    <div class="activity-focus"><strong>Focus:</strong> {activity.focus}</div>
                    <div class="activity-cue"><strong>External Cue:</strong> "{activity.externalCue}"</div>
                    {activity.variation && <div class="activity-variation"><strong>Variation:</strong> {activity.variation}</div>}
                    {activity.coachingNote && <div class="activity-note"><strong>Note:</strong> {activity.coachingNote}</div>}
                    {activity.progression && <div class="activity-progression"><strong>Progression:</strong> {activity.progression}</div>}
                    {activity.debrief && <div class="activity-debrief"><strong>Debrief:</strong> {activity.debrief}</div>}
                  </div>
                </div>
              ))}
            </div>

            {stage.parentHomeActivities && (
              <div class="home-activities">
                <h4>At-Home Activities for Parents</h4>
                <ul>
                  {stage.parentHomeActivities.map(a => <li>{a}</li>)}
                </ul>
              </div>
            )}

            {stage.signsOfProgress && (
              <div class="progress-signs">
                <h4>Signs of Progress</h4>
                <ul class="checklist">
                  {stage.signsOfProgress.map(sign => <li>{sign}</li>)}
                </ul>
              </div>
            )}

            {stage.videoAnalysisIntro && (
              <div class="video-analysis">
                <h4>Video Analysis Introduction</h4>
                <p>{stage.videoAnalysisIntro.activity}</p>
                <p><strong>Players to watch:</strong> {stage.videoAnalysisIntro.players.join(', ')}</p>
                <p><strong>Frequency:</strong> {stage.videoAnalysisIntro.frequency}</p>
              </div>
            )}

            {stage.mentalSkillsIntegration && (
              <div class="mental-skills">
                <h4>Mental Skills Integration</h4>
                {stage.mentalSkillsIntegration.map(skill => (
                  <div class="mental-skill-item">
                    <strong>{skill.skill}:</strong> {skill.application}
                  </div>
                ))}
              </div>
            )}
          </section>

          {/* Coach Wisdom Interlude: In Progression (after stage 2) */}
          {stageIndex === 1 && getCoachWisdom('in-progression') && (
            <section class="minibook-section interlude interlude-coach">
              <div class="interlude-header">
                <span class="interlude-label">Coach's Perspective</span>
              </div>
              <h2 class="interlude-title">{getCoachWisdom('in-progression')!.title}</h2>
              <p class="interlude-coach-info">{getCoachWisdom('in-progression')!.coach} — {getCoachWisdom('in-progression')!.role}</p>
              <div class="interlude-content" set:html={getCoachWisdom('in-progression')!.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
              {getCoachWisdom('in-progression')!.quote && (
                <blockquote class="interlude-quote">
                  "{getCoachWisdom('in-progression')!.quote.text}"
                  <cite>— {getCoachWisdom('in-progression')!.quote.attribution}</cite>
                </blockquote>
              )}
              {getCoachWisdom('in-progression')!.keyPrinciple && (
                <div class="interlude-principle">
                  <strong>Key Principle:</strong> {getCoachWisdom('in-progression')!.keyPrinciple}
                </div>
              )}
            </section>
          )}
        </>
      ))}

      <!-- Part Five: Parent Guide -->
      <section class="section-divider">
        <span class="section-divider-number">Part Five</span>
        <h2 class="section-divider-title">{book.parentGuide.title.replace("Part Five: ", '')}</h2>
        <p class="section-divider-subtitle">{book.parentGuide.subtitle}</p>
        <div class="section-divider-icon">✦</div>
      </section>

      <section class="minibook-section">
        <p class="section-intro">{book.parentGuide.introduction}</p>
      </section>

      {book.parentGuide.sections.map(section => (
        <section class="minibook-section">
          <h2 class="minibook-section-title">{section.title}</h2>

          {section.content && (
            <div class="section-content" set:html={section.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          )}

          {section.keyResearch && (
            <div class="research-box">
              <div class="research-header">
                <span class="research-icon">✦</span>
                <span class="research-label">Research Finding</span>
              </div>
              <blockquote class="research-finding">"{section.keyResearch.finding}"</blockquote>
              <cite class="research-citation">{section.keyResearch.citation}</cite>
            </div>
          )}

          {section.items && section.title.includes("What to Do") && (
            <div class="do-list">
              {section.items.map(item => (
                <div class="do-item">
                  <h4>✓ {item.action}</h4>
                  <p><strong>Why:</strong> {item.why}</p>
                  <p><strong>How:</strong> {item.how}</p>
                </div>
              ))}
            </div>
          )}

          {section.items && section.title.includes("Avoid") && (
            <div class="avoid-list">
              {section.items.map(item => (
                <div class="avoid-item">
                  <h4>✗ {item.behavior}</h4>
                  <p><strong>Why it hurts:</strong> {item.why}</p>
                  <p><strong>Instead:</strong> {item.alternative}</p>
                </div>
              ))}
            </div>
          )}

          {section.activities && (
            <div class="age-activities">
              {Object.entries(section.activities).map(([ageKey, activities]) => (
                <div class="age-activity-group">
                  <h4>{ageKey.replace('ages', 'Ages ').replace('to', '-')}</h4>
                  <ul>
                    {activities.map(a => <li>{a}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          )}

          {section.alternatives && (
            <div class="conversation-alternatives">
              <table class="guide-table">
                <thead>
                  <tr>
                    <th>Instead of...</th>
                    <th>Try...</th>
                  </tr>
                </thead>
                <tbody>
                  {section.alternatives.map(alt => (
                    <tr>
                      <td class="old-way">"{alt.instead}"</td>
                      <td class="new-way">"{alt.try}"</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}

      <!-- Resources -->
      <section class="section-divider">
        <span class="section-divider-number">Resources</span>
        <h2 class="section-divider-title">Further Reading</h2>
        <p class="section-divider-subtitle">Books, videos, and research references</p>
        <div class="section-divider-icon">✦</div>
      </section>

      <section class="minibook-section">
        <h2 class="minibook-section-title">Recommended Books for Parents</h2>
        <div class="book-list">
          {book.resources.booksForParents.map(b => (
            <div class="book-item">
              <strong>{b.title}</strong> by {b.author}
              <span class="book-relevance">{b.relevance}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="minibook-section">
        <h2 class="minibook-section-title">Recommended Books for Coaches</h2>
        <div class="book-list">
          {book.resources.booksForCoaches.map(b => (
            <div class="book-item">
              <strong>{b.title}</strong> by {b.author}
              <span class="book-relevance">{b.relevance}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="minibook-section">
        <h2 class="minibook-section-title">Academic References</h2>
        <ol class="reference-list">
          {book.resources.academicReferences.map(ref => (
            <li>{ref}</li>
          ))}
        </ol>
      </section>

      <!-- About Aspire Sports -->
      <section class="minibook-about">
        <h2 class="about-title">About Aspire Sports</h2>

        <div class="about-content">
          <p>Aspire Sports is dedicated to transforming youth sports through evidence-based coaching and development practices. We believe every child deserves access to quality sports education that builds skills, confidence, and a lifelong love of movement.</p>

          <p>Our programs are built on the latest research in motor learning, sports psychology, and child development. We train coaches to create environments where young athletes can thrive—developing not just as players, but as people.</p>
        </div>

        <div class="about-mission">
          <h3>Our Mission</h3>
          <p>To provide every young athlete with the opportunity to develop their full potential through research-based coaching, age-appropriate training, and a positive, supportive environment.</p>
        </div>

        <div class="about-values">
          <h3>Our Values</h3>
          <ul>
            <li><strong>Long-Term Development</strong> — Building skills over years, not rushing results</li>
            <li><strong>Evidence-Based</strong> — Grounded in research, not tradition</li>
            <li><strong>Child-Centered</strong> — Meeting kids where they are</li>
            <li><strong>Joy First</strong> — Making sports fun keeps kids playing</li>
          </ul>
        </div>

        <div class="about-contact">
          <p><strong>Learn more at</strong> aspiresports.com</p>
        </div>
      </section>

      <!-- Other Titles in This Series -->
      <section class="minibook-series-page">
        <h2 class="series-page-title">Other Titles in This Series</h2>
        <p class="series-page-subtitle">Evidence-Based Youth Development Guides</p>

        <div class="series-books">
          <div class="series-book-group">
            <h3 class="series-sport">Soccer</h3>
            <ul class="series-book-list">
              <li class="series-book">The Path to Better Dribbling</li>
              <li class="series-book current">The Path to Better Passing</li>
              <li class="series-book">The Path to Better Game Intelligence</li>
              <li class="series-book">The Path to Better Shooting</li>
              <li class="series-book">The Path to Better Defending</li>
            </ul>
          </div>

          <div class="series-book-group">
            <h3 class="series-sport">Basketball</h3>
            <ul class="series-book-list">
              <li class="series-book">The Path to Better Ball Handling</li>
              <li class="series-book">The Path to Better Passing</li>
              <li class="series-book">The Path to Better Shooting</li>
              <li class="series-book">The Path to Better Defending</li>
              <li class="series-book">The Path to Better Game Intelligence</li>
            </ul>
          </div>

          <div class="series-book-group">
            <h3 class="series-sport">Hockey</h3>
            <ul class="series-book-list">
              <li class="series-book">The Path to Better Skating</li>
              <li class="series-book">The Path to Better Stickhandling</li>
              <li class="series-book">The Path to Better Passing</li>
              <li class="series-book">The Path to Better Shooting</li>
              <li class="series-book">The Path to Better Defending</li>
            </ul>
          </div>
        </div>

        <div class="series-cta">
          <p>Find all titles at <strong>aspiresports.com/guides</strong></p>
        </div>
      </section>

      <!-- Back Cover -->
      <section class="minibook-back-cover">
        <img src="/images/logo-black.png" alt="Aspire Sports" class="minibook-back-logo" />
        <p class="minibook-back-tagline">"The best passers see the game before it happens."</p>
        <div class="minibook-back-info">
          <p>Part of the <strong>Aspire Sports Evidence-Based Development Series</strong></p>
          <p class="minibook-back-url">aspiresports.com</p>
        </div>
      </section>
    </div>

    <!-- Print button for screen view -->
    <div class="no-print" style="
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      display: flex;
      gap: 0.5rem;
    ">
      <button
        onclick="window.print()"
        style="
          background: var(--soccer-primary);
          color: white;
          border: none;
          padding: 1rem 2rem;
          font-size: 14px;
          font-weight: 600;
          border-radius: 8px;
          cursor: pointer;
          box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        "
      >
        Print / Save as PDF
      </button>
      <a
        href="/guides/"
        style="
          background: white;
          color: var(--soccer-primary);
          border: 2px solid var(--soccer-primary);
          padding: 1rem 1.5rem;
          font-size: 14px;
          font-weight: 600;
          border-radius: 8px;
          text-decoration: none;
          display: flex;
          align-items: center;
        "
      >
        More free guides
      </a>
    </div>
  </body>
</html>
