---
import BaseLayout from "@/layouts/BaseLayout.astro";
import KioskRoot from "@/components/kiosk/KioskRoot";
import { requireKioskLocation } from "@/lib/check-in/kiosk-auth";
import { getBrandTheme } from "@/lib/branding/themes";
import { BUSINESS_TIMEZONE } from "@/lib/time/business-timezone";

export const prerender = false;

// The kiosk serves both brands — the name is never hardcoded in the island.
const brandId = Astro.locals.brandId;
const brandName = getBrandTheme(brandId).displayName;

const slug = Astro.params.locationSlug;
let locationName: string | null = null;
// Default to the business timezone; overridden below with the resolved
// location's own timezone.
let locationTimezone: string = BUSINESS_TIMEZONE;
let invalid = false;

if (slug) {
  const k = await requireKioskLocation(slug);
  if (k.ok) {
    locationName = k.location.name;
    locationTimezone = k.location.timezone ?? locationTimezone;
  } else {
    invalid = true;
  }
} else {
  invalid = true;
}

// Format the masthead date in the facility's timezone. This page renders
// server-side and Netlify runs in UTC — an unzoned format rolls over to
// "tomorrow" late in the evening local time.
const today = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: locationTimezone,
});
---
<BaseLayout
  title={locationName ? `${locationName} kiosk — ${brandName}` : `Kiosk — ${brandName}`}
  navigation={false}
  footer={false}
>
  <main class="min-h-screen bg-cream text-ink antialiased">
    <!-- Editorial masthead -->
    <div class="border-b border-border">
      <div class="max-w-2xl mx-auto px-6 py-3 flex items-center justify-between gap-4">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink-muted">
          § The Front Desk
        </p>
        <p class="text-[11px] font-medium tracking-[0.08em] uppercase text-ink-faint">
          {today}
        </p>
      </div>
    </div>

    <div class="max-w-2xl mx-auto px-6 py-10 md:py-14">
      {invalid ? (
        <div class="bg-paper border border-destructive/30 rounded-xl p-6">
          <h1 class="font-display text-2xl font-medium italic text-ink mb-2">
            Kiosk not configured
          </h1>
          <p class="text-sm text-ink-muted leading-relaxed">
            This URL doesn't match an active facility. Ask the front desk for the correct kiosk URL.
          </p>
        </div>
      ) : (
        <KioskRoot
          client:load
          locationSlug={slug!}
          locationName={locationName!}
          brandName={brandName}
          brandId={brandId}
          publishableKey={import.meta.env.STRIPE_PUBLISHABLE_KEY ?? ""}
        />
      )}
    </div>
  </main>
</BaseLayout>
