---
import BaseLayout from "@/layouts/BaseLayout.astro";
import KioskLanding from "@/components/kiosk/KioskLanding";
import { requireKioskVenue } from "@/lib/check-in/kiosk-auth";

export const prerender = false;

const slug = Astro.params.venueSlug;
let venueName: string | null = null;
let invalid = false;

if (slug) {
  const k = await requireKioskVenue(slug);
  if (k.ok) venueName = k.venue.name;
  else invalid = true;
} else {
  invalid = true;
}
---
<BaseLayout title={venueName ? `${venueName} kiosk — Aspire Sports` : "Kiosk — Aspire Sports"} navigation={false} footer={false}>
  <main class="max-w-xl mx-auto p-4">
    {invalid ? (
      <div class="p-6 rounded-lg border border-rose-200 bg-rose-50 text-rose-800">
        <h1 class="font-semibold text-lg mb-2">Kiosk not configured</h1>
        <p class="text-sm">This URL doesn't match an active venue. Ask the front desk for the correct kiosk URL.</p>
      </div>
    ) : (
      <KioskLanding client:load venueSlug={slug!} venueName={venueName!} />
    )}
  </main>
</BaseLayout>
