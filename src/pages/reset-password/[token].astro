---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import { ResetPasswordForm } from '../../components/auth/reset-password-form';
import { db } from '@/lib/db';
import { passwordResetTokens } from '@/lib/db/schema';
import { eq, gt, and } from 'drizzle-orm';

const { token } = Astro.params;

// Redirect if already logged in
const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/dashboard');
}

// Verify token exists and is not expired
let validToken = false;
if (token && db) {
  const resetToken = await db
    .select()
    .from(passwordResetTokens)
    .where(
      and(
        eq(passwordResetTokens.id, token),
        gt(passwordResetTokens.expiresAt, new Date())
      )
    )
    .limit(1);

  validToken = resetToken.length > 0;
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Reset Password — Aspire Sports</title>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main class="flex-1 flex items-center justify-center py-12 px-4 pt-24">
      <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-cream-2 border border-border rounded-2xl p-8">
          {validToken ? (
            <>
              <!-- Header -->
              <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-ink mb-2">Reset Password</h1>
                <p class="text-ink-muted">
                  Enter your new password below.
                </p>
              </div>

              <!-- Form -->
              <ResetPasswordForm client:load token={token!} />
            </>
          ) : (
            <>
              <!-- Invalid Token -->
              <div class="text-center">
                <div class="w-16 h-16 bg-destructive/10 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                </div>
                <h1 class="text-2xl font-bold text-ink mb-2">Invalid or Expired Link</h1>
                <p class="text-ink-muted mb-6">
                  This password reset link is invalid or has expired. Please request a new one.
                </p>
                <a
                  href="/forgot-password"
                  class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
                >
                  Request New Link
                </a>
              </div>
            </>
          )}

          <!-- Back to sign in link -->
          <div class="mt-6 text-center">
            <p class="text-ink-faint text-sm">
              Remember your password?{' '}
              <a href="/signin" class="text-primary hover:text-primary/80 font-medium">
                Sign in
              </a>
            </p>
          </div>
        </div>
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
