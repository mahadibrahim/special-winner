---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CoachLayout } from '@/components/coach/coach-layout';
import StandingsTable from '../../components/coach/standings-table';

export const prerender = false;

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Standings — Coach Dashboard — Aspire Sports" navigation={false} footer={false}>
  <CoachLayout
    client:load
    currentPath="/coach/standings"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <StandingsTable client:load />
  </CoachLayout>
</BaseLayout>
