---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StandingsTable from '../../components/coach/standings-table';

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Standings — Coach Dashboard — Aspire Sports">

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
      <div class="max-w-5xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-ink-muted mb-6">
          <a href="/coach" class="hover:text-ink transition-colors">Coach Dashboard</a>
          <span>/</span>
          <span class="text-ink">Standings</span>
        </nav>

        <StandingsTable client:load />
      </div>
    </main>


</BaseLayout>
