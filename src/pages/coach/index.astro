---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import CoachDashboardOverview from '../../components/coach/coach-dashboard-overview';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/signin?redirect=/coach');
}

// Get current hour for greeting
const hour = new Date().getHours();
let greeting = "Good morning";
if (hour >= 12 && hour < 17) greeting = "Good afternoon";
else if (hour >= 17) greeting = "Good evening";
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Coach Dashboard - Aspire Sports</title>
    <style>
      /* Stagger animation for dashboard sections */
      @keyframes fadeSlideIn {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .dashboard-section {
        animation: fadeSlideIn 0.5s ease-out forwards;
        opacity: 0;
      }

      .dashboard-section:nth-child(1) { animation-delay: 0ms; }
      .dashboard-section:nth-child(2) { animation-delay: 100ms; }
      .dashboard-section:nth-child(3) { animation-delay: 200ms; }
      .dashboard-section:nth-child(4) { animation-delay: 300ms; }

      /* Subtle background pattern */
      .coach-bg {
        background-image:
          radial-gradient(ellipse 80% 50% at 50% -20%, rgba(59, 130, 246, 0.08), transparent),
          radial-gradient(circle at 80% 80%, rgba(59, 130, 246, 0.04), transparent);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4 coach-bg">
      <div class="max-w-7xl mx-auto">
        <!-- Header Section -->
        <header class="mb-10 dashboard-section">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
            <div class="flex items-center gap-4">
              <!-- Avatar with gradient ring -->
              <div class="relative">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 via-blue-600 to-indigo-600 p-0.5">
                  <div class="w-full h-full rounded-2xl bg-[#0a0a0f] flex items-center justify-center">
                    <span class="text-xl font-bold text-white">
                      {user?.firstName?.[0] || 'C'}{user?.lastName?.[0] || ''}
                    </span>
                  </div>
                </div>
                <!-- Coach badge -->
                <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-blue-500 rounded-full border-4 border-[#0a0a0f] flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>

              <div>
                <p class="text-sm text-gray-500 mb-0.5">{greeting}, Coach</p>
                <h1 class="text-2xl sm:text-3xl font-bold text-white">
                  {user?.firstName || 'there'}!
                </h1>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="flex gap-2">
              <a href="/coach/practices/new" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg bg-primary text-white hover:bg-primary/90 transition-colors">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Practice
              </a>
              <a href="/coach/practices" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg border border-white/10 text-gray-400 hover:text-white hover:bg-white/5 transition-colors">
                Practices
              </a>
              <a href="/coach/assessments" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg border border-white/10 text-gray-400 hover:text-white hover:bg-white/5 transition-colors">
                Assessments
              </a>
              <a href="/dashboard" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg border border-white/10 text-gray-400 hover:text-white hover:bg-white/5 transition-colors">
                Parent View
              </a>
            </div>
          </div>
        </header>

        <!-- Main Dashboard Content -->
        <CoachDashboardOverview client:load />
      </div>
    </main>

    <Footer client:load />
  </body>
</html>
