---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import CoachAssessmentsOverview from '../../components/coach/coach-assessments-overview';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/signin?redirect=/coach/assessments');
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Player Assessments - Coach Dashboard - Aspire Sports</title>
    <style>
      /* Page load animation */
      @keyframes fadeSlideIn {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .page-content {
        animation: fadeSlideIn 0.5s ease-out forwards;
      }

      /* Background pattern */
      .assessments-bg {
        background-image:
          radial-gradient(ellipse 80% 50% at 50% -20%, rgba(204, 68, 44, 0.08), transparent),
          radial-gradient(circle at 80% 80%, rgba(204, 68, 44, 0.04), transparent);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4 assessments-bg">
      <div class="max-w-7xl mx-auto page-content">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
          <a href="/coach" class="hover:text-white transition-colors">Coach Dashboard</a>
          <span>/</span>
          <span class="text-white">Player Assessments</span>
        </nav>

        <!-- Header -->
        <header class="mb-8">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
            <div>
              <h1 class="text-2xl sm:text-3xl font-bold text-white mb-2">
                Player Assessments
              </h1>
              <p class="text-gray-500">
                Track and assess player development across technical, tactical, physical, and psychological domains.
              </p>
            </div>

            <div class="flex gap-2">
              <a href="/coach" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg border border-white/10 text-gray-400 hover:text-white hover:bg-white/5 transition-colors">
                Back to Dashboard
              </a>
            </div>
          </div>
        </header>

        <!-- Main Content -->
        <CoachAssessmentsOverview client:load />
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
