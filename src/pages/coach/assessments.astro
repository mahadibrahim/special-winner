---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CoachLayout } from '@/components/coach/coach-layout';
import CoachAssessmentsOverview from '../../components/coach/coach-assessments-overview';

export const prerender = false;

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Player Assessments — Coach Dashboard — Aspire Sports" navigation={false} footer={false}>
  <CoachLayout
    client:load
    currentPath="/coach/assessments"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <CoachAssessmentsOverview client:load />
  </CoachLayout>
</BaseLayout>
