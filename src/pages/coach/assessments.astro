---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import CoachAssessmentsOverview from '../../components/coach/coach-assessments-overview';

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Player Assessments — Coach Dashboard — Aspire Sports</title>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
      <div class="max-w-7xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-ink-muted mb-6">
          <a href="/coach" class="hover:text-ink transition-colors">Coach Dashboard</a>
          <span>/</span>
          <span class="text-ink">Player Assessments</span>
        </nav>

        <!-- Header -->
        <header class="mb-8">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
            <div>
              <h1 class="text-2xl sm:text-3xl font-bold text-ink mb-2">
                Player Assessments
              </h1>
              <p class="text-ink-muted">
                Track and assess player development across technical, tactical, physical, and psychological domains.
              </p>
            </div>

            <div class="flex gap-2">
              <a href="/coach" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg border border-border text-ink-muted hover:text-ink hover:bg-cream-2 transition-colors">
                Back to Dashboard
              </a>
            </div>
          </div>
        </header>

        <!-- Main Content -->
        <CoachAssessmentsOverview client:load />
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
