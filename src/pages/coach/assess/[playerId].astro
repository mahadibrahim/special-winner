---
import '../../../styles/globals.css';
import Navigation from '../../../components/navigation';
import Footer from '../../../components/footer';
import PlayerAssessmentDetail from '../../../components/coach/player-assessment-detail';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/signin?redirect=/coach/assessments');
}

// Get player ID from URL
const { playerId } = Astro.params;

if (!playerId) {
  return Astro.redirect('/coach/assessments');
}

// Optional query params
const teamId = Astro.url.searchParams.get('teamId') || undefined;
const sportId = Astro.url.searchParams.get('sportId') || undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Player Assessment — Coach Dashboard — Aspire Sports</title>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
      <div class="max-w-6xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-ink-muted mb-6">
          <a href="/coach" class="hover:text-ink transition-colors">Coach Dashboard</a>
          <span>/</span>
          <a href="/coach/assessments" class="hover:text-ink transition-colors">Assessments</a>
          <span>/</span>
          <span class="text-ink">Player Details</span>
        </nav>

        <!-- Main Content -->
        <PlayerAssessmentDetail
          client:load
          playerId={playerId}
          teamId={teamId}
          sportId={sportId}
        />
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
