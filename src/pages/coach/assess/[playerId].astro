---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CoachLayout } from '@/components/coach/coach-layout';
import PlayerAssessmentDetail from '../../../components/coach/player-assessment-detail';

export const prerender = false;

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;

// Get player ID from URL
const { playerId } = Astro.params;

if (!playerId) {
  return Astro.redirect('/coach/assessments');
}

// Optional query params
const teamId = Astro.url.searchParams.get('teamId') || undefined;
const sportId = Astro.url.searchParams.get('sportId') || undefined;
---

<BaseLayout title="Player Assessment — Coach Dashboard — Aspire Sports" navigation={false} footer={false}>
  <CoachLayout
    client:load
    currentPath="/coach/assess"
    breadcrumbs={[{ label: "My Teams", href: "/coach/teams" }]}
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <PlayerAssessmentDetail
      client:load
      playerId={playerId}
      teamId={teamId}
      sportId={sportId}
    />
  </CoachLayout>
</BaseLayout>
