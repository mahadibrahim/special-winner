---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlayerAssessmentDetail from '../../../components/coach/player-assessment-detail';

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;

// Get player ID from URL
const { playerId } = Astro.params;

if (!playerId) {
  return Astro.redirect('/coach/assessments');
}

// Optional query params
const teamId = Astro.url.searchParams.get('teamId') || undefined;
const sportId = Astro.url.searchParams.get('sportId') || undefined;
---

<BaseLayout title="Player Assessment — Coach Dashboard — Aspire Sports">

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
      <div class="max-w-6xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-ink-muted mb-6">
          <a href="/coach" class="hover:text-ink transition-colors">Coach Dashboard</a>
          <span>/</span>
          <a href="/coach/assessments" class="hover:text-ink transition-colors">Assessments</a>
          <span>/</span>
          <span class="text-ink">Player Details</span>
        </nav>

        <!-- Main Content -->
        <PlayerAssessmentDetail
          client:load
          playerId={playerId}
          teamId={teamId}
          sportId={sportId}
        />
      </div>
    </main>


</BaseLayout>
