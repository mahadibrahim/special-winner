---
import '../../../styles/globals.css';
import Navigation from '../../../components/navigation';
import Footer from '../../../components/footer';
import PlayerAssessmentDetail from '../../../components/coach/player-assessment-detail';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/signin?redirect=/coach/assessments');
}

// Get player ID from URL
const { playerId } = Astro.params;

if (!playerId) {
  return Astro.redirect('/coach/assessments');
}

// Optional query params
const teamId = Astro.url.searchParams.get('teamId') || undefined;
const sportId = Astro.url.searchParams.get('sportId') || undefined;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Player Assessment - Coach Dashboard - Aspire Sports</title>
    <style>
      /* Page load animation */
      @keyframes fadeSlideIn {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .page-content {
        animation: fadeSlideIn 0.5s ease-out forwards;
      }

      /* Background pattern */
      .assessment-bg {
        background-image:
          radial-gradient(ellipse 80% 50% at 50% -20%, rgba(204, 68, 44, 0.06), transparent),
          radial-gradient(circle at 20% 80%, rgba(34, 197, 94, 0.04), transparent),
          radial-gradient(circle at 80% 60%, rgba(59, 130, 246, 0.04), transparent);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4 assessment-bg">
      <div class="max-w-6xl mx-auto page-content">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
          <a href="/coach" class="hover:text-white transition-colors">Coach Dashboard</a>
          <span>/</span>
          <a href="/coach/assessments" class="hover:text-white transition-colors">Assessments</a>
          <span>/</span>
          <span class="text-white">Player Details</span>
        </nav>

        <!-- Main Content -->
        <PlayerAssessmentDetail
          client:load
          playerId={playerId}
          teamId={teamId}
          sportId={sportId}
        />
      </div>
    </main>

    <Footer client:load />
  </body>
</html>
