---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import { ResourceLibrary } from '../../components/coach/resource-library';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/signin?redirect=/coach/resources');
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Coach Resources - Aspire Sports</title>
    <style>
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .resources-content {
        animation: fadeIn 0.4s ease-out forwards;
      }

      .resources-bg {
        background-image:
          radial-gradient(ellipse 60% 40% at 50% 0%, rgba(59, 130, 246, 0.06), transparent),
          radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.04), transparent);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4 resources-bg">
      <div class="max-w-7xl mx-auto resources-content">
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
          <a href="/coach" class="hover:text-white transition-colors">Coach Dashboard</a>
          <span>/</span>
          <span class="text-white">Resources</span>
        </nav>

        <ResourceLibrary client:load />
      </div>
    </main>

    <Footer client:load />
  </body>
</html>
