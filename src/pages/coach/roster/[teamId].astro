---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RosterTable from '../../../components/coach/roster-table';

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;

// Get team ID from URL
const { teamId } = Astro.params;

if (!teamId) {
  return Astro.redirect('/coach');
}
---

<BaseLayout title="Team Roster — Aspire Sports">

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
      <div class="max-w-5xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-ink-muted mb-6">
          <a href="/coach" class="hover:text-ink transition-colors">Coach Dashboard</a>
          <span>/</span>
          <span class="text-ink">Team Roster</span>
        </nav>

        <RosterTable client:load teamId={teamId} />
      </div>
    </main>


</BaseLayout>
