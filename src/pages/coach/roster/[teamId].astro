---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CoachLayout } from '@/components/coach/coach-layout';
import RosterTable from '../../../components/coach/roster-table';

export const prerender = false;

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;

// Get team ID from URL
const { teamId } = Astro.params;

if (!teamId) {
  return Astro.redirect('/coach');
}
---

<BaseLayout title="Team Roster — Aspire Sports" navigation={false} footer={false}>
  <CoachLayout
    client:load
    currentPath="/coach/roster"
    breadcrumbs={[{ label: "My Teams", href: "/coach/teams" }]}
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <RosterTable client:load teamId={teamId} />
  </CoachLayout>
</BaseLayout>
