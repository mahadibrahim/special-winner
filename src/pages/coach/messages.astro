---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CoachLayout } from '@/components/coach/coach-layout';
import CoachMessageComposer from '../../components/coach/coach-message-composer';

export const prerender = false;

// Middleware guarantees user is authenticated + coach/admin for /coach routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Message Parents — Aspire Sports" navigation={false} footer={false}>
  <CoachLayout
    client:load
    currentPath="/coach/messages"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <CoachMessageComposer client:load />
  </CoachLayout>
</BaseLayout>
