---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CoachLayout } from '@/components/coach/coach-layout';
import PracticesOverview from '../../../components/coach/practices-overview';

export const prerender = false;

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Practice Sessions — Coach Dashboard — Aspire Sports" navigation={false} footer={false}>
  <CoachLayout
    client:load
    currentPath="/coach/practices"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <PracticesOverview client:load />
  </CoachLayout>
</BaseLayout>
