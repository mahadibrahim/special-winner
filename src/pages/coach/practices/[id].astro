---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SessionDetail from '../../../components/coach/session-detail';

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;

// Get session ID from params
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/coach/practices');
}
---

<BaseLayout title="Practice Session — Coach Dashboard — Aspire Sports">

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
      <div class="max-w-7xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-ink-muted mb-6">
          <a href="/coach" class="hover:text-ink transition-colors">Coach Dashboard</a>
          <span>/</span>
          <a href="/coach/practices" class="hover:text-ink transition-colors">Practice Sessions</a>
          <span>/</span>
          <span class="text-ink">Session Details</span>
        </nav>

        <!-- Main Content -->
        <SessionDetail client:load sessionId={id} />
      </div>
    </main>


</BaseLayout>
