---
import '../../../styles/globals.css';
import Navigation from '../../../components/navigation';
import Footer from '../../../components/footer';
import SessionDetail from '../../../components/coach/session-detail';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/signin?redirect=/coach/practices');
}

// Get session ID from params
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/coach/practices');
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Practice Session - Coach Dashboard - Aspire Sports</title>
    <style>
      /* Page load animation */
      @keyframes fadeSlideIn {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .page-content {
        animation: fadeSlideIn 0.5s ease-out forwards;
      }

      /* Background pattern */
      .session-bg {
        background-image:
          radial-gradient(ellipse 80% 50% at 50% -20%, rgba(59, 130, 246, 0.06), transparent),
          radial-gradient(circle at 80% 80%, rgba(204, 68, 44, 0.04), transparent);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4 session-bg">
      <div class="max-w-7xl mx-auto page-content">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
          <a href="/coach" class="hover:text-white transition-colors">Coach Dashboard</a>
          <span>/</span>
          <a href="/coach/practices" class="hover:text-white transition-colors">Practice Sessions</a>
          <span>/</span>
          <span class="text-white">Session Details</span>
        </nav>

        <!-- Main Content -->
        <SessionDetail client:load sessionId={id} />
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
