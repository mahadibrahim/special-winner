---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoachSchedule from '../../components/coach/coach-schedule';

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Team Schedule — Coach Dashboard — Aspire Sports">

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
      <div class="max-w-6xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-ink-muted mb-6">
          <a href="/coach" class="hover:text-ink transition-colors">Coach Dashboard</a>
          <span>/</span>
          <span class="text-ink">Schedule</span>
        </nav>

        <CoachSchedule client:load />
      </div>
    </main>


</BaseLayout>
