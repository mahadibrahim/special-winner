---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CoachLayout } from '@/components/coach/coach-layout';
import CoachSchedule from '../../components/coach/coach-schedule';

export const prerender = false;

// Middleware guarantees user is authenticated for /coach routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Team Schedule — Coach Dashboard — Aspire Sports" navigation={false} footer={false}>
  <CoachLayout
    client:load
    currentPath="/coach/schedule"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <CoachSchedule client:load />
  </CoachLayout>
</BaseLayout>
