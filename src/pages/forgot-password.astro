---
// NOT prerendered: needs request-time Astro.locals.user for the
// "already logged in" redirect.
import '../styles/globals.css';
import Navigation from '../components/navigation';
import Footer from '../components/footer';
import { ForgotPasswordForm } from '../components/auth/forgot-password-form';

// Redirect if already logged in
const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/dashboard');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Forgot Password — Aspire Sports</title>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main id="main-content" class="flex-1 flex items-center justify-center py-12 px-4 pt-24">
      <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-cream-2 border border-border rounded-2xl p-8">
          <!-- Header -->
          <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-ink mb-2">Forgot Password?</h1>
            <p class="text-ink-muted">
              Enter your email address and we'll send you a link to reset your password.
            </p>
          </div>

          <!-- Form -->
          <ForgotPasswordForm client:load />

          <!-- Back to sign in link -->
          <div class="mt-6 text-center">
            <p class="text-ink-faint text-sm">
              Remember your password?{' '}
              <a href="/signin" class="text-primary hover:text-primary/80 font-medium">
                Sign in
              </a>
            </p>
          </div>
        </div>
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
