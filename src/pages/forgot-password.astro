---
// Renamed to /email-link-signin. This page is now a 301 permanent redirect
// preserving existing email-template links + bookmarks.
//
// Authed users go to /dashboard like everywhere else; the underlying
// page already does that bounce via middleware once they land.
if (Astro.locals.user) {
  return Astro.redirect("/dashboard", 302);
}
return Astro.redirect("/email-link-signin", 301);
