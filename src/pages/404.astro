---
import BaseLayout from "@/layouts/BaseLayout.astro";

// SSR (no prerender) so this genuinely returns a 404 status — important for
// search engines to drop dead/removed URLs instead of keeping them indexed.
Astro.response.status = 404;
---

<BaseLayout
  title="Page not found — Aspire Sports"
  description="The page you're looking for doesn't exist or has moved."
>
  <main class="mx-auto flex min-h-[50vh] max-w-2xl flex-col items-center justify-center px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary-orange">404</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">We couldn't find that page.</h1>
    <p class="mt-4 text-muted-foreground">
      The link may be broken, or the page may have moved.
    </p>
    <a
      href="/programs"
      class="mt-8 inline-block rounded-md bg-primary-bright px-5 py-2.5 font-semibold text-primary-foreground transition hover:opacity-90"
    >
      Browse programs
    </a>
  </main>
</BaseLayout>
