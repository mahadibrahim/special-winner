---
// SSR like /adult — the islands fetch host-scoped public endpoints
// client-side; keep request-time rendering (no prerender flag).
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryFinder from "@/components/landing/category-finder.tsx";
import SeasonFactsBand from "@/components/landing/season-facts-band.tsx";
import HowItWorksStrip from "@/components/landing/how-it-works-strip.astro";
import SeasonCalendarBand, { type CalendarTermConfig } from "@/components/landing/season-calendar-band.tsx";
import LandingFaq, { type LandingFaqItem } from "@/components/landing/landing-faq.tsx";
import CTABanner from "@/components/cta-banner";
import { setMarketingEdgeCache } from "@/lib/http/edge-cache";
setMarketingEdgeCache(Astro);

const howItWorksSteps = [
  {
    title: "Reserve for $200",
    body: "Your deposit locks the roster spot and counts toward the team fee.",
  },
  {
    title: "Share your link",
    body: "Teammates tap it, register, and pay their own share — you front nothing else.",
  },
  {
    title: "Watch it fill",
    body: "Live tracker shows who's paid. Unpaid shares fall to your card only after the deadline.",
  },
];

// Authored future-term cells for the calendar band — live terms from the
// catalog replace any cell they match. Months are authored estimates until
// upcoming seasons exist in the DB (see the follow-up note in
// season-calendar-band.tsx).
const calendarTerms: CalendarTermConfig[] = [
  { name: "Fall", months: "Sep–Nov", games: "7 games", match: "fall" },
  { name: "Winter I", months: "Dec–Feb", games: "7 games", match: "winter-i" },
  { name: "Winter II", months: "Feb–Apr", games: "7 games", match: "winter-ii" },
  { name: "Spring", months: "Apr–Jun", games: "7 games", match: "spring" },
];

const faqs: LandingFaqItem[] = [
  {
    question: "Who can register?",
    answer:
      "Anyone 18 or older. Sign up a full team with a captain link, or register solo as a free agent and we'll place you on a team.",
  },
  {
    question: "How does team signup work?",
    answer:
      "The captain puts down a $200 deposit that reserves the roster spot and counts toward the team fee. You get a share link; teammates register and pay their own share online, and a live tracker shows who's paid. Only shares still unpaid after the deadline fall back to the captain's card.",
  },
  {
    question: "What's the refund policy?",
    answer:
      "Cancel 14 or more days before the season starts for a full refund. Inside 14 days, we review case by case — the default is a prorated credit toward a future season.",
    linkHref: "/refund-policy",
    linkLabel: "Read the full refund policy",
  },
  {
    question: "What's included in the season?",
    answer:
      "A 7-game season with referees at every match, standings tracked all season, and your full schedule published before week 1.",
  },
  {
    question: "What if I don't have a full team?",
    answer:
      "Register as a free agent. We place free agents on teams that need players — balanced by skill level where possible — and you'll get your team and schedule before the first game.",
  },
];
---

<BaseLayout
  title="Adult Leagues — Aspire Sports"
  description="Adult sports leagues in Columbus and central Ohio. Organized seasons, fair refs, team and free-agent signup — find your league night."
>
  <Fragment slot="head">
    <link rel="canonical" href={`${Astro.url.origin}/adult/leagues`} />
  </Fragment>

  <main id="main-content" class="flex-1">
    <section class="relative text-cream pt-16 px-9 pb-8 overflow-hidden">
      <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover z-0"
        poster="https://images.unsplash.com/photo-1543326727-cf6c39e8f84c?auto=format&fit=crop&w=1600&q=60">
        <source src="https://videos.pexels.com/video-files/6077723/6077723-hd_1920_1080_25fps.mp4" type="video/mp4" />
        <source src="https://videos.pexels.com/video-files/6077723/6077723-sd_640_360_25fps.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 z-[1]" style="background:linear-gradient(180deg,oklch(0.18 0.07 262/0.45),oklch(0.18 0.07 262/0.82)),linear-gradient(100deg,oklch(0.18 0.07 262/0.7),oklch(0.18 0.07 262/0.25))"></div>
      <div class="relative z-[2] max-w-[1080px] mx-auto">
        <h1 class="font-display font-semibold tracking-tight" style="font-size:clamp(2.5rem,6vw,4rem);line-height:.95">Adult leagues.</h1>
        <p class="mt-3 text-base text-cream/90 max-w-[520px]">Season-long play with fair refs, reliable scheduling, and a post-game scene worth staying for. Sign up a full team or join as a free agent.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-6">
          <a href="/adult/leagues/soccer" data-sport-tile data-sport="soccer" data-state="live" class="relative rounded-2xl p-4 text-ink overflow-hidden" style="background:oklch(0.66 0.21 35)">
            <div class="font-mono text-[9px] tracking-widest uppercase opacity-80">● Now registering</div>
            <div class="font-display font-semibold text-2xl mt-1.5">Soccer</div>
            <div class="font-mono text-xs">Fall 2026 · 13 divisions · 2 venues</div>
            <span class="absolute right-4 bottom-4 font-semibold text-lg">→</span>
          </a>
          <a href="/adult/leagues/flag-football" data-sport-tile data-sport="flag-football" data-state="live" class="relative rounded-2xl p-4 text-ink overflow-hidden" style="background:oklch(0.75 0.14 85)">
            <div class="font-mono text-[9px] tracking-widest uppercase opacity-80">● Now registering</div>
            <div class="font-display font-semibold text-2xl mt-1.5">Flag Football</div>
            <div class="font-mono text-xs">Winter 1 · 4v4 · Men's &amp; Coed</div>
            <span class="absolute right-4 bottom-4 font-semibold text-lg">→</span>
          </a>
          <div data-sport-tile data-sport="basketball" data-state="coming_soon" class="rounded-2xl p-4 border border-cream/25 text-cream/80" style="background:oklch(0.2 0.06 262/0.7)">
            <div class="font-mono text-[9px] tracking-widest uppercase opacity-80">Coming soon</div>
            <div class="font-display font-semibold text-2xl mt-1.5">Basketball</div>
            <div class="font-mono text-xs">Interested? Notify me</div>
          </div>
          <div data-sport-tile data-sport="volleyball" data-state="coming_soon" class="rounded-2xl p-4 border border-cream/25 text-cream/80" style="background:oklch(0.2 0.06 262/0.7)">
            <div class="font-mono text-[9px] tracking-widest uppercase opacity-80">Coming soon</div>
            <div class="font-display font-semibold text-2xl mt-1.5">Volleyball</div>
            <div class="font-mono text-xs">Interested? Notify me</div>
          </div>
        </div>
        <p class="mt-5 text-sm text-cream/70">
          Looking for youth leagues?
          <a href="/youth/leagues" class="underline underline-offset-2 hover:text-cream transition-colors">See kids &amp; teen leagues →</a>
        </p>
        <p class="mt-2 text-sm text-cream/70">
          City guides:
          <a href="/adult-soccer-leagues-columbus" class="underline underline-offset-2 hover:text-cream transition-colors">soccer in Columbus</a>
          ·
          <a href="/adult-flag-football-columbus" class="underline underline-offset-2 hover:text-cream transition-colors">flag football in Columbus</a>
        </p>
      </div>
    </section>

    <SeasonFactsBand
      client:load
      audience="adult"
      programTypes={["league"]}
      authoredFact={{ label: "Format", value: "7-game season" }}
      faqHref="#faq"
    />

    <HowItWorksStrip heading="How team signup works" steps={howItWorksSteps} />

    <CategoryFinder
      client:load
      audience="adult"
      programTypes={["league"]}
      title="Open now"
      descriptor="Seasons open to full teams and free agents."
      sectionId="adult-leagues"
    />

    <SeasonCalendarBand
      client:visible
      audience="adult"
      programTypes={["league"]}
      pageKey="adult-leagues"
      cardsSectionId="adult-leagues"
      heading="The league year."
      descriptor="Back-to-back seasons all year — if you miss one window, the next is never far."
      futureTerms={calendarTerms}
      liveGamesLabel="7 games"
    />

    <LandingFaq client:visible id="faq" heading="Adult league FAQs" items={faqs} />

    <CTABanner client:visible />
  </main>
</BaseLayout>

<script>
  import { trackCatalogSportTileClicked } from "@/lib/analytics/events";
  document.querySelectorAll<HTMLElement>("[data-sport-tile]").forEach((el) => {
    el.addEventListener("click", () =>
      trackCatalogSportTileClicked({
        sport: el.dataset.sport ?? "",
        state: (el.dataset.state as "live" | "coming_soon") ?? "live",
      }),
    );
  });
</script>
