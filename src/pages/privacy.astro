---
// NOT prerendered: nav needs request-time auth state.
import '../styles/globals.css';
import Navigation from '../components/navigation';
import Footer from '../components/footer';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Privacy Policy — Aspire Sports</title>
    <meta name="description" content="Aspire Sports privacy policy." />
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4">
      <article class="max-w-3xl mx-auto prose prose-ink">
        <h1 class="text-3xl sm:text-4xl font-display font-bold text-ink mb-2">Privacy Policy</h1>
        <p class="text-ink-muted mb-8">Last updated: April 2026</p>

        <section class="space-y-4 text-ink-2 leading-relaxed">
          <p>
            Aspire Sports collects only the information we need to run youth sports programs. This
            page explains what we collect, why, and the choices you have.
          </p>

          <h2 class="text-xl font-display font-semibold text-ink mt-8">Information we collect</h2>
          <ul class="list-disc pl-6 space-y-1">
            <li>Parent/guardian: name, email, phone (optional).</li>
            <li>Child participant: first/last name, birth date, gender (optional), and any medical or emergency details you provide on a waiver.</li>
            <li>Registration and payment history (payment-card details are handled by our payment provider and are not stored by us).</li>
            <li>Basic usage data (pages visited, rough location) to keep the site reliable and secure.</li>
          </ul>

          <h2 class="text-xl font-display font-semibold text-ink mt-8">How we use it</h2>
          <ul class="list-disc pl-6 space-y-1">
            <li>Registering and placing children in appropriate programs, teams, and age groups.</li>
            <li>Communicating schedule changes, coach messages, receipts, and reminders.</li>
            <li>Ensuring participant safety, including emergency contact during a session.</li>
            <li>Improving programs and the website.</li>
          </ul>

          <h2 class="text-xl font-display font-semibold text-ink mt-8">Sharing</h2>
          <p>
            We do not sell personal information. We share information only with the vendors needed
            to deliver the service — our payment processor, email/SMS providers, and cloud hosting —
            and only the minimum required. We share with coaches and staff who need roster and
            safety information for your child's team.
          </p>

          <h2 class="text-xl font-display font-semibold text-ink mt-8">Children's privacy</h2>
          <p>
            Parent/guardian accounts register children. We do not knowingly collect information
            directly from children. Parents can review, correct, or delete their child's records at
            any time by contacting us.
          </p>

          <h2 class="text-xl font-display font-semibold text-ink mt-8">Your choices</h2>
          <ul class="list-disc pl-6 space-y-1">
            <li>Update your profile or family members from your dashboard.</li>
            <li>Opt out of marketing email at any time — operational messages (schedule, safety, receipts) continue while you have an active registration.</li>
            <li>Request deletion of your data; we retain registration and payment records for the period required by law.</li>
          </ul>

          <h2 class="text-xl font-display font-semibold text-ink mt-8">Security</h2>
          <p>
            We use industry-standard encryption in transit and at rest, and we limit internal access
            to a need-to-know basis. No system is perfectly secure; if we discover a material
            incident affecting your data, we will notify you.
          </p>

          <h2 class="text-xl font-display font-semibold text-ink mt-8">Contact</h2>
          <p>
            Privacy questions or requests:
            <a class="text-primary" href="mailto:info@aspiresports.com">info@aspiresports.com</a>.
          </p>
        </section>
      </article>
    </main>

    <Footer client:idle />
  </body>
</html>
