---
// SSR — the AdultFinder island fetches the drop-in endpoint client-side,
// which is org-scoped via the request host; the page must not be prerendered.
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdultFinder from "@/components/landing/adult-finder.tsx";
import Testimonials from "@/components/testimonials";
import CTABanner from "@/components/cta-banner";
---

<BaseLayout
  title="Adult Sports Leagues — Aspire Sports"
  description="Adult sports leagues, pickup, and tournaments in central Ohio. Find a league, play pickup, or register for a tournament — Aspire Sports."
>
  <Fragment slot="head">
    <link rel="canonical" href={`${Astro.url.origin}/adult`} />
  </Fragment>

  <main id="main-content" class="flex-1">
    <!-- Hero — energy + credibility, dark/orange. Evergreen kicker (no
         time-bound copy). CTAs scroll down to the finder, not away. -->
    <section class="bg-gradient-to-br from-ink to-zinc-700 text-cream pt-28 pb-16">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-primary-orange mb-4">
          Adult Sports · Central Ohio
        </p>
        <h1
          class="font-display max-w-3xl"
          style="font-size: clamp(2.25rem, 6vw, 4.5rem); line-height: 1.05; letter-spacing: -0.03em;"
        >
          The league you'll build your week around.
        </h1>
        <p class="mt-6 text-lg text-cream/85 max-w-2xl">
          Fair refs, reliable communication, and a post-game scene worth staying
          for. Find a league, drop into pickup, or register a team for a
          tournament — all right here.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#leagues"
            data-landing-cta="adult-hero-leagues"
            class="inline-flex items-center gap-2 bg-primary text-cream px-7 py-4 text-sm font-medium tracking-wide uppercase hover:bg-primary/90 transition-colors"
            style="letter-spacing: 0.08em;"
          >
            Find a league ↓
          </a>
          <a
            href="#pickup"
            data-landing-cta="adult-hero-pickup"
            class="inline-flex items-center gap-2 border border-cream text-cream px-7 py-4 text-sm font-medium tracking-wide uppercase hover:bg-cream hover:text-ink transition-colors"
            style="letter-spacing: 0.08em;"
          >
            Play pickup ↓
          </a>
          <a
            href="#tournaments"
            data-landing-cta="adult-hero-tournaments"
            class="inline-flex items-center gap-2 border border-cream text-cream px-7 py-4 text-sm font-medium tracking-wide uppercase hover:bg-cream hover:text-ink transition-colors"
            style="letter-spacing: 0.08em;"
          >
            Tournaments ↓
          </a>
        </div>
      </div>
    </section>

    <!-- The finder — sticky section-nav + three filterable sections.
         Everything an adult needs resolves here without navigating away. -->
    <AdultFinder client:load />

    <!-- Testimonials — captain voice -->
    <Testimonials client:visible />

    <!-- CTA banner -->
    <CTABanner client:visible />
  </main>
</BaseLayout>

<script>
  import { track } from "@/lib/analytics/track";

  // Conversion analytics on the hero jump-links.
  document.querySelectorAll<HTMLAnchorElement>("[data-landing-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      track("landing_hero_cta_click", { cta: el.dataset.landingCta });
    });
  });

  // Smooth-scroll for in-page anchors (hero jump-links + the sticky
  // section-nav). `scroll-mt-*` on each <section> offsets the sticky headers.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const anchor = target.closest<HTMLAnchorElement>('a[href^="#"]');
    if (!anchor) return;
    const id = anchor.getAttribute("href")?.slice(1);
    if (!id) return;
    const section = document.getElementById(id);
    if (!section) return;
    e.preventDefault();
    section.scrollIntoView({ behavior: "smooth" });
    history.replaceState(null, "", `#${id}`);
  });
</script>
