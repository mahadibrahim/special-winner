---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import CheckInDashboard from '../../../components/admin/check-in/CheckInDashboard';
import { getDb } from '@/lib/db';
import { venues } from '@/lib/db/schema/teams';
import { locations } from '@/lib/db/schema/organizations';
import { and, eq } from 'drizzle-orm';

export const prerender = false;

// Middleware guarantees admin for /admin/**
const user = Astro.locals.user!;
const orgId = Astro.locals.organization?.id;

let venuesList: { id: string; name: string }[] = [];
if (orgId) {
  const rows = await getDb()
    .select({ id: venues.id, name: venues.name })
    .from(venues)
    .innerJoin(locations, eq(venues.locationId, locations.id))
    .where(and(eq(locations.organizationId, orgId), eq(venues.active, true)))
    .orderBy(venues.name);
  venuesList = rows;
}
---

<BaseLayout title="Check-in — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    currentPath="/admin/check-in"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <CheckInDashboard venues={venuesList} client:load />
  </AdminLayout>
</BaseLayout>
