---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../components/admin/admin-layout';
import { AdminSettings } from '../../components/admin/admin-settings';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.name ?? "parent";
const organizationName = Astro.locals.organization?.name ?? null;
---

<BaseLayout title="Settings — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/settings"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <AdminSettings client:load organizationName={organizationName} />
  </AdminLayout>
</BaseLayout>
