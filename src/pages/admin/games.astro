---
import '../../styles/globals.css';
import { AdminLayout } from '../../components/admin/admin-layout';
import { GamesList } from '../../components/admin/games-list';
import { getDb } from '../../lib/db';
import { seasons, programs, teams, venues } from '../../lib/db/schema';
import { eq, asc } from 'drizzle-orm';

// Check if user is admin
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/signin?returnUrl=/admin/games');
}

// Fetch data for dropdowns
let seasonsList: any[] = [];
let teamsList: any[] = [];
let venuesList: any[] = [];

try {
  const db = getDb();

  const [allSeasons, allTeams, allVenues] = await Promise.all([
    db
      .select({
        id: seasons.id,
        name: seasons.name,
        program: {
          id: programs.id,
          name: programs.name,
        },
      })
      .from(seasons)
      .innerJoin(programs, eq(seasons.programId, programs.id))
      .orderBy(asc(seasons.name)),

    db
      .select({
        id: teams.id,
        name: teams.name,
        seasonId: teams.seasonId,
        color: teams.color,
      })
      .from(teams)
      .orderBy(asc(teams.name)),

    db
      .select({
        id: venues.id,
        name: venues.name,
      })
      .from(venues)
      .where(eq(venues.active, true))
      .orderBy(asc(venues.name)),
  ]);

  seasonsList = allSeasons.map(s => ({
    id: s.id,
    name: s.name,
    program: s.program,
  }));
  teamsList = allTeams;
  venuesList = allVenues;
} catch (error) {
  console.error('Error fetching games data:', error);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Games — Admin — Aspire Sports</title>
  </head>
  <body class="bg-cream text-ink antialiased">
    <AdminLayout
      client:load
      currentPath="/admin/games"
      user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
    >
      <GamesList client:load seasons={seasonsList} teams={teamsList} venues={venuesList} />
    </AdminLayout>
  </body>
</html>
