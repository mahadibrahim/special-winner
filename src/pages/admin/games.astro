---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../components/admin/admin-layout';
import { GamesList } from '../../components/admin/games-list';
import { getDb } from '../../lib/db';
import { seasons, programs, teams, venues } from '../../lib/db/schema';
import { eq, asc } from 'drizzle-orm';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;

// Fetch data for dropdowns
let seasonsList: any[] = [];
let teamsList: any[] = [];
let venuesList: any[] = [];

try {
  const db = getDb();

  const [allSeasons, allTeams, allVenues] = await Promise.all([
    db
      .select({
        id: seasons.id,
        name: seasons.name,
        program: {
          id: programs.id,
          name: programs.name,
        },
      })
      .from(seasons)
      .innerJoin(programs, eq(seasons.programId, programs.id))
      .orderBy(asc(seasons.name)),

    db
      .select({
        id: teams.id,
        name: teams.name,
        seasonId: teams.seasonId,
        color: teams.color,
      })
      .from(teams)
      .orderBy(asc(teams.name)),

    db
      .select({
        id: venues.id,
        name: venues.name,
      })
      .from(venues)
      .where(eq(venues.active, true))
      .orderBy(asc(venues.name)),
  ]);

  seasonsList = allSeasons.map(s => ({
    id: s.id,
    name: s.name,
    program: s.program,
  }));
  teamsList = allTeams;
  venuesList = allVenues;
} catch (error) {
  console.error('Error fetching games data:', error);
}
---

<BaseLayout title="Games — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    currentPath="/admin/games"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <GamesList client:load seasons={seasonsList} teams={teamsList} venues={venuesList} />
  </AdminLayout>
</BaseLayout>
