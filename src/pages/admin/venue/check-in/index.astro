---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AdminLayout } from '@/components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { getLocationIdsForUser } from "@/lib/auth/location-scope";
import { resolveVenueLabel } from "@/lib/admin/venue-label";
import CheckInDashboard from '@/components/admin/check-in/CheckInDashboard';
import { getDb } from '@/lib/db';
import { venues } from '@/lib/db/schema/teams';
import { locations } from '@/lib/db/schema/organizations';
import { and, eq, inArray } from 'drizzle-orm';

export const prerender = false;

// Middleware guarantees admin for /admin/**
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const isSuperAdmin = primaryRole === "super_admin";
const venueLabel = isSuperAdmin ? undefined : await resolveVenueLabel(user.id);
const orgId = Astro.locals.organization?.id;

// Super-admins see every active venue in the org. Venue managers see only
// venues at locations they're scoped to — a Downtown manager shouldn't be
// able to mark Worthington check-ins.
let venuesList: { id: string; name: string; location: { name: string } }[] = [];
if (orgId) {
  const conditions = [eq(locations.organizationId, orgId), eq(venues.active, true)];
  let shouldQuery = true;
  if (!isSuperAdmin) {
    const allowedLocationIds = await getLocationIdsForUser(user.id);
    if (allowedLocationIds.length === 0) {
      shouldQuery = false;
    } else {
      conditions.push(inArray(venues.locationId, allowedLocationIds));
    }
  }
  if (shouldQuery) {
    const rows = await getDb()
      .select({
        id: venues.id,
        name: venues.name,
        location: { name: locations.name },
      })
      .from(venues)
      .innerJoin(locations, eq(venues.locationId, locations.id))
      .where(and(...conditions))
      .orderBy(venues.name);
    venuesList = rows;
  }
}
---

<BaseLayout title="Check-in — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    venueLabel={venueLabel}
    currentPath="/admin/venue/check-in"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <CheckInDashboard venues={venuesList} client:load />
  </AdminLayout>
</BaseLayout>
