---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import {
  SeasonHubLayout,
  type SeasonHeader,
  type SeasonStats,
  type SeasonHubTab,
} from "@/components/admin/super/season-hub-layout";
import { ProgramGearBinding } from "@/components/admin/program-gear-binding";
import { getDb } from "@/lib/db";
import { seasons, programs } from "@/lib/db/schema/programs";
import { sports } from "@/lib/db/schema/sports";
import { locations } from "@/lib/db/schema/organizations";
import { registrations, familyMembers } from "@/lib/db/schema/registrations";
import { teams, games, rosters } from "@/lib/db/schema/teams";
import { payments } from "@/lib/db/schema/payments";
import { and, eq, sql, ne, desc, asc } from "drizzle-orm";

export const prerender = false;

const user = Astro.locals.user!;
const userRoles = Astro.locals.userRoles ?? [];
const primaryRole = userRoles[0]?.name ?? "parent";
const organization = Astro.locals.organization;
const seasonId = Astro.params.id;

if (!seasonId || !organization?.id) {
  return Astro.redirect("/admin/seasons");
}

const [row] = await getDb()
  .select({
    seasonId: seasons.id,
    seasonName: seasons.name,
    seasonStatus: seasons.status,
    startDate: seasons.startDate,
    endDate: seasons.endDate,
    maxParticipants: seasons.maxParticipants,
    programName: programs.name,
    sportName: sports.name,
    locationName: locations.name,
  })
  .from(seasons)
  .innerJoin(programs, eq(seasons.programId, programs.id))
  .innerJoin(sports, eq(programs.sportId, sports.id))
  .innerJoin(locations, eq(programs.locationId, locations.id))
  .where(
    and(eq(seasons.id, seasonId), eq(locations.organizationId, organization.id)),
  );

if (!row) {
  return Astro.redirect("/admin/seasons");
}

// Aggregate counts for the key-facts strip.
const [[regCount], [teamCount], [gameCount], [waitCount], [refundCount], [revRow]] =
  await Promise.all([
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(registrations)
      .where(
        and(
          eq(registrations.seasonId, seasonId),
          ne(registrations.status, "cancelled"),
        ),
      ),
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(teams)
      .where(eq(teams.seasonId, seasonId)),
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(games)
      .where(eq(games.seasonId, seasonId)),
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(registrations)
      .where(
        and(
          eq(registrations.seasonId, seasonId),
          eq(registrations.status, "waitlisted"),
        ),
      ),
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(registrations)
      .where(
        and(
          eq(registrations.seasonId, seasonId),
          eq(registrations.refundStatus, "pending_approval"),
        ),
      ),
    getDb()
      .select({
        total: sql<number>`COALESCE(SUM(${payments.amountCents}), 0)::int`,
      })
      .from(payments)
      .innerJoin(registrations, eq(payments.registrationId, registrations.id))
      .where(
        and(
          eq(registrations.seasonId, seasonId),
          eq(payments.status, "succeeded"),
        ),
      ),
  ]);

const header: SeasonHeader = {
  id: row.seasonId,
  name: row.seasonName,
  programName: row.programName,
  sportName: row.sportName,
  locationName: row.locationName,
  status: row.seasonStatus,
  startDate: row.startDate.toString(),
  endDate: row.endDate.toString(),
};

const stats: SeasonStats = {
  capacityCurrent: regCount?.n ?? 0,
  capacityMax: row.maxParticipants ?? null,
  revenueCents: revRow?.total ?? 0,
  teams: teamCount?.n ?? 0,
  games: gameCount?.n ?? 0,
  waitlistCount: waitCount?.n ?? 0,
  refundsPending: refundCount?.n ?? 0,
};

// Pull inline-table data for the two highest-value tabs (Registrations
// and Teams). The remaining 5 tabs stay as deep-link panels — that work
// lives on other admin pages and inlining it would duplicate without
// adding value.
const [recentRegs, teamsWithRoster] = await Promise.all([
  getDb()
    .select({
      id: registrations.id,
      status: registrations.status,
      createdAt: registrations.createdAt,
      firstName: familyMembers.firstName,
      lastName: familyMembers.lastName,
    })
    .from(registrations)
    .innerJoin(familyMembers, eq(registrations.familyMemberId, familyMembers.id))
    .where(
      and(
        eq(registrations.seasonId, seasonId),
        ne(registrations.status, "cancelled"),
      ),
    )
    .orderBy(desc(registrations.createdAt))
    .limit(10),
  getDb()
    .select({
      id: teams.id,
      name: teams.name,
      maxRosterSize: teams.maxRosterSize,
      rosterCount: sql<number>`COALESCE((
        SELECT COUNT(*)::int FROM ${rosters}
          WHERE ${rosters.teamId} = ${teams.id}
            AND ${rosters.status} = 'active'
      ), 0)`,
    })
    .from(teams)
    .where(eq(teams.seasonId, seasonId))
    .orderBy(asc(teams.name)),
]);

// HTML-escape user-controlled text. Cheap to call; defends the
// dangerouslySetInnerHTML path on the React side without dragging in
// a library.
const esc = (s: string): string =>
  s.replace(/[&<>"']/g, (c) => {
    switch (c) {
      case "&": return "&amp;";
      case "<": return "&lt;";
      case ">": return "&gt;";
      case '"': return "&quot;";
      case "'": return "&#39;";
      default: return c;
    }
  });

// Deep-link panel shared by tabs whose real work lives elsewhere.
function panel(label: string, hrefs: { label: string; href: string }[]): string {
  const items = hrefs
    .map(
      (h) =>
        '<li><a href="' +
        esc(h.href) +
        '" class="underline hover:no-underline">' +
        esc(h.label) +
        " &rarr;</a></li>",
    )
    .join("");
  return (
    '<div class="bg-white border border-border rounded p-6 space-y-3">' +
    '<p class="text-sm text-ink-muted">' +
    esc(label) +
    "</p>" +
    '<ul class="space-y-1 text-sm">' +
    items +
    "</ul></div>"
  );
}

// Inline registrations table — 10 most recent active registrations,
// followed by a deep-link to the full list with the season filter.
function registrationsPanel(): string {
  const summary =
    stats.capacityCurrent +
    " active registration" +
    (stats.capacityCurrent === 1 ? "" : "s") +
    (stats.capacityMax ? " of " + stats.capacityMax : "") +
    ".";

  if (recentRegs.length === 0) {
    return (
      '<div class="bg-white border border-border rounded p-6 space-y-3">' +
      '<p class="text-sm text-ink-muted">' +
      esc(summary) +
      "</p>" +
      '<p class="text-sm text-ink-muted italic">No registrations yet.</p>' +
      '<a href="/admin/registrations?seasonId=' +
      esc(seasonId) +
      '" class="underline text-sm hover:no-underline">' +
      "View all registrations &rarr;</a>" +
      "</div>"
    );
  }

  const rows = recentRegs
    .map((r) => {
      const name = esc(`${r.firstName} ${r.lastName}`);
      const status = esc(r.status);
      const when = esc(
        new Date(r.createdAt).toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        }),
      );
      const link = `/admin/registrations/${esc(r.id)}`;
      return (
        '<tr class="border-t border-border">' +
        '<td class="py-2 pr-3"><a href="' +
        link +
        '" class="underline hover:no-underline">' +
        name +
        "</a></td>" +
        '<td class="py-2 pr-3 text-ink-muted">' +
        status +
        "</td>" +
        '<td class="py-2 pr-3 text-ink-muted">' +
        when +
        "</td>" +
        "</tr>"
      );
    })
    .join("");

  return (
    '<div class="bg-white border border-border rounded p-6 space-y-3">' +
    '<p class="text-sm text-ink-muted">' +
    esc(summary) +
    " Showing the 10 most recent.</p>" +
    '<table class="w-full text-sm"><thead><tr class="text-left text-[10px] uppercase tracking-wider text-ink-muted">' +
    '<th class="pb-1 pr-3">Player</th>' +
    '<th class="pb-1 pr-3">Status</th>' +
    '<th class="pb-1 pr-3">Registered</th>' +
    "</tr></thead><tbody>" +
    rows +
    "</tbody></table>" +
    '<a href="/admin/registrations?seasonId=' +
    esc(seasonId) +
    '" class="underline text-sm hover:no-underline">' +
    "View all registrations &rarr;</a>" +
    "</div>"
  );
}

// Inline teams table — every team in the season + active roster count.
function teamsPanel(): string {
  const summary =
    stats.teams +
    " team" +
    (stats.teams === 1 ? "" : "s") +
    " in this season.";

  if (teamsWithRoster.length === 0) {
    return (
      '<div class="bg-white border border-border rounded p-6 space-y-3">' +
      '<p class="text-sm text-ink-muted">' +
      esc(summary) +
      "</p>" +
      '<p class="text-sm text-ink-muted italic">No teams yet.</p>' +
      '<a href="/admin/teams?seasonId=' +
      esc(seasonId) +
      '" class="underline text-sm hover:no-underline">' +
      "Manage teams &rarr;</a>" +
      "</div>"
    );
  }

  const rows = teamsWithRoster
    .map((t) => {
      const name = esc(t.name);
      const count = `${t.rosterCount}${t.maxRosterSize ? " / " + t.maxRosterSize : ""}`;
      const link = `/admin/teams/${esc(t.id)}`;
      return (
        '<tr class="border-t border-border">' +
        '<td class="py-2 pr-3"><a href="' +
        link +
        '" class="underline hover:no-underline">' +
        name +
        "</a></td>" +
        '<td class="py-2 pr-3 text-ink-muted">' +
        esc(count) +
        "</td>" +
        "</tr>"
      );
    })
    .join("");

  return (
    '<div class="bg-white border border-border rounded p-6 space-y-3">' +
    '<p class="text-sm text-ink-muted">' +
    esc(summary) +
    "</p>" +
    '<table class="w-full text-sm"><thead><tr class="text-left text-[10px] uppercase tracking-wider text-ink-muted">' +
    '<th class="pb-1 pr-3">Team</th>' +
    '<th class="pb-1 pr-3">Active roster</th>' +
    "</tr></thead><tbody>" +
    rows +
    "</tbody></table>" +
    '<div class="flex gap-4">' +
    '<a href="/admin/teams?seasonId=' +
    esc(seasonId) +
    '" class="underline text-sm hover:no-underline">' +
    "Manage teams &rarr;</a>" +
    '<a href="#gear" class="underline text-sm hover:no-underline">Jump to Gear binding &rarr;</a>' +
    "</div></div>"
  );
}

const tabContents: Record<SeasonHubTab, string> = {
  registrations: registrationsPanel(),
  teams: teamsPanel(),
  schedule: panel(
    `${stats.games} game${stats.games === 1 ? "" : "s"} scheduled.`,
    [{ label: "Manage games", href: `/admin/games?seasonId=${seasonId}` }],
  ),
  pricing: panel("Pricing + discount codes for this season.", [
    { label: "Edit season pricing", href: `/admin/seasons/${seasonId}/edit` },
    { label: "Manage discount codes", href: `/admin/discount-codes?seasonId=${seasonId}` },
  ]),
  communications: panel("Broadcasts and announcements for this season.", [
    { label: "Send an announcement", href: `/admin/announcements?seasonId=${seasonId}` },
    { label: "View sent broadcasts", href: `/admin/broadcasts?seasonId=${seasonId}` },
  ]),
  refunds: panel(
    stats.refundsPending > 0
      ? `${stats.refundsPending} refund request${stats.refundsPending === 1 ? "" : "s"} pending approval.`
      : "No refund requests pending for this season.",
    [{ label: "Open refunds queue", href: "/admin/refunds" }],
  ),
  settings: panel("Edit dates, capacity, registration window, and status.", [
    { label: "Edit season", href: `/admin/seasons/${seasonId}/edit` },
  ]),
};

const initialTab = (Astro.url.searchParams.get("tab") as SeasonHubTab) || "registrations";
---

<BaseLayout
  title={`${header.name} — Seasons — Admin — Aspire Sports`}
  navigation={false}
  footer={false}
>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/seasons"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <SeasonHubLayout
      client:load
      season={header}
      stats={stats}
      initialTab={initialTab}
      tabContents={tabContents}
    />

    <section id="gear" class="mt-8">
      <h2 class="text-xl font-semibold mb-3 text-ink">Gear binding</h2>
      <ProgramGearBinding client:load seasonId={header.id} />
    </section>
  </AdminLayout>
</BaseLayout>
