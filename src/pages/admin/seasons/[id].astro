---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import {
  SeasonHubLayout,
  type SeasonHeader,
  type SeasonStats,
  type SeasonHubTab,
} from "@/components/admin/super/season-hub-layout";
import { ProgramGearBinding } from "@/components/admin/program-gear-binding";
import { getDb } from "@/lib/db";
import { seasons, programs } from "@/lib/db/schema/programs";
import { sports } from "@/lib/db/schema/sports";
import { locations } from "@/lib/db/schema/organizations";
import { registrations } from "@/lib/db/schema/registrations";
import { teams, games } from "@/lib/db/schema/teams";
import { payments } from "@/lib/db/schema/payments";
import { and, eq, sql, ne } from "drizzle-orm";

export const prerender = false;

const user = Astro.locals.user!;
const userRoles = Astro.locals.userRoles ?? [];
const primaryRole = userRoles[0]?.name ?? "parent";
const organization = Astro.locals.organization;
const seasonId = Astro.params.id;

if (!seasonId || !organization?.id) {
  return Astro.redirect("/admin/seasons");
}

const [row] = await getDb()
  .select({
    seasonId: seasons.id,
    seasonName: seasons.name,
    seasonStatus: seasons.status,
    startDate: seasons.startDate,
    endDate: seasons.endDate,
    maxParticipants: seasons.maxParticipants,
    programName: programs.name,
    sportName: sports.name,
    locationName: locations.name,
  })
  .from(seasons)
  .innerJoin(programs, eq(seasons.programId, programs.id))
  .innerJoin(sports, eq(programs.sportId, sports.id))
  .innerJoin(locations, eq(programs.locationId, locations.id))
  .where(
    and(eq(seasons.id, seasonId), eq(locations.organizationId, organization.id)),
  );

if (!row) {
  return Astro.redirect("/admin/seasons");
}

// Aggregate counts for the key-facts strip.
const [[regCount], [teamCount], [gameCount], [waitCount], [refundCount], [revRow]] =
  await Promise.all([
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(registrations)
      .where(
        and(
          eq(registrations.seasonId, seasonId),
          ne(registrations.status, "cancelled"),
        ),
      ),
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(teams)
      .where(eq(teams.seasonId, seasonId)),
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(games)
      .where(eq(games.seasonId, seasonId)),
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(registrations)
      .where(
        and(
          eq(registrations.seasonId, seasonId),
          eq(registrations.status, "waitlisted"),
        ),
      ),
    getDb()
      .select({ n: sql<number>`count(*)::int` })
      .from(registrations)
      .where(
        and(
          eq(registrations.seasonId, seasonId),
          eq(registrations.refundStatus, "pending_approval"),
        ),
      ),
    getDb()
      .select({
        total: sql<number>`COALESCE(SUM(${payments.amountCents}), 0)::int`,
      })
      .from(payments)
      .innerJoin(registrations, eq(payments.registrationId, registrations.id))
      .where(
        and(
          eq(registrations.seasonId, seasonId),
          eq(payments.status, "succeeded"),
        ),
      ),
  ]);

const header: SeasonHeader = {
  id: row.seasonId,
  name: row.seasonName,
  programName: row.programName,
  sportName: row.sportName,
  locationName: row.locationName,
  status: row.seasonStatus,
  startDate: row.startDate.toString(),
  endDate: row.endDate.toString(),
};

const stats: SeasonStats = {
  capacityCurrent: regCount?.n ?? 0,
  capacityMax: row.maxParticipants ?? null,
  revenueCents: revRow?.total ?? 0,
  teams: teamCount?.n ?? 0,
  games: gameCount?.n ?? 0,
  waitlistCount: waitCount?.n ?? 0,
  refundsPending: refundCount?.n ?? 0,
};

// Tab content as pre-rendered HTML strings, passed to SeasonHubLayout
// (which renders them via dangerouslySetInnerHTML). These are deep-link
// panels that point at the existing top-level admin surfaces with a
// seasonId filter; an inline-table enhancement is a Phase-4 follow-up.
function panel(label: string, hrefs: { label: string; href: string }[]): string {
  const items = hrefs
    .map(
      (h) =>
        '<li><a href="' +
        h.href +
        '" class="underline hover:no-underline">' +
        h.label +
        " &rarr;</a></li>",
    )
    .join("");
  return (
    '<div class="bg-white border border-border rounded p-6 space-y-3">' +
    '<p class="text-sm text-ink-muted">' +
    label +
    "</p>" +
    '<ul class="space-y-1 text-sm">' +
    items +
    "</ul></div>"
  );
}

const tabContents: Record<SeasonHubTab, string> = {
  registrations: panel(
    `${stats.capacityCurrent} active registrations${stats.capacityMax ? ` of ${stats.capacityMax}` : ""}.`,
    [{ label: "View all registrations", href: `/admin/registrations?seasonId=${seasonId}` }],
  ),
  teams: panel(
    `${stats.teams} team${stats.teams === 1 ? "" : "s"} in this season.`,
    [
      { label: "Manage teams", href: `/admin/teams?seasonId=${seasonId}` },
      { label: "Jump to Gear binding", href: "#gear" },
    ],
  ),
  schedule: panel(
    `${stats.games} game${stats.games === 1 ? "" : "s"} scheduled.`,
    [{ label: "Manage games", href: `/admin/games?seasonId=${seasonId}` }],
  ),
  pricing: panel("Pricing + discount codes for this season.", [
    { label: "Edit season pricing", href: `/admin/seasons/${seasonId}/edit` },
    { label: "Manage discount codes", href: `/admin/discount-codes?seasonId=${seasonId}` },
  ]),
  communications: panel("Broadcasts and announcements for this season.", [
    { label: "Send an announcement", href: `/admin/announcements?seasonId=${seasonId}` },
    { label: "View sent broadcasts", href: `/admin/broadcasts?seasonId=${seasonId}` },
  ]),
  refunds: panel(
    stats.refundsPending > 0
      ? `${stats.refundsPending} refund request${stats.refundsPending === 1 ? "" : "s"} pending approval.`
      : "No refund requests pending for this season.",
    [{ label: "Open refunds queue", href: "/admin/refunds" }],
  ),
  settings: panel("Edit dates, capacity, registration window, and status.", [
    { label: "Edit season", href: `/admin/seasons/${seasonId}/edit` },
  ]),
};

const initialTab = (Astro.url.searchParams.get("tab") as SeasonHubTab) || "registrations";
---

<BaseLayout
  title={`${header.name} — Seasons — Admin — Aspire Sports`}
  navigation={false}
  footer={false}
>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/seasons"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <SeasonHubLayout
      client:load
      season={header}
      stats={stats}
      initialTab={initialTab}
      tabContents={tabContents}
    />

    <section id="gear" class="mt-8">
      <h2 class="text-xl font-semibold mb-3 text-ink">Gear binding</h2>
      <ProgramGearBinding client:load seasonId={header.id} />
    </section>
  </AdminLayout>
</BaseLayout>
