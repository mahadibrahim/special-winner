---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { SeasonsList } from '../../../components/admin/seasons-list';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Seasons — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    currentPath="/admin/seasons"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <SeasonsList client:load />
  </AdminLayout>
</BaseLayout>
