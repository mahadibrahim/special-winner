---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.roleName ?? "parent";
---

<BaseLayout title="Gear & Merchandise — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/gear"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <div class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Gear & Merchandise</h1>
        <p class="text-gray-600 mt-1">
          Manage your product catalog, program gear bindings, and external team
          store links.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        <a
          href="/admin/gear/products"
          class="block p-6 rounded-lg border bg-white hover:bg-muted transition-colors"
        >
          <h2 class="text-xl font-semibold">Products</h2>
          <p class="text-sm text-muted-foreground mt-1">
            Manage your gear catalog and variants.
          </p>
        </a>
      </div>
    </div>
  </AdminLayout>
</BaseLayout>
