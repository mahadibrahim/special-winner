---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import { getPrimaryRoleName } from "@/lib/auth";
import { BlueprintWorkspace } from "@/components/admin/blueprint-workspace";
import { getDb } from "@/lib/db";
import { seasons, programs } from "@/lib/db/schema/programs";
import { locations } from "@/lib/db/schema/organizations";
import { eq, and } from "drizzle-orm";

export const prerender = false;

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const organization = Astro.locals.organization;
const { programId, seasonId } = Astro.params;

// UUID-shape guard before hitting the DB: a non-uuid path segment (bad
// link, typo, bot probe) would otherwise reach the `eq(seasons.id, ...)`
// query and raise a raw "invalid input syntax for type uuid" Postgres
// error — an uncaught 500 rather than a clean redirect. This is a
// pre-existing gap shared by other `[id].astro` admin pages (e.g.
// src/pages/admin/seasons/[id].astro also 500s on a non-uuid id) — out of
// scope to fix everywhere here, but cheap to guard on this new route.
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

if (
  !programId ||
  !seasonId ||
  !organization?.id ||
  !UUID_RE.test(programId) ||
  !UUID_RE.test(seasonId)
) {
  return Astro.redirect("/admin/programs");
}

// Confirm the season belongs to BOTH this program and this org before
// rendering — same "PK lookup joined through locations.organizationId"
// pattern as src/pages/admin/seasons/[id].astro. A mismatched programId in
// the URL (or a cross-org season id) redirects rather than 404ing, matching
// the rest of the admin season pages.
const [row] = await getDb()
  .select({ seasonId: seasons.id, seasonName: seasons.name })
  .from(seasons)
  .innerJoin(programs, eq(seasons.programId, programs.id))
  .innerJoin(locations, eq(programs.locationId, locations.id))
  .where(
    and(
      eq(seasons.id, seasonId),
      eq(seasons.programId, programId),
      eq(locations.organizationId, organization.id),
    ),
  );

if (!row) {
  return Astro.redirect("/admin/programs");
}
---

<BaseLayout
  title={`Blueprint — ${row.seasonName} — Admin — Aspire Sports`}
  navigation={false}
  footer={false}
>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/programs"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <BlueprintWorkspace client:load seasonId={seasonId} />
  </AdminLayout>
</BaseLayout>
