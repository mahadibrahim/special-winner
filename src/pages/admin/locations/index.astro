---
import '../../../styles/globals.css';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { LocationsList } from '../../../components/admin/locations-list';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/signin?returnUrl=/admin/locations');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Locations - Admin - Aspire Sports</title>
  </head>
  <body>
    <AdminLayout
      client:load
      currentPath="/admin/locations"
      user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
    >
      <LocationsList client:load />
    </AdminLayout>
  </body>
</html>
