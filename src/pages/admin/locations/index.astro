---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { LocationsList } from '../../../components/admin/locations-list';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.name ?? "parent";
---

<BaseLayout title="Locations — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/locations"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <LocationsList client:load />
  </AdminLayout>
</BaseLayout>
