---
import '../../styles/globals.css';
import { AdminLayout } from '../../components/admin/admin-layout';
import { ReRegistrationCampaign as CampaignForm } from '../../components/admin/re-registration-campaign';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Re-Registration Campaign — Admin — Aspire Sports</title>
  </head>
  <body class="bg-cream text-ink antialiased">
    <AdminLayout
      client:load
      currentPath="/admin/re-registration-campaign"
      user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
    >
      <div class="space-y-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Re-Registration Campaign</h1>
          <p class="text-gray-600 mt-1">
            Invite returning families back for a new season. One magic link per family,
            pre-fills their registration form, 30-second flow on the parent's side.
          </p>
        </div>

        <CampaignForm client:load />
      </div>
    </AdminLayout>
  </body>
</html>
