---
import '../../styles/globals.css';
import { AdminLayout } from '../../components/admin/admin-layout';
import { DiscountCodesList } from '../../components/admin/discount-codes-list';

// Check if user is admin
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/signin?returnUrl=/admin/discount-codes');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Discount Codes - Admin - Aspire Sports</title>
  </head>
  <body>
    <AdminLayout
      client:load
      currentPath="/admin/discount-codes"
      user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
    >
      <DiscountCodesList client:load />
    </AdminLayout>
  </body>
</html>
