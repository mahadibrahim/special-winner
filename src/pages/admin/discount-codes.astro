---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../components/admin/admin-layout';
import { DiscountCodesList } from '../../components/admin/discount-codes-list';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.name ?? "parent";
---

<BaseLayout title="Discount Codes — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/discount-codes"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <DiscountCodesList client:load />
  </AdminLayout>
</BaseLayout>
