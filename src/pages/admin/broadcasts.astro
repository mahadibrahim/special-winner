---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { SentAnnouncementsList } from '../../components/admin/sent-announcements-list';

// Middleware guarantees user is an admin for /admin routes.
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
---

<BaseLayout title="Sent Announcements — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/broadcasts"
    user={{ firstName: Astro.locals.user!.firstName, lastName: Astro.locals.user!.lastName, email: Astro.locals.user!.email }}
  >
    <div class="mx-auto max-w-3xl p-6">
      <h1 class="mb-6 text-2xl font-semibold">Sent announcements</h1>
      <SentAnnouncementsList client:load />
    </div>
  </AdminLayout>
</BaseLayout>
