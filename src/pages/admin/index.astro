---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import { NeedsAttentionPanel } from "@/components/admin/super/needs-attention-panel";
import { SeasonsGrid, type SeasonCard } from "@/components/admin/super/seasons-grid";
import { TodayAcrossVenues } from "@/components/admin/super/today-across-venues";
import { getDb } from "@/lib/db";
import { programs, seasons } from "@/lib/db/schema/programs";
import { locations } from "@/lib/db/schema/organizations";
import { registrations } from "@/lib/db/schema/registrations";
import { and, eq, ne, sql, desc, asc } from "drizzle-orm";

export const prerender = false;

const user = Astro.locals.user!;
const orgId = Astro.locals.organization?.id;
const userRoles = Astro.locals.userRoles ?? [];
const primaryRole = userRoles[0]?.name ?? "parent";

// Pull the latest seasons (any non-cancelled status) for the SeasonsGrid.
let seasonCards: SeasonCard[] = [];
let venueList: { id: string; name: string }[] = [];
let loadError: string | null = null;

if (orgId) {
  try {
    const rawSeasons = await getDb()
      .select({
        id: seasons.id,
        seasonName: seasons.name,
        programName: programs.name,
        locationName: locations.name,
        status: seasons.status,
        maxParticipants: seasons.maxParticipants,
        endDate: seasons.endDate,
        registered: sql<number>`COALESCE((
          SELECT COUNT(*)::int FROM ${registrations}
            WHERE ${registrations.seasonId} = ${seasons.id}
              AND ${registrations.status} <> 'cancelled'
        ), 0)`,
      })
      .from(seasons)
      .innerJoin(programs, eq(seasons.programId, programs.id))
      .innerJoin(locations, eq(programs.locationId, locations.id))
      .where(
        and(
          eq(locations.organizationId, orgId),
          ne(seasons.status, "cancelled"),
        ),
      )
      .orderBy(desc(seasons.createdAt))
      .limit(6);

    seasonCards = rawSeasons.map((s) => {
      const today = new Date();
      const end = s.endDate ? new Date(`${s.endDate}T23:59:59Z`) : null;
      const daysLeft =
        end && end > today
          ? Math.ceil((end.getTime() - today.getTime()) / (24 * 60 * 60 * 1000))
          : null;
      return {
        id: s.id,
        programName: s.programName,
        seasonLabel: s.seasonName,
        locationName: s.locationName,
        status: s.status as SeasonCard["status"],
        capacityCurrent: Number(s.registered) || 0,
        capacityMax: s.maxParticipants ?? null,
        daysLeft,
      };
    });

    const locs = await getDb()
      .select({ id: locations.id, name: locations.name })
      .from(locations)
      .where(eq(locations.organizationId, orgId))
      .orderBy(asc(locations.createdAt));
    venueList = locs;
  } catch (e) {
    loadError =
      "Couldn't load seasons + venues. Check the database connection.";
    console.error("Admin home load error:", e);
  }
}

const greeting =
  new Date().getHours() < 12
    ? "morning"
    : new Date().getHours() < 17
      ? "afternoon"
      : "evening";
const niceDate = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title="Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <div class="space-y-6">
      <div class="flex items-end justify-between gap-3">
        <div>
          <p class="text-[10px] uppercase tracking-widest text-ink-muted font-semibold">
            Good {greeting}, {user.firstName ?? "Admin"}
          </p>
          <h1 class="font-display text-3xl font-semibold text-ink">{niceDate}</h1>
        </div>
        <a href="/" class="text-sm text-primary hover:text-primary/80 font-medium">
          View Site →
        </a>
      </div>

      {loadError ? (
        <div class="rounded border border-rose-200 bg-rose-50 p-4 text-sm text-rose-900">
          {loadError}
        </div>
      ) : (
        <>
          <NeedsAttentionPanel client:load />
          <SeasonsGrid client:load seasons={seasonCards} />
          <TodayAcrossVenues client:load venues={venueList} />
        </>
      )}
    </div>
  </AdminLayout>
</BaseLayout>
