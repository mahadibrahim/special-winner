---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { BrandProfileEditor } from '../../../components/admin/branding/BrandProfileEditor';

export const prerender = false;
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const profileId = Astro.params.id!;
---

<BaseLayout title="Brand Profile — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/branding"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <BrandProfileEditor client:load profileId={profileId} />
  </AdminLayout>
</BaseLayout>
