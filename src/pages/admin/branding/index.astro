---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { BrandProfilesList } from '../../../components/admin/branding/BrandProfilesList';

export const prerender = false;
const user = Astro.locals.user!;
---

<BaseLayout title="Branding — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    currentPath="/admin/branding"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <BrandProfilesList client:load />
  </AdminLayout>
</BaseLayout>
