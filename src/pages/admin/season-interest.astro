---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { SeasonInterestList } from '../../components/admin/season-interest-list';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
---

<BaseLayout title="Season Interest — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/season-interest"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <SeasonInterestList client:load />
  </AdminLayout>
</BaseLayout>
