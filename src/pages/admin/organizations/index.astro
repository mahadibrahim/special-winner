---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import OrganizationsList from '../../../components/admin/organizations-list';

// Middleware guarantees user is an admin for /admin routes.
const user = {
  firstName: Astro.locals.user!.firstName,
  lastName: Astro.locals.user!.lastName,
  email: Astro.locals.user!.email,
};
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.roleName ?? "parent";
---

<BaseLayout title="Organizations — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout client:load role={primaryRole} currentPath="/admin/organizations" user={user}>
    <OrganizationsList client:load />
  </AdminLayout>
</BaseLayout>
