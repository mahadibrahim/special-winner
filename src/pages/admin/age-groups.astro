---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../components/admin/admin-layout';
import { AgeGroupsList } from '../../components/admin/age-groups-list';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Age Groups — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    currentPath="/admin/age-groups"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <AgeGroupsList client:load />
  </AdminLayout>
</BaseLayout>
