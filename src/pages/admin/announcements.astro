---
import '../../styles/globals.css';
import { AdminLayout } from '../../components/admin/admin-layout';
import { AnnouncementsList } from '../../components/admin/announcements-list';

// Check if user is admin
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/signin?returnUrl=/admin/announcements');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Announcements - Admin - Aspire Sports</title>
  </head>
  <body>
    <AdminLayout
      client:load
      currentPath="/admin/announcements"
      user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
    >
      <AnnouncementsList client:load />
    </AdminLayout>
  </body>
</html>
