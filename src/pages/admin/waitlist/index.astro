---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { WaitlistManager } from '../../../components/admin/waitlist-manager';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.roleName ?? "parent";
---

<BaseLayout title="Waitlist Management — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/waitlist"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <WaitlistManager client:load />
  </AdminLayout>
</BaseLayout>
