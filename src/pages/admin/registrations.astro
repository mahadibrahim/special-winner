---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { RegistrationsList } from '../../components/admin/registrations-list';

// Auth check handled by middleware
// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
---

<BaseLayout title="Registrations — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/registrations"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <RegistrationsList client:load />
  </AdminLayout>
</BaseLayout>
