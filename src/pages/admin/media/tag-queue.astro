---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { TagQueueList } from '../../../components/media/tag-queue-list';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.roleName ?? "parent";
---

<BaseLayout title="Tag queue — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/media/tag-queue"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <section class="p-6">
      <header class="mb-4">
        <h1 class="text-2xl font-semibold">Tag queue</h1>
        <p class="text-sm text-neutral-600">
          Sessions uploaded and awaiting tagging, oldest first.
        </p>
      </header>
      <TagQueueList client:load />
    </section>
  </AdminLayout>
</BaseLayout>
