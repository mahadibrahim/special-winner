---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../../components/admin/admin-layout';
import { ShootsList } from '../../../../components/media/shoots-list';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Media Shoots — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    currentPath="/admin/media/shoots"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <ShootsList client:load />
  </AdminLayout>
</BaseLayout>
