---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../../components/admin/admin-layout';
import { ShootBulkGrid } from '../../../../components/media/shoot-bulk-grid';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.name ?? "parent";
---

<BaseLayout title="Bulk Weekend — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout client:load role={primaryRole} currentPath="/admin/media/shoots/bulk"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}>
    <ShootBulkGrid client:load />
  </AdminLayout>
</BaseLayout>
