---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../../components/admin/admin-layout';
import { ShootWizard } from '../../../../components/media/shoot-wizard';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
---

<BaseLayout title="New Shoot — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout client:load currentPath="/admin/media/shoots/new"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}>
    <ShootWizard client:load />
  </AdminLayout>
</BaseLayout>
