---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { RosterManager } from '../../../components/admin/roster-manager';
import { TeamBroadcastSection } from '../../../components/admin/team-broadcast-section';
import { TeamGroupManagementSection } from '../../../components/admin/team-group-management-section';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/teams');
}
---

<BaseLayout title="Team Roster — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/teams"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <RosterManager client:load teamId={id} />
    <TeamGroupManagementSection client:load teamId={id} />
    <TeamBroadcastSection client:load teamId={id} />
  </AdminLayout>
</BaseLayout>
