---
import '../../../styles/globals.css';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { RosterManager } from '../../../components/admin/roster-manager';

// Check if user is admin
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/signin?returnUrl=/admin/teams');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/teams');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Team Roster — Admin — Aspire Sports</title>
  </head>
  <body class="bg-cream text-ink antialiased">
    <AdminLayout
      client:load
      currentPath="/admin/teams"
      user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
    >
      <RosterManager client:load teamId={id} />
    </AdminLayout>
  </body>
</html>
