---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { TeamsList } from '../../../components/admin/teams-list';
import { db } from '../../../lib/db';
import { seasons, programs, users, userRoles, roles } from '../../../lib/db/schema';
import { eq, asc } from 'drizzle-orm';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);

// Fetch seasons with programs
let seasonsList: any[] = [];
let coachesList: any[] = [];

try {
  // Three independent lookups — run in parallel. Coaches: single join
  // (users -> userRoles -> roles) instead of the previous 3-hop cascade
  // (role lookup -> userRoles -> users). selectDistinct because a coach can
  // hold multiple `coach` userRoles rows (different scopes) that would
  // otherwise duplicate them.
  const [allSeasons, coachesFromRoles, allUsers] = await Promise.all([
    db
      .select({
        id: seasons.id,
        name: seasons.name,
        program: {
          id: programs.id,
          name: programs.name,
        },
      })
      .from(seasons)
      .leftJoin(programs, eq(seasons.programId, programs.id))
      .orderBy(asc(programs.name), asc(seasons.name)),

    db
      .selectDistinct({
        id: users.id,
        firstName: users.firstName,
        lastName: users.lastName,
        email: users.email,
      })
      .from(users)
      .innerJoin(userRoles, eq(userRoles.userId, users.id))
      .innerJoin(roles, eq(roles.id, userRoles.roleId))
      .where(eq(roles.name, 'coach')),

    // Also include admins as potential coaches
    db
      .select({
        id: users.id,
        firstName: users.firstName,
        lastName: users.lastName,
        email: users.email,
      })
      .from(users)
      .orderBy(asc(users.lastName), asc(users.firstName))
      .limit(100),
  ]);

  seasonsList = allSeasons.map(s => ({
    id: s.id,
    name: s.name,
    program: s.program,
  }));

  coachesList = [...coachesFromRoles];

  // Merge and dedupe
  const seenIds = new Set(coachesList.map(c => c.id));
  for (const u of allUsers) {
    if (!seenIds.has(u.id)) {
      coachesList.push(u);
    }
  }
} catch (error) {
  console.error('Error fetching data:', error);
}
---

<BaseLayout title="Teams — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/teams"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <div class="space-y-3">
      <div class="rounded border border-blue-200 bg-blue-50 p-3 text-sm text-blue-900">
        Cross-season summary. To create or edit teams, open the relevant season's
        <a href="/admin/seasons" class="underline font-medium">Season Hub</a> →
        Teams & rosters tab.
      </div>
      <TeamsList client:load seasons={seasonsList} coaches={coachesList} />
    </div>
  </AdminLayout>
</BaseLayout>
