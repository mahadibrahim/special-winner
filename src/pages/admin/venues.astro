---
import '../../styles/globals.css';
import { AdminLayout } from '../../components/admin/admin-layout';
import { VenuesList } from '../../components/admin/venues-list';
import { db } from '../../lib/db';
import { locations } from '../../lib/db/schema';
import { asc } from 'drizzle-orm';

// Check if user is admin
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/signin?returnUrl=/admin/venues');
}

// Fetch locations for the dropdown
let locationsList: { id: string; name: string }[] = [];
try {
  const allLocations = await db
    .select({ id: locations.id, name: locations.name })
    .from(locations)
    .orderBy(asc(locations.name));
  locationsList = allLocations;
} catch (error) {
  console.error('Error fetching locations:', error);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Venues - Admin - Aspire Sports</title>
  </head>
  <body>
    <AdminLayout
      client:load
      currentPath="/admin/venues"
      user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
    >
      <VenuesList client:load locations={locationsList} />
    </AdminLayout>
  </body>
</html>
