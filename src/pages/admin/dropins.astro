---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import { getPrimaryRoleName } from "@/lib/auth";
import { SessionsList } from "@/components/admin/dropin/SessionsList";
import { RateCardEditor } from "@/components/admin/dropin/RateCardEditor";
import { HostsPanel } from "@/components/admin/dropin/HostsPanel";

export const prerender = false;

const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const timezone = Astro.locals.organization?.timezone ?? "America/New_York";

type Tab = "sessions" | "rate-card" | "hosts";
const tabRaw = Astro.url.searchParams.get("tab");
const tab: Tab =
  tabRaw === "rate-card" ? "rate-card" : tabRaw === "hosts" ? "hosts" : "sessions";

const TABS: { id: Tab; label: string }[] = [
  { id: "sessions", label: "Sessions" },
  { id: "rate-card", label: "Rate card" },
  { id: "hosts", label: "Hosts" },
];
---

<BaseLayout title="Manage Pickup and Hosts — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/dropins"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <div class="space-y-4">
      <h1 class="font-display text-3xl font-semibold text-ink">Manage Pickup and Hosts</h1>
      <div class="border-b border-border flex gap-4 overflow-x-auto">
        {
          TABS.map((t) => (
            <a
              href={t.id === "sessions" ? "/admin/dropins" : `/admin/dropins?tab=${t.id}`}
              class={`py-2 text-sm whitespace-nowrap border-b-2 transition-colors ${
                tab === t.id
                  ? "border-ink text-ink font-semibold"
                  : "border-transparent text-ink-muted hover:text-ink"
              }`}
            >
              {t.label}
            </a>
          ))
        }
      </div>
      {tab === "sessions" && <SessionsList client:load timezone={timezone} />}
      {tab === "rate-card" && <RateCardEditor client:load />}
      {tab === "hosts" && <HostsPanel client:load />}
    </div>
  </AdminLayout>
</BaseLayout>
