---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import { getPrimaryRoleName } from "@/lib/auth";
import { PayrollExport } from "@/components/admin/reports/payroll-export";

export const prerender = false;

const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
---

<BaseLayout title="Payroll export — Reports — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/reports/payroll"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <PayrollExport client:load />
  </AdminLayout>
</BaseLayout>
