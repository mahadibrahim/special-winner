---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import { RegistrationReport } from "@/components/admin/registration-report";

export const prerender = false;

const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.name ?? "parent";
---

<BaseLayout title="Registrations — Reports — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/reports/registrations"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <RegistrationReport client:load />
  </AdminLayout>
</BaseLayout>
