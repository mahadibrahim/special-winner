---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { MerchSyncPanel } from '../../components/admin/merch-sync-panel';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
---

<BaseLayout title="Shop — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/merch"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <div class="mb-6">
      <a
        href="/admin/merch/stores"
        class="inline-flex items-center gap-2 text-sm font-medium text-gray-900 hover:underline"
      >
        Manage stores (team, league, and general storefronts) &rarr;
      </a>
    </div>
    <MerchSyncPanel client:load />
  </AdminLayout>
</BaseLayout>
