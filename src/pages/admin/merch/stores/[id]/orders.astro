---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { MerchStoreOrders } from '../../../../../components/admin/merch-store-orders';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const id = Astro.params.id!;
---

<BaseLayout title="Store orders — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/merch/stores"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <MerchStoreOrders storeId={id} client:load />
  </AdminLayout>
</BaseLayout>
