---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { SkillEditor } from '../../../components/admin/skill-editor';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Skills Management — Aspire Sports Admin" navigation={false} footer={false}>
  <AdminLayout
    client:load
    currentPath="/admin/curriculum"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <SkillEditor client:load />
  </AdminLayout>
</BaseLayout>
