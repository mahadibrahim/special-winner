---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { CurriculumManager } from '../../../components/admin/curriculum-manager';

// Middleware guarantees user is an admin for /admin routes.
const user = Astro.locals.user!;
const primaryRole = (Astro.locals.userRoles ?? [])[0]?.name ?? "parent";
---

<BaseLayout title="Curriculum Management — Aspire Sports Admin" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/curriculum"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <CurriculumManager client:load />
  </AdminLayout>
</BaseLayout>
