---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import { getPrimaryRoleName } from "@/lib/auth";
import { BlockBuilder } from "@/components/admin/rentals/blocks/BlockBuilder";
import { getDb } from "@/lib/db";
import { locations } from "@/lib/db/schema/organizations";
import { venues } from "@/lib/db/schema/teams";
import { and, asc, eq } from "drizzle-orm";

export const prerender = false;

const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const orgId = Astro.locals.organization?.id ?? "";
const timeZone = Astro.locals.organization?.timezone ?? "America/New_York";

// ?internal=1 builds manual ledger holds instead of rentals — same generator,
// no money panels.
const internal = Astro.url.searchParams.get("internal") === "1";

const locationRows = orgId
  ? await getDb()
      .select({ id: locations.id, name: locations.name })
      .from(locations)
      .where(eq(locations.organizationId, orgId))
      .orderBy(asc(locations.name))
  : [];

const venueRows = orgId
  ? await getDb()
      .select({ id: venues.id, name: venues.name, locationId: venues.locationId })
      .from(venues)
      .innerJoin(locations, eq(locations.id, venues.locationId))
      .where(and(eq(locations.organizationId, orgId), eq(venues.rentalEnabled, true)))
      .orderBy(asc(venues.name))
  : [];
---

<BaseLayout
  title={`${internal ? "Reserve Inventory" : "New Rental Block"} — Admin — Aspire Sports`}
  navigation={false}
  footer={false}
>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/rentals"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <div class="space-y-4">
      <div>
        <a
          href="/admin/rentals/blocks"
          class="text-xs uppercase tracking-wider text-ink-muted hover:text-ink"
        >
          ← All blocks
        </a>
        <h1 class="mt-2 text-2xl font-bold text-ink">
          {internal ? "Reserve inventory" : "New rental block"}
        </h1>
        <p class="text-sm text-ink-muted mt-1">
          {
            internal
              ? "Fence prime slots for facility-hosted programming. No renter, no money — the builder surfaces these as conflicts."
              : "Build a recurring multi-month rental in one pass, then take a deposit that holds every session."
          }
        </p>
      </div>
      <BlockBuilder
        client:load
        locations={locationRows}
        venues={venueRows}
        timeZone={timeZone}
        internal={internal}
      />
    </div>
  </AdminLayout>
</BaseLayout>
