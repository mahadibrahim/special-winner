---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import { getPrimaryRoleName } from "@/lib/auth";
import { BlockDetail } from "@/components/admin/rentals/blocks/BlockDetail";

export const prerender = false;

const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const blockId = Astro.params.id!;
const timeZone = Astro.locals.organization?.timezone ?? "America/New_York";
---

<BaseLayout title="Rental Block — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/rentals"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <BlockDetail client:load blockId={blockId} timeZone={timeZone} />
  </AdminLayout>
</BaseLayout>
