---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLayout } from "@/components/admin/admin-layout";
import { getPrimaryRoleName } from "@/lib/auth";
import { RecurringSlotFinder } from "@/components/admin/rentals/RecurringSlotFinder";
import { RentalCalendar } from "@/components/admin/rentals/RentalCalendar";
import { getDb } from "@/lib/db";
import { locations } from "@/lib/db/schema/organizations";
import { asc, eq } from "drizzle-orm";

export const prerender = false;

const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const orgId = Astro.locals.organization?.id ?? "";
const timeZone = Astro.locals.organization?.timezone ?? "America/New_York";

const locationRows = orgId
  ? await getDb()
      .select({ id: locations.id, name: locations.name })
      .from(locations)
      .where(eq(locations.organizationId, orgId))
      .orderBy(asc(locations.name))
  : [];
---

<BaseLayout title="Rental Calendar — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/rentals"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <div class="space-y-6">
      <div>
        <a
          href="/admin/rentals"
          class="text-xs uppercase tracking-wider text-ink-muted hover:text-ink"
        >
          ← Field rentals
        </a>
        <h1 class="mt-2 text-2xl font-bold text-ink">Rental calendar</h1>
        <p class="text-sm text-ink-muted mt-1">
          Inventory across months: confirmed rentals, league games, internal reserves and
          live quotes in one picture. Read-only.
        </p>
      </div>

      {
        locationRows.length === 0 ? (
          <p class="text-sm text-ink-muted">
            No locations on this organization yet.
          </p>
        ) : (
          <>
            <RecurringSlotFinder
              client:load
              locations={locationRows}
              timeZone={timeZone}
            />
            <RentalCalendar client:load locations={locationRows} timeZone={timeZone} />
          </>
        )
      }
    </div>
  </AdminLayout>
</BaseLayout>
