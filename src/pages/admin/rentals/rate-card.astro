---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { RentalRateCardEditor } from '../../../components/admin/rentals/RentalRateCardEditor';

export const prerender = false;
const user = Astro.locals.user!;
---

<BaseLayout title="Rental Rate Card — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    currentPath="/admin/rentals/rate-card"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <RentalRateCardEditor client:load />
  </AdminLayout>
</BaseLayout>
