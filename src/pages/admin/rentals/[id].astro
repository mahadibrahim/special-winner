---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AdminLayout } from '../../../components/admin/admin-layout';
import { getPrimaryRoleName } from "@/lib/auth";
import { RentalDetail } from '../../../components/admin/rentals/RentalDetail';

export const prerender = false;
const user = Astro.locals.user!;
const primaryRole = getPrimaryRoleName(Astro.locals.userRoles);
const rentalId = Astro.params.id!;
---

<BaseLayout title="Rental Detail — Admin — Aspire Sports" navigation={false} footer={false}>
  <AdminLayout
    client:load
    role={primaryRole}
    currentPath="/admin/rentals"
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <RentalDetail client:load rentalId={rentalId} />
  </AdminLayout>
</BaseLayout>
