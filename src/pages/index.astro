---
export const prerender = true;
import '../styles/globals.css';
import Navigation from '../components/navigation';
import HeroSection from '../components/hero-section';
import WhyAspire from '../components/why-aspire';
import StatsSection from '../components/stats-section';
import PartnersSection from '../components/partners-section';
import ProgramsDirectory from '../components/programs-directory';
import Testimonials from '../components/testimonials';
import FAQSection from '../components/faq-section';
import CTABanner from '../components/cta-banner';
import Footer from '../components/footer';
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aspire Sports - Development-focused youth sports programs building character, confidence, and community through athletics in Central Ohio." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Aspire Sports | Youth Sports Programs in Central Ohio</title>
  </head>
  <body class="bg-[#0a0a0f] text-white antialiased">
    <Navigation client:load />
    <main>
      <HeroSection client:load />
      <WhyAspire client:load />
      <StatsSection client:load />
      <PartnersSection client:load />
      <section id="programs">
        <ProgramsDirectory client:load />
      </section>
      <Testimonials client:load />
      <FAQSection client:load />
      <CTABanner client:load />
    </main>
    <Footer client:idle />
  </body>
</html>
