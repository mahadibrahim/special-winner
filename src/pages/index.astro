---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DualCtaHero } from '../components/marketing/dual-cta-hero';
import WhyAspire from '../components/why-aspire';
import StatsSection from '../components/stats-section';
import PartnersSection from '../components/partners-section';
import HomepageProgramsPreview from '../components/homepage-programs-preview';
import Testimonials from '../components/testimonials';
import FAQSection from '../components/faq-section';
import CTABanner from '../components/cta-banner';
---

<BaseLayout
  title="Aspire Sports | Youth Sports Programs in Central Ohio"
  description="Aspire Sports — evidence-based youth sports in Central Ohio. Development-first programs built on the Double-Goal Coach, ELM, and TDEQ-5 frameworks."
>
  <main id="main-content">
    <DualCtaHero client:load />
    <section id="programs">
      <HomepageProgramsPreview client:load />
    </section>
    <WhyAspire client:visible />
    <StatsSection client:visible />
    <Testimonials client:visible />
    <PartnersSection client:visible />
    <FAQSection client:visible />
    <CTABanner client:visible />
  </main>
</BaseLayout>
