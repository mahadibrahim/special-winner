---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
---

<BaseLayout
  title="SoccerOne Powell | Indoor Soccer Leagues, Pickup & Field Rentals"
  description="Powell's premier indoor soccer complex. Adult leagues, youth programs, drop-in pickup, and field rentals. Year-round. One facility. One account."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a1929] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --so-navy: #0a1929;
        --so-navy-2: #0d2035;
        --so-yellow: #facc15;
        --so-yellow-dim: #fde04780;
        --so-teal: #0e7490;
        --so-blue: #0ea5e9;
        --so-white: #ffffff;
        --so-muted: rgba(255,255,255,0.55);
      }
      body { font-family: 'Inter', sans-serif; }
      *, *::before, *::after { box-sizing: border-box; }
    </style>
  </Fragment>

  <SoccerOneHeader />

  <main>
    <!-- ====================================================
         HERO
    ==================================================== -->
    <section class="hero-section" aria-label="Hero">
      <!-- Soccer pitch SVG motif -->
      <div class="hero-pitch-motif" aria-hidden="true">
        <svg viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg" class="pitch-svg">
          <!-- Outer pitch boundary -->
          <rect x="40" y="40" width="720" height="420" rx="4" stroke="rgba(255,255,255,0.07)" stroke-width="2"/>
          <!-- Center circle -->
          <circle cx="400" cy="250" r="80" stroke="rgba(255,255,255,0.07)" stroke-width="2"/>
          <!-- Center spot -->
          <circle cx="400" cy="250" r="4" fill="rgba(255,255,255,0.08)"/>
          <!-- Halfway line -->
          <line x1="400" y1="40" x2="400" y2="460" stroke="rgba(255,255,255,0.07)" stroke-width="2"/>
          <!-- Left penalty area -->
          <rect x="40" y="150" width="120" height="200" stroke="rgba(255,255,255,0.07)" stroke-width="2"/>
          <!-- Left goal area -->
          <rect x="40" y="200" width="50" height="100" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
          <!-- Right penalty area -->
          <rect x="640" y="150" width="120" height="200" stroke="rgba(255,255,255,0.07)" stroke-width="2"/>
          <!-- Right goal area -->
          <rect x="710" y="200" width="50" height="100" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
          <!-- Left penalty arc -->
          <path d="M160,200 A50,50 0 0,1 160,300" stroke="rgba(255,255,255,0.07)" stroke-width="2" fill="none"/>
          <!-- Right penalty arc -->
          <path d="M640,200 A50,50 0 0,0 640,300" stroke="rgba(255,255,255,0.07)" stroke-width="2" fill="none"/>
          <!-- Corner arcs -->
          <path d="M40,60 A20,20 0 0,0 60,40" stroke="rgba(255,255,255,0.05)" stroke-width="1.5" fill="none"/>
          <path d="M740,60 A20,20 0 0,1 760,40" stroke="rgba(255,255,255,0.05)" stroke-width="1.5" fill="none"/>
          <path d="M40,440 A20,20 0 0,1 60,460" stroke="rgba(255,255,255,0.05)" stroke-width="1.5" fill="none"/>
          <path d="M740,440 A20,20 0 0,0 760,460" stroke="rgba(255,255,255,0.05)" stroke-width="1.5" fill="none"/>
        </svg>
      </div>

      <!-- Diagonal accent stripe -->
      <div class="hero-diagonal" aria-hidden="true"></div>

      <div class="hero-content">
        <div class="hero-badge">Powell, Ohio</div>

        <h1 class="hero-headline">
          Indoor soccer<br />in Powell.<br />
          <span class="headline-accent">Year-round.</span>
        </h1>

        <p class="hero-subheadline">
          Adult leagues. Youth programs. Drop-in pickup.<br />
          Field rentals. <strong>One facility. One schedule. One account.</strong>
        </p>

        <div class="hero-ctas">
          <a href="/soccerone#leagues" class="cta-primary">Find a League</a>
          <a href="/soccerone/rent" class="cta-secondary">Rent a Field</a>
        </div>

        <!-- Trust signals -->
        <div class="trust-row">
          <div class="trust-item">
            <span class="trust-stars">★★★★★</span>
            <span class="trust-text">4.8 <span class="trust-dim">(200+ reviews)</span></span>
          </div>
          <span class="trust-divider" aria-hidden="true">·</span>
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="1" y="3" width="14" height="10" rx="2" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
              <line x1="1" y1="7" x2="15" y2="7" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
            </svg>
            <span class="trust-text">8 fields</span>
          </div>
          <span class="trust-divider" aria-hidden="true">·</span>
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
              <polyline points="8,4 8,8 11,10" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span class="trust-text">Open 7am – 11pm</span>
          </div>
          <span class="trust-divider" aria-hidden="true">·</span>
          <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
              <path d="M5 8l2 2 4-3" stroke="rgba(74,222,128,0.8)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="trust-text">Free parking</span>
          </div>
        </div>
      </div>

      <!-- Soccer ball SVG decoration -->
      <div class="hero-ball" aria-hidden="true">
        <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="60" cy="60" r="55" stroke="rgba(255,255,255,0.08)" stroke-width="2"/>
          <circle cx="60" cy="60" r="14" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
          <polygon points="60,5 73,35 105,35 80,55 90,88 60,68 30,88 40,55 15,35 47,35" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </div>
    </section>

    <!-- ====================================================
         WHAT'S AT SOCCERONE — six-tile grid
    ==================================================== -->
    <section class="programs-section" id="leagues" aria-labelledby="programs-heading">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">What's at SoccerOne</span>
          <h2 id="programs-heading" class="section-heading">Everything you need.<br />One facility.</h2>
        </div>

        <div class="programs-grid">
          <!-- Adult Coed League -->
          <a href="/register?sport=soccer&audience=adult" class="program-tile program-tile--featured">
            <div class="tile-icon">
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="18" stroke="#facc15" stroke-width="2"/>
                <polygon points="20,6 23.5,14 32,15 25.5,21 27.5,30 20,25 12.5,30 14.5,21 8,15 16.5,14" fill="rgba(250,204,21,0.25)" stroke="#facc15" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="tile-content">
              <h3 class="tile-heading">Adult Coed League</h3>
              <p class="tile-desc">Co-ed indoor leagues for all skill levels. Spring, summer, fall and winter seasons.</p>
              <span class="tile-cta">Register now →</span>
            </div>
            <div class="tile-badge">Enrolling Now</div>
          </a>

          <!-- Adult Premier League -->
          <div class="program-tile">
            <div class="tile-icon">
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="18" stroke="rgba(14,165,233,0.7)" stroke-width="2"/>
                <path d="M12 20l5 5 11-10" stroke="rgba(14,165,233,0.9)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="tile-content">
              <h3 class="tile-heading">Adult Premier League</h3>
              <p class="tile-desc">Competitive division for experienced players. Higher-level refs, scoreboards, standings.</p>
              <span class="tile-cta">Learn more →</span>
            </div>
          </div>

          <!-- Youth Programs -->
          <a href="/programs?audience=youth" class="program-tile">
            <div class="tile-icon">
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="18" stroke="rgba(74,222,128,0.7)" stroke-width="2"/>
                <circle cx="20" cy="14" r="4" stroke="rgba(74,222,128,0.8)" stroke-width="1.75"/>
                <path d="M12 32c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="rgba(74,222,128,0.8)" stroke-width="1.75" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="tile-content">
              <h3 class="tile-heading">Youth Programs</h3>
              <p class="tile-desc">Ages 5–18. Skills camps, recreational leagues, and elite academy tracks.</p>
              <span class="tile-cta">View programs →</span>
            </div>
          </a>

          <!-- Drop-In Pickup -->
          <a href="/soccerone/pickup" class="program-tile">
            <div class="tile-icon">
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="18" stroke="rgba(251,191,36,0.7)" stroke-width="2"/>
                <path d="M14 20h12M20 14l6 6-6 6" stroke="rgba(251,191,36,0.9)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="tile-content">
              <h3 class="tile-heading">Drop-In Pickup</h3>
              <p class="tile-desc">Show up and play. No teams, no commitment — just great soccer seven days a week.</p>
              <span class="tile-cta">See today's games →</span>
            </div>
          </a>

          <!-- Field Rentals -->
          <a href="/soccerone/rent" class="program-tile">
            <div class="tile-icon">
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="18" stroke="rgba(167,139,250,0.7)" stroke-width="2"/>
                <rect x="10" y="13" width="20" height="14" rx="2" stroke="rgba(167,139,250,0.8)" stroke-width="1.75"/>
                <line x1="20" y1="13" x2="20" y2="27" stroke="rgba(167,139,250,0.6)" stroke-width="1.25"/>
                <line x1="10" y1="20" x2="30" y2="20" stroke="rgba(167,139,250,0.6)" stroke-width="1.25"/>
              </svg>
            </div>
            <div class="tile-content">
              <h3 class="tile-heading">Field Rentals</h3>
              <p class="tile-desc">Hourly field reservations for private training, corporate events, and birthday parties.</p>
              <span class="tile-cta">Book a field →</span>
            </div>
          </a>

          <!-- Birthday Parties -->
          <div class="program-tile" id="birthday">
            <div class="tile-icon">
              <svg viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="18" stroke="rgba(251,113,133,0.7)" stroke-width="2"/>
                <path d="M12 30c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="rgba(251,113,133,0.8)" stroke-width="1.75" stroke-linecap="round"/>
                <path d="M16 16c0-2 1.5-4 4-4s4 2 4 4" stroke="rgba(251,113,133,0.7)" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="20" cy="12" r="1.5" fill="rgba(251,113,133,0.8)"/>
              </svg>
            </div>
            <div class="tile-content">
              <h3 class="tile-heading">Birthday Parties</h3>
              <p class="tile-desc">Private field rental + party room package. Full catering options available.</p>
              <span class="tile-cta">Inquire →</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================
         THIS WEEK'S SCHEDULE STRIP
    ==================================================== -->
    <section class="schedule-section" aria-labelledby="schedule-heading">
      <div class="section-container">
        <div class="schedule-header">
          <h2 id="schedule-heading" class="section-heading-sm">This Week at SoccerOne</h2>
          <a href="/soccerone/pickup" class="view-all-link">View full schedule →</a>
        </div>

        <div class="schedule-strip">
          <div class="schedule-card schedule-card--live">
            <div class="schedule-card-type">LIVE NOW</div>
            <div class="schedule-card-name">Coed Pickup</div>
            <div class="schedule-card-time">Now – 9:00 PM · Field 3</div>
            <div class="schedule-card-spots">
              <span class="spots-dot spots-dot--few"></span>3 spots left
            </div>
          </div>

          <div class="schedule-card">
            <div class="schedule-card-type schedule-card-type--league">LEAGUE</div>
            <div class="schedule-card-name">Adult Coed — Game Night</div>
            <div class="schedule-card-time">Tonight 7:00 PM · Field 1 &amp; 2</div>
            <div class="schedule-card-spots">
              <span class="spots-dot"></span>Spectators welcome
            </div>
          </div>

          <div class="schedule-card">
            <div class="schedule-card-type">PICKUP</div>
            <div class="schedule-card-name">Beginner Pickup</div>
            <div class="schedule-card-time">Wed Apr 29 · 6:30 PM · Field 5</div>
            <div class="schedule-card-spots">
              <span class="spots-dot"></span>8 spots left
            </div>
          </div>

          <div class="schedule-card">
            <div class="schedule-card-type">PICKUP</div>
            <div class="schedule-card-name">Competitive Pickup</div>
            <div class="schedule-card-time">Thu Apr 30 · 7:00 PM · Field 4</div>
            <div class="schedule-card-spots">
              <span class="spots-dot spots-dot--few"></span>2 spots left
            </div>
          </div>

          <div class="schedule-card">
            <div class="schedule-card-type schedule-card-type--youth">YOUTH</div>
            <div class="schedule-card-name">U12 Skills Clinic</div>
            <div class="schedule-card-time">Sat May 2 · 10:00 AM · Field 6</div>
            <div class="schedule-card-spots">
              <span class="spots-dot"></span>6 spots left
            </div>
          </div>

          <div class="schedule-card">
            <div class="schedule-card-type schedule-card-type--league">LEAGUE</div>
            <div class="schedule-card-name">Premier League — Semifinal</div>
            <div class="schedule-card-time">Sat May 2 · 8:00 PM · Field 1</div>
            <div class="schedule-card-spots">
              <span class="spots-dot"></span>Spectators welcome
            </div>
          </div>

          <div class="schedule-card">
            <div class="schedule-card-type">PICKUP</div>
            <div class="schedule-card-name">Sunday Morning Pickup</div>
            <div class="schedule-card-time">Sun May 3 · 8:00 AM · Field 2</div>
            <div class="schedule-card-spots">
              <span class="spots-dot"></span>10 spots left
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================
         MEMBERSHIPS CALLOUT
    ==================================================== -->
    <section class="memberships-section" aria-labelledby="memberships-heading">
      <div class="section-container">
        <div class="memberships-header">
          <span class="section-eyebrow">Memberships</span>
          <h2 id="memberships-heading" class="section-heading">Play more. Pay less.</h2>
          <p class="memberships-subhead">Members get discounted hourly rates, priority league registration, and exclusive pickup access.</p>
        </div>

        <div class="memberships-grid">
          <!-- Day Pass -->
          <div class="membership-card">
            <div class="membership-card-header">
              <h3 class="mc-name">Day Pass</h3>
              <div class="mc-price-row">
                <span class="mc-price">$15</span>
                <span class="mc-period">/visit</span>
              </div>
            </div>
            <ul class="mc-benefits">
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                Full facility access
              </li>
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                Join any open pickup
              </li>
              <li class="mc-benefit mc-benefit--no">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(148,163,184,0.3)"/><path d="M5.5 10.5l5-5M5.5 5.5l5 5" stroke="rgba(148,163,184,0.5)" stroke-width="1.5" stroke-linecap="round"/></svg>
                Member rental discount
              </li>
              <li class="mc-benefit mc-benefit--no">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(148,163,184,0.3)"/><path d="M5.5 10.5l5-5M5.5 5.5l5 5" stroke="rgba(148,163,184,0.5)" stroke-width="1.5" stroke-linecap="round"/></svg>
                Priority league signup
              </li>
              <li class="mc-benefit mc-benefit--no">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(148,163,184,0.3)"/><path d="M5.5 10.5l5-5M5.5 5.5l5 5" stroke="rgba(148,163,184,0.5)" stroke-width="1.5" stroke-linecap="round"/></svg>
                Guest passes
              </li>
            </ul>
            <a href="/soccerone/memberships" class="mc-cta mc-cta--outline">Buy Day Pass</a>
          </div>

          <!-- Member -->
          <div class="membership-card membership-card--featured">
            <div class="mc-popular-badge">Most Popular</div>
            <div class="membership-card-header">
              <h3 class="mc-name">Member</h3>
              <div class="mc-price-row">
                <span class="mc-price">$29</span>
                <span class="mc-period">/mo</span>
              </div>
              <div class="mc-annual-note">or $290/yr — save 17%</div>
            </div>
            <ul class="mc-benefits">
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                Full facility access
              </li>
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                Join any open pickup
              </li>
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                10% off hourly rentals
              </li>
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                Priority league signup
              </li>
              <li class="mc-benefit mc-benefit--no">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(148,163,184,0.3)"/><path d="M5.5 10.5l5-5M5.5 5.5l5 5" stroke="rgba(148,163,184,0.5)" stroke-width="1.5" stroke-linecap="round"/></svg>
                Guest passes
              </li>
            </ul>
            <a href="/soccerone/memberships" class="mc-cta mc-cta--primary">Join as Member</a>
          </div>

          <!-- Founder -->
          <div class="membership-card membership-card--founder">
            <div class="membership-card-header">
              <h3 class="mc-name">Founder</h3>
              <div class="mc-price-row">
                <span class="mc-price">$99</span>
                <span class="mc-period">/mo</span>
              </div>
              <div class="mc-annual-note">or $990/yr — save 17%</div>
            </div>
            <ul class="mc-benefits">
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                Full facility access
              </li>
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                Unlimited pickup
              </li>
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                20% off hourly rentals
              </li>
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                Priority league signup
              </li>
              <li class="mc-benefit mc-benefit--yes">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><circle cx="8" cy="8" r="7.5" stroke="rgba(250,204,21,0.5)"/><path d="M5 8l2 2 4-3.5" stroke="#facc15" stroke-width="1.5" stroke-linecap="round"/></svg>
                2 guest passes/month
              </li>
