    .about-big-label {
      font-family: var(--so-font-mono);
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--so-lime-a40);
      margin-bottom: 2rem;
    }

    .about-dot-grid {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 8px;
      width: 100%;
      max-width: 300px;
    }

    .dot-cell {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--so-lime-a12);
    }
    .dot-cell:nth-child(3n+1) { background: var(--so-lime-a20); }
    .dot-cell:nth-child(7n+2) { background: var(--so-lime-a08); }

    /* ---- CONTACT BAR ---- */
    .contact-bar {
      background: var(--so-surface);
      border-top: 1px solid var(--border);
      padding: 3rem 0;
    }

    .contact-bar-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .contact-location { flex: 1; min-width: 200px; }

    .contact-name {
      font-family: var(--so-font-display);
      font-size: 1.375rem;
      color: #ffffff;
      letter-spacing: 0.01em;
      margin-bottom: 0.375rem;
    }
    .contact-addr { font-size: 0.9375rem; color: var(--muted); margin-bottom: 0.25rem; }
    .contact-hours {
      font-family: var(--so-font-mono);
      font-size: 0.75rem;
      color: var(--so-lime-a60);
      letter-spacing: 0.04em;
    }

    .contact-divider {
      width: 1px;
      height: 60px;
      background: var(--border);
      flex-shrink: 0;
    }

    .contact-action {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
      flex-shrink: 0;
    }

    .contact-email {
      font-size: 0.9375rem;
      color: var(--so-lime-a70);
      text-decoration: none;
      transition: color 0.15s;
    }
    .contact-email:hover { color: var(--so-lime); }

    .contact-book-btn {
      display: inline-block;
      background: var(--so-lime);
      color: var(--so-ink);
      font-family: var(--so-font-body);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.625rem 1.375rem;
      border-radius: var(--so-radius-sm);
      transition: background 0.15s;
    }
    .contact-book-btn:hover { background: var(--so-lime-bright); }

    /* ---- RESPONSIVE ---- */
    @media (max-width: 1100px) {
      .play-grid { grid-template-columns: repeat(2, 1fr); }
      .mem-callout-inner { grid-template-columns: 1fr; gap: 3rem; }
      .about-inner { grid-template-columns: 1fr; gap: 3rem; }
      .about-visual-col { order: -1; }
    }

    @media (max-width: 768px) {
      .hero { min-height: 85vh; }
      .hero-content { padding: 0 1.5rem 3rem; }
      .hero-actions { grid-template-columns: 1fr; }
      .season-name { padding-right: 0; margin-top: 1.5rem; }
      .futsal-title { padding-right: 0; margin-top: 1.5rem; }
      .play-grid { grid-template-columns: 1fr; }
      .cta-band-inner { flex-direction: column; align-items: flex-start; }
      .cta-band-right { align-items: flex-start; }
      .contact-bar-inner { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
      .contact-divider { display: none; }
      .contact-action { align-items: flex-start; }
    }

    @media (max-width: 375px) {
      .hero-line-1, .hero-line-2 { font-size: 4.5rem; }
    }
  </style>

  <script>
    // Intersection observer for staggered card reveals
    const cards = document.querySelectorAll('.play-card, .mem-card, .review-card');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            (entry.target as HTMLElement).style.opacity = '1';
            (entry.target as HTMLElement).style.transform = 'translateY(0)';
          }, i * 80);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    cards.forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(20px)';
      (card as HTMLElement).style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      obs.observe(card);
    });
  </script>

  <script>
    import { trackDivisionRegisterClicked } from "@/lib/analytics/events";

    // Conversion analytics on the server-rendered register CTAs (hero season
    // card + fall CTA band).
    document.querySelectorAll<HTMLAnchorElement>("[data-so-register-cta]").forEach((el) => {
      el.addEventListener("click", () => {
        trackDivisionRegisterClicked({
          seasonId: el.dataset.seasonId ?? "",
          level: el.dataset.level ?? "open",
          gender: el.dataset.gender ?? "unknown",
          venue: el.dataset.venue ?? "",
          mode: el.dataset.mode === "team" ? "team" : "individual",
          term: el.dataset.term ?? "",
        });
      });
    });
  </script>
</BaseLayout>
