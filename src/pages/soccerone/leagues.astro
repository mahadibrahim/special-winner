<script>
  import { trackDivisionRegisterClicked, trackLandingTabViewed } from "@/lib/analytics/events";

  // Tab switching (round 2 — Aspire anatomy). Panes are all server-rendered;
  // this only flips `hidden` + aria-selected, so crawlers and no-JS readers
  // see every pane's content.
  const lgTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-lg-tab]"));
  const lgPanes = Array.from(document.querySelectorAll<HTMLElement>("[data-lg-pane]"));
  function lgShow(key: string) {
    lgTabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.lgTab === key)));
    lgPanes.forEach((p) => { p.hidden = p.dataset.lgPane !== key; });
    trackLandingTabViewed({ sport: "soccer", tab: key });
  }
  lgTabs.forEach((t) => t.addEventListener("click", () => lgShow(t.dataset.lgTab ?? "")));
  document.querySelectorAll<HTMLButtonElement>("[data-lg-jump]").forEach((el) => {
    el.addEventListener("click", () => {
      lgShow(el.dataset.lgJump ?? "");
      document.querySelector(".lg-tabbar")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
  // Initial-view event (server decided the starting tab).
  const lgInitial = lgTabs.find((t) => t.getAttribute("aria-selected") === "true");
  if (lgInitial) trackLandingTabViewed({ sport: "soccer", tab: lgInitial.dataset.lgTab ?? "" });

  // Conversion analytics on the server-rendered register CTAs (featured
  // banner + bottom band). The finder cards track from React directly.
  document.querySelectorAll<HTMLAnchorElement>("[data-so-register-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      trackDivisionRegisterClicked({
        seasonId: el.dataset.seasonId ?? "",
        level: el.dataset.level ?? "open",
        gender: el.dataset.gender ?? "unknown",
        venue: el.dataset.venue ?? "",
        mode: el.dataset.mode === "team" ? "team" : "individual",
        term: el.dataset.term ?? "",
      });
    });
  });
</script>
