---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import SoccerOneLeaguesFinder from '@/components/soccerone/SoccerOneLeaguesFinder';
import SoccerOneLeagueLevels from '@/components/soccerone/SoccerOneLeagueLevels.astro';
import { breadcrumbJsonLd } from '@/lib/seo/breadcrumbs';
import { seasonsToSportsEvents } from '@/lib/seo/events';

// Phase 2 — fetch live SoccerOne seasons via the tenant-scoped public API.
// The endpoint is org-scoped from Phase 0 (reads Astro.locals.organization),
// so this page sees only SoccerOne seasons when rendered in SoccerOne context.
// Fetch ALL seasons for the requested audience (no location filter) so the
// client-side finder can filter across all locations.
const audience = Astro.url.searchParams.get('audience') === 'youth' ? 'youth' : 'adult';
let seasons: any[] = [];
try {
  const url = new URL('/api/public/seasons', Astro.url);
  url.searchParams.set('audience', audience);
  // Dev-only guard: Astro.url reconstructs from the forwarded Host header,
  // so a port-less Host (e.g. `curl -H "Host: soccerone.localhost"`) yields
  // port 80 and the self-fetch misses the dev server. Pin the dev port.
  // Do NOT rewrite the hostname to localhost: undici silently drops an
  // explicit Host header (forbidden fetch header), so the tenant must stay
  // in the URL or org resolution falls back to the default org.
  if (url.hostname.endsWith('.localhost') && !url.port) url.port = '4321';
  const res = await fetch(url, {
    headers: { Host: Astro.request.headers.get('host') ?? '' },
  });
  if (res.ok) {
    const body = await res.json();
    seasons = body.seasons ?? [];
  }
} catch (err) {
  console.error('[soccerone/leagues] failed to load seasons', err);
}

// Phase 1: this hand-rolled SoccerOne template only renders a "Register Now"
// CTA, so exclude `forming` (interest-only) seasons — otherwise they'd show a
// register button for a season that isn't open yet. Forming seasons surface on
// the main Aspire catalog (program-card-v2 renders the interest form). Phase 2
// adds an interest CTA to this template.
seasons = seasons.filter((s) => s.signupMode !== 'interest');

// A season whose start date has passed is no longer a "Register & Pay"
// candidate — a stale "NOW REGISTERING" banner over a finished tournament is
// worse than no banner. Date-only compare (season startDate is YYYY-MM-DD) so
// a season starting today stays visible through its start day.
const todayIso = new Date().toISOString().slice(0, 10);
seasons = seasons.filter((s) => !s.startDate || String(s.startDate).slice(0, 10) >= todayIso);

// SportsEvent JSON-LD for the seasons visible on this page (post-filter, so
// forming/interest and past-start seasons never get an event marker).
const eventSchema = seasonsToSportsEvents(seasons, 'https://www.gosoccerone.com');

// Featured season = first upcoming open season (the API already sorts by
// startDate). All featured-CTA copy derives from it; the block renders only
// when one exists — no more hardcoded season names/dates/prices over a dead
// button.
const featured = seasons[0] ?? null;
const firstSeasonId = featured?.id ?? null;
const featuredStart = featured?.startDate
  ? new Date(featured.startDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
const featuredPrice = featured
  ? (featured.teamPrice
      ? `$${featured.price}/player · $${featured.teamPrice}/team`
      : `$${featured.price}/player`)
  : null;
import { setMarketingEdgeCache } from '@/lib/http/edge-cache';
setMarketingEdgeCache(Astro);

const SO = 'https://www.gosoccerone.com';
const breadcrumbSchema = breadcrumbJsonLd([
  { name: 'SoccerOne', url: `${SO}/` },
  { name: 'Leagues', url: `${SO}/leagues` },
]);
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title={audience === 'youth' ? 'Youth Leagues — SoccerOne' : 'Leagues — SoccerOne'}
  description={audience === 'youth'
    ? 'Youth indoor soccer leagues at SoccerOne Columbus — Worthington and Downtown. Register now for the upcoming season.'
    : 'Adult coed, premier, and corporate indoor soccer leagues at SoccerOne Columbus. Worthington and Downtown. Register now for the upcoming season.'}
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    {eventSchema.length > 0 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(eventSchema)} />
    )}
  </Fragment>

  <SoccerOneHeader />

  <main class="leagues-main">

    <!-- Page header -->
    <div class="leagues-header">
      <div class="lh-inner">
        <div class="lh-top">
          <div class="lh-text">
            <h1 class="lh-title">{audience === 'youth' ? 'YOUTH LEAGUES' : 'LEAGUES'}</h1>
            <p class="lh-desc">
              {audience === 'youth'
                ? 'Youth indoor soccer leagues and academies across both locations.'
                : 'Competitive indoor soccer, season by season. Adult Coed, Premier, Women\'s, and Corporate divisions across both locations.'}
            </p>
          </div>
          <div class="lh-stats">
            <div class="lhs-item">
              <span class="lhs-num">4</span>
              <span class="lhs-label">Indoor fields</span>
            </div>
            <div class="lhs-div" aria-hidden="true"></div>
            <div class="lhs-item">
              <span class="lhs-num">2</span>
              <span class="lhs-label">Locations</span>
            </div>
            <div class="lhs-div" aria-hidden="true"></div>
            <div class="lhs-item">
              <span class="lhs-num">4PM</span>
              <span class="lhs-label">Open daily</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Leagues listing -->
    <div class="leagues-section">
      <div class="leagues-inner">

        <!-- REGISTRATION CTA — featured row. Data-driven from the first
             open season; hidden entirely when the catalog is empty so we
             never show a dead pay button over the empty state. -->
        {featured && (
          <div class="leagues-featured-cta">
            <div class="lfcta-left">
              <span class="lfcta-eyebrow">NOW REGISTERING</span>
              <h2 class="lfcta-title">{featured.name}</h2>
              <div class="lfcta-meta">
                {featuredStart && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="rgba(163,230,53,0.5)" stroke-width="1.2"/><path d="M7 4v3l2 2" stroke="rgba(163,230,53,0.7)" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Starts {featuredStart}
                  </span>
                )}
                {featured.scheduleNotes && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="3" width="12" height="10" rx="1.5" stroke="rgba(163,230,53,0.5)" stroke-width="1.2"/><line x1="1" y1="6" x2="13" y2="6" stroke="rgba(163,230,53,0.3)" stroke-width="1"/></svg>
                    {featured.scheduleNotes}
                  </span>
                )}
                {featured.location?.name && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1L8.5 5H13L9.5 7.5 11 12 7 9.5 3 12 4.5 7.5 1 5H5.5z" stroke="rgba(163,230,53,0.5)" stroke-width="1.1" fill="none"/></svg>
                    {featured.location.name}
                  </span>
                )}
                {featuredPrice && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M4 7h6M7 4l3 3-3 3" stroke="rgba(163,230,53,0.5)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {featuredPrice}
                  </span>
                )}
              </div>
            </div>
            <div class="lfcta-right">
              <a
                href={`/register/${featured.id}`}
                class="lfcta-btn"
                data-so-register-cta
                data-season-id={featured.id}
                data-level={featured.skillLevel ?? 'open'}
                data-gender={featured.divisionGender ?? 'unknown'}
                data-venue={featured.location?.slug ?? ''}
                data-term={featured.termSlug ?? ''}
                data-mode={featured.signupModes?.includes('team') ? 'team' : 'individual'}
              >
                Register &amp; Pay Now
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <span class="lfcta-note">Secure checkout via Aspire Sports</span>
            </div>
          </div>
        )}

        <SoccerOneLeagueLevels />
        <SoccerOneLeaguesFinder client:load seasons={seasons} />
      </div>
    </div>

    <!-- Bottom CTA — only when there is a season to register for; dead
         '#' buttons are worse than no banner. -->
    {firstSeasonId && (
    <div class="leagues-bottom-cta">
      <div class="lbc-inner">
        <div class="lbc-text">
          <span class="lbc-label">HAVE A TEAM?</span>
          <h2 class="lbc-title">Register your team directly. No middleman.</h2>
        </div>
        <div class="lbc-buttons">
          <a
            href={`/register/${firstSeasonId}`}
            class="lbc-btn-primary"
            data-so-register-cta
            data-season-id={firstSeasonId}
            data-level={featured?.skillLevel ?? 'open'}
            data-gender={featured?.divisionGender ?? 'unknown'}
            data-venue={featured?.location?.slug ?? ''}
            data-term={featured?.termSlug ?? ''}
            data-mode="team"
          >Register a Team</a>
          <a
            href={`/register/${firstSeasonId}`}
            class="lbc-btn-secondary"
            data-so-register-cta
            data-season-id={firstSeasonId}
            data-level={featured?.skillLevel ?? 'open'}
            data-gender={featured?.divisionGender ?? 'unknown'}
            data-venue={featured?.location?.slug ?? ''}
            data-term={featured?.termSlug ?? ''}
            data-mode="individual"
          >Register as Individual</a>
        </div>
      </div>
    </div>
    )}

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }
    .accent { color: var(--so-lime); }

    .leagues-main { flex: 1; font-family: var(--so-font-body); }

    /* ---- HEADER ---- */
    .leagues-header {
      background: var(--so-ink);
      border-bottom: 1px solid var(--so-lime-a10);
      padding: 4rem 0 0;
    }
    .lh-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    .lh-top {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }

    .lh-title {
      font-family: var(--so-font-display);
      font-size: clamp(4rem, 10vw, 9rem);
      color: #ffffff;
      line-height: 0.9;
      letter-spacing: 0.01em;
      margin-bottom: 1rem;
    }

    .lh-desc {
      font-size: 1.0625rem;
      color: var(--muted);
      line-height: 1.6;
      max-width: 500px;
    }

    .lh-stats {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      background: var(--so-lime-a04);
      border: 1px solid var(--so-lime-a15);
      border-radius: var(--so-radius-md);
      padding: 1.25rem 1.75rem;
      flex-shrink: 0;
    }
    .lhs-item { display: flex; flex-direction: column; gap: 2px; text-align: center; }
    .lhs-num { font-family: var(--so-font-display); font-size: 2.25rem; color: var(--so-lime); letter-spacing: 0.02em; line-height: 1; }
    .lhs-label { font-family: var(--so-font-mono); font-size: 0.5rem; font-weight: 600; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); }
    .lhs-div { width: 1px; height: 40px; background: rgba(255,255,255,0.08); }

    /* ---- LEAGUES SECTION ---- */
    .leagues-section { background: var(--bg); padding: 4rem 0; }
    .leagues-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    /* Featured CTA */
    .leagues-featured-cta {
      background: var(--so-lime-a06);
      border: 1px solid var(--so-lime-a25);
      border-radius: var(--so-radius-lg);
      padding: 1.75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }

    .lfcta-eyebrow {
      display: block;
      font-family: var(--so-font-mono);
      font-size: 0.5625rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--so-lime);
      margin-bottom: 0.5rem;
    }

    .lfcta-title {
      font-family: var(--so-font-display);
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      color: #ffffff;
      letter-spacing: 0.01em;
      margin-bottom: 0.875rem;
    }

    .lfcta-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
    }
    .lm-item {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.875rem;
      color: rgba(255,255,255,0.55);
    }

    .lfcta-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .lfcta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      background: var(--so-lime);
      color: var(--so-ink);
      font-family: var(--so-font-body);
      font-size: 0.9375rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration: none;
      padding: 0.875rem 1.75rem;
      border-radius: var(--so-radius-sm);
      transition: background 0.15s;
      white-space: nowrap;
    }
    .lfcta-btn:hover { background: var(--so-lime-bright); }
    .lfcta-note { font-size: 0.75rem; color: rgba(255,255,255,0.3); }

    /* ---- BOTTOM CTA ---- */
    .leagues-bottom-cta {
      background: var(--so-lime);
      padding: 3rem 0;
    }
    .lbc-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .lbc-label { font-family: var(--so-font-mono); font-size: 0.5625rem; font-weight: 600; letter-spacing: 0.14em; color: rgba(10,10,13,0.5); display: block; margin-bottom: 0.375rem; }
    .lbc-title { font-family: var(--so-font-display); font-size: clamp(1.5rem, 3vw, 2.25rem); color: var(--so-ink); letter-spacing: 0.01em; }
    .lbc-buttons { display: flex; gap: 0.875rem; flex-wrap: wrap; flex-shrink: 0; }
    .lbc-btn-primary { display: inline-block; background: var(--so-ink); color: var(--so-lime); font-family: var(--so-font-body); font-size: 0.875rem; font-weight: 700; letter-spacing: 0.04em; text-decoration: none; padding: 0.875rem 1.5rem; border-radius: var(--so-radius-sm); transition: background 0.15s; white-space: nowrap; }
    .lbc-btn-primary:hover { background: #1a1a1e; }
    .lbc-btn-secondary { display: inline-block; background: rgba(10,10,13,0.1); color: var(--so-ink); font-family: var(--so-font-body); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; text-decoration: none; padding: 0.875rem 1.5rem; border-radius: var(--so-radius-sm); border: 1px solid rgba(10,10,13,0.25); transition: background 0.15s; white-space: nowrap; }
    .lbc-btn-secondary:hover { background: rgba(10,10,13,0.18); }

    @media (max-width: 768px) {
      .lh-top { flex-direction: column; align-items: flex-start; }
      .leagues-featured-cta { flex-direction: column; align-items: flex-start; }
      .lfcta-right { align-items: flex-start; }
      .lbc-inner { flex-direction: column; align-items: flex-start; }
    }
  </style>


</BaseLayout>

<script>
  import { trackDivisionRegisterClicked } from "@/lib/analytics/events";

  // Conversion analytics on the server-rendered register CTAs (featured
  // banner + bottom band). The finder cards track from React directly.
  document.querySelectorAll<HTMLAnchorElement>("[data-so-register-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      trackDivisionRegisterClicked({
        seasonId: el.dataset.seasonId ?? "",
        level: el.dataset.level ?? "open",
        gender: el.dataset.gender ?? "unknown",
        venue: el.dataset.venue ?? "",
        mode: el.dataset.mode === "team" ? "team" : "individual",
        term: el.dataset.term ?? "",
      });
    });
  });
</script>
