---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import SoccerOneLeaguesFinder from '@/components/soccerone/SoccerOneLeaguesFinder';
import SoccerOneInterestCapture from '@/components/soccerone/SoccerOneInterestCapture';
import { breadcrumbJsonLd } from '@/lib/seo/breadcrumbs';
import { seasonsToSportsEvents } from '@/lib/seo/events';
import { partitionTerms, type TermSeason } from '@/lib/leagues/terms';
import { aggregateFeaturedTerm } from '@/lib/soccerone/featured-term';
import { WHY_INDOOR, RULE_SECTIONS } from '@/lib/leagues/adult-soccer-content';

// Phase 2 — fetch live SoccerOne seasons via the tenant-scoped public API.
// The endpoint is org-scoped from Phase 0 (reads Astro.locals.organization),
// so this page sees only SoccerOne seasons when rendered in SoccerOne context.
// Fetch ALL seasons for the requested audience (no location filter) so the
// client-side finder can filter across all locations.
const audience = Astro.url.searchParams.get('audience') === 'youth' ? 'youth' : 'adult';
let seasons: any[] = [];
try {
  const url = new URL('/api/public/seasons', Astro.url);
  url.searchParams.set('audience', audience);
  // Dev-only guard: Astro.url reconstructs from the forwarded Host header,
  // so a port-less Host (e.g. `curl -H "Host: soccerone.localhost"`) yields
  // port 80 and the self-fetch misses the dev server. Pin the dev port.
  // Do NOT rewrite the hostname to localhost: undici silently drops an
  // explicit Host header (forbidden fetch header), so the tenant must stay
  // in the URL or org resolution falls back to the default org.
  if (url.hostname.endsWith('.localhost') && !url.port) url.port = '4321';
  const res = await fetch(url, {
    headers: { Host: Astro.request.headers.get('host') ?? '' },
  });
  if (res.ok) {
    const body = await res.json();
    seasons = body.seasons ?? [];
  }
} catch (err) {
  console.error('[soccerone/leagues] failed to load seasons', err);
}

// Forming (interest-only) seasons now render on this template: the finder
// card shows a "Notify me" interest capture instead of a register button
// (SoccerOneInterestCapture — the Phase 2 the old comment here promised).
// They stay OUT of the featured/bottom register CTAs below, which must only
// ever point at a season that can actually take money.

// A season whose start date has passed is no longer a "Register & Pay"
// candidate — a stale "NOW REGISTERING" banner over a finished tournament is
// worse than no banner. Date-only compare (season startDate is YYYY-MM-DD) so
// a season starting today stays visible through its start day.
const todayIso = new Date().toISOString().slice(0, 10);
seasons = seasons.filter((s) => !s.startDate || String(s.startDate).slice(0, 10) >= todayIso);

// Registerable = seasons that can actually take money right now. Forming
// (interest-only) seasons are in `seasons` for the finder — their card shows
// a "Notify me" capture — but they must never drive a register CTA or an
// event marker.
const registerable = seasons.filter((s) => s.signupMode !== 'interest');

// SportsEvent JSON-LD only for registerable seasons (unchanged behaviour:
// forming/interest and past-start seasons never get an event marker).
const eventSchema = seasonsToSportsEvents(registerable, 'https://www.gosoccerone.com');

// Featured season = first upcoming registerable season (the API already sorts
// by startDate). "Register & Pay Now" over an interest-only season is a lie.
// The block renders only when one exists — no more hardcoded season
// names/dates/prices over a dead button.
const featured = registerable[0] ?? null;

// Season tier: partitionTerms is the shared brand-neutral term model — it
// deliberately refuses to call a forming term "current", so the featured
// banner's term link and the Upcoming band below inherit Aspire's
// banner-never-lies guardrail for free.
const termSeasons: TermSeason[] = seasons
  .filter((s) => s.termSlug)
  .map((s) => ({ id: s.id, termSlug: s.termSlug, termLabel: s.termLabel, status: s.status, startDate: s.startDate }));
// Completed seasons feed ONLY the Past tab's term list — never the finder.
let completedSeasons: any[] = [];
try {
  const doneUrl = new URL('/api/public/seasons', Astro.url);
  doneUrl.searchParams.set('audience', audience);
  doneUrl.searchParams.set('status', 'completed');
  if (doneUrl.hostname.endsWith('.localhost') && !doneUrl.port) doneUrl.port = '4321';
  const doneRes = await fetch(doneUrl, { headers: { Host: Astro.request.headers.get('host') ?? '' } });
  if (doneRes.ok) completedSeasons = (await doneRes.json()).seasons ?? [];
} catch { /* Past tab degrades to its empty-state promise */ }

const allTermSeasons: TermSeason[] = [...termSeasons, ...completedSeasons
  .filter((s: any) => s.termSlug)
  .map((s: any) => ({ id: s.id, termSlug: s.termSlug, termLabel: s.termLabel, status: s.status, startDate: s.startDate }))];
const { current: currentTerm, upcoming: upcomingTerms, past: pastTerms } = partitionTerms(allTermSeasons);

// This Season excludes seasons that belong to an UPCOMING term — those are
// sold as term cards in the Upcoming tab. Before this scoping the forming
// winter/spring seasons leaked into the finder as ~50 "Notify me" cards
// drowning the 13 registerable fall ones. Scoped by exclusion (not
// "current term only") so a second open/active term — e.g. spring still
// running while fall opens — can never silently vanish from the catalog.
const upcomingSlugs = new Set(upcomingTerms.map((t) => t.slug));
const thisSeasonSeasons = seasons.filter(
  (s) => !s.termSlug || !upcomingSlugs.has(s.termSlug),
);

// Banner sells the TERM when it has 2+ registerable divisions — the same
// aggregation the homepage hero uses (featured-term.ts exists because a
// tiebreak once advertised "Co-Ed D" as the flagship; a single arbitrary
// division as the page headline is that bug again).
const termAgg = aggregateFeaturedTerm(registerable);
const fmtShort = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : null;

// Aspire-anatomy tabs (round 2). All panes are server-rendered and toggled
// via `hidden` — crawlers see every pane's copy regardless of tab state
// (deliberately better than Aspire's conditional-mount tabs). Initial tab is
// server-decided: a ?location= deep link (venue pages) lands on the finder;
// youth skips Overview (WHY_INDOOR copy is adult-voiced).
const hasOverview = audience !== 'youth';
const locationParam = Astro.url.searchParams.get('location');
const initialTab = !hasOverview || locationParam ? 'this-season' : 'overview';
const TAB_DEFS = [
  ...(hasOverview ? [{ key: 'overview', label: 'Overview' }] : []),
  { key: 'this-season', label: 'This Season' },
  { key: 'upcoming', label: 'Upcoming' },
  { key: 'past', label: 'Past' },
];
const firstSeasonId = featured?.id ?? null;
const featuredStart = featured?.startDate
  ? new Date(featured.startDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
const featuredPrice = featured
  ? (featured.teamPrice
      ? `$${featured.price}/player · $${featured.teamPrice}/team`
      : `$${featured.price}/player`)
  : null;
// Structured play day wins over the free-text scheduleNotes when set.
const featuredDay = featured
  ? formatDaySchedule(featured.dayOfWeek, featured.startTime, featured.endTime) || featured.scheduleNotes || null
  : null;
import { setMarketingEdgeCache } from '@/lib/http/edge-cache';
import { formatDaySchedule } from '@/lib/time/format-date';
setMarketingEdgeCache(Astro);

const SO = 'https://www.gosoccerone.com';
const breadcrumbSchema = breadcrumbJsonLd([
  { name: 'SoccerOne', url: `${SO}/` },
  { name: 'Leagues', url: `${SO}/leagues` },
]);
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title={audience === 'youth' ? 'Youth Leagues — SoccerOne' : 'Leagues — SoccerOne'}
  description={audience === 'youth'
    ? 'Youth indoor soccer leagues at SoccerOne Columbus — Worthington and Downtown. Register now for the upcoming season.'
    : 'Adult indoor 7v7 soccer leagues at SoccerOne Columbus — coed, men\'s, women\'s, 30+/40+, and futsal divisions at Worthington and Downtown. Register now.'}
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    {eventSchema.length > 0 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(eventSchema)} />
    )}
  </Fragment>

  <SoccerOneHeader />

  <main class="leagues-main">

    <!-- Page header -->
    <div class="leagues-header">
      <div class="lh-inner">
        <!-- REGISTRATION CTA — featured row. Data-driven from the first
             open season; hidden entirely when the catalog is empty so we
             never show a dead pay button over the empty state. -->
        {featured && termAgg.multi ? (
          <div class="leagues-featured-cta">
            <div class="lfcta-left">
              <span class="lfcta-eyebrow">NOW REGISTERING</span>
              <h2 class="lfcta-title">
                <a href={`/leagues/${featured.termSlug}`} class="lfcta-title-link">{termAgg.termLabel}</a>
              </h2>
              <div class="lfcta-meta">
                {termAgg.closes && <span class="lm-item">Registration closes {fmtShort(termAgg.closes)}</span>}
                <span class="lm-item">{termAgg.count} divisions</span>
                {termAgg.families.length > 0 && <span class="lm-item">{termAgg.families.join(' · ')}</span>}
                {termAgg.uniformPrice && <span class="lm-item">{termAgg.uniformPrice}</span>}
              </div>
            </div>
            <div class="lfcta-right">
              {/* The finder is one tab away — jumping there beats sending a
                  13-division term to one arbitrary division's checkout. */}
              <button type="button" class="lfcta-btn" data-lg-jump="this-season">
                Pick your division &amp; register
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <a href={`/leagues/${featured.termSlug}`} class="lfcta-note lfcta-note-link">Full {termAgg.termLabel} page: schedule &amp; standings →</a>
            </div>
          </div>
        ) : featured && (
          <div class="leagues-featured-cta">
            <div class="lfcta-left">
              <span class="lfcta-eyebrow">NOW REGISTERING</span>
              <h2 class="lfcta-title">
                {currentTerm && featured.termSlug === currentTerm.slug ? (
                  <a href={`/leagues/${featured.termSlug}`} class="lfcta-title-link">{featured.name}</a>
                ) : (
                  featured.name
                )}
              </h2>
              <div class="lfcta-meta">
                {featuredStart && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="rgba(163,230,53,0.5)" stroke-width="1.2"/><path d="M7 4v3l2 2" stroke="rgba(163,230,53,0.7)" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Starts {featuredStart}
                  </span>
                )}
                {featuredDay && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="3" width="12" height="10" rx="1.5" stroke="rgba(163,230,53,0.5)" stroke-width="1.2"/><line x1="1" y1="6" x2="13" y2="6" stroke="rgba(163,230,53,0.3)" stroke-width="1"/></svg>
                    {featuredDay}
                  </span>
                )}
                {featured.location?.name && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1L8.5 5H13L9.5 7.5 11 12 7 9.5 3 12 4.5 7.5 1 5H5.5z" stroke="rgba(163,230,53,0.5)" stroke-width="1.1" fill="none"/></svg>
                    {featured.location.name}
                  </span>
                )}
                {featuredPrice && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M4 7h6M7 4l3 3-3 3" stroke="rgba(163,230,53,0.5)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {featuredPrice}
                  </span>
                )}
              </div>
            </div>
            <div class="lfcta-right">
              <a
                href={`/register/${featured.id}`}
                class="lfcta-btn"
                data-so-register-cta
                data-season-id={featured.id}
                data-level={featured.skillLevel ?? 'open'}
                data-gender={featured.divisionGender ?? 'unknown'}
                data-venue={featured.location?.slug ?? ''}
                data-term={featured.termSlug ?? ''}
                data-mode={featured.signupModes?.includes('team') ? 'team' : 'individual'}
              >
                Register &amp; Pay Now
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <span class="lfcta-note">Secure checkout via Aspire Sports</span>
            </div>
          </div>
        )}

        <div class="lh-top">
          <div class="lh-text">
            <h1 class="lh-title">{audience === 'youth' ? 'YOUTH LEAGUES' : 'LEAGUES'}</h1>
            <p class="lh-desc">
              {audience === 'youth'
                ? 'Youth indoor soccer leagues and academies across both locations.'
                : termAgg.families.length > 0
                  ? `Indoor 7v7, season by season. ${termAgg.families.join(' · ')} divisions across both locations.`
                  : 'Competitive indoor soccer, season by season, across both locations.'}
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- Aspire-anatomy tab bar (round 2). Server-rendered; a small inline
         script toggles panes and fires league_landing_tab_viewed. -->
    <div class="lg-tabbar">
      <div class="lg-tabbar-inner" role="tablist" aria-label="Leagues">
        {TAB_DEFS.map((t) => (
          <button
            type="button"
            role="tab"
            class="lg-tab"
            data-lg-tab={t.key}
            aria-selected={String(t.key === initialTab)}
          >
            {t.label}
            {t.key === 'upcoming' && upcomingTerms.length > 0 && <span class="lg-cnt">{upcomingTerms.length}</span>}
          </button>
        ))}
      </div>
    </div>

    <!-- Leagues listing -->
    <div class="leagues-section">
      <div class="leagues-inner">

        {hasOverview && (
          <section data-lg-pane="overview" hidden={initialTab !== 'overview'} role="tabpanel" aria-label="Overview">


            <!-- Why-play — the selling copy Aspire carries on its Overview
                 tab (WHY_INDOOR shared constants). Server-rendered: this pane
                 is in the HTML even when another tab is active. -->
            <div class="leagues-why">
              <h2 class="lw-title">Why indoor. Why here.</h2>
              <div class="lw-grid">
                {WHY_INDOOR.map((v) => (
                  <div class="lw-card">
                    <h3 class="lw-h">{v.title}</h3>
                    <p class="lw-copy">{v.copy}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="lo-rules">
              <h2 class="lw-title">How the game runs</h2>
              <ul class="lo-rules-list">
                {RULE_SECTIONS[0].items.slice(0, 3).map((it) => (
                  <li class="lo-rule">{it}</li>
                ))}
              </ul>
            </div>

            {/* The interactive ladder lives in This Season as the filter —
                pointing there beats rendering the same ladder twice on one
                page. data-lg-jump switches tabs client-side. */}
            <button type="button" class="lo-jump" data-lg-jump="this-season">
              Find your level &amp; register →
            </button>
          </section>
        )}

        <section data-lg-pane="this-season" hidden={initialTab !== 'this-season'} role="tabpanel" aria-label="This season">
          {/* The level ladder lives INSIDE the finder as its level filter
              (SoccerOneLevelLadder) — the static display it replaced asked the
              same question twice in two visual languages. */}
          <SoccerOneLeaguesFinder client:load seasons={thisSeasonSeasons} />
        </section>

        <section data-lg-pane="upcoming" hidden={initialTab !== 'upcoming'} role="tabpanel" aria-label="Upcoming seasons">
          {/* Off-season demand engine. Terms appear once their seasons are
              flipped to `forming` (drafts never surface; the API refuses
              them by design). The capture renders regardless. */}
          <div class="leagues-upcoming">
            <h2 class="lu-title">Upcoming seasons</h2>
            {upcomingTerms.length > 0 && (
              <div class="lu-grid">
                {upcomingTerms.map((t) => (
                  <a href={`/leagues/${t.slug}`} class="lu-card">
                    <span class="lu-label">{t.label}</span>
                    <span class="lu-cta">See divisions →</span>
                  </a>
                ))}
              </div>
            )}
            <div class="lu-capture">
              <SoccerOneInterestCapture
                client:load
                source="leagues-upcoming"
                title="Tell me when registration opens"
                subtitle="One email the day an upcoming season opens — nothing else."
              />
            </div>
          </div>
        </section>

        <section data-lg-pane="past" hidden={initialTab !== 'past'} role="tabpanel" aria-label="Past seasons">
          <h2 class="lu-title">Past seasons</h2>
          {pastTerms.length > 0 ? (
            <div class="lu-grid">
              {pastTerms.map((t) => (
                <a href={`/leagues/${t.slug}`} class="lu-card">
                  <span class="lu-label">{t.label}</span>
                  <span class="lu-cta">Final standings &amp; results →</span>
                </a>
              ))}
            </div>
          ) : (
            <p class="lp-empty">Final standings &amp; results live here once a season wraps — Fall 2026 is the first.</p>
          )}
        </section>
      </div>
    </div>

    <!-- Bottom CTA — only when there is a season to register for; dead
         '#' buttons are worse than no banner. -->
    {firstSeasonId && (
    <div class="leagues-bottom-cta">
      <div class="lbc-inner">
        <div class="lbc-text">
          <span class="lbc-label">HAVE A TEAM?</span>
          <h2 class="lbc-title">Register your team directly. No middleman.</h2>
        </div>
        <div class="lbc-buttons">
          {/* Same fix as the featured banner: this used to deep-link ONE
              arbitrary division's checkout. Solo/team is chosen at register
              (ChooseMode) — the honest destination is the division picker. */}
          <button type="button" class="lbc-btn-primary" data-lg-jump="this-season">Pick your division &amp; register →</button>
        </div>
      </div>
    </div>
    )}

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }
    .accent { color: var(--so-lime); }

    .leagues-main { flex: 1; font-family: var(--so-font-body); }

    /* ---- HEADER ---- */
    .leagues-header {
      background: var(--so-ink);
      border-bottom: 1px solid var(--so-lime-a10);
      padding: 4rem 0 0;
    }
    .lh-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    .lh-top {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }

    .lh-title {
      font-family: var(--so-font-display);
      font-size: clamp(4rem, 10vw, 9rem);
      color: #ffffff;
      line-height: 0.9;
      letter-spacing: 0.01em;
      margin-bottom: 1rem;
    }

    .lh-desc {
      font-size: 1.0625rem;
      color: var(--muted);
      line-height: 1.6;
      max-width: 500px;
    }


    /* ---- LEAGUES SECTION ---- */
    .leagues-section { background: var(--bg); padding: 4rem 0; }
    .leagues-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    /* Featured CTA */
    .leagues-featured-cta {
      background: var(--so-lime-a06);
      border: 1px solid var(--so-lime-a25);
      border-radius: var(--so-radius-lg);
      padding: 1.75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }

    .lfcta-eyebrow {
      display: block;
      font-family: var(--so-font-mono);
      font-size: 0.5625rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--so-lime);
      margin-bottom: 0.5rem;
    }

    .lfcta-title {
      font-family: var(--so-font-display);
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      color: #ffffff;
      letter-spacing: 0.01em;
      margin-bottom: 0.875rem;
    }
    .lfcta-title-link { color: inherit; text-decoration: none; }
    .lfcta-title-link:hover { color: var(--so-lime-bright); }
    .lfcta-term-link {
      display: inline-block;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--so-lime);
      text-decoration: none;
      border-bottom: 1px solid var(--so-lime-a25);
      padding-bottom: 0.15rem;
      margin-bottom: 0.875rem;
    }
    .lfcta-term-link:hover { border-bottom-color: var(--so-lime); }

    /* Tab bar (round 2 — Aspire anatomy) */
    .lg-tabbar { background: var(--so-ink); border-bottom: 1px solid var(--so-lime-a20); }
    .lg-tabbar-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; display: flex; gap: 2px; flex-wrap: wrap; }
    .lg-tab {
      font-family: var(--so-font-mono); font-size: 0.7rem; letter-spacing: 0.1em;
      text-transform: uppercase; padding: 0.75rem 1.1rem; color: rgba(255,255,255,0.4);
      background: none; border: none; cursor: pointer; position: relative; top: 1px;
      display: inline-flex; align-items: center; gap: 0.4rem;
    }
    .lg-tab:hover { color: rgba(255,255,255,0.7); }
    .lg-tab[aria-selected="true"] { background: var(--so-lime); color: var(--so-ink); font-weight: 700; border-radius: var(--so-radius-sm) var(--so-radius-sm) 0 0; }
    .lg-cnt { font-size: 0.55rem; font-weight: 700; background: var(--so-lime-a20); color: var(--so-lime); border-radius: 99px; padding: 1px 6px; }
    .lg-tab[aria-selected="true"] .lg-cnt { background: rgba(10,10,13,0.2); color: var(--so-ink); }

    /* Overview pane extras */
    .lo-rules { margin-top: 2.5rem; }
    .lo-rules-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; max-width: 560px; }
    .lo-rule { font-size: 0.85rem; color: rgba(255,255,255,0.6); line-height: 1.5; padding-left: 1rem; position: relative; }
    .lo-rule::before { content: '›'; position: absolute; left: 0; color: var(--so-lime); font-weight: 700; }
    .lo-jump {
      margin-top: 2rem; background: var(--so-lime); color: var(--so-ink);
      font-family: var(--so-font-body); font-size: 0.875rem; font-weight: 700;
      letter-spacing: 0.03em; border: none; border-radius: var(--so-radius-sm);
      padding: 0.8rem 1.4rem; cursor: pointer;
    }
