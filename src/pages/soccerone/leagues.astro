---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { Toaster } from 'sonner';

const facility = Astro.url.searchParams.get('facility') || 'all';
const facilityLabel = facility === 'worthington' ? 'Worthington' : facility === 'downtown' ? 'Downtown' : 'All Locations';

// Phase 2 — fetch live SoccerOne seasons via the tenant-scoped public API.
// The endpoint is org-scoped from Phase 0 (reads Astro.locals.organization),
// so this page sees only SoccerOne seasons when rendered in SoccerOne context.
// Optional ?facility=downtown|worthington filters by location slug — matches
// the existing UI affordance. The location slugs in the DB are bare
// ('downtown' / 'worthington'), not 'soccerone-' prefixed, so the tab value
// maps straight through; the old prefixed slugs matched no location and made
// both tabs return zero leagues.
const locationSlug =
  facility === 'downtown' || facility === 'worthington' ? facility : null;

let seasons: any[] = [];
try {
  const url = new URL('/api/public/seasons', Astro.url);
  url.searchParams.set('audience', 'adult');
  if (locationSlug) url.searchParams.set('location', locationSlug);
  const res = await fetch(url, {
    headers: { Host: Astro.request.headers.get('host') ?? '' },
  });
  if (res.ok) {
    const body = await res.json();
    seasons = body.seasons ?? [];
  }
} catch (err) {
  console.error('[soccerone/leagues] failed to load seasons', err);
}

// Phase 1: this hand-rolled SoccerOne template only renders a "Register Now"
// CTA, so exclude `forming` (interest-only) seasons — otherwise they'd show a
// register button for a season that isn't open yet. Forming seasons surface on
// the main Aspire catalog (program-card-v2 renders the interest form). Phase 2
// adds an interest CTA to this template.
seasons = seasons.filter((s) => s.signupMode !== 'interest');

const firstSeasonId = seasons[0]?.id ?? null;

// Featured season = first open season (the API already sorts by startDate).
// All featured-CTA copy derives from it; the block renders only when one
// exists — no more hardcoded season names/dates/prices over a dead button.
const featured = seasons[0] ?? null;
const featuredStart = featured?.startDate
  ? new Date(featured.startDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
const featuredPrice = featured
  ? (featured.teamPrice
      ? `$${featured.price}/player · $${featured.teamPrice}/team`
      : `$${featured.price}/player`)
  : null;
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title={`Leagues — SoccerOne | ${facilityLabel}`}
  description="Adult coed, premier, and corporate indoor soccer leagues at SoccerOne Columbus. Worthington (3 fields) and Downtown (1 field). Register now for the upcoming season."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <SoccerOneHeader />
  <Toaster client:load richColors position="bottom-right" />

  <main class="leagues-main">

    <!-- Page header -->
    <div class="leagues-header">
      <div class="lh-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/soccerone" class="bc-link">SoccerOne</a>
          <span class="bc-sep" aria-hidden="true">—</span>
          <span class="bc-current">Leagues</span>
        </nav>

        <div class="lh-top">
          <div class="lh-text">
            <h1 class="lh-title">LEAGUES</h1>
            <p class="lh-desc">
              Competitive indoor soccer, season by season. Adult Coed, Premier, Women's, and Corporate divisions across both locations.
            </p>
          </div>
          <div class="lh-stats">
            <div class="lhs-item">
              <span class="lhs-num">4</span>
              <span class="lhs-label">Indoor fields</span>
            </div>
            <div class="lhs-div" aria-hidden="true"></div>
            <div class="lhs-item">
              <span class="lhs-num">2</span>
              <span class="lhs-label">Locations</span>
            </div>
            <div class="lhs-div" aria-hidden="true"></div>
            <div class="lhs-item">
              <span class="lhs-num">7–11</span>
              <span class="lhs-label">Open daily</span>
            </div>
          </div>
        </div>

        <!-- Facility filter tabs -->
        <div class="facility-filter-row" role="group" aria-label="Filter by facility">
          <a
            href="/soccerone/leagues"
            class={`ff-tab ${facility === 'all' ? 'ff-tab--active' : ''}`}
          >
            ALL LOCATIONS
          </a>
          <a
            href="/soccerone/leagues?facility=worthington"
            class={`ff-tab ${facility === 'worthington' ? 'ff-tab--active' : ''}`}
          >
            WORTHINGTON · 3 FIELDS
          </a>
          <a
            href="/soccerone/leagues?facility=downtown"
            class={`ff-tab ${facility === 'downtown' ? 'ff-tab--active' : ''}`}
          >
            DOWNTOWN · 1 FIELD
          </a>
        </div>
      </div>
    </div>

    <!-- Leagues listing -->
    <div class="leagues-section">
      <div class="leagues-inner">

        <!-- REGISTRATION CTA — featured row. Data-driven from the first
             open season; hidden entirely when the catalog is empty so we
             never show a dead pay button over the empty state. -->
        {featured && (
          <div class="leagues-featured-cta">
            <div class="lfcta-left">
              <span class="lfcta-eyebrow">NOW REGISTERING</span>
              <h2 class="lfcta-title">{featured.name}</h2>
              <div class="lfcta-meta">
                {featuredStart && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="rgba(163,230,53,0.5)" stroke-width="1.2"/><path d="M7 4v3l2 2" stroke="rgba(163,230,53,0.7)" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Starts {featuredStart}
                  </span>
                )}
                {featured.scheduleNotes && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="3" width="12" height="10" rx="1.5" stroke="rgba(163,230,53,0.5)" stroke-width="1.2"/><line x1="1" y1="6" x2="13" y2="6" stroke="rgba(163,230,53,0.3)" stroke-width="1"/></svg>
                    {featured.scheduleNotes}
                  </span>
                )}
                {featured.location?.name && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1L8.5 5H13L9.5 7.5 11 12 7 9.5 3 12 4.5 7.5 1 5H5.5z" stroke="rgba(163,230,53,0.5)" stroke-width="1.1" fill="none"/></svg>
                    {featured.location.name}
                  </span>
                )}
                {featuredPrice && (
                  <span class="lm-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M4 7h6M7 4l3 3-3 3" stroke="rgba(163,230,53,0.5)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {featuredPrice}
                  </span>
                )}
              </div>
            </div>
            <div class="lfcta-right">
              <a href={`/register/${featured.id}`} class="lfcta-btn">
                Register &amp; Pay Now
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <span class="lfcta-note">Secure checkout via Aspire Sports</span>
            </div>
          </div>
        )}

        <!-- League cards grid — data-driven from /api/public/seasons -->
        {seasons.length === 0 ? (
          <div class="leagues-empty">
            <p class="le-title">No open leagues right now</p>
            <p class="le-body">
              New seasons open before each cycle — leave your email and you'll
              hear the moment registration opens.
            </p>
            <form id="le-notify-form" class="le-form" novalidate>
              <label class="sr-only" for="le-notify-email">Email address</label>
              <input
                id="le-notify-email"
                class="le-input"
                type="email"
                required
                autocomplete="email"
                placeholder="you@email.com"
              />
              <button type="submit" class="le-btn">Notify me</button>
            </form>
            <p id="le-notify-msg" class="le-msg" role="status" hidden></p>
          </div>
        ) : (
          <div class="leagues-grid">
            {seasons.map((season: any) => {
              const isDowntown = season.location.slug?.includes('downtown');
              const statusKey = season.status === 'open' ? 'open' : season.status === 'filling' ? 'filling' : 'coming';
              const cardMod = isDowntown ? 'league-card--downtown' : 'league-card--active';
              const badgeMod = isDowntown ? 'lc-location-badge--downtown' : '';
              const locationLabel = season.location.name.toUpperCase();
              const statusLabel = season.status.toUpperCase();
              const priceLabel = season.teamPrice
                ? `$${season.price}/player · $${season.teamPrice}/team`
                : `$${season.price}/player`;
              return (
                <div class={`league-card ${cardMod}`}>
                  <div class={`lc-location-badge ${badgeMod}`}>{locationLabel}</div>
                  <div class="lc-top">
                    <div class="lc-division">
                      <span class="lc-div-label">PROGRAM</span>
                      <span class="lc-div-name">{season.program.name}</span>
                    </div>
                    <span class={`lc-status lc-status--${statusKey}`}>{statusLabel}</span>
                  </div>

                  <h3 class="lc-name">{season.name}</h3>

                  <div class="lc-details">
                    {season.startDate && (
                      <div class="lc-detail-row">
                        <span class="lcd-label">STARTS</span>
                        <span class="lcd-val">{new Date(season.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                      </div>
                    )}
                    {season.scheduleNotes && (
                      <div class="lc-detail-row">
                        <span class="lcd-label">SCHEDULE</span>
                        <span class="lcd-val">{season.scheduleNotes}</span>
                      </div>
                    )}
                    <div class="lc-detail-row">
                      <span class="lcd-label">SPOTS</span>
                      <span class="lcd-val">
                        {season.spotsLeft != null
                          ? `${season.spotsLeft} left of ${season.maxParticipants}`
                          : 'Open'}
                      </span>
                    </div>
                    <div class="lc-detail-row">
                      <span class="lcd-label">PRICE</span>
                      <span class="lcd-val mono accent">{priceLabel}</span>
                    </div>
                  </div>

                  <a href={`/register/${season.id}`} class="lc-cta">
                    Register Now →
                  </a>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>

    <!-- Bottom CTA — only when there is a season to register for; dead
         '#' buttons are worse than no banner. -->
    {firstSeasonId && (
    <div class="leagues-bottom-cta">
      <div class="lbc-inner">
        <div class="lbc-text">
          <span class="lbc-label">HAVE A TEAM?</span>
          <h2 class="lbc-title">Register your team directly. No middleman.</h2>
        </div>
        <div class="lbc-buttons">
          <a href={`/register/${firstSeasonId}`} class="lbc-btn-primary">Register a Team</a>
          <a href={`/register/${firstSeasonId}`} class="lbc-btn-secondary">Register as Individual</a>
        </div>
      </div>
    </div>
    )}

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }
    .accent { color: var(--so-lime); }

    .leagues-main { flex: 1; font-family: var(--so-font-body); }

    /* ---- HEADER ---- */
    .leagues-header {
      background: var(--so-ink);
      border-bottom: 1px solid var(--so-lime-a10);
      padding: 4rem 0 0;
    }
    .lh-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; }
    .bc-link { font-size: 0.8125rem; color: var(--so-lime-a60); text-decoration: none; font-weight: 500; transition: color 0.15s; }
    .bc-link:hover { color: var(--so-lime); }
    .bc-sep { color: rgba(255,255,255,0.2); font-size: 0.75rem; }
    .bc-current { font-size: 0.8125rem; color: rgba(255,255,255,0.4); }

    .lh-top {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }

    .lh-title {
      font-family: var(--so-font-display);
      font-size: clamp(4rem, 10vw, 9rem);
      color: #ffffff;
      line-height: 0.9;
      letter-spacing: 0.01em;
      margin-bottom: 1rem;
    }

    .lh-desc {
      font-size: 1.0625rem;
      color: var(--muted);
      line-height: 1.6;
      max-width: 500px;
    }

    .lh-stats {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      background: var(--so-lime-a04);
      border: 1px solid var(--so-lime-a15);
      border-radius: var(--so-radius-md);
      padding: 1.25rem 1.75rem;
      flex-shrink: 0;
    }
    .lhs-item { display: flex; flex-direction: column; gap: 2px; text-align: center; }
    .lhs-num { font-family: var(--so-font-display); font-size: 2.25rem; color: var(--so-lime); letter-spacing: 0.02em; line-height: 1; }
    .lhs-label { font-family: var(--so-font-mono); font-size: 0.5rem; font-weight: 600; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); }
    .lhs-div { width: 1px; height: 40px; background: rgba(255,255,255,0.08); }

    /* Facility filter tabs */
    .facility-filter-row {
      display: flex;
      gap: 0;
      border-top: 1px solid var(--border);
    }

    .ff-tab {
      font-family: var(--so-font-body);
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: rgba(255,255,255,0.4);
      text-decoration: none;
      padding: 1rem 1.5rem;
      border-bottom: 2px solid transparent;
      transition: color 0.15s, border-color 0.15s;
      white-space: nowrap;
    }
    .ff-tab:hover { color: rgba(255,255,255,0.7); }
    .ff-tab--active { color: var(--so-lime); border-bottom-color: var(--so-lime); }

    /* ---- LEAGUES SECTION ---- */
    .leagues-section { background: var(--bg); padding: 4rem 0; }
    .leagues-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    /* Featured CTA */
    .leagues-featured-cta {
      background: var(--so-lime-a06);
      border: 1px solid var(--so-lime-a25);
      border-radius: var(--so-radius-lg);
      padding: 1.75rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }

    .lfcta-eyebrow {
      display: block;
      font-family: var(--so-font-mono);
      font-size: 0.5625rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--so-lime);
      margin-bottom: 0.5rem;
    }

    .lfcta-title {
      font-family: var(--so-font-display);
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      color: #ffffff;
      letter-spacing: 0.01em;
      margin-bottom: 0.875rem;
    }

    .lfcta-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
    }
    .lm-item {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.875rem;
      color: rgba(255,255,255,0.55);
    }

    .lfcta-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .lfcta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      background: var(--so-lime);
      color: var(--so-ink);
      font-family: var(--so-font-body);
      font-size: 0.9375rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration: none;
      padding: 0.875rem 1.75rem;
      border-radius: var(--so-radius-sm);
      transition: background 0.15s;
      white-space: nowrap;
    }
    .lfcta-btn:hover { background: var(--so-lime-bright); }
    .lfcta-note { font-size: 0.75rem; color: rgba(255,255,255,0.3); }

    /* League cards */
    .leagues-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .league-card {
      background: var(--so-surface);
      border: 1px solid var(--so-lime-a20);
      border-left: 3px solid var(--so-lime);
      border-radius: var(--so-radius-lg);
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      position: relative;
      transition: border-color 0.2s, transform 0.2s;
    }
    .league-card:hover { border-color: var(--so-lime-a40); border-left-color: var(--so-lime); transform: translateY(-4px); }
    .league-card--active { border-color: var(--so-lime-a15); }
    .league-card--downtown { border-color: rgba(100,160,255,0.2); border-left-color: rgba(100,160,255,0.8); }
    .league-card--downtown:hover { border-color: rgba(100,160,255,0.4); border-left-color: rgba(100,160,255,1); }
    .league-card--youth { border-color: rgba(192,132,252,0.2); border-left-color: rgba(192,132,252,0.8); }

    .lc-location-badge {
      font-family: var(--so-font-mono);
      font-size: 0.5rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      background: var(--so-lime-a08);
      color: var(--so-lime-a60);
      border: 1px solid var(--so-lime-a15);
      padding: 2px 7px;
      border-radius: 3px;
      display: inline-block;
      width: fit-content;
    }
    .lc-location-badge--downtown {
      background: rgba(100,160,255,0.08);
      color: rgba(147,197,253,0.7);
      border-color: rgba(100,160,255,0.15);
    }

    .lc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; }

    .lc-division { display: flex; flex-direction: column; gap: 2px; }
    .lc-div-label { font-family: var(--so-font-mono); font-size: 0.5rem; font-weight: 600; letter-spacing: 0.1em; color: rgba(255,255,255,0.3); }
    .lc-div-name { font-size: 0.875rem; font-weight: 600; color: rgba(255,255,255,0.7); }

    .lc-status {
      font-family: var(--so-font-mono);
      font-size: 0.5rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      padding: 3px 8px;
      border-radius: 3px;
      flex-shrink: 0;
    }
    .lc-status--open { background: var(--so-lime-a12); color: var(--so-lime); border: 1px solid var(--so-lime-a20); }
    .lc-status--filling { background: rgba(251,191,36,0.1); color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }
    .lc-status--coming { background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.4); border: 1px solid rgba(255,255,255,0.1); }

    .lc-name {
      font-family: var(--so-font-display);
      font-size: 1.75rem;
      color: #ffffff;
      letter-spacing: 0.01em;
      line-height: 1;
    }

    .lc-desc {
      font-size: 0.9375rem;
      color: var(--muted);
      line-height: 1.55;
      flex: 1;
    }

    .lc-details { display: flex; flex-direction: column; gap: 0.5rem; }
    .lc-detail-row {
      display: grid;
      grid-template-columns: 60px 1fr;
      gap: 0.625rem;
      align-items: start;
    }
    .lcd-label { font-family: var(--so-font-mono); font-size: 0.5rem; font-weight: 600; letter-spacing: 0.1em; color: var(--so-lime-a50); padding-top: 2px; }
    .lcd-val { font-size: 0.875rem; color: rgba(255,255,255,0.65); line-height: 1.4; }
    .lcd-val.mono { font-family: var(--so-font-mono); font-size: 0.8125rem; }
    .lcd-val.accent { color: var(--so-lime); }

    .lc-cta {
      display: inline-flex;
      align-items: center;
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--so-lime);
      text-decoration: none;
      padding: 0.625rem 0;
      border-bottom: 1px solid var(--so-lime-a25);
      transition: border-color 0.15s;
      width: fit-content;
      cursor: pointer;
      background: none;
      border-left: none;
      border-right: none;
      border-top: none;
    }
    .lc-cta:hover { border-bottom-color: var(--so-lime); }
    .lc-cta--notify { color: rgba(255,255,255,0.5); border-bottom-color: rgba(255,255,255,0.15); }
    .lc-cta--notify:hover { color: rgba(255,255,255,0.7); border-bottom-color: rgba(255,255,255,0.3); }

    /* ---- BOTTOM CTA ---- */
    .leagues-bottom-cta {
      background: var(--so-lime);
      padding: 3rem 0;
    }
    .lbc-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .lbc-label { font-family: var(--so-font-mono); font-size: 0.5625rem; font-weight: 600; letter-spacing: 0.14em; color: rgba(10,10,13,0.5); display: block; margin-bottom: 0.375rem; }
    .lbc-title { font-family: var(--so-font-display); font-size: clamp(1.5rem, 3vw, 2.25rem); color: var(--so-ink); letter-spacing: 0.01em; }
    .lbc-buttons { display: flex; gap: 0.875rem; flex-wrap: wrap; flex-shrink: 0; }
    .lbc-btn-primary { display: inline-block; background: var(--so-ink); color: var(--so-lime); font-family: var(--so-font-body); font-size: 0.875rem; font-weight: 700; letter-spacing: 0.04em; text-decoration: none; padding: 0.875rem 1.5rem; border-radius: var(--so-radius-sm); transition: background 0.15s; white-space: nowrap; }
    .lbc-btn-primary:hover { background: #1a1a1e; }
    .lbc-btn-secondary { display: inline-block; background: rgba(10,10,13,0.1); color: var(--so-ink); font-family: var(--so-font-body); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; text-decoration: none; padding: 0.875rem 1.5rem; border-radius: var(--so-radius-sm); border: 1px solid rgba(10,10,13,0.25); transition: background 0.15s; white-space: nowrap; }
    .lbc-btn-secondary:hover { background: rgba(10,10,13,0.18); }

    /* Empty state */
    .leagues-empty {
      padding: 4rem 0;
      text-align: center;
    }
    .le-form {
      margin: 1.5rem auto 0;
      display: flex;
      gap: 0.5rem;
      max-width: 26rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .le-input {
      flex: 1 1 14rem;
      padding: 0.75rem 1rem;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: var(--so-radius-md);
      color: #ffffff;
      font-size: 0.9375rem;
    }
    .le-input::placeholder { color: rgba(255, 255, 255, 0.4); }
    .le-input:focus {
      outline: none;
      border-color: var(--so-lime);
    }
    .le-btn {
      padding: 0.75rem 1.25rem;
      background: var(--so-lime);
      color: var(--so-ink);
      font-family: var(--so-font-display);
      font-size: 0.9375rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border: none;
      border-radius: var(--so-radius-md);
      cursor: pointer;
    }
    .le-btn:hover { background: var(--so-lime-bright); }
    .le-btn:disabled { opacity: 0.6; cursor: default; }
    .le-msg {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
      color: var(--so-lime);
    }
