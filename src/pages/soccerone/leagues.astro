    .le-title {
      font-family: var(--so-font-display);
      font-size: 1.5rem;
      color: #ffffff;
      letter-spacing: 0.01em;
      margin-bottom: 0.5rem;
    }
    .le-body {
      font-size: 0.9375rem;
      color: var(--muted);
    }

    @media (max-width: 1100px) { .leagues-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) {
      .leagues-grid { grid-template-columns: 1fr; }
      .lh-top { flex-direction: column; align-items: flex-start; }
      .leagues-featured-cta { flex-direction: column; align-items: flex-start; }
      .lfcta-right { align-items: flex-start; }
      .lbc-inner { flex-direction: column; align-items: flex-start; }
    }
  </style>

  <script>
    // Empty-state email capture — posts to the org-scoped newsletter
    // endpoint (rate-limited, upserts by email). Only present when the
    // page rendered with zero open seasons.
    const form = document.getElementById("le-notify-form") as HTMLFormElement | null;
    const input = document.getElementById("le-notify-email") as HTMLInputElement | null;
    const msg = document.getElementById("le-notify-msg");
    const btn = form?.querySelector("button");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!input || !msg || !input.value.trim()) return;
      if (btn) btn.disabled = true;
      msg.hidden = true;
      try {
        const res = await fetch("/api/public/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: input.value.trim(),
            audience: "adult",
            source: "soccerone-leagues-empty",
          }),
        });
        if (!res.ok) {
          const json = await res.json().catch(() => ({}));
          throw new Error(json.error ?? "Could not save your email");
        }
        msg.textContent =
          "You're on the list — we'll email you the moment registration opens.";
        msg.classList.remove("le-msg--error");
        msg.hidden = false;
        form.hidden = true;
      } catch (err) {
        msg.textContent =
          err instanceof Error ? err.message : "Could not save your email";
        msg.classList.add("le-msg--error");
        msg.hidden = false;
        if (btn) btn.disabled = false;
      }
    });
  </script>

</BaseLayout>
