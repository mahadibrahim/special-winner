---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { WORTHINGTON_JSONLD } from '@/lib/seo/soccerone-jsonld';
import HomeSignupStrip from '@/components/soccerone/HomeSignupStrip';

// Live season data — org-scoped fetch pinned to the Worthington location,
// same pattern as src/pages/soccerone/index.astro:16-40.
async function fetchOpenSeasons(audience: 'adult' | 'youth') {
  try {
    const url = new URL('/api/public/seasons', Astro.url);
    // Prod (single-org cutover 2026-06-11) resolves gosoccerone.com to the
    // single Aspire org, whose location slugs are bare (`worthington`,
    // `downtown` — see src/lib/organization/soccerone-routing.ts:5-11 and
    // rent.astro's locationSlug). The SoccerOne staging fixture org's seed
    // uses the same bare slug, so this stays correct on both.
    url.searchParams.set('location', 'worthington');
    url.searchParams.set('audience', audience);
    // Dev-only guard: Astro.url reconstructs from the forwarded Host header,
    // so a port-less Host (e.g. `curl -H "Host: soccerone.localhost"`) yields
    // port 80 and the self-fetch misses the dev server. Pin the dev port.
    // Do NOT rewrite the hostname to localhost: undici silently drops an
    // explicit Host header (forbidden fetch header), so the tenant must stay
    // in the URL or org resolution falls back to the default org.
    if (url.hostname.endsWith('.localhost') && !url.port) url.port = '4321';
    const res = await fetch(url, {
      headers: { Host: Astro.request.headers.get('host') ?? '' },
    });
    if (!res.ok) return [];
    const body = await res.json();
    const todayIso = new Date().toISOString().slice(0, 10);
    return (body.seasons ?? [])
      .filter((s: any) => s.signupMode !== 'interest')
      .filter((s: any) => !s.startDate || String(s.startDate).slice(0, 10) >= todayIso);
  } catch (err) {
    console.error('[soccerone/worthington] failed to load ' + audience + ' seasons', err);
    return [];
  }
}

const adultSeasons = await fetchOpenSeasons('adult');

// The hero's priority register CTA binds to the first open ADULT season at
// this location — Worthington's youth leagues are weekend-morning drop-in
// programs, not a registration CTA the hero should ever surface. The youth
// card in "What's Happening" is static copy (Sat & Sun mornings), so no
// youth season fetch is needed here.
const featured = adultSeasons[0] ?? null;
// Multi-division term (all fall divisions share a start date): route
// register CTAs to the division finder instead of pre-picking whichever
// division the createdAt tiebreak surfaces ('Co-Ed D' incident).
const termAgg = aggregateFeaturedTerm(adultSeasons);

// registrationCloses is a timestamp (full ISO instant): display the
// deadline in the org's local timezone, not the server's.
const featuredCloses = featured?.registrationCloses
  ? new Date(featured.registrationCloses).toLocaleDateString('en-US', {
      weekday: 'short', month: 'short', day: 'numeric', timeZone: 'America/New_York',
    })
  : null;

// The $1,000/team early-bird promo (thru Aug 3) is a static founder
// decision, not a season-catalog field — date-gate it off "today" in the
// org's timezone (en-CA yields YYYY-MM-DD, directly comparable to the cutoff).
const todayEasternIso = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
const earlyBirdActive = todayEasternIso <= '2026-08-03';

// Guarded price strings for the fall pricing block (Task 4) — never render
// "$null" when a field is unset. Thousands-separated to match the mockup's
// "$1,050" formatting (the raw `$${n}` template used elsewhere on the
// homepage doesn't need it since those prices stay under $1,000).
const fmtPrice = (n: number) => `$${n.toLocaleString('en-US')}`;
const teamPriceStr = featured?.teamPrice != null ? fmtPrice(featured.teamPrice) : null;
const soloPriceStr = featured?.price != null ? fmtPrice(featured.price) : null;
const depositStr = featured?.deposit != null ? fmtPrice(featured.deposit) : null;

// Every fall-date mention on the page derives from the live featured season
// (no hardcoded calendar dates), so the page stays internally consistent
// on any data (fixture dates on staging, real dates in prod).
// startDate/endDate are date-only columns ("YYYY-MM-DD"): parsing yields
// UTC midnight, so format in UTC — America/New_York would shift the date
// back a day (same convention as the homepage's featuredStart).
const formatSeasonDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', timeZone: 'UTC',
  });
const fallKickoffDate = featured?.startDate ? formatSeasonDate(featured.startDate) : null;
const fallEndDate = featured?.endDate ? formatSeasonDate(featured.endDate) : null;

// What's Happening — "THE FALL RHYTHM" list groups the fetched adult
// seasons by dayOfWeek (Sunday→Saturday) and joins each day's season
// names + a formatted startTime–endTime range. Never fabricate: only
// names/days pulled straight from the API. The Fri·Sat open-play row isn't
// a season and is appended verbatim from the approved mockup copy; the
// Thursday pickup+futsal row is also static copy but only appended when
// there's no live Thursday season (see hasLiveThu below) to avoid
// duplicating it. The confirmed night map lives in
// operations/decisions/2026-07-11-worthington-fall-division-nights.md.
const DAY_ORDER = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'] as const;
const DAY_NAMES: Record<string, string> = {
  sun: 'Sunday', mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday',
  thu: 'Thursday', fri: 'Friday', sat: 'Saturday',
};

function formatTimeRange(start?: string | null, end?: string | null): string | null {
  if (!start || !end) return null;
  const toHour12 = (t: string) => {
    const h = parseInt(t.slice(0, 2), 10) % 24;
    const suffix = h >= 12 ? 'pm' : 'am';
    const h12 = h % 12 === 0 ? 12 : h % 12;
    return { h12, suffix };
  };
  const s = toHour12(start);
  const e = toHour12(end);
  return s.suffix === e.suffix
    ? `${s.h12}–${e.h12}${e.suffix}`
    : `${s.h12}${s.suffix}–${e.h12}${e.suffix}`;
}

const seasonsByDay = new Map<string, typeof adultSeasons>();
for (const season of adultSeasons) {
  if (!season.dayOfWeek) continue;
  const list = seasonsByDay.get(season.dayOfWeek) ?? [];
  list.push(season);
  seasonsByDay.set(season.dayOfWeek, list);
}

// Hide the fall tab + list entirely when the catalog carries no
// dayOfWeek-scheduled adult seasons yet (summer state only).
const hasFallSchedule = seasonsByDay.size > 0;

// Prod carries Tuesday + Thursday FUTSAL division seasons with dayOfWeek
// set, so the static Thursday/Tuesday copy below can no longer be appended
// unconditionally — it would duplicate a live Thursday row and name futsal
// twice on Tuesday. hasLiveThu gates the static Thursday row (see markup);
// the /futsal/i checks here suppress the hardcoded Tuesday suffix and the
// per-day "LEAGUES + FUTSAL" tag picks up any live day that already names
// futsal, wherever it lands.
const liveFallRows = DAY_ORDER
  .filter((day) => seasonsByDay.has(day))
  .map((day) => {
    const daySeasons = seasonsByDay.get(day) ?? [];
    const names = daySeasons.map((s: any) => s.name).join(', ');
    const hasFutsal = daySeasons.some((s: any) => /futsal/i.test(s.name ?? ''));
    const timeStr = formatTimeRange(daySeasons[0]?.startTime, daySeasons[0]?.endTime);
    let text = timeStr ? `${names} · ${timeStr}` : names;
    if (day === 'tue' && !hasFutsal) text += ' · Co-Ed futsal on the courts';
    if (day === 'thu') text += ' · plus open pickup + make-up games on the fields';
    return { day: DAY_NAMES[day], text, tag: hasFutsal ? 'LEAGUES + FUTSAL' : 'LEAGUES', hasFutsal };
  });

const hasLiveThu = seasonsByDay.has('thu');

import { aggregateFeaturedTerm } from '@/lib/soccerone/featured-term';
import { setMarketingEdgeCache } from '@/lib/http/edge-cache';
setMarketingEdgeCache(Astro); // after fetches; a degraded (empty-seasons) render may cache for 60s — SWR refreshes it
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title="Worthington — SoccerOne (Soccer One) | Indoor Soccer · 535 Lakeview Plaza Blvd"
  description="SoccerOne Worthington — Soccer One indoor soccer. Two 110×60 boarded fields with sand-filled turf, adult leagues, youth weekend leagues, pickup, and field rentals. Futsal courts open September. 535 Lakeview Plaza Blvd, Worthington OH."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(WORTHINGTON_JSONLD)} />
  </Fragment>

  <SoccerOneHeader currentFacility="worthington" />

  <main class="facility-main">

    <!-- ============================================================
         HERO — shrunk ~55vh, real venue footage, priority CTAs
    ============================================================ -->
    <section class="f-hero" aria-label="Worthington hero">
      <!-- Background: real venue footage -->
      <div class="f-hero-bg" aria-hidden="true">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/media/soccerone/worthington-hero-poster.jpg"
          class="f-hero-video"
        >
          <source src="/media/soccerone/worthington-hero.mp4" type="video/mp4" />
        </video>
      </div>

      <div class="f-hero-inner">
        <nav class="f-breadcrumb" aria-label="Breadcrumb"><a href="/">Locations</a> / Worthington</nav>
        <h1 class="f-title">Worthington</h1>
        <p class="f-sub">
          Columbus's newest indoor soccer venue. <b>Two 110×60 boarded fields</b>, <b>futsal courts</b>
          arriving September, sand-filled turf, and games as late as 1am.
        </p>

        <div class="f-cta-row">
          {featured && (
            <a
              href={termAgg.multi ? '/leagues' : `/register/${featured.id}`}
              class="f-cta f-cta--primary"
              {...(termAgg.multi ? {} : {
                'data-so-register-cta': true,
                'data-season-id': featured.id,
                'data-level': featured.skillLevel ?? 'open',
                'data-gender': featured.divisionGender ?? 'unknown',
                'data-venue': featured.location?.slug ?? '',
                'data-term': featured.termSlug ?? '',
                'data-mode': featured.signupModes?.includes('team') ? 'team' : 'individual',
              })}
            >
              <span class="f-cta-label">Register for Fall Leagues →</span>
              {(earlyBirdActive || featuredCloses) && (
                <span class="f-cta-note">
                  {earlyBirdActive && '$1,000/TEAM EARLY-BIRD THRU AUG 3'}
                  {earlyBirdActive && featuredCloses && ' · '}
                  {featuredCloses && `CLOSES ${featuredCloses.toUpperCase()}`}
                </span>
              )}
            </a>
          )}
          <a href="/pickup?facility=worthington" class="f-cta f-cta--secondary">
            <span class="f-cta-label">Play Pickup</span>
            <span class="f-cta-note">DROP IN · SEE THIS WEEK'S SESSIONS</span>
          </a>
          <a href="/join?src=worthington-classes" class="f-cta f-cta--tertiary">
            <span class="f-cta-label">Classes &amp; Camps</span>
            <span class="f-cta-note">LAUNCHING 2027 · GET NOTIFIED</span>
          </a>
        </div>

        <div class="f-fact-line">
          <span><b>535 Lakeview Plaza Blvd</b>, Worthington OH</span>
          <span class="ffl-div"></span>
          <span>OPEN 4PM–LATE · GAMES AS LATE AS 1AM</span>
          <span class="ffl-div"></span>
          <span><b>PLENTY OF FREE PARKING</b></span>
          <span class="ffl-div"></span>
          <span>YOUTH LEAGUES SAT &amp; SUN MORNINGS</span>
        </div>
      </div>
    </section>

    <!-- ============================================================
         WHAT'S HAPPENING — two-state (summer light now, fall rhythm)
    ============================================================ -->
    <section class="sec happening" id="happening" aria-label="What's happening">
      <div class="sec-inner">
        <div class="hap-head">
          <div>
            <div class="kicker-bar"></div>
            <h2 class="sec-title">What's Happening</h2>
            <p class="sec-desc">The real rhythm of the building — light through summer, full tilt when fall leagues kick off{fallKickoffDate ? ` ${fallKickoffDate}` : ''}.</p>
          </div>
          {hasFallSchedule && (
            <div class="hap-toggle">
              <button class="hap-tab hap-tab--on" id="tabNow" type="button">NOW · SUMMER</button>
              <button class="hap-tab" id="tabFall" type="button">THE FALL RHYTHM</button>
            </div>
          )}
        </div>

        <div class="now-grid">
          <div class="now-card">
            <span class="now-when">THU · FRI · SAT NIGHTS</span>
            <span class="now-what">Drop-In Pickup</span>
            <p class="now-note">Show up and play — balanced teams, kicks off on time. Live session times pulled from the schedule.</p>
            <a href="/pickup?facility=worthington" class="now-link">See sessions →</a>
          </div>
          <div class="now-card">
            <span class="now-when">SAT &amp; SUN MORNINGS</span>
            <span class="now-what">Youth Leagues</span>
            <p class="now-note">Boys' and girls' leagues — game-day energy before lunch.</p>
            <a href="/leagues?audience=youth" class="now-link">Youth leagues →</a>
          </div>
          <div class="now-card">
            <span class="now-when">ANY DAY · BY THE HOUR</span>
            <span class="now-what">Field Rentals</span>
            <p class="now-note">Book either field for training, parties, or team practice — online in two minutes.</p>
            <a href="/rent?facility=worthington" class="now-link">Book a field →</a>
          </div>
          {featured && (
            <div class="now-card">
              <span class="now-when">OPEN NOW{featuredCloses && ` · CLOSES ${featuredCloses.toUpperCase()}`}</span>
              <span class="now-what">Fall Registration</span>
              <p class="now-note">Nine adult divisions plus futsal. Early-bird team pricing through Aug 3.</p>
              <a href="#fall" class="now-link">Grab your spot →</a>
            </div>
          )}
        </div>

        {hasFallSchedule && (
          <Fragment>
            <div class="week-list">
              {liveFallRows.map((row) => (
                <div class="week-row"><span class="wr-day">{row.day}</span><span class="wr-what">{row.text}</span><span class={row.hasFutsal ? 'wr-tag wr-tag--futsal' : 'wr-tag'}>{row.tag}</span></div>
              ))}
              {!hasLiveThu && (
                <div class="week-row"><span class="wr-day">Thursday</span><span class="wr-what"><b>Open pickup</b> on both fields + make-up games · <b>Men's futsal</b> on the courts</span><span class="wr-tag wr-tag--futsal">PICKUP + FUTSAL</span></div>
              )}
              <div class="week-row week-row--live"><span class="wr-day">Fri · Sat</span><span class="wr-what"><b>Pickup, rentals &amp; events</b> — open late · <b>youth leagues Saturday morning</b></span><span class="wr-tag">OPEN PLAY</span></div>
            </div>
            <p class="hap-note">{fallKickoffDate && fallEndDate ? `Fall rhythm runs ${fallKickoffDate} – ${fallEndDate} · ` : 'Fall rhythm: '}7-game seasons, every team plays every week, no playoffs.</p>
          </Fragment>
        )}
      </div>
    </section>

    <!-- ============================================================
         THE BUILDING — real specs
    ============================================================ -->
    <section class="sec building" aria-label="The building">
      <div class="sec-inner">
        <div class="kicker-bar"></div>
        <h2 class="sec-title">The Building</h2>
        <p class="sec-desc">Built new in 2026 — not a retrofit. Here's exactly what you play on.</p>

        <div class="build-grid">
          <div>
            <div class="spec-cards">
              <div class="spec-card">
                <div class="spec-num">2</div>
                <div class="spec-name">Soccer fields — 110 × 60 ft</div>
                <p class="spec-note">Sized for an intense 6v6 or a comfortable 7v7. Fully boarded — the ball stays in, the game stays fast.</p>
              </div>
              <div class="spec-card">
                <div class="spec-num">2+</div>
                <div class="spec-name">Futsal courts — Sept 2026</div>
                <p class="spec-note">Dedicated hard courts, separate from the fields. Futsal leagues run without touching field time.</p>
              </div>
              <div class="spec-card">
                <div class="spec-num">1AM</div>
                <div class="spec-name">Open late</div>
                <p class="spec-note">Games regularly run as late as 1am — later than any comparable venue in Columbus.</p>
              </div>
              <div class="spec-card">
                <div class="spec-num">2026</div>
                <div class="spec-name">Newest venue in Columbus</div>
                <p class="spec-note">Brand-new construction, clean and well-maintained — players say so in the reviews.</p>
              </div>
            </div>

            <!-- Field diagram -->
            <div class="field-figure" aria-label="Field diagram">
              <svg viewBox="0 0 560 220" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="20" y="20" width="520" height="180" rx="8" stroke="#a3e635" stroke-width="2" fill="rgba(163,230,53,0.04)"/>
                <line x1="280" y1="20" x2="280" y2="200" stroke="rgba(163,230,53,0.35)" stroke-width="1.5"/>
                <circle cx="280" cy="110" r="34" stroke="rgba(163,230,53,0.35)" stroke-width="1.5"/>
                <rect x="20" y="75" width="26" height="70" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>
                <rect x="514" y="75" width="26" height="70" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>
                <text x="280" y="14" fill="rgba(255,255,255,0.6)" font-family="monospace" font-size="11" text-anchor="middle">110 FT</text>
                <text x="12" y="110" fill="rgba(255,255,255,0.6)" font-family="monospace" font-size="11" text-anchor="middle" transform="rotate(-90 12 110)">60 FT</text>
                <text x="280" y="216" fill="rgba(163,230,53,0.7)" font-family="monospace" font-size="10" text-anchor="middle">FULLY BOARDED · SAND-FILLED TURF</text>
              </svg>
              <p class="field-caption">EACH OF THE TWO FIELDS · BEST AT 6V6–7V7</p>
            </div>
          </div>

          <div class="diff-list">
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">Sand-filled turf — no rubber crumb</div>
              <p class="diff-copy">Truer roll, softer landings, and no black pellets in your socks, your car, or your washing machine.</p>
            </div></div>
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">Fully boarded fields</div>
              <p class="diff-copy">No throw-ins, no chasing balls — play off the walls and keep the tempo up.</p>
            </div></div>
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">A real halftime, every match</div>
              <p class="diff-copy">Games aren't piled back-to-back. Two 24-minute halves with a proper break.</p>
            </div></div>
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">Rate your ref after every game</div>
              <p class="diff-copy">Every match ends with a text or email to rate your referee — ratings feed continuous evaluation of the ref pool.</p>
            </div></div>
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">Plenty of spectator room</div>
              <p class="diff-copy">Seating and standing space for the people who came to watch you.</p>
            </div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         MEDIA STRIP — home for the growing footage/photo pipeline
    ============================================================ -->
    <section class="sec media-strip" aria-label="Inside the building">
      <div class="sec-inner">
        <div class="kicker-bar"></div>
        <h2 class="sec-title">Inside the Building</h2>
        <div class="media-grid">
          <div class="media-tile media-tile--tall">
            <video class="media-media" muted loop playsinline autoplay preload="metadata">
              <source src="/media/soccerone/worthington-reel.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="media-tile">
            <img class="media-media" src="/media/soccerone/still-entrance.jpg" alt="Front entrance at 535 Lakeview Plaza Blvd" loading="lazy" />
          </div>
          <div class="media-tile">
            <img class="media-media" src="/media/soccerone/still-action.jpg" alt="Pickup game on the boarded field" loading="lazy" />
          </div>
          <div class="media-tile">
            <img class="media-media" src="/media/soccerone/still-lockers.jpg" alt="Locker wall inside the venue" loading="lazy" />
          </div>
          <div class="media-tile">
            <img class="media-media" src="/media/soccerone/still-party.jpg" alt="Party room" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         FALL LEAGUES — pricing & answers (conversion block)
    ============================================================ -->
    {featured && (
      <section class="sec fall-block" id="fall" aria-label="Fall leagues pricing">
        <div class="sec-inner">
          <div class="fall-grid">
            <div>
              <h2 class="fall-title">
                {fallKickoffDate ? <>Fall leagues<br />kick off {fallKickoffDate}.</> : 'Fall leagues are coming.'}
              </h2>
              <p class="fall-copy">
                Nine adult divisions at Worthington — Co-Ed, Men's, Women's, and 30+/40+ tiers — plus futsal
                on the new courts. <b>7 games in 7 weeks, every team plays every week, no playoffs.</b>
              </p>
              <div class="fall-facts">
                {fallKickoffDate && fallEndDate && (
                  <span class="fall-fact">{`${fallKickoffDate} – ${fallEndDate}`.toUpperCase()}</span>
                )}
                <span class="fall-fact">6–11PM GAME SLOTS</span>
                <span class="fall-fact">YOUR DIVISION = YOUR NIGHT</span>
                <span class="fall-fact">REFS RATED EVERY GAME</span>
              </div>
            </div>
            <div class="price-card">
              <span class="price-dock">OPEN{featuredCloses && ` · CLOSES ${featuredCloses.toUpperCase()}`}</span>
              <div class="price-rows">
                {earlyBirdActive && (
                  <div class="price-row"><span class="pr-label">Team — early-bird thru Aug 3</span><span class="pr-val">$1,000</span></div>
                )}
                {teamPriceStr && (
                  <div class="price-row"><span class="pr-label">Team{earlyBirdActive ? ' — after Aug 3' : ''}</span><span class="pr-val">{teamPriceStr}</span></div>
                )}
                {soloPriceStr && (
                  <div class="price-row"><span class="pr-label">Solo / free agent</span><span class="pr-val">{soloPriceStr}</span></div>
                )}
                {depositStr && (
                  <div class="price-row"><span class="pr-label">Hold your spot</span><span class="pr-val">{depositStr} <small>deposit</small></span></div>
                )}
              </div>
              <a
                href={termAgg.multi ? '/leagues' : `/register/${featured.id}`}
                class="price-cta"
                {...(termAgg.multi ? {} : {
                  'data-so-register-cta': true,
                  'data-season-id': featured.id,
                  'data-level': featured.skillLevel ?? 'open',
                  'data-gender': featured.divisionGender ?? 'unknown',
                  'data-venue': featured.location?.slug ?? '',
                  'data-term': featured.termSlug ?? '',
                  'data-mode': featured.signupModes?.includes('team') ? 'team' : 'individual',
                })}
              >Register for Fall →</a>
              <p class="price-note">Secure checkout · powered by Aspire Sports</p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ============================================================
         GOOD TO KNOW
    ============================================================ -->
    <section class="sec know" aria-label="Good to know">
      <div class="sec-inner">
        <div class="kicker-bar"></div>
        <h2 class="sec-title">Good to Know</h2>
