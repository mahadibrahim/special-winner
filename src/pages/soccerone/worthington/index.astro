---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { SOCCERONE_CONTACT_EMAIL } from '@/lib/soccerone/contact';
---

<BaseLayout
  title="Worthington — SoccerOne | 3 Indoor Fields · 535 Lakeview Plaza Blvd"
  description="SoccerOne Worthington: 3 FIFA-approved indoor turf fields, adult leagues, youth programs, pickup, and field rentals. 535 Lakeview Plaza Blvd, Worthington OH. Open 7am–11pm daily."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <SoccerOneHeader currentFacility="worthington" />

  <main class="facility-main">

    <!-- ============================================================
         FACILITY HERO — photo-driven, warehouse soccer aesthetic
    ============================================================ -->
    <section class="f-hero" aria-label="Worthington facility">
      <!-- Background: real facility photo -->
      <div class="f-hero-bg" aria-hidden="true">
        <img
          src="https://images.unsplash.com/photo-1771909720886-a90afd1b37f5?w=2000&q=80&fm=jpg"
          alt="Worthington facility — interior field"
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/65 to-black"></div>
        <div class="f-hero-bottom-stripe" aria-hidden="true"></div>
      </div>

      <div class="f-hero-content">
        <!-- Breadcrumb -->
        <nav class="f-breadcrumb" aria-label="Breadcrumb">
          <a href="/soccerone" class="fbc-link">SoccerOne</a>
          <span class="fbc-sep" aria-hidden="true">—</span>
          <span class="fbc-current">Worthington</span>
        </nav>

        <!-- Header block -->
        <div class="f-hero-block">
          <div class="f-hero-left">
            <div class="f-hero-tag-row">
              <span class="f-tag f-tag--flagship">FLAGSHIP</span>
              <span class="f-tag f-tag--live">
                <span class="live-dot"></span>
                OPEN NOW
              </span>
            </div>
            <h1 class="f-hero-title">WORTHINGTON</h1>
            <div class="f-field-count">
              <span class="fc-num">3</span>
              <span class="fc-label">INDOOR FIELDS</span>
            </div>
            <div class="f-hero-address">
              535 Lakeview Plaza Blvd, Worthington, OH 43085
            </div>
            <div class="f-hero-hours mono">Open daily — 7:00 AM – 11:00 PM</div>
          </div>

          <div class="f-hero-right">
            <div class="f-hero-stats">
              <div class="fhs-item">
                <span class="fhs-num">FIFA</span>
                <span class="fhs-label">Approved turf</span>
              </div>
              <div class="fhs-div" aria-hidden="true"></div>
              <div class="fhs-item">
                <span class="fhs-num">700+</span>
                <span class="fhs-label">Lux lighting</span>
              </div>
              <div class="fhs-div" aria-hidden="true"></div>
              <div class="fhs-item">
                <span class="fhs-num">400+</span>
                <span class="fhs-label">Active members</span>
              </div>
            </div>
            <div class="f-hero-ctas">
              <a href="/soccerone/rent?facility=worthington" class="f-cta-primary">Book a Field</a>
              <a href="/soccerone/leagues?facility=worthington" class="f-cta-secondary">View Leagues</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         THIS WEEK'S SCHEDULE — scoreboard style
    ============================================================ -->
    <section class="schedule-section" aria-label="This week's schedule">
      <div class="schedule-inner">
        <div class="schedule-header">
          <div class="sh-left">
            <span class="section-num-sm">01.</span>
            <h2 class="schedule-title">This Week's Schedule</h2>
          </div>
          <div class="sh-right">
            <span class="schedule-date mono">A typical week</span>
            <a href="/soccerone/leagues?facility=worthington" class="view-all-link">View all leagues →</a>
          </div>
        </div>

        <!-- Schedule grid — scoreboard style -->
        <div class="schedule-board">
          <div class="sb-header-row">
            <div class="sbh-time">TIME</div>
            <div class="sbh-col">FIELD 1</div>
            <div class="sbh-col">FIELD 2</div>
            <div class="sbh-col">FIELD 3</div>
          </div>

          <div class="sb-row sb-row--event">
            <div class="sb-time mono">7:00 AM</div>
            <div class="sb-cell sb-cell--practice">
              <span class="sbc-type">YOUTH</span>
              <span class="sbc-name">Academy Training</span>
            </div>
            <div class="sb-cell sb-cell--open">
              <span class="sbc-type">OPEN</span>
              <span class="sbc-name">Available</span>
              <a href="/soccerone/rent?facility=worthington" class="sb-book-link">Book →</a>
            </div>
            <div class="sb-cell sb-cell--open">
              <span class="sbc-type">OPEN</span>
              <span class="sbc-name">Available</span>
              <a href="/soccerone/rent?facility=worthington" class="sb-book-link">Book →</a>
            </div>
          </div>

          <div class="sb-row">
            <div class="sb-time mono">10:00 AM</div>
            <div class="sb-cell sb-cell--league">
              <span class="sbc-type">LEAGUE</span>
              <span class="sbc-name">Women's Coed</span>
            </div>
            <div class="sb-cell sb-cell--practice">
              <span class="sbc-type">TRAINING</span>
              <span class="sbc-name">Youth Skills Camp</span>
            </div>
            <div class="sb-cell sb-cell--open">
              <span class="sbc-type">OPEN</span>
              <span class="sbc-name">Available</span>
              <a href="/soccerone/rent?facility=worthington" class="sb-book-link">Book →</a>
            </div>
          </div>

          <div class="sb-row">
            <div class="sb-time mono">12:00 PM</div>
            <div class="sb-cell sb-cell--rental">
              <span class="sbc-type">RENTAL</span>
              <span class="sbc-name">Private — Martinez</span>
            </div>
            <div class="sb-cell sb-cell--open">
              <span class="sbc-type">OPEN</span>
              <span class="sbc-name">Available</span>
              <a href="/soccerone/rent?facility=worthington" class="sb-book-link">Book →</a>
            </div>
            <div class="sb-cell sb-cell--pickup">
              <span class="sbc-type">PICKUP</span>
              <span class="sbc-name">Lunch Pickup</span>
            </div>
          </div>

          <div class="sb-row">
            <div class="sb-time mono">5:00 PM</div>
            <div class="sb-cell sb-cell--open">
              <span class="sbc-type">OPEN</span>
              <span class="sbc-name">Available</span>
              <a href="/soccerone/rent?facility=worthington" class="sb-book-link">Book →</a>
            </div>
            <div class="sb-cell sb-cell--rental">
              <span class="sbc-type">RENTAL</span>
              <span class="sbc-name">Corporate — Acme Co.</span>
            </div>
            <div class="sb-cell sb-cell--youth">
              <span class="sbc-type">YOUTH</span>
              <span class="sbc-name">U14 Practice</span>
            </div>
          </div>

          <div class="sb-row sb-row--prime">
            <div class="sb-time mono">7:00 PM</div>
            <div class="sb-cell sb-cell--league">
              <span class="sbc-type">LEAGUE</span>
              <span class="sbc-name">Adult Coed League</span>
            </div>
            <div class="sb-cell sb-cell--league">
              <span class="sbc-type">LEAGUE</span>
              <span class="sbc-name">Adult Premier League</span>
            </div>
            <div class="sb-cell sb-cell--pickup">
              <span class="sbc-type">PICKUP</span>
              <span class="sbc-name">Evening Pickup (Open)</span>
            </div>
          </div>

          <div class="sb-row">
            <div class="sb-time mono">9:00 PM</div>
            <div class="sb-cell sb-cell--league">
              <span class="sbc-type">LEAGUE</span>
              <span class="sbc-name">Adult Coed League</span>
            </div>
            <div class="sb-cell sb-cell--open">
              <span class="sbc-type">OPEN</span>
              <span class="sbc-name">Available</span>
              <a href="/soccerone/rent?facility=worthington" class="sb-book-link">Book →</a>
            </div>
            <div class="sb-cell sb-cell--pickup">
              <span class="sbc-type">PICKUP</span>
              <span class="sbc-name">Late Pickup</span>
            </div>
          </div>
        </div>

        <!-- Legend -->
        <div class="schedule-legend">
          <div class="sl-item"><span class="sl-dot sl-league"></span>League</div>
          <div class="sl-item"><span class="sl-dot sl-pickup"></span>Pickup</div>
          <div class="sl-item"><span class="sl-dot sl-rental"></span>Private Rental</div>
          <div class="sl-item"><span class="sl-dot sl-practice"></span>Training</div>
          <div class="sl-item"><span class="sl-dot sl-open"></span>Available to Book</div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         FIELD SPECS — technical grid
    ============================================================ -->
    <section class="specs-section" aria-label="Field specifications">
      <div class="specs-inner">
        <div class="specs-header">
          <span class="section-num-sm">02.</span>
          <h2 class="specs-title">What's Here</h2>
          <p class="specs-desc">All fields are FIFA-approved, professionally maintained. Industrial warehouse conversion with stadium lighting.</p>
        </div>

        <div class="specs-grid">
          <!-- Field 1 card -->
          <div class="spec-card spec-card--primary">
            <div class="spec-card-num">FIELD 01</div>
            <div class="spec-card-details">
              <div class="scd-row">
                <span class="scd-label">SURFACE</span>
                <span class="scd-val">FieldTurf® Revolution 360<br />FIFA Quality Pro certified</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">SIZE</span>
                <span class="scd-val mono">200 × 85 ft (full-size)</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">LIGHTING</span>
                <span class="scd-val">700+ lux LED, color-corrected for video</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">USES</span>
                <span class="scd-val">Adult leagues · Youth programs · Rentals</span>
              </div>
            </div>
          </div>

          <!-- Fields 2+3 combined card -->
          <div class="spec-card">
            <div class="spec-card-num">FIELDS 02–03</div>
            <div class="spec-card-details">
              <div class="scd-row">
                <span class="scd-label">SURFACE</span>
                <span class="scd-val">FieldTurf® Revolution 360<br />FIFA Quality Pro certified</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">SIZE</span>
                <span class="scd-val mono">180 × 80 ft each</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">LIGHTING</span>
                <span class="scd-val">600+ lux LED, scoreboard per field</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">USES</span>
                <span class="scd-val">Pickup · Youth clinics · Rentals</span>
              </div>
            </div>
          </div>

          <!-- Facility amenities -->
          <div class="spec-card spec-card--amenities">
            <div class="spec-card-num">FACILITY</div>
            <div class="amenities-list">
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Locker rooms with showers</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">100+ space free parking</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Concessions + coffee bar</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Team benches & spectator seating</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Pro Shop (balls, shinguards, jerseys)</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Birthday party room</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">High-speed WiFi throughout</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Video replay screens at bench areas</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         HOURS & DIRECTIONS
    ============================================================ -->
    <section class="info-section" aria-label="Hours and directions">
      <div class="info-inner">
        <div class="info-hours">
          <span class="section-num-sm">03.</span>
          <h2 class="info-title">Hours &amp; Directions</h2>
          <div class="hours-grid">
            <div class="hours-row">
              <span class="hours-day">Monday – Friday</span>
              <span class="hours-time mono">7:00 AM – 11:00 PM</span>
            </div>
            <div class="hours-row">
              <span class="hours-day">Saturday</span>
              <span class="hours-time mono">7:00 AM – 11:00 PM</span>
            </div>
            <div class="hours-row">
              <span class="hours-day">Sunday</span>
              <span class="hours-time mono">7:00 AM – 11:00 PM</span>
            </div>
            <div class="hours-note">Closed Thanksgiving &amp; Christmas Day</div>
          </div>
          <div class="info-address-block">
            <div class="iab-name">SoccerOne Worthington</div>
            <div class="iab-addr">535 Lakeview Plaza Blvd<br />Worthington, OH 43085</div>
            <div class="iab-links">
              <a href="https://maps.google.com/?q=535+Lakeview+Plaza+Blvd,+Worthington,+OH+43085" target="_blank" rel="noopener noreferrer" class="iab-link">Get Directions →</a>
              <a href={`mailto:${SOCCERONE_CONTACT_EMAIL}`} class="iab-link">{SOCCERONE_CONTACT_EMAIL}</a>
            </div>
          </div>
        </div>

        <!-- Map placeholder -->
        <div class="info-map" aria-label="Map location placeholder">
          <div class="map-placeholder">
            <div class="map-grid">
              <!-- Stylized map grid -->
              <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="map-svg">
                <rect width="400" height="300" fill="#0e1a0e"/>
                <!-- Streets -->
                <line x1="0" y1="150" x2="400" y2="150" stroke="rgba(163,230,53,0.15)" stroke-width="3"/>
                <line x1="200" y1="0" x2="200" y2="300" stroke="rgba(163,230,53,0.15)" stroke-width="3"/>
                <line x1="0" y1="80" x2="400" y2="80" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
                <line x1="0" y1="220" x2="400" y2="220" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
                <line x1="100" y1="0" x2="100" y2="300" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
                <line x1="300" y1="0" x2="300" y2="300" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
                <!-- City blocks -->
                <rect x="10" y="10" width="80" height="60" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="110" y="10" width="80" height="60" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="210" y="10" width="80" height="60" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="310" y="10" width="80" height="60" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="10" y="90" width="80" height="50" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="110" y="90" width="80" height="50" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="310" y="90" width="80" height="50" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <!-- SoccerOne marker -->
                <rect x="175" y="105" width="50" height="35" rx="4" fill="#a3e635"/>
                <text x="200" y="124" text-anchor="middle" font-size="8" font-weight="bold" fill="#0a0a0d" font-family="monospace">S1</text>
                <!-- Location pin -->
                <circle cx="200" cy="95" r="8" fill="#a3e635"/>
                <circle cx="200" cy="95" r="3" fill="#0a0a0d"/>
                <line x1="200" y1="103" x2="200" y2="110" stroke="#a3e635" stroke-width="2"/>
                <!-- Street labels -->
                <text x="200" y="165" text-anchor="middle" font-size="8" fill="rgba(163,230,53,0.5)" font-family="monospace">LAKEVIEW PLAZA BLVD</text>
                <text x="15" y="148" font-size="7" fill="rgba(255,255,255,0.3)" font-family="monospace">WORTHINGTON</text>
              </svg>
            </div>
            <div class="map-overlay-label">
              <div class="mol-name">SoccerOne Worthington</div>
              <div class="mol-addr">535 Lakeview Plaza Blvd</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CTA STRIP
    ============================================================ -->
    <section class="facility-cta-strip" aria-label="Get started">
      <div class="fcs-inner">
        <div class="fcs-text">
          <h2 class="fcs-title">Ready to play at Worthington?</h2>
          <p class="fcs-sub">Join a league, book a field, or just show up for pickup — all from one account.</p>
        </div>
        <div class="fcs-buttons">
          <a href="/soccerone/leagues?facility=worthington" class="fcs-btn-primary">
            See Open Leagues
          </a>
          <a href="/soccerone/rent?facility=worthington" class="fcs-btn-secondary">
            Book a Field
          </a>
          <a href="/soccerone/memberships" class="fcs-btn-ghost">
            View Memberships
          </a>
        </div>
      </div>
    </section>

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: #a3e635;
      --bg: #0a0a0d;
      --bg-2: #0e0e10;
      --white: #ffffff;
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: 'JetBrains Mono', monospace; }

    .facility-main { flex: 1; font-family: 'DM Sans', sans-serif; }

    /* ---- FACILITY HERO ---- */
    .f-hero {
      position: relative;
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      overflow: hidden;
      background: #050d04;
    }

    .f-hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .f-hero-bottom-stripe {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #a3e635 0%, rgba(163,230,53,0.3) 50%, transparent 100%);
    }

    .f-hero-content {
      position: relative;
      z-index: 10;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      padding: 2.5rem 2rem 4rem;
    }

    /* Breadcrumb */
    .f-breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin-bottom: 2.5rem;
      animation: fadeUp 0.8s ease-out 0.1s both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fbc-link {
      font-size: 0.8125rem;
      font-weight: 500;
      color: rgba(163,230,53,0.6);
      text-decoration: none;
      transition: color 0.15s;
    }
    .fbc-link:hover { color: #a3e635; }
    .fbc-sep { color: rgba(255,255,255,0.2); font-size: 0.75rem; }
    .fbc-current { font-size: 0.8125rem; color: rgba(255,255,255,0.4); }

    .f-hero-block {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .f-hero-left { animation: fadeUp 0.8s ease-out 0.2s both; }
    .f-hero-right { animation: fadeUp 0.8s ease-out 0.4s both; }

    .f-hero-tag-row {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin-bottom: 0.75rem;
    }

    .f-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.5625rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      padding: 3px 8px;
      border-radius: 3px;
    }
    .f-tag--flagship {
      background: rgba(163,230,53,0.12);
      color: #a3e635;
      border: 1px solid rgba(163,230,53,0.25);
    }
    .f-tag--live {
      display: flex;
      align-items: center;
      gap: 5px;
      background: rgba(74,222,128,0.1);
      color: #86efac;
      border: 1px solid rgba(74,222,128,0.2);
    }

    .live-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #86efac;
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .f-hero-title {
      font-family: 'Anton', sans-serif;
      font-size: clamp(4rem, 10vw, 9rem);
      color: #ffffff;
      line-height: 0.9;
      letter-spacing: 0.01em;
      margin-bottom: 0.75rem;
    }

    .f-field-count {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .fc-num {
      font-family: 'Anton', sans-serif;
      font-size: 3.5rem;
      color: #a3e635;
      line-height: 1;
    }
    .fc-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
