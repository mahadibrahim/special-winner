    .wr-tag--futsal { color: var(--so-sky-soft); border-color: var(--so-sky-a25); }
    .happening.show-fall .week-list { display: flex; }
    .happening.show-fall .now-grid { display: none; }
    .hap-note { margin-top: 1.1rem; font-size: 0.8125rem; color: rgba(255,255,255,0.35); }

    /* ---- THE BUILDING — real specs, no FIFA language ---- */
    .building { background: var(--bg); }
