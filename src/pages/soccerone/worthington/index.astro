---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { SOCCERONE_CONTACT_EMAIL } from '@/lib/soccerone/contact';
import { WORTHINGTON_JSONLD } from '@/lib/seo/soccerone-jsonld';

// Live season data — org-scoped fetch pinned to the Worthington location,
// same pattern as src/pages/soccerone/index.astro:16-40.
async function fetchOpenSeasons(audience: 'adult' | 'youth') {
  try {
    const url = new URL('/api/public/seasons', Astro.url);
    url.searchParams.set('location', 'soccerone-worthington');
    url.searchParams.set('audience', audience);
    // Dev-only guard: Astro.url reconstructs from the forwarded Host header,
    // so a port-less Host (e.g. `curl -H "Host: soccerone.localhost"`) yields
    // port 80 and the self-fetch misses the dev server. Pin the dev port.
    // Do NOT rewrite the hostname to localhost: undici silently drops an
    // explicit Host header (forbidden fetch header), so the tenant must stay
    // in the URL or org resolution falls back to the default org.
    if (url.hostname.endsWith('.localhost') && !url.port) url.port = '4321';
    const res = await fetch(url, {
      headers: { Host: Astro.request.headers.get('host') ?? '' },
    });
    if (!res.ok) return [];
    const body = await res.json();
    const todayIso = new Date().toISOString().slice(0, 10);
    return (body.seasons ?? [])
      .filter((s: any) => s.signupMode !== 'interest')
      .filter((s: any) => !s.startDate || String(s.startDate).slice(0, 10) >= todayIso);
  } catch (err) {
    console.error('[soccerone/worthington] failed to load ' + audience + ' seasons', err);
    return [];
  }
}

const [adultSeasons, youthSeasons] = await Promise.all([
  fetchOpenSeasons('adult'),
  fetchOpenSeasons('youth'),
]);

// The hero's priority register CTA binds to the first open ADULT season at
// this location — Worthington's youth leagues are weekend-morning drop-in
// programs, not a registration CTA the hero should ever surface. youthSeasons
// is fetched now (same shape as the homepage) for Task 3's "What's Happening"
// summer card, which needs it live.
const featured = adultSeasons[0] ?? null;

// registrationCloses is a timestamp (full ISO instant): display the
// deadline in the org's local timezone, not the server's.
const featuredCloses = featured?.registrationCloses
  ? new Date(featured.registrationCloses).toLocaleDateString('en-US', {
      weekday: 'short', month: 'short', day: 'numeric', timeZone: 'America/New_York',
    })
  : null;

// The $1,000/team early-bird promo (thru Aug 3) is a static founder
// decision, not a season-catalog field — date-gate it off "today" in the
// org's timezone (en-CA yields YYYY-MM-DD, directly comparable to the cutoff).
const todayEasternIso = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
const earlyBirdActive = todayEasternIso <= '2026-08-03';

// Guarded price strings for the fall pricing block (Task 4) — never render
// "$null" when a field is unset.
const teamPriceStr = featured?.teamPrice != null ? `$${featured.teamPrice}` : null;
const soloPriceStr = featured?.price != null ? `$${featured.price}` : null;
const depositStr = featured?.deposit != null ? `$${featured.deposit}` : null;

import { setMarketingEdgeCache } from '@/lib/http/edge-cache';
setMarketingEdgeCache(Astro); // after fetches; a degraded (empty-seasons) render may cache for 60s — SWR refreshes it
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title="Worthington — SoccerOne (Soccer One) | Indoor Soccer · 535 Lakeview Plaza Blvd"
  description="SoccerOne Worthington — Soccer One indoor soccer. Two 110×60 boarded fields with sand-filled turf, adult leagues, youth weekend leagues, pickup, and field rentals. Futsal courts open September. 535 Lakeview Plaza Blvd, Worthington OH."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(WORTHINGTON_JSONLD)} />
  </Fragment>

  <SoccerOneHeader currentFacility="worthington" />

  <main class="facility-main">

    <!-- ============================================================
         HERO — shrunk ~55vh, real venue footage, priority CTAs
    ============================================================ -->
    <section class="f-hero" aria-label="Worthington hero">
      <!-- Background: real venue footage -->
      <div class="f-hero-bg" aria-hidden="true">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/media/soccerone/worthington-hero-poster.jpg"
          class="f-hero-video"
        >
          <source src="/media/soccerone/worthington-hero.mp4" type="video/mp4" />
        </video>
      </div>

      <div class="f-hero-inner">
        <nav class="f-breadcrumb" aria-label="Breadcrumb"><a href="/">Locations</a> / Worthington</nav>
        <h1 class="f-title">Worthington</h1>
        <p class="f-sub">
          Columbus's newest indoor soccer venue. <b>Two 110×60 boarded fields</b>, <b>futsal courts</b>
          arriving September, sand-filled turf, and games as late as 1am.
        </p>

        <div class="f-cta-row">
          {featured && (
            <a
              href={`/register/${featured.id}`}
              class="f-cta f-cta--primary"
              data-so-register-cta
              data-season-id={featured.id}
              data-level={featured.skillLevel ?? 'open'}
              data-gender={featured.divisionGender ?? 'unknown'}
              data-venue={featured.location?.slug ?? ''}
              data-term={featured.termSlug ?? ''}
              data-mode={featured.signupModes?.includes('team') ? 'team' : 'individual'}
            >
              <span class="f-cta-label">Register for Fall Leagues →</span>
              {(earlyBirdActive || featuredCloses) && (
                <span class="f-cta-note">
                  {earlyBirdActive && '$1,000/TEAM EARLY-BIRD THRU AUG 3'}
                  {earlyBirdActive && featuredCloses && ' · '}
                  {featuredCloses && `CLOSES ${featuredCloses.toUpperCase()}`}
                </span>
              )}
            </a>
          )}
          <a href="/pickup?facility=worthington" class="f-cta f-cta--secondary">
            <span class="f-cta-label">Play Pickup</span>
            <span class="f-cta-note">DROP IN · SEE THIS WEEK'S SESSIONS</span>
          </a>
          <a href="/join?src=worthington-classes" class="f-cta f-cta--tertiary">
            <span class="f-cta-label">Classes &amp; Camps</span>
            <span class="f-cta-note">LAUNCHING 2027 · GET NOTIFIED</span>
          </a>
        </div>

        <div class="f-fact-line">
          <span><b>535 Lakeview Plaza Blvd</b>, Worthington OH</span>
          <span class="ffl-div"></span>
          <span>OPEN 4PM–LATE · GAMES AS LATE AS 1AM</span>
          <span class="ffl-div"></span>
          <span><b>PLENTY OF FREE PARKING</b></span>
          <span class="ffl-div"></span>
          <span>YOUTH LEAGUES SAT &amp; SUN MORNINGS</span>
        </div>
      </div>
    </section>

    <!-- What's Happening lands in Task 3 -->

    <!-- ============================================================
         FIELD SPECS — technical grid
    ============================================================ -->
    <section class="specs-section" aria-label="Field specifications">
      <div class="specs-inner">
        <div class="specs-header">
          <span class="section-num-sm">02.</span>
          <h2 class="specs-title">What's Here</h2>
          <p class="specs-desc">All fields are FIFA-approved, professionally maintained. Industrial warehouse conversion with stadium lighting.</p>
        </div>

        <div class="specs-grid">
          <!-- Field 1 card -->
          <div class="spec-card spec-card--primary">
            <div class="spec-card-num">FIELD 01</div>
            <div class="spec-card-details">
              <div class="scd-row">
                <span class="scd-label">SURFACE</span>
                <span class="scd-val">FieldTurf® Revolution 360<br />FIFA Quality Pro certified</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">SIZE</span>
                <span class="scd-val mono">200 × 85 ft (full-size)</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">LIGHTING</span>
                <span class="scd-val">700+ lux LED, color-corrected for video</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">USES</span>
                <span class="scd-val">Adult leagues · Youth programs · Rentals</span>
              </div>
            </div>
          </div>

          <!-- Fields 2+3 combined card -->
          <div class="spec-card">
            <div class="spec-card-num">FIELDS 02–03</div>
            <div class="spec-card-details">
              <div class="scd-row">
                <span class="scd-label">SURFACE</span>
                <span class="scd-val">FieldTurf® Revolution 360<br />FIFA Quality Pro certified</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">SIZE</span>
                <span class="scd-val mono">180 × 80 ft each</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">LIGHTING</span>
                <span class="scd-val">600+ lux LED, scoreboard per field</span>
              </div>
              <div class="scd-row">
                <span class="scd-label">USES</span>
                <span class="scd-val">Leagues · Pickup · Rentals</span>
              </div>
            </div>
          </div>

          <!-- Facility amenities -->
          <div class="spec-card spec-card--amenities">
            <div class="spec-card-num">FACILITY</div>
            <div class="amenities-list">
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Locker rooms with showers</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">100+ space free parking</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Concessions + coffee bar</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Team benches & spectator seating</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Pro Shop (balls, shinguards, jerseys)</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Birthday party room</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">High-speed WiFi throughout</span>
              </div>
              <div class="amenity">
                <span class="amenity-check">✓</span>
                <span class="amenity-text">Video replay screens at bench areas</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         HOURS & DIRECTIONS
    ============================================================ -->
    <section class="info-section" aria-label="Hours and directions">
      <div class="info-inner">
        <div class="info-hours">
          <span class="section-num-sm">03.</span>
          <h2 class="info-title">Hours &amp; Directions</h2>
          <div class="hours-grid">
            <div class="hours-row">
              <span class="hours-day">Monday – Friday</span>
              <span class="hours-time mono">4:00 PM – 12:00 AM</span>
            </div>
            <div class="hours-row">
              <span class="hours-day">Saturday</span>
              <span class="hours-time mono">4:00 PM – 12:00 AM</span>
            </div>
            <div class="hours-row">
              <span class="hours-day">Sunday</span>
              <span class="hours-time mono">4:00 PM – 12:00 AM</span>
            </div>
            <div class="hours-note">Closed Thanksgiving &amp; Christmas Day</div>
          </div>
          <div class="info-address-block">
            <div class="iab-name">SoccerOne Worthington</div>
            <div class="iab-addr">535 Lakeview Plaza Blvd<br />Worthington, OH 43085</div>
            <div class="iab-links">
              <a href="https://maps.google.com/?q=535+Lakeview+Plaza+Blvd,+Worthington,+OH+43085" target="_blank" rel="noopener noreferrer" class="iab-link">Get Directions →</a>
              <a href={`mailto:${SOCCERONE_CONTACT_EMAIL}`} class="iab-link">{SOCCERONE_CONTACT_EMAIL}</a>
            </div>
          </div>
        </div>

        <!-- Map placeholder -->
        <div class="info-map" aria-label="Map location placeholder">
          <div class="map-placeholder">
            <div class="map-grid">
              <!-- Stylized map grid -->
              <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="map-svg">
                <rect width="400" height="300" fill="#0e1a0e"/>
                <!-- Streets -->
                <line x1="0" y1="150" x2="400" y2="150" stroke="rgba(163,230,53,0.15)" stroke-width="3"/>
                <line x1="200" y1="0" x2="200" y2="300" stroke="rgba(163,230,53,0.15)" stroke-width="3"/>
                <line x1="0" y1="80" x2="400" y2="80" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
                <line x1="0" y1="220" x2="400" y2="220" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
                <line x1="100" y1="0" x2="100" y2="300" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
                <line x1="300" y1="0" x2="300" y2="300" stroke="rgba(255,255,255,0.05)" stroke-width="1.5"/>
                <!-- City blocks -->
                <rect x="10" y="10" width="80" height="60" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="110" y="10" width="80" height="60" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="210" y="10" width="80" height="60" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="310" y="10" width="80" height="60" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="10" y="90" width="80" height="50" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="110" y="90" width="80" height="50" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <rect x="310" y="90" width="80" height="50" rx="2" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <!-- SoccerOne marker -->
                <rect x="175" y="105" width="50" height="35" rx="4" fill="#a3e635"/>
                <text x="200" y="124" text-anchor="middle" font-size="8" font-weight="bold" fill="#0a0a0d" font-family="monospace">S1</text>
                <!-- Location pin -->
                <circle cx="200" cy="95" r="8" fill="#a3e635"/>
                <circle cx="200" cy="95" r="3" fill="#0a0a0d"/>
                <line x1="200" y1="103" x2="200" y2="110" stroke="#a3e635" stroke-width="2"/>
                <!-- Street labels -->
                <text x="200" y="165" text-anchor="middle" font-size="8" fill="rgba(163,230,53,0.5)" font-family="monospace">LAKEVIEW PLAZA BLVD</text>
                <text x="15" y="148" font-size="7" fill="rgba(255,255,255,0.3)" font-family="monospace">WORTHINGTON</text>
              </svg>
            </div>
            <div class="map-overlay-label">
              <div class="mol-name">SoccerOne Worthington</div>
              <div class="mol-addr">535 Lakeview Plaza Blvd</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CTA STRIP
    ============================================================ -->
    <section class="facility-cta-strip" aria-label="Get started">
      <div class="fcs-inner">
        <div class="fcs-text">
          <h2 class="fcs-title">Ready to play at Worthington?</h2>
          <p class="fcs-sub">Join a league, book a field, or just show up for pickup — all from one account.</p>
        </div>
        <div class="fcs-buttons">
          <a href="/leagues?facility=worthington" class="fcs-btn-primary">
            See Open Leagues
          </a>
          <a href="/rent?facility=worthington" class="fcs-btn-secondary">
            Book a Field
          </a>
          <a href="/memberships" class="fcs-btn-ghost">
            View Memberships
          </a>
        </div>
      </div>
    </section>

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --white: #ffffff;
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }

    .facility-main { flex: 1; font-family: var(--so-font-body); }

    /* ============================================================
       HERO — shrunk ~55vh, real venue footage, priority CTAs
    ============================================================ */
    .f-hero {
      position: relative;
      min-height: 55vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      overflow: hidden;
      background: #0a120c;
    }

    .f-hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .f-hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .f-hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 50% at 30% 20%, var(--so-lime-a06), transparent 60%),
        linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.55) 55%, rgba(10,10,13,0.96) 100%);
    }

    .f-hero-inner {
      position: relative;
      z-index: 5;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      padding: 4.5rem 2rem 2rem;
    }

    .f-breadcrumb {
      font-family: var(--so-font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.4);
      margin-bottom: 0.875rem;
    }
    .f-breadcrumb a { color: inherit; text-decoration: none; }
    .f-breadcrumb a:hover { color: var(--so-lime); }

    .f-title {
      font-family: var(--so-font-display);
      font-size: clamp(3rem, 8vw, 6.5rem);
      line-height: 0.95;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: #ffffff;
    }

    .f-sub {
      font-size: 1.0625rem;
      color: rgba(255,255,255,0.65);
      line-height: 1.55;
      max-width: 620px;
      margin-top: 0.875rem;
    }
    .f-sub b { color: #fff; font-weight: 600; }

    /* Priority CTA row — leagues > pickup > classes/camps */
    .f-cta-row {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      align-items: stretch;
      margin-top: 1.5rem;
    }
    .f-cta {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      text-decoration: none;
      border-radius: var(--so-radius-md);
      padding: 0.8rem 1.4rem;
    }
    .f-cta-label { font-size: 0.9375rem; font-weight: 700; letter-spacing: 0.02em; }
    .f-cta-note { font-family: var(--so-font-mono); font-size: 0.5625rem; letter-spacing: 0.06em; }
    .f-cta--primary { background: var(--so-lime); color: var(--so-ink); }
    .f-cta--primary:hover { background: var(--so-lime-bright); }
    .f-cta--primary .f-cta-note { color: rgba(10,10,13,0.65); }
    .f-cta--secondary { background: rgba(255,255,255,0.06); border: 1.5px solid var(--so-lime-a40); color: #fff; }
    .f-cta--secondary:hover { border-color: var(--so-lime); }
    .f-cta--secondary .f-cta-note { color: var(--so-lime-a70); }
    .f-cta--tertiary { background: none; border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.75); }
    .f-cta--tertiary:hover { border-color: rgba(255,255,255,0.4); color: #fff; }
    .f-cta--tertiary .f-cta-note { color: rgba(255,255,255,0.35); }

    .f-fact-line {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
      padding-bottom: 0.25rem;
      font-family: var(--so-font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.45);
    }
    .ffl-div { width: 1px; height: 13px; background: rgba(255,255,255,0.15); }
    .f-fact-line b { color: rgba(255,255,255,0.85); font-weight: 600; }

    /* Shared "small numeral" label used by the specs/info sections below. */
    .section-num-sm {
      font-family: var(--so-font-display);
      font-size: 2.5rem;
      color: var(--so-lime-a15);
      line-height: 1;
    }

    /* ---- SPECS ---- */
    .specs-section {
      background: var(--bg-2);
      padding: 5rem 0;
      border-bottom: 1px solid var(--border);
    }

    .specs-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .specs-header {
      margin-bottom: 3rem;
    }

    .specs-title {
      font-family: var(--so-font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      color: #ffffff;
      letter-spacing: 0.01em;
      line-height: 1;
      margin: 0.5rem 0 0.875rem;
    }

    .specs-desc {
      font-size: 1.0625rem;
      color: var(--muted);
      max-width: 560px;
      line-height: 1.55;
    }

    .specs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .spec-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: var(--so-radius-md);
      padding: 2rem;
    }
    .spec-card--primary { border-color: var(--so-lime-a20); }

    .spec-card-num {
      font-family: var(--so-font-mono);
      font-size: 0.5625rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      color: var(--so-lime-a60);
      margin-bottom: 1.5rem;
    }

    .spec-card-details { display: flex; flex-direction: column; gap: 1rem; }

    .scd-row {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 0.75rem;
      align-items: start;
    }

    .scd-label {
      font-family: var(--so-font-mono);
      font-size: 0.5rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--so-lime-a50);
      padding-top: 2px;
      text-transform: uppercase;
    }

    .scd-val {
      font-size: 0.9375rem;
      color: rgba(255,255,255,0.7);
      line-height: 1.4;
    }
    .scd-val.mono {
      font-family: var(--so-font-mono);
      font-size: 0.875rem;
    }

    /* Amenities */
    .spec-card--amenities {}
    .amenities-list {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }
    .amenity {
      display: flex;
      align-items: flex-start;
      gap: 0.625rem;
    }
    .amenity-check {
      color: var(--so-lime);
      font-weight: 700;
      font-size: 0.875rem;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .amenity-text {
      font-size: 0.9375rem;
      color: rgba(255,255,255,0.65);
    }

    /* ---- INFO SECTION ---- */
    .info-section {
      background: var(--bg);
      padding: 5rem 0;
      border-bottom: 1px solid var(--border);
    }

    .info-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .info-title {
      font-family: var(--so-font-display);
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      color: #ffffff;
      letter-spacing: 0.01em;
      margin: 0.5rem 0 2rem;
    }

    .hours-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      border: 1px solid var(--border);
      border-radius: var(--so-radius-md);
      overflow: hidden;
      margin-bottom: 2rem;
    }

    .hours-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.875rem 1.25rem;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      font-size: 0.9375rem;
    }
    .hours-row:last-child { border-bottom: none; }
    .hours-day { color: rgba(255,255,255,0.7); font-weight: 500; }
    .hours-time {
      font-family: var(--so-font-mono);
      font-size: 0.875rem;
      color: var(--so-lime);
    }
    .hours-note {
      font-size: 0.8125rem;
      color: rgba(255,255,255,0.3);
      padding: 0.75rem 1.25rem;
      border-top: 1px solid rgba(255,255,255,0.04);
      font-style: italic;
    }

    .info-address-block { display: flex; flex-direction: column; gap: 0.375rem; }
    .iab-name { font-weight: 700; font-size: 1rem; color: #ffffff; }
    .iab-addr { font-size: 0.9375rem; color: var(--muted); line-height: 1.5; }
    .iab-links { display: flex; gap: 1.25rem; margin-top: 0.75rem; flex-wrap: wrap; }
    .iab-link { font-size: 0.875rem; color: var(--so-lime-a70); text-decoration: none; transition: color 0.15s; }
    .iab-link:hover { color: var(--so-lime); }

    /* Map */
    .info-map { position: relative; }
    .map-placeholder {
      border-radius: var(--so-radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
      position: relative;
      aspect-ratio: 4/3;
      background: #0e1a0e;
    }
    .map-grid { position: absolute; inset: 0; }
    .map-svg { width: 100%; height: 100%; }

    .map-overlay-label {
      position: absolute;
      bottom: 1rem;
      left: 1rem;
      background: rgba(10,10,13,0.85);
      border: 1px solid var(--so-lime-a20);
      border-radius: var(--so-radius-sm);
      padding: 0.625rem 1rem;
      backdrop-filter: blur(4px);
    }
    .mol-name {
      font-family: var(--so-font-body);
      font-size: 0.8125rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 1px;
    }
    .mol-addr {
      font-family: var(--so-font-mono);
      font-size: 0.625rem;
      color: var(--so-lime-a60);
      letter-spacing: 0.04em;
    }

    /* ---- CTA STRIP ---- */
    .facility-cta-strip {
      background: var(--so-surface);
      padding: 4rem 0;
      border-top: 1px solid var(--so-lime-a10);
    }

    .fcs-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .fcs-title {
      font-family: var(--so-font-display);
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      color: #ffffff;
      letter-spacing: 0.01em;
      margin-bottom: 0.5rem;
    }
    .fcs-sub { font-size: 1rem; color: var(--muted); line-height: 1.5; }

    .fcs-buttons {
      display: flex;
      gap: 0.875rem;
      flex-wrap: wrap;
      flex-shrink: 0;
    }

    .fcs-btn-primary {
      display: inline-block;
      background: var(--so-lime);
      color: var(--so-ink);
      font-family: var(--so-font-body);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration: none;
      padding: 0.875rem 1.5rem;
      border-radius: var(--so-radius-sm);
      transition: background 0.15s;
      white-space: nowrap;
    }
    .fcs-btn-primary:hover { background: var(--so-lime-bright); }

    .fcs-btn-secondary {
      display: inline-block;
      background: var(--so-lime-a08);
      color: var(--so-lime);
      font-family: var(--so-font-body);
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: none;
      padding: 0.875rem 1.5rem;
      border-radius: var(--so-radius-sm);
      border: 1px solid var(--so-lime-a20);
      transition: background 0.15s;
      white-space: nowrap;
    }
    .fcs-btn-secondary:hover { background: var(--so-lime-a14); }

    .fcs-btn-ghost {
      display: inline-block;
      background: transparent;
      color: rgba(255,255,255,0.5);
      font-family: var(--so-font-body);
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: none;
      padding: 0.875rem 1.5rem;
      border-radius: var(--so-radius-sm);
      border: 1px solid rgba(255,255,255,0.1);
      transition: border-color 0.15s, color 0.15s;
      white-space: nowrap;
    }
    .fcs-btn-ghost:hover { border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.75); }

    /* ---- RESPONSIVE ---- */
    @media (max-width: 1100px) {
      .specs-grid { grid-template-columns: 1fr 1fr; }
      .info-inner { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .specs-grid { grid-template-columns: 1fr; }
      .fcs-inner { flex-direction: column; align-items: flex-start; }
    }
  </style>

  <script>
    import { trackDivisionRegisterClicked } from "@/lib/analytics/events";

    // Conversion analytics on the server-rendered hero register CTA.
    document.querySelectorAll<HTMLAnchorElement>("[data-so-register-cta]").forEach((el) => {
      el.addEventListener("click", () => {
        trackDivisionRegisterClicked({
          seasonId: el.dataset.seasonId ?? "",
          level: el.dataset.level ?? "open",
          gender: el.dataset.gender ?? "unknown",
          venue: el.dataset.venue ?? "",
          mode: el.dataset.mode === "team" ? "team" : "individual",
          term: el.dataset.term ?? "",
        });
      });
    });
  </script>
</BaseLayout>
