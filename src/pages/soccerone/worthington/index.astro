    <!-- ============================================================
         CTA STRIP
    ============================================================ -->
    <section class="facility-cta-strip" aria-label="Get started">
      <div class="fcs-inner">
        <div class="fcs-text">
          <h2 class="fcs-title">Ready to play at Worthington?</h2>
          <p class="fcs-sub">Join a league, book a field, or just show up for pickup — all from one account.</p>
        </div>
        <div class="fcs-buttons">
          <a href="/leagues?facility=worthington" class="fcs-btn-primary">
            See Open Leagues
          </a>
          <a href="/rent?facility=worthington" class="fcs-btn-secondary">
            Book a Field
          </a>
          <a href="/memberships" class="fcs-btn-ghost">
            View Memberships
          </a>
        </div>
      </div>
    </section>

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --white: #ffffff;
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }

    .facility-main { flex: 1; font-family: var(--so-font-body); }

    /* ============================================================
       HERO — shrunk ~55vh, real venue footage, priority CTAs
    ============================================================ */
    .f-hero {
      position: relative;
      min-height: 55vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      overflow: hidden;
      background: #0a120c;
    }

    .f-hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .f-hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .f-hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 50% at 30% 20%, var(--so-lime-a06), transparent 60%),
        linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.55) 55%, rgba(10,10,13,0.96) 100%);
    }

    .f-hero-inner {
      position: relative;
      z-index: 5;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      padding: 4.5rem 2rem 2rem;
    }

    .f-breadcrumb {
      font-family: var(--so-font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.4);
      margin-bottom: 0.875rem;
    }
    .f-breadcrumb a { color: inherit; text-decoration: none; }
    .f-breadcrumb a:hover { color: var(--so-lime); }

    .f-title {
      font-family: var(--so-font-display);
      font-size: clamp(3rem, 8vw, 6.5rem);
      line-height: 0.95;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: #ffffff;
    }

    .f-sub {
      font-size: 1.0625rem;
      color: rgba(255,255,255,0.65);
      line-height: 1.55;
      max-width: 620px;
      margin-top: 0.875rem;
    }
    .f-sub b { color: #fff; font-weight: 600; }

    /* Priority CTA row — leagues > pickup > classes/camps */
    .f-cta-row {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      align-items: stretch;
      margin-top: 1.5rem;
    }
    .f-cta {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      text-decoration: none;
      border-radius: var(--so-radius-md);
      padding: 0.8rem 1.4rem;
    }
    .f-cta-label { font-size: 0.9375rem; font-weight: 700; letter-spacing: 0.02em; }
    .f-cta-note { font-family: var(--so-font-mono); font-size: 0.5625rem; letter-spacing: 0.06em; }
    .f-cta--primary { background: var(--so-lime); color: var(--so-ink); }
    .f-cta--primary:hover { background: var(--so-lime-bright); }
    .f-cta--primary .f-cta-note { color: rgba(10,10,13,0.65); }
    .f-cta--secondary { background: rgba(255,255,255,0.06); border: 1.5px solid var(--so-lime-a40); color: #fff; }
    .f-cta--secondary:hover { border-color: var(--so-lime); }
    .f-cta--secondary .f-cta-note { color: var(--so-lime-a70); }
    .f-cta--tertiary { background: none; border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.75); }
    .f-cta--tertiary:hover { border-color: rgba(255,255,255,0.4); color: #fff; }
    .f-cta--tertiary .f-cta-note { color: rgba(255,255,255,0.35); }

    .f-fact-line {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
      padding-bottom: 0.25rem;
      font-family: var(--so-font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.45);
    }
    .ffl-div { width: 1px; height: 13px; background: rgba(255,255,255,0.15); }
    .f-fact-line b { color: rgba(255,255,255,0.85); font-weight: 600; }

    /* Shared "small numeral" label used by the specs/info sections below. */
    .section-num-sm {
      font-family: var(--so-font-display);
      font-size: 2.5rem;
      color: var(--so-lime-a15);
      line-height: 1;
    }

    /* ---- SECTION SCAFFOLD (no numerals — kicker bar only) ---- */
    .sec { padding: 4.5rem 0; }
    .sec-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }
    .kicker-bar { width: 32px; height: 3px; background: var(--so-lime); margin-bottom: 1.1rem; }
    .sec-title {
      font-family: var(--so-font-display);
      font-size: clamp(1.9rem, 3.6vw, 3rem);
      line-height: 1.02;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      color: #ffffff;
    }
    .sec-desc { font-size: 1rem; color: var(--muted); max-width: 560px; line-height: 1.6; margin-top: 0.625rem; }

    /* ---- WHAT'S HAPPENING — two-state (summer light now, fall rhythm) ---- */
    .happening { background: var(--bg-2); border-top: 1px solid var(--border); }
    .hap-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .hap-toggle { display: inline-flex; border: 1px solid var(--so-lime-a25); border-radius: var(--so-radius-pill); overflow: hidden; }
    .hap-tab { font-family: var(--so-font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; padding: 0.55rem 1.1rem; background: none; border: none; color: rgba(255,255,255,0.55); cursor: pointer; }
    .hap-tab--on { background: var(--so-lime); color: var(--so-ink); font-weight: 700; }

    .now-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; }
    .now-card { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-left: 3px solid var(--so-lime); border-radius: var(--so-radius-md); padding: 1.25rem 1.25rem 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
    .now-when { font-family: var(--so-font-mono); font-size: 0.625rem; letter-spacing: 0.1em; color: var(--so-lime); }
    .now-what { font-family: var(--so-font-display); font-size: 1.25rem; text-transform: uppercase; letter-spacing: 0.01em; }
    .now-note { font-size: 0.875rem; color: var(--muted); line-height: 1.5; }
    .now-link { font-size: 0.8125rem; font-weight: 700; color: var(--so-lime); text-decoration: none; margin-top: 0.35rem; width: fit-content; border-bottom: 1px solid var(--so-lime-a25); padding-bottom: 2px; }

    .week-list { display: none; flex-direction: column; border: 1px solid var(--border); border-radius: var(--so-radius-lg); overflow: hidden; }
    .week-row { display: grid; grid-template-columns: 130px 1fr auto; gap: 1rem; align-items: center; padding: 0.9rem 1.25rem; border-bottom: 1px solid var(--border); background: rgba(255,255,255,0.02); }
    .week-row:last-child { border-bottom: none; }
    .week-row--live { background: var(--so-lime-a04); }
    .wr-day { font-family: var(--so-font-display); font-size: 1.125rem; text-transform: uppercase; letter-spacing: 0.02em; }
    .wr-what { font-size: 0.9rem; color: rgba(255,255,255,0.75); line-height: 1.45; }
    .wr-what b { color: #fff; font-weight: 600; }
    .wr-tag { font-family: var(--so-font-mono); font-size: 0.5625rem; letter-spacing: 0.08em; color: var(--so-lime-a70); border: 1px solid var(--so-lime-a25); padding: 2px 8px; border-radius: var(--so-radius-pill); white-space: nowrap; }
    .wr-tag--futsal { color: var(--so-sky-soft); border-color: var(--so-sky-a25); }
    .happening.show-fall .week-list { display: flex; }
    .happening.show-fall .now-grid { display: none; }
    .hap-note { margin-top: 1.1rem; font-size: 0.8125rem; color: rgba(255,255,255,0.35); }

    /* ---- THE BUILDING — real specs, no FIFA language ---- */
    .building { background: var(--bg); }
    .build-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: start; margin-top: 2rem; }
    .spec-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .spec-card { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--so-radius-md); padding: 1.25rem; }
    .spec-num { font-family: var(--so-font-display); font-size: 2rem; line-height: 1; letter-spacing: 0.02em; color: var(--so-lime); }
    .spec-name { font-size: 0.9375rem; font-weight: 700; margin-top: 0.375rem; }
    .spec-note { font-size: 0.8125rem; color: var(--muted); line-height: 1.5; margin-top: 0.25rem; }
    .diff-list { display: flex; flex-direction: column; gap: 1rem; }
    .diff-item { display: flex; gap: 0.875rem; align-items: flex-start; }
    .diff-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--so-lime); flex-shrink: 0; margin-top: 7px; }
    .diff-title { font-size: 0.9375rem; font-weight: 700; }
    .diff-copy { font-size: 0.875rem; color: var(--muted); line-height: 1.55; }

    /* Field diagram */
    .field-figure { margin-top: 2.25rem; border: 1px solid var(--so-lime-a20); border-radius: var(--so-radius-lg); padding: 1.5rem; background: rgba(255,255,255,0.02); }
    .field-figure svg { width: 100%; height: auto; display: block; }
    .field-caption { font-family: var(--so-font-mono); font-size: 0.625rem; letter-spacing: 0.08em; color: rgba(255,255,255,0.4); margin-top: 0.75rem; text-align: center; }

    /* ---- MEDIA STRIP — home for the growing footage/photo pipeline ---- */
    .media-strip { background: var(--bg-2); border-top: 1px solid var(--border); }
    .media-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-auto-rows: 180px; gap: 0.75rem; margin-top: 2rem; }
    .media-tile { position: relative; border-radius: var(--so-radius-md); overflow: hidden; background: linear-gradient(145deg, #15200f, #0c1310); border: 1px solid var(--border); }
    .media-tile--tall { grid-row: span 2; }
    .media-media { width: 100%; height: 100%; object-fit: cover; display: block; }

    @media (max-width: 1100px) {
      .build-grid { grid-template-columns: 1fr; gap: 2rem; }
      .media-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 768px) {
      .spec-cards { grid-template-columns: 1fr; }
      .week-row { grid-template-columns: 90px 1fr; }
      .wr-tag { display: none; }
      .media-grid { grid-template-columns: 1fr; grid-auto-rows: 150px; }
    }

    /* ---- INFO SECTION ---- */
    .info-section {
      background: var(--bg);
      padding: 5rem 0;
      border-bottom: 1px solid var(--border);
    }

    .info-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .info-title {
      font-family: var(--so-font-display);
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      color: #ffffff;
      letter-spacing: 0.01em;
      margin: 0.5rem 0 2rem;
    }

    .hours-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      border: 1px solid var(--border);
      border-radius: var(--so-radius-md);
      overflow: hidden;
      margin-bottom: 2rem;
    }

    .hours-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.875rem 1.25rem;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      font-size: 0.9375rem;
    }
    .hours-row:last-child { border-bottom: none; }
    .hours-day { color: rgba(255,255,255,0.7); font-weight: 500; }
    .hours-time {
      font-family: var(--so-font-mono);
      font-size: 0.875rem;
      color: var(--so-lime);
    }
    .hours-note {
      font-size: 0.8125rem;
      color: rgba(255,255,255,0.3);
      padding: 0.75rem 1.25rem;
      border-top: 1px solid rgba(255,255,255,0.04);
      font-style: italic;
    }

    .info-address-block { display: flex; flex-direction: column; gap: 0.375rem; }
    .iab-name { font-weight: 700; font-size: 1rem; color: #ffffff; }
    .iab-addr { font-size: 0.9375rem; color: var(--muted); line-height: 1.5; }
    .iab-links { display: flex; gap: 1.25rem; margin-top: 0.75rem; flex-wrap: wrap; }
    .iab-link { font-size: 0.875rem; color: var(--so-lime-a70); text-decoration: none; transition: color 0.15s; }
    .iab-link:hover { color: var(--so-lime); }

    /* Map */
    .info-map { position: relative; }
    .map-placeholder {
      border-radius: var(--so-radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
      position: relative;
      aspect-ratio: 4/3;
      background: #0e1a0e;
    }
    .map-grid { position: absolute; inset: 0; }
    .map-svg { width: 100%; height: 100%; }

    .map-overlay-label {
      position: absolute;
      bottom: 1rem;
      left: 1rem;
      background: rgba(10,10,13,0.85);
      border: 1px solid var(--so-lime-a20);
      border-radius: var(--so-radius-sm);
      padding: 0.625rem 1rem;
      backdrop-filter: blur(4px);
    }
    .mol-name {
      font-family: var(--so-font-body);
      font-size: 0.8125rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 1px;
    }
    .mol-addr {
      font-family: var(--so-font-mono);
      font-size: 0.625rem;
      color: var(--so-lime-a60);
      letter-spacing: 0.04em;
    }

    /* ---- CTA STRIP ---- */
    .facility-cta-strip {
      background: var(--so-surface);
      padding: 4rem 0;
      border-top: 1px solid var(--so-lime-a10);
    }

    .fcs-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .fcs-title {
      font-family: var(--so-font-display);
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      color: #ffffff;
      letter-spacing: 0.01em;
      margin-bottom: 0.5rem;
    }
    .fcs-sub { font-size: 1rem; color: var(--muted); line-height: 1.5; }

    .fcs-buttons {
      display: flex;
      gap: 0.875rem;
      flex-wrap: wrap;
      flex-shrink: 0;
    }

    .fcs-btn-primary {
      display: inline-block;
      background: var(--so-lime);
      color: var(--so-ink);
      font-family: var(--so-font-body);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration: none;
      padding: 0.875rem 1.5rem;
      border-radius: var(--so-radius-sm);
      transition: background 0.15s;
      white-space: nowrap;
    }
    .fcs-btn-primary:hover { background: var(--so-lime-bright); }

    .fcs-btn-secondary {
      display: inline-block;
      background: var(--so-lime-a08);
      color: var(--so-lime);
      font-family: var(--so-font-body);
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: none;
      padding: 0.875rem 1.5rem;
      border-radius: var(--so-radius-sm);
      border: 1px solid var(--so-lime-a20);
      transition: background 0.15s;
      white-space: nowrap;
    }
    .fcs-btn-secondary:hover { background: var(--so-lime-a14); }

    .fcs-btn-ghost {
      display: inline-block;
      background: transparent;
      color: rgba(255,255,255,0.5);
      font-family: var(--so-font-body);
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: none;
      padding: 0.875rem 1.5rem;
      border-radius: var(--so-radius-sm);
      border: 1px solid rgba(255,255,255,0.1);
      transition: border-color 0.15s, color 0.15s;
      white-space: nowrap;
    }
    .fcs-btn-ghost:hover { border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.75); }

    /* ---- RESPONSIVE ---- */
    @media (max-width: 1100px) {
      .info-inner { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .fcs-inner { flex-direction: column; align-items: flex-start; }
    }
  </style>

  <script>
    import { trackDivisionRegisterClicked } from "@/lib/analytics/events";

    // Conversion analytics on the server-rendered hero register CTA.
    document.querySelectorAll<HTMLAnchorElement>("[data-so-register-cta]").forEach((el) => {
      el.addEventListener("click", () => {
        trackDivisionRegisterClicked({
          seasonId: el.dataset.seasonId ?? "",
          level: el.dataset.level ?? "open",
          gender: el.dataset.gender ?? "unknown",
          venue: el.dataset.venue ?? "",
          mode: el.dataset.mode === "team" ? "team" : "individual",
          term: el.dataset.term ?? "",
        });
      });
    });
  </script>

  <script is:inline>
    // What's Happening toggle — plain class flip, click-driven only (no
    // window keydown listeners). No-ops when the fall tab is hidden
    // (summer-only state, no dayOfWeek-scheduled seasons yet).
    (function () {
      var hap = document.getElementById("happening");
      var tabNow = document.getElementById("tabNow");
      var tabFall = document.getElementById("tabFall");
      if (!hap || !tabNow || !tabFall) return;
      tabNow.addEventListener("click", function () {
        hap.classList.remove("show-fall");
        tabNow.classList.add("hap-tab--on");
        tabFall.classList.remove("hap-tab--on");
      });
      tabFall.addEventListener("click", function () {
        hap.classList.add("show-fall");
        tabFall.classList.add("hap-tab--on");
        tabNow.classList.remove("hap-tab--on");
      });
    })();
  </script>
</BaseLayout>
