---
export const prerender = false;
import { eq } from "drizzle-orm";
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import PickupGames from '@/components/soccerone/PickupGames';
import SoccerOnePricingBand from '@/components/soccerone/SoccerOnePricingBand.astro';
import SoccerOneLevels from '@/components/soccerone/SoccerOneLevels.astro';
import { Toaster } from 'sonner';
import { getDb } from "@/lib/db";
import { dropInRateCard } from "@/lib/db/schema/drop-in";

const facility = Astro.url.searchParams.get('facility') || 'all';

const orgId = Astro.locals.organization?.id ?? null;
let rate = { defaultSessionRateCents: 1500, defaultMemberRateCents: 1200 };
if (orgId) {
  const [card] = await getDb()
    .select({
      defaultSessionRateCents: dropInRateCard.defaultSessionRateCents,
      defaultMemberRateCents: dropInRateCard.defaultMemberRateCents,
    })
    .from(dropInRateCard)
    .where(eq(dropInRateCard.organizationId, orgId))
    .limit(1);
  if (card) rate = card;
}
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title="Drop-In Pickup Soccer | SoccerOne Columbus"
  description="Show up and play at SoccerOne. Drop-in pickup soccer at Worthington and Downtown. No team needed. 7 days a week. Multiple skill levels."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <SoccerOneHeader />
  <Toaster client:load richColors position="bottom-right" />

  <main class="pickup-main">

    <!-- Page header -->
    <div class="pickup-header">
      <div class="ph-inner">
        <div class="ph-top">
          <div class="ph-text">
            <h1 class="ph-title">PICKUP</h1>
            <p class="ph-desc">
              No team. No commitment. Show up, pay at the door, and play. Seven days a week across both locations. Multiple skill levels every day.
            </p>
            <a href="#sessions" class="ph-jump">See tonight's sessions ↓</a>
          </div>
          <div class="ph-quickstats">
            <div class="pqs-item">
              <span class="pqs-num">7</span>
              <span class="pqs-label">days/week</span>
            </div>
            <div class="pqs-div" aria-hidden="true"></div>
            <div class="pqs-item">
              <span class="pqs-num">3</span>
              <span class="pqs-label">skill levels</span>
            </div>
            <div class="pqs-div" aria-hidden="true"></div>
            <div class="pqs-item">
              <span class="pqs-num">{`$${Math.round(rate.defaultMemberRateCents / 100)}`}</span>
              <span class="pqs-label">members</span>
            </div>
            <div class="pqs-div" aria-hidden="true"></div>
            <div class="pqs-item">
              <span class="pqs-num">Free</span>
              <span class="pqs-label">Founder members</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <SoccerOnePricingBand rate={rate} />

    <SoccerOneLevels />

    <!-- Sessions: location switcher + games listing -->
    <section id="sessions">
      <!-- Facility filter tabs -->
      <div class="facility-filter-row" role="group" aria-label="Filter by facility">
        <a href="/pickup" class={`ff-tab ${facility === 'all' ? 'ff-tab--active' : ''}`}>ALL LOCATIONS</a>
        <a href="/pickup?facility=worthington" class={`ff-tab ${facility === 'worthington' ? 'ff-tab--active' : ''}`}>WORTHINGTON · 3 FIELDS</a>
        <a href="/pickup?facility=downtown" class={`ff-tab ${facility === 'downtown' ? 'ff-tab--active' : ''}`}>DOWNTOWN · 1 FIELD</a>
      </div>

      <!-- Games listing component -->
      <div class="pickup-games-wrap">
        <PickupGames client:visible facility={facility} />
      </div>
    </section>

    <!-- How it works strip -->
    <div class="how-strip">
      <div class="hs-inner">
        <div class="hs-step">
          <span class="hss-num mono">01</span>
          <span class="hss-text">Pick a session based on skill level and time</span>
        </div>
        <div class="hs-arrow" aria-hidden="true">→</div>
        <div class="hs-step">
          <span class="hss-num mono">02</span>
          <span class="hss-text">Show up at the facility 10 min early with cleats &amp; shinguards</span>
        </div>
        <div class="hs-arrow" aria-hidden="true">→</div>
        <div class="hs-step">
          <span class="hss-num mono">03</span>
          <span class="hss-text">Pay at the door, book online, or use a Member plan — Founder members play free</span>
        </div>
        <div class="hs-arrow" aria-hidden="true">→</div>
        <div class="hs-step">
          <span class="hss-num mono">04</span>
          <span class="hss-text">We assign balanced teams and kick off on time</span>
        </div>
      </div>
    </div>

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }

    .pickup-main { flex: 1; font-family: var(--so-font-body); }

    .pickup-header { background: var(--so-ink); border-bottom: 1px solid var(--so-lime-a10); padding: 4rem 0 2.5rem; }
    .ph-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    .ph-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }

    .ph-title { font-family: var(--so-font-display); font-size: clamp(4rem, 10vw, 9rem); color: #ffffff; line-height: 0.9; letter-spacing: 0.01em; margin-bottom: 1rem; }
    .ph-desc { font-size: 1.0625rem; color: var(--muted); line-height: 1.6; max-width: 500px; }

    .ph-jump {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      margin-top: 1rem;
      font-family: var(--so-font-mono);
      font-size: .8rem;
      letter-spacing: .04em;
      color: var(--so-ink);
      background: var(--so-lime);
      border-radius: var(--so-radius-sm);
      padding: .6rem 1.1rem;
      text-decoration: none;
      transition: background .15s;
    }
    .ph-jump:hover { background: var(--so-lime-bright); }

    .ph-quickstats { display: flex; align-items: center; gap: 1.5rem; background: var(--so-lime-a04); border: 1px solid var(--so-lime-a15); border-radius: var(--so-radius-md); padding: 1.25rem 1.75rem; flex-shrink: 0; }
    .pqs-item { display: flex; flex-direction: column; gap: 2px; text-align: center; }
    .pqs-num { font-family: var(--so-font-display); font-size: 2rem; color: var(--so-lime); letter-spacing: 0.02em; line-height: 1; }
    .pqs-label { font-family: var(--so-font-mono); font-size: 0.5rem; font-weight: 600; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); }
    .pqs-div { width: 1px; height: 36px; background: rgba(255,255,255,0.08); }

    #sessions { background: var(--bg); scroll-margin-top: 5rem; }

    .facility-filter-row { display: flex; gap: 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--so-ink); }
    .ff-tab { font-family: var(--so-font-body); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; color: rgba(255,255,255,0.4); text-decoration: none; padding: 1rem 1.5rem; border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s; white-space: nowrap; }
    .ff-tab:hover { color: rgba(255,255,255,0.7); }
    .ff-tab--active { color: var(--so-lime); border-bottom-color: var(--so-lime); }

    .how-strip { background: var(--so-surface); border-bottom: 1px solid var(--border); padding: 1.5rem 0; }
    .hs-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
    .hs-step { display: flex; align-items: flex-start; gap: 0.625rem; flex: 1; min-width: 180px; }
    .hss-num { font-family: var(--so-font-mono); font-size: 0.875rem; font-weight: 600; color: var(--so-lime); flex-shrink: 0; margin-top: 1px; }
    .hss-text { font-size: 0.875rem; color: rgba(255,255,255,0.5); line-height: 1.4; }
    .hs-arrow { font-size: 1.25rem; color: var(--so-lime-a25); flex-shrink: 0; }

    .pickup-games-wrap { background: var(--bg); padding: 2rem 0 3rem; min-height: 420px; }

    @media (max-width: 768px) {
      .ph-top { flex-direction: column; align-items: flex-start; }
      .hs-arrow { display: none; }
      .hs-inner { flex-direction: column; gap: 0.875rem; }
    }
  </style>
</BaseLayout>
