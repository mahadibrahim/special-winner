---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import PickupGames from '@/components/soccerone/PickupGames';
import { Toaster } from 'sonner';

const facility = Astro.url.searchParams.get('facility') || 'all';
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title="Drop-In Pickup Soccer | SoccerOne Columbus"
  description="Show up and play at SoccerOne. Drop-in pickup soccer at Worthington and Downtown. No team needed. 7 days a week. Multiple skill levels. From $12/session."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <SoccerOneHeader />
  <Toaster client:load richColors position="bottom-right" />

  <main class="pickup-main">

    <!-- Page header -->
    <div class="pickup-header">
      <div class="ph-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/soccerone" class="bc-link">SoccerOne</a>
          <span class="bc-sep">—</span>
          <span class="bc-current">Drop-In Pickup</span>
        </nav>

        <div class="ph-top">
          <div class="ph-text">
            <h1 class="ph-title">PICKUP</h1>
            <p class="ph-desc">
              No team. No commitment. Show up, pay at the door, and play. Seven days a week across both locations. Multiple skill levels every day.
            </p>
          </div>
          <div class="ph-quickstats">
            <div class="pqs-item">
              <span class="pqs-num">7</span>
              <span class="pqs-label">days/week</span>
            </div>
            <div class="pqs-div" aria-hidden="true"></div>
            <div class="pqs-item">
              <span class="pqs-num">3</span>
              <span class="pqs-label">skill levels</span>
            </div>
            <div class="pqs-div" aria-hidden="true"></div>
            <div class="pqs-item">
              <span class="pqs-num mono">$15</span>
              <span class="pqs-label">booked online</span>
            </div>
            <div class="pqs-div" aria-hidden="true"></div>
            <div class="pqs-item">
              <span class="pqs-num">Free</span>
              <span class="pqs-label">Founder members</span>
            </div>
          </div>
        </div>

        <!-- Facility filter tabs -->
        <div class="facility-filter-row" role="group" aria-label="Filter by facility">
          <a href="/soccerone/pickup" class={`ff-tab ${facility === 'all' ? 'ff-tab--active' : ''}`}>ALL LOCATIONS</a>
          <a href="/soccerone/pickup?facility=worthington" class={`ff-tab ${facility === 'worthington' ? 'ff-tab--active' : ''}`}>WORTHINGTON · 3 FIELDS</a>
          <a href="/soccerone/pickup?facility=downtown" class={`ff-tab ${facility === 'downtown' ? 'ff-tab--active' : ''}`}>DOWNTOWN · 1 FIELD</a>
        </div>
      </div>
    </div>

    <!-- How it works strip -->
    <div class="how-strip">
      <div class="hs-inner">
        <div class="hs-step">
          <span class="hss-num mono">01</span>
          <span class="hss-text">Pick a session below based on skill level and time</span>
        </div>
        <div class="hs-arrow" aria-hidden="true">→</div>
        <div class="hs-step">
          <span class="hss-num mono">02</span>
          <span class="hss-text">Show up at the facility 10 min early with cleats &amp; shinguards</span>
        </div>
        <div class="hs-arrow" aria-hidden="true">→</div>
        <div class="hs-step">
          <span class="hss-num mono">03</span>
          <span class="hss-text">Pay at the door ($17), book online ($15), or use a Member plan ($12) — Founder members play free</span>
        </div>
        <div class="hs-arrow" aria-hidden="true">→</div>
        <div class="hs-step">
          <span class="hss-num mono">04</span>
          <span class="hss-text">We assign balanced teams and kick off on time</span>
        </div>
      </div>
    </div>

    <!-- Games listing component -->
    <div class="pickup-games-wrap">
      <PickupGames client:visible facility={facility} />
    </div>

    <!-- Skill levels guide -->
    <div class="skill-guide">
      <div class="sg-inner">
        <h2 class="sg-title">
          <span class="section-num-sm">02.</span>
          Skill Levels
        </h2>
        <div class="sg-grid">
          <div class="sg-card">
            <div class="sg-level sg-level--beginner">BEGINNER</div>
            <h3 class="sg-name">Recreational</h3>
            <p class="sg-desc">Haven't played in years? Never played indoors? This is your game. Emphasis on fun, no pressure.</p>
            <div class="sg-tag-row">
              <span class="sg-tag">Any fitness level</span>
              <span class="sg-tag">No experience needed</span>
              <span class="sg-tag">Friendly atmosphere</span>
            </div>
          </div>
          <div class="sg-card sg-card--featured">
            <div class="sg-level sg-level--intermediate">INTERMEDIATE</div>
            <h3 class="sg-name">Competitive</h3>
            <p class="sg-desc">Regular players who want a real run. Tactical awareness expected. Most sessions are this level.</p>
            <div class="sg-tag-row">
              <span class="sg-tag">League-level play</span>
              <span class="sg-tag">High-tempo</span>
              <span class="sg-tag">Mixed ages</span>
            </div>
          </div>
          <div class="sg-card">
            <div class="sg-level sg-level--competitive">COMPETITIVE</div>
            <h3 class="sg-name">Premier</h3>
            <p class="sg-desc">High-level play, serious players. Former collegiate, semi-pro, and elite adult league players. Fast and physical.</p>
            <div class="sg-tag-row">
              <span class="sg-tag">Elite level</span>
              <span class="sg-tag">Limited spots</span>
              <span class="sg-tag">Late-night sessions</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }

    .pickup-main { flex: 1; font-family: var(--so-font-body); }

    .pickup-header { background: var(--so-ink); border-bottom: 1px solid var(--so-lime-a10); padding: 4rem 0 0; }
    .ph-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; }
    .bc-link { font-size: 0.8125rem; color: var(--so-lime-a60); text-decoration: none; font-weight: 500; transition: color 0.15s; }
    .bc-link:hover { color: var(--so-lime); }
    .bc-sep { color: rgba(255,255,255,0.2); font-size: 0.75rem; }
    .bc-current { font-size: 0.8125rem; color: rgba(255,255,255,0.4); }

    .ph-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; flex-wrap: wrap; }

    .ph-title { font-family: var(--so-font-display); font-size: clamp(4rem, 10vw, 9rem); color: #ffffff; line-height: 0.9; letter-spacing: 0.01em; margin-bottom: 1rem; }
    .ph-desc { font-size: 1.0625rem; color: var(--muted); line-height: 1.6; max-width: 500px; }

    .ph-quickstats { display: flex; align-items: center; gap: 1.5rem; background: var(--so-lime-a04); border: 1px solid var(--so-lime-a15); border-radius: var(--so-radius-md); padding: 1.25rem 1.75rem; flex-shrink: 0; }
    .pqs-item { display: flex; flex-direction: column; gap: 2px; text-align: center; }
    .pqs-num { font-family: var(--so-font-display); font-size: 2rem; color: var(--so-lime); letter-spacing: 0.02em; line-height: 1; }
    .pqs-num.mono { font-family: var(--so-font-mono); font-size: 1.5rem; }
    .pqs-label { font-family: var(--so-font-mono); font-size: 0.5rem; font-weight: 600; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); }
    .pqs-div { width: 1px; height: 36px; background: rgba(255,255,255,0.08); }

    .facility-filter-row { display: flex; gap: 0; border-top: 1px solid var(--border); }
    .ff-tab { font-family: var(--so-font-body); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; color: rgba(255,255,255,0.4); text-decoration: none; padding: 1rem 1.5rem; border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s; white-space: nowrap; }
    .ff-tab:hover { color: rgba(255,255,255,0.7); }
    .ff-tab--active { color: var(--so-lime); border-bottom-color: var(--so-lime); }

    .how-strip { background: var(--so-surface); border-bottom: 1px solid var(--border); padding: 1.5rem 0; }
    .hs-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
    .hs-step { display: flex; align-items: flex-start; gap: 0.625rem; flex: 1; min-width: 180px; }
    .hss-num { font-family: var(--so-font-mono); font-size: 0.875rem; font-weight: 600; color: var(--so-lime); flex-shrink: 0; margin-top: 1px; }
    .hss-text { font-size: 0.875rem; color: rgba(255,255,255,0.5); line-height: 1.4; }
    .hs-arrow { font-size: 1.25rem; color: var(--so-lime-a25); flex-shrink: 0; }

    .pickup-games-wrap { background: var(--bg); padding: 2rem 0 3rem; }

    .skill-guide { background: var(--bg-2); border-top: 1px solid var(--border); padding: 5rem 0; }
    .sg-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }
    .sg-title { font-family: var(--so-font-display); font-size: clamp(2rem, 4vw, 3rem); color: #ffffff; letter-spacing: 0.01em; margin-bottom: 2.5rem; display: flex; align-items: baseline; gap: 1rem; }
    .section-num-sm { font-family: var(--so-font-display); font-size: 2.5rem; color: var(--so-lime-a15); line-height: 1; }
    .sg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .sg-card { background: var(--so-surface); border: 1px solid var(--so-lime-a20); border-left: 3px solid var(--so-lime); border-radius: var(--so-radius-lg); padding: 1.75rem; display: flex; flex-direction: column; gap: 0.875rem; transition: border-color 0.2s; }
    .sg-card:hover { border-color: var(--so-lime-a40); border-left-color: var(--so-lime); }
    .sg-card--featured { border-color: var(--so-lime-a20); background: var(--so-lime-a03); }
    .sg-level { font-family: var(--so-font-mono); font-size: 0.5625rem; font-weight: 600; letter-spacing: 0.14em; padding: 3px 8px; border-radius: 3px; display: inline-block; width: fit-content; }
    .sg-level--beginner { background: rgba(100,200,100,0.1); color: #86efac; border: 1px solid rgba(100,200,100,0.2); }
    .sg-level--intermediate { background: var(--so-lime-a12); color: var(--so-lime); border: 1px solid var(--so-lime-a20); }
    .sg-level--competitive { background: rgba(251,146,60,0.1); color: #fb923c; border: 1px solid rgba(251,146,60,0.2); }
    .sg-name { font-family: var(--so-font-display); font-size: 1.75rem; color: #ffffff; letter-spacing: 0.01em; line-height: 1; }
    .sg-desc { font-size: 0.9375rem; color: var(--muted); line-height: 1.55; flex: 1; }
    .sg-tag-row { display: flex; flex-wrap: wrap; gap: 0.375rem; }
    .sg-tag { font-size: 0.75rem; color: rgba(255,255,255,0.45); background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 3px; padding: 2px 8px; }

    @media (max-width: 1000px) { .sg-grid { grid-template-columns: 1fr; } }
    @media (max-width: 768px) {
      .ph-top { flex-direction: column; align-items: flex-start; }
      .hs-arrow { display: none; }
      .hs-inner { flex-direction: column; gap: 0.875rem; }
    }
  </style>
</BaseLayout>
