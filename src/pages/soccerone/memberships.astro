---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { MembershipTier } from '@/components/soccerone/MembershipTier';
import { Toaster } from 'sonner';
---

<BaseLayout
  title="Memberships | SoccerOne Powell"
  description="Choose your SoccerOne membership. Day Pass, Member ($29/mo), or Founder ($99/mo). Members get discounted rentals, priority league access, and more."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a1929] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body { font-family: 'Inter', sans-serif; }
      *, *::before, *::after { box-sizing: border-box; }
    </style>
  </Fragment>

  <SoccerOneHeader />
  <Toaster client:load richColors position="bottom-right" />

  <main class="memberships-main">

    <!-- Page header with diagonal stripe -->
    <div class="mem-page-header">
      <div class="mem-diagonal" aria-hidden="true"></div>
      <div class="mem-header-inner">
        <div class="breadcrumb">
          <a href="/soccerone" class="breadcrumb-link">SoccerOne</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span class="breadcrumb-current">Memberships</span>
        </div>
        <h1 class="page-title">Membership Plans</h1>
        <p class="page-subtitle">
          Play more. Pay less. Members unlock discounted field rentals, priority league registration, and exclusive pickup access — all on one account.
        </p>

        <div class="header-stats">
          <div class="header-stat">
            <span class="stat-n">400+</span>
            <span class="stat-l">Active members</span>
          </div>
          <div class="header-stat">
            <span class="stat-n">$8–$16</span>
            <span class="stat-l">Saved per rental hour</span>
          </div>
          <div class="header-stat">
            <span class="stat-n">24h</span>
            <span class="stat-l">Cancel anytime</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tier grid -->
    <div class="tiers-section">
      <div class="tiers-inner">
        <div class="tiers-grid">
          <!-- Day Pass -->
          <MembershipTier
            client:visible
            name="Day Pass"
            monthlyPrice="$15"
            annualPrice="$15"
            ctaLabel="Buy a Day Pass"
            highlighted={false}
            accentColor="#7dd3fc"
            benefits={[
              { text: "Full facility access for the day", included: true },
              { text: "Join any open pickup game", included: true },
              { text: "Spectate any scheduled league", included: true },
              { text: "Locker room + amenities", included: true },
              { text: "10% off hourly field rental", included: false },
              { text: "Priority league registration", included: false },
              { text: "Guest passes (per month)", included: false },
              { text: "Members-only pickup events", included: false },
            ]}
            testimonial={{
              quote: "Perfect for when I'm visiting family in Powell. Walk in, play, done.",
              author: "Derek T.",
              since: "Day Pass regular"
            }}
          />

          <!-- Member -->
          <MembershipTier
            client:visible
            name="Member"
            monthlyPrice="$29"
            annualPrice="$290"
            annualSaving="17%"
            ctaLabel="Sign up for Member"
            highlighted={true}
            accentColor="#facc15"
            benefits={[
              { text: "Full facility access, every visit", included: true },
              { text: "Join any open pickup game", included: true },
              { text: "Priority league registration (48h early)", included: true },
              { text: "10% off hourly field rentals ($72/hr)", included: true },
              { text: "Members-only pickup events", included: true },
              { text: "Locker room + amenities", included: true },
              { text: "1 guest pass per month", included: false },
              { text: "Free pickup games included monthly", included: false },
            ]}
            testimonial={{
              quote: "Pays for itself in two field rentals. And the early league signup is clutch.",
              author: "Maria C.",
              since: "2025"
            }}
          />

          <!-- Founder -->
          <MembershipTier
            client:visible
            name="Founder"
            monthlyPrice="$99"
            annualPrice="$990"
            annualSaving="17%"
            ctaLabel="Sign up for Founder"
            highlighted={false}
            accentColor="#c084fc"
            benefits={[
              { text: "Full facility access, every visit", included: true },
              { text: "Unlimited pickup games", included: true },
              { text: "First access to league registration (72h early)", included: true },
              { text: "20% off hourly field rentals ($64/hr)", included: true },
              { text: "Members-only + Founder-only pickup events", included: true },
              { text: "2 guest passes per month", included: true },
              { text: "Name on the Founder wall (lobby)", included: true },
              { text: "Quarterly facility access report", included: true },
            ]}
            testimonial={{
              quote: "I train here three times a week. Founder membership made this place my second home.",
              author: "James R.",
              since: "2024 — Original Founder"
            }}
          />
        </div>
      </div>
    </div>

    <!-- Full comparison table -->
    <div class="comparison-section">
      <div class="comparison-inner">
        <h2 class="comparison-heading">Full Benefit Comparison</h2>

        <div class="comparison-table-wrap">
          <table class="comparison-table" aria-label="Membership benefit comparison">
            <thead>
              <tr>
                <th class="table-feature-col">Feature</th>
                <th class="table-tier-col">Day Pass</th>
                <th class="table-tier-col table-tier-featured">Member</th>
                <th class="table-tier-col">Founder</th>
              </tr>
            </thead>
            <tbody>
              <tr class="table-row">
                <td class="table-feature">Monthly price</td>
                <td class="table-val">$15/visit</td>
                <td class="table-val table-val-featured">$29/mo</td>
                <td class="table-val">$99/mo</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Annual price</td>
                <td class="table-val table-na">—</td>
                <td class="table-val table-val-featured">$290/yr</td>
                <td class="table-val">$990/yr</td>
              </tr>
              <tr class="table-section-header">
                <td colspan="4">Access</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Facility access</td>
                <td class="table-val table-check">Per visit</td>
                <td class="table-val table-val-featured table-check">Unlimited</td>
                <td class="table-val table-check">Unlimited</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Open pickup games</td>
                <td class="table-val table-check">Pay per game</td>
                <td class="table-val table-val-featured table-check">Unlimited</td>
                <td class="table-val table-check">Unlimited (free)</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Members-only pickup</td>
                <td class="table-val table-x">Not included</td>
                <td class="table-val table-val-featured table-check">Included</td>
                <td class="table-val table-check">Included</td>
              </tr>
              <tr class="table-section-header">
                <td colspan="4">Rentals</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Hourly rental rate</td>
                <td class="table-val">$80/hr</td>
                <td class="table-val table-val-featured">$72/hr (−10%)</td>
                <td class="table-val">$64/hr (−20%)</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Booking window</td>
                <td class="table-val">7 days ahead</td>
                <td class="table-val table-val-featured">14 days ahead</td>
                <td class="table-val">30 days ahead</td>
              </tr>
              <tr class="table-section-header">
                <td colspan="4">Leagues</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Priority league signup</td>
                <td class="table-val table-x">Not included</td>
                <td class="table-val table-val-featured table-check">48h early access</td>
                <td class="table-val table-check">72h early access</td>
              </tr>
              <tr class="table-section-header">
                <td colspan="4">Perks</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Guest passes per month</td>
                <td class="table-val table-x">None</td>
                <td class="table-val table-val-featured table-x">None</td>
                <td class="table-val table-check">2 passes</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Founder wall recognition</td>
                <td class="table-val table-x">Not included</td>
                <td class="table-val table-val-featured table-x">Not included</td>
                <td class="table-val table-check">Lobby recognition</td>
              </tr>
              <tr class="table-row">
                <td class="table-feature">Cancel anytime</td>
                <td class="table-val table-na">N/A</td>
                <td class="table-val table-val-featured table-check">Yes</td>
                <td class="table-val table-check">Yes</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- FAQ strip -->
    <div class="faq-section">
      <div class="faq-inner">
        <h2 class="faq-heading">Common questions</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3 class="faq-q">When does my membership start?</h3>
            <p class="faq-a">Immediately after your first payment. You'll get a confirmation email and your account will show member pricing right away.</p>
          </div>
          <div class="faq-item">
            <h3 class="faq-q">Can I pause my membership?</h3>
            <p class="faq-a">Yes — you can pause for up to 60 days per year. Great for seasonal travel. Reach out to the front desk or your account dashboard.</p>
          </div>
          <div class="faq-item">
            <h3 class="faq-q">Do member rates apply to all 8 fields?</h3>
            <p class="faq-a">Yes. All 8 indoor fields qualify for member rates. Rates are applied automatically at checkout when you're signed in.</p>
          </div>
          <div class="faq-item">
            <h3 class="faq-q">Can I upgrade from Member to Founder?</h3>
            <p class="faq-a">Absolutely. You'll only pay the prorated difference for the current billing period. Email us or upgrade directly in your dashboard.</p>
          </div>
        </div>
      </div>
    </div>

  </main>

  <SoccerOneFooter />

  <style>
    .memberships-main { flex: 1; }

    /* ——— Page header ——— */
    .mem-page-header {
      position: relative;
      background: linear-gradient(135deg, #0a1929 0%, #0d2035 50%, #0c3050 100%);
      padding: 4rem 0 3.5rem;
      overflow: hidden;
      border-bottom: 1px solid rgba(250,204,21,0.15);
    }

    .mem-diagonal {
      position: absolute;
      inset: 0;
      background: linear-gradient(155deg, transparent 55%, rgba(250,204,21,0.04) 100%);
      pointer-events: none;
    }

    .mem-header-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
      position: relative;
      z-index: 1;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }

    .breadcrumb-link {
      color: rgba(250,204,21,0.7);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.15s;
    }
    .breadcrumb-link:hover { color: #facc15; }
    .breadcrumb-sep { color: rgba(255,255,255,0.3); }
    .breadcrumb-current { color: rgba(255,255,255,0.5); }

    .page-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      color: #ffffff;
      line-height: 1;
      margin: 0 0 1rem;
    }

    .page-subtitle {
      font-size: 1.125rem;
      color: rgba(255,255,255,0.6);
      line-height: 1.65;
      max-width: 560px;
      margin: 0 0 2.5rem;
    }

    .header-stats {
      display: flex;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .header-stat {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
    }

    .stat-n {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 2rem;
      font-weight: 800;
      color: #facc15;
      letter-spacing: -0.04em;
    }

    .stat-l {
      font-size: 0.8125rem;
      color: rgba(255,255,255,0.45);
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    /* ——— Tiers ——— */
    .tiers-section {
      padding: 5rem 0;
      background: #0a1929;
    }

    .tiers-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .tiers-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      align-items: stretch;
    }

    /* ——— Comparison table ——— */
    .comparison-section {
      padding: 4rem 0 5rem;
      background: #0d2035;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .comparison-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .comparison-heading {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.02em;
      margin: 0 0 2rem;
    }

    .comparison-table-wrap {
      overflow-x: auto;
      border-radius: 12px;
      border: 1.5px solid rgba(255,255,255,0.1);
    }

    .comparison-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9375rem;
    }

    .comparison-table thead th {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.875rem;
      letter-spacing: 0.03em;
      color: rgba(255,255,255,0.6);
      padding: 1rem 1.25rem;
      text-align: left;
      background: rgba(255,255,255,0.04);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .table-tier-featured {
      background: rgba(250,204,21,0.08) !important;
      color: #facc15 !important;
      border-left: 1px solid rgba(250,204,21,0.2);
      border-right: 1px solid rgba(250,204,21,0.2);
    }

    .table-feature-col { width: 35%; }
    .table-tier-col { text-align: center; }

    .table-section-header td {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #facc15;
      padding: 0.875rem 1.25rem 0.375rem;
      background: rgba(250,204,21,0.04);
      border-top: 1px solid rgba(250,204,21,0.1);
    }

    .table-row td {
      padding: 0.875rem 1.25rem;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      vertical-align: middle;
    }

    .table-row:last-child td {
      border-bottom: none;
    }

    .table-feature {
      color: rgba(255,255,255,0.7);
    }

    .table-val {
      text-align: center;
      color: rgba(255,255,255,0.65);
    }

    .table-val-featured {
      background: rgba(250,204,21,0.05);
      color: rgba(255,255,255,0.85);
      border-left: 1px solid rgba(250,204,21,0.1);
      border-right: 1px solid rgba(250,204,21,0.1);
    }

    .table-check { color: rgba(74,222,128,0.9); font-weight: 600; }
    .table-x { color: rgba(255,255,255,0.2); }
    .table-na { color: rgba(255,255,255,0.2); }

    /* ——— FAQ ——— */
    .faq-section {
      padding: 4rem 0;
      background: #0a1929;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .faq-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .faq-heading {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.625rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.02em;
      margin: 0 0 2rem;
    }

    .faq-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .faq-item {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 1.5rem;
    }

    .faq-q {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 0.625rem;
    }

    .faq-a {
      font-size: 0.9375rem;
      color: rgba(255,255,255,0.55);
      line-height: 1.6;
      margin: 0;
    }

    @media (max-width: 900px) {
      .tiers-grid { grid-template-columns: 1fr; }
      .faq-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
