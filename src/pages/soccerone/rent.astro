---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { FieldCalendar } from '@/components/soccerone/FieldCalendar';
import { getRentalVenuesByLocation } from '@/lib/soccerone/venues';
import { RENTAL_RATE_SCHEDULE } from '@/lib/rentals/soccerone-pricing';
import { DEFAULT_BOOKING_WINDOW_DAYS } from '@/lib/memberships/booking-window';
import { breadcrumbJsonLd } from '@/lib/seo/breadcrumbs';
import { SOCCERONE_CONTACT_PHONE, SOCCERONE_CONTACT_PHONE_TEL } from '@/lib/soccerone/contact';

const facility = Astro.url.searchParams.get('facility') || 'worthington';
const facilityLabel = facility === 'downtown' ? 'Downtown' : 'Worthington';

// Brands share one org — the facility param maps straight onto the org's
// location slugs ('downtown' / 'worthington').
const locationSlug = facility === 'worthington' ? 'worthington' : 'downtown';

const organizationId = Astro.locals.organization?.id ?? null;
const venueList = organizationId
  ? await getRentalVenuesByLocation(organizationId, locationSlug)
  : [];
// Venues are modeled one-per-physical-field; the calendar's Field selector
// switches between them.
const calendarVenues = venueList.map((v) => ({ id: v.id, name: v.name }));

const bookingWindowDays = DEFAULT_BOOKING_WINDOW_DAYS;

const orgTimeZone = Astro.locals.organization?.timezone ?? "America/New_York";

const PLAY_FACTS = [
  {
    big: '3',
    title: 'Fields open now',
    desc: 'Orange & Blue in Worthington, Yellow downtown — futsal courts land in September.',
  },
  {
    big: '0',
    title: 'Rubber crumb',
    desc: 'Sand-filled turf — truer roll, softer landings, no black pellets in your socks.',
  },
  {
    big: 'Sept',
    title: 'Futsal on the way',
    desc: 'Dedicated hard courts open this September — separate from the fields.',
  },
  {
    big: '4–12',
    title: 'PM, every day',
    desc: 'Indoor and year-round — the same evening window seven days a week.',
  },
];

// Helper to format cents as dollars (whole numbers shown without decimals)
const fmt = (cents: number) => {
  const dollars = cents / 100;
  return `$${Number.isInteger(dollars) ? dollars : dollars.toFixed(2)}`;
};

const SO = 'https://www.gosoccerone.com';
const breadcrumbSchema = breadcrumbJsonLd([
  { name: 'SoccerOne', url: `${SO}/` },
  { name: 'Rent', url: `${SO}/rent` },
]);
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title={`Field Rentals — SoccerOne | ${facilityLabel}`}
  description="Request an indoor soccer field at SoccerOne. 3 fields open now — Orange and Blue in Worthington, Yellow downtown — with futsal courts opening September. Seasonal tiered rates. Open 4pm–12am daily."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <SoccerOneHeader />

  <main class="rent-main">

    <!-- Page header -->
    <div class="rent-header">
      <div class="rh-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="bc-link">SoccerOne</a>
          <span class="bc-sep">—</span>
          <span class="bc-current">Field Rentals</span>
        </nav>

        <div class="rh-top">
          <div class="rh-text">
            <h1 class="rh-title">REQUEST A<br />FIELD</h1>
            <p class="rh-desc">
              Request a field at {facilityLabel}. We review each request and email you a secure link to pay — the slot is held while we confirm. Requests must be at least 48 hours out and up to {bookingWindowDays} days ahead — call or email us for anything sooner or further.
            </p>
            <a href={`tel:${SOCCERONE_CONTACT_PHONE_TEL}`} class="call-chip">
              <span class="call-chip-sub">Book faster — call or text</span>
              <b class="mono">{SOCCERONE_CONTACT_PHONE}</b>
            </a>
          </div>

          <!-- Tiered rates table -->
          <div class="rates-table-wrap">
            <table class="rates-table" aria-label="Field rental rates by season and time">
              <thead>
                <tr>
                  <th class="rt-th rt-th--season">Season</th>
                  <th class="rt-th">Weekday before 3 PM</th>
                  <th class="rt-th">Weekday 3–6 PM</th>
                  <th class="rt-th">Weekday after 6 PM &amp; weekends</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="rt-season mono">Apr – Sep</td>
                  <td class="rt-rate">{fmt(RENTAL_RATE_SCHEDULE.summer.before3)}<span class="rt-per">/hr</span></td>
                  <td class="rt-rate">{fmt(RENTAL_RATE_SCHEDULE.summer.midday)}<span class="rt-per">/hr</span></td>
                  <td class="rt-rate">{fmt(RENTAL_RATE_SCHEDULE.summer.evening)}<span class="rt-per">/hr</span></td>
                </tr>
                <tr>
                  <td class="rt-season mono">Oct – Mar</td>
                  <td class="rt-rate">{fmt(RENTAL_RATE_SCHEDULE.winter.before3)}<span class="rt-per">/hr</span></td>
                  <td class="rt-rate">{fmt(RENTAL_RATE_SCHEDULE.winter.midday)}<span class="rt-per">/hr</span></td>
                  <td class="rt-rate">{fmt(RENTAL_RATE_SCHEDULE.winter.evening)}<span class="rt-per">/hr</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Location segmented control -->
        <div class="seg-label mono">Choose a location</div>
        <div class="seg" role="group" aria-label="Select facility">
          <a
            href="/rent?facility=worthington"
            class={`seg-btn ${facility === 'worthington' ? 'seg-btn--active' : ''}`}
          >
            Worthington
            <span class="seg-btn-sub">2 fields · Orange, Blue</span>
          </a>
          <a
            href="/rent?facility=downtown"
            class={`seg-btn ${facility === 'downtown' ? 'seg-btn--active' : ''}`}
          >
            Downtown
            <span class="seg-btn-sub">1 field · Yellow</span>
          </a>
        </div>
        <div class="loc-meta">
          {facility === 'worthington' ? (
            <span class="mono">535 Lakeview Plaza Blvd, Worthington, OH 43085</span>
          ) : (
            <span class="mono">980 E Starr Ave, Columbus, OH 43201</span>
          )}
          <span class="mono">Open 4PM – 12AM daily</span>
        </div>
      </div>
    </div>

    <!-- Calendar -->
    <div class="calendar-section">
      <div class="cal-inner">
        <div class="cal-header">
          <div class="cal-header-left">
            <h2 class="cal-title">Select a Time Slot</h2>
          </div>
        </div>

        <!-- Availability disclaimer -->
        <div class="avail-disclaimer" role="note">
          <span class="avail-icon" aria-hidden="true">⚠</span>
          <span>Field rental availability is very limited on weekends between November and March, and on weekdays after 6 PM.</span>
        </div>

        <FieldCalendar client:load venues={calendarVenues} timeZone={orgTimeZone} bookingWindowDays={bookingWindowDays} signedIn={!!Astro.locals.user} />

        <!-- Cancellation policy -->
        <p class="cancel-policy">Cancel 14+ days out for a full refund. Within 14 days, bookings are final.</p>
      </div>
    </div>

    <!-- What you play on (accurate) -->
    <div class="play-section">
      <div class="play-inner">
        <div class="play-header">
          <h2 class="play-title">What you play on</h2>
          <p class="play-lead">Built new in 2026 — not a retrofit. Here's exactly what's there today.</p>
        </div>
        <div class="fact-grid">
          {PLAY_FACTS.map((fact) => (
            <div class="fact-card">
              <div class="fact-big">{fact.big}</div>
              <div class="fact-title">{fact.title}</div>
              <div class="fact-desc">{fact.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Futsal — Coming September -->
    <div class="fut-section">
      <div class="fut-inner">
        <div class="fut-copy">
          <h2 class="fut-title">Futsal — Coming September</h2>
          <p class="fut-desc">Indoor futsal courts open this September at Worthington. Join the list — we'll email you the moment booking opens.</p>
        </div>

        <form id="fut-form" class="fut-form" novalidate>
          <label class="fut-field">
            <span class="fut-label">Email</span>
            <input
              type="email"
              id="fut-email"
              name="email"
              required
              maxlength="320"
              placeholder="you@example.com"
              class="fut-input"
              autocomplete="email"
            />
          </label>
          <button type="submit" id="fut-submit" class="fut-btn">
            <span class="fut-btn-text">Notify me →</span>
            <span class="fut-btn-spinner" hidden aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="pf-spin"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-dasharray="28" stroke-dashoffset="10" stroke-linecap="round"/></svg>
            </span>
          </button>
          <div id="fut-error" class="fut-error" hidden></div>
        </form>

        <div id="fut-success" class="fut-success" hidden>
          <span class="fut-success-icon" aria-hidden="true">✓</span>
          <span>You're on the list — we'll email you when booking opens.</span>
        </div>
      </div>
    </div>

    <!-- Package request section -->
    <div class="pkg-section" id="rental-package">
      <div class="pkg-inner">
        <div class="pkg-layout">

          <!-- Left: copy -->
          <div class="pkg-copy">
            <div class="pkg-header">
              <h2 class="pkg-title">Need a package?</h2>
            </div>
            <p class="pkg-desc">Booking 10+ hours, a recurring slot, or a tournament block? Tell us what you need and we'll build a custom package.</p>
            <ul class="pkg-perks">
              <li class="pkg-perk">
                <span class="perk-dot" aria-hidden="true"></span>
                Bulk-hour discounts
              </li>
              <li class="pkg-perk">
                <span class="perk-dot" aria-hidden="true"></span>
                Weekly or bi-weekly reserved slots
              </li>
              <li class="pkg-perk">
                <span class="perk-dot" aria-hidden="true"></span>
                Multi-field tournament blocks
              </li>
              <li class="pkg-perk">
                <span class="perk-dot" aria-hidden="true"></span>
                Custom invoicing for clubs &amp; orgs
              </li>
            </ul>
          </div>

          <!-- Right: form -->
          <div class="pkg-form-wrap">

            <!-- Idle / error state -->
            <form id="pkg-form" class="pkg-form" novalidate>
              <div class="pf-row pf-row--2">
                <label class="pf-field">
                  <span class="pf-label">Organization / team name <span class="pf-opt">(optional)</span></span>
                  <input
                    type="text"
                    id="pkg-org"
                    name="orgName"
                    maxlength="255"
                    placeholder="Columbus FC, Individual, etc."
                    class="pf-input"
                    autocomplete="organization"
                  />
                </label>
                <label class="pf-field">
                  <span class="pf-label">Contact name <span class="pf-req" aria-label="required">*</span></span>
                  <input
                    type="text"
                    id="pkg-name"
                    name="contactName"
                    required
                    maxlength="200"
                    placeholder="Your full name"
                    class="pf-input"
                    autocomplete="name"
                  />
                </label>
              </div>

              <label class="pf-field">
                <span class="pf-label">Email <span class="pf-req" aria-label="required">*</span></span>
                <input
                  type="email"
                  id="pkg-email"
                  name="contactEmail"
                  required
                  maxlength="320"
                  placeholder="you@example.com"
                  class="pf-input"
                  autocomplete="email"
                />
              </label>

              <label class="pf-field">
                <span class="pf-label">Desired dates, times &amp; duration <span class="pf-opt">(optional)</span></span>
                <input
                  type="text"
                  id="pkg-dates"
                  name="preferredStart"
                  maxlength="100"
                  placeholder="e.g. Sat mornings starting July, 2 hr blocks"
                  class="pf-input"
                />
              </label>

              <label class="pf-field">
                <span class="pf-label">Anything else? <span class="pf-opt">(optional)</span></span>
                <textarea
                  id="pkg-msg"
                  name="message"
                  rows="4"
                  maxlength="1900"
                  placeholder="Number of fields, add-ons, tournament format, budget — whatever helps us scope the package."
                  class="pf-textarea"
                ></textarea>
              </label>

              <div id="pkg-error" class="pf-error" hidden></div>

              <button type="submit" id="pkg-submit" class="pf-btn">
                <span class="pf-btn-text">Request a Package →</span>
                <span class="pf-btn-spinner" hidden aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="pf-spin"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-dasharray="28" stroke-dashoffset="10" stroke-linecap="round"/></svg>
                  Sending…
                </span>
              </button>
            </form>

            <!-- Success state (hidden until submit OK) -->
            <div id="pkg-success" class="pf-success" hidden>
              <div class="pfs-icon" aria-hidden="true">✓</div>
              <div class="pfs-body">
                <h3 class="pfs-title">Thanks — we'll be in touch about your package.</h3>
                <p class="pfs-sub">Expect a reply within one business day. Questions now? Email <a href="mailto:rentals@gosoccerone.com" class="pfs-link">rentals@gosoccerone.com</a>.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

  </main>

  <SoccerOneFooter hideStatsBand={true} />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }

    .rent-main { flex: 1; font-family: var(--so-font-body); }

    .rent-header { background: var(--so-ink); border-bottom: 1px solid var(--so-lime-a10); padding: 4rem 0 0; }
    .rh-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }

    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; }
    .bc-link { font-size: 0.8125rem; color: var(--so-lime-a60); text-decoration: none; font-weight: 500; transition: color 0.15s; }
    .bc-link:hover { color: var(--so-lime); }
    .bc-sep { color: rgba(255,255,255,0.2); font-size: 0.75rem; }
    .bc-current { font-size: 0.8125rem; color: rgba(255,255,255,0.4); }

    .rh-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; flex-wrap: wrap; }

    .rh-title { font-family: var(--so-font-display); font-size: clamp(3.5rem, 8vw, 7.5rem); color: #ffffff; line-height: 0.92; letter-spacing: 0.01em; margin-bottom: 1rem; }
    .rh-desc { font-size: 1.0625rem; color: var(--muted); line-height: 1.6; max-width: 440px; }

    /* Tiered rates table */
    .rates-table-wrap {
      flex-shrink: 0;
      max-width: 560px;
      width: 100%;
    }
    .rates-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--so-lime-a04);
      border: 1px solid var(--so-lime-a15);
      border-radius: var(--so-radius-md);
      overflow: hidden;
      font-size: 0.8125rem;
    }
    .rt-th {
      font-family: var(--so-font-mono);
      font-size: 0.5rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: rgba(255,255,255,0.4);
      text-align: left;
      padding: 0.625rem 0.875rem;
      border-bottom: 1px solid var(--so-lime-a10);
      white-space: nowrap;
    }
    .rt-th--season { color: var(--so-lime-a50); }
    .rt-season {
      font-family: var(--so-font-mono);
      font-size: 0.75rem;
      color: rgba(255,255,255,0.55);
      padding: 0.625rem 0.875rem;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      white-space: nowrap;
    }
    .rt-rate {
      font-family: var(--so-font-display);
      font-size: 1.375rem;
      color: var(--so-lime);
      letter-spacing: 0.02em;
      padding: 0.625rem 0.875rem;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      white-space: nowrap;
    }
    .rt-per {
      font-family: var(--so-font-mono);
      font-size: 0.5rem;
      color: var(--so-lime-a60);
      letter-spacing: 0.06em;
      margin-left: 1px;
    }
    tbody tr:last-child .rt-season,
    tbody tr:last-child .rt-rate { border-bottom: none; }

    /* Availability disclaimer */
    .avail-disclaimer {
      display: flex;
      align-items: flex-start;
      gap: 0.625rem;
      background: rgba(var(--so-lime-rgb, 163,230,53), 0.06);
      border: 1px solid var(--so-lime-a20);
      border-left: 3px solid var(--so-lime);
      border-radius: var(--so-radius-sm);
      padding: 0.875rem 1rem;
      font-size: 0.875rem;
      color: rgba(255,255,255,0.7);
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }
    .avail-icon {
      color: var(--so-lime);
      font-size: 0.875rem;
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* Cancellation policy */
    .cancel-policy {
      font-family: var(--so-font-mono);
      font-size: 0.75rem;
      color: rgba(255,255,255,0.35);
      letter-spacing: 0.04em;
      margin-top: 1.25rem;
    }

    /* Call chip (hero) */
    .call-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      margin-top: 1.25rem;
      padding: 0.625rem 1rem;
      border: 1px solid var(--so-lime-a25);
      background: var(--so-lime-a06, rgba(163,230,53,0.06));
      border-radius: 999px;
      font-size: 0.875rem;
      text-decoration: none;
      transition: border-color 0.15s, background 0.15s;
    }
    .call-chip:hover { border-color: var(--so-lime-a50); background: var(--so-lime-a10); }
    .call-chip b { color: var(--so-lime); letter-spacing: 0.03em; }
    .call-chip-sub { color: rgba(255,255,255,0.55); }

    /* Location segmented control */
    .seg-label { font-size: 0.6875rem; letter-spacing: 0.16em; color: var(--so-lime-a60); text-transform: uppercase; padding-top: 1.5rem; margin: 0 0 0.625rem; border-top: 1px solid var(--border); }
    .seg { display: inline-flex; gap: 0.5rem; background: var(--so-surface); border: 1px solid var(--border); padding: 0.375rem; border-radius: 0.75rem; flex-wrap: wrap; }
    .seg-btn {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 0.75rem 1.25rem;
      border-radius: 0.5rem;
      font-family: var(--so-font-body);
      font-weight: 700;
      font-size: 0.9375rem;
      color: rgba(255,255,255,0.55);
      text-decoration: none;
      transition: background 0.15s, color 0.15s;
    }
    .seg-btn:hover { color: #ffffff; }
    .seg-btn-sub { font-family: var(--so-font-mono); font-size: 0.625rem; font-weight: 500; letter-spacing: 0.06em; color: inherit; opacity: 0.7; }
    .seg-btn--active { background: var(--so-lime); color: var(--so-ink); }
    .seg-btn--active:hover { color: var(--so-ink); }

    .loc-meta { display: flex; gap: 1.125rem; flex-wrap: wrap; align-items: center; margin-top: 0.75rem; padding-bottom: 1.5rem; }
    .loc-meta .mono { color: rgba(255,255,255,0.4); font-size: 0.75rem; letter-spacing: 0.04em; }

    /* Calendar */
    .calendar-section { background: var(--bg); padding: 4rem 0; }
    .cal-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }
    .cal-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
    .cal-header-left { display: flex; align-items: baseline; gap: 1rem; }
    .cal-title { font-family: var(--so-font-display); font-size: clamp(1.75rem, 3vw, 2.5rem); color: #ffffff; letter-spacing: 0.01em; line-height: 1; }
    .cal-legend { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
    .cl-item { display: flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; color: rgba(255,255,255,0.4); }
    .cl-dot { width: 8px; height: 8px; border-radius: 50%; }
    .cl-open { background: var(--so-lime); }
    .cl-league { background: #67e8f9; }
    .cl-rental { background: #fbbf24; }
    .cl-practice { background: #c4b5fd; }
    .cal-desc { font-size: 0.875rem; color: rgba(255,255,255,0.35); margin-bottom: 2rem; }

    /* What you play on */
    .play-section { background: var(--bg-2); border-top: 1px solid var(--border); padding: 4rem 0; }
    .play-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }
    .play-header { margin-bottom: 1.5rem; }
    .play-title { font-family: var(--so-font-display); font-size: clamp(1.75rem, 3vw, 2.5rem); color: #ffffff; letter-spacing: 0.01em; line-height: 1; margin-bottom: 0.5rem; }
    .play-lead { font-size: 0.9375rem; color: rgba(255,255,255,0.45); }
    .fact-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .fact-card { background: var(--so-surface); border: 1px solid var(--so-lime-a20); border-radius: var(--so-radius-lg); padding: 1.25rem; }
    .fact-big { font-family: var(--so-font-display); font-size: 2.25rem; color: var(--so-lime); line-height: 1; }
    .fact-title { font-weight: 700; margin: 0.75rem 0 0.25rem; font-size: 0.9375rem; color: #ffffff; }
    .fact-desc { color: rgba(255,255,255,0.45); font-size: 0.8125rem; line-height: 1.5; }

    /* Futsal — Coming September */
    .fut-section {
      background: var(--so-lime-a05);
      border-top: 1px solid var(--so-lime-a10);
      border-bottom: 1px solid var(--so-lime-a10);
      padding: 3rem 0;
    }
    .fut-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
