---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { DOWNTOWN_JSONLD } from '@/lib/seo/soccerone-jsonld';
import HomeSignupStrip from '@/components/soccerone/HomeSignupStrip';
import { HOME_GOOGLE_RATING, HOME_REVIEWS } from '@/lib/soccerone/home-reviews';

// Live season data — org-scoped fetch pinned to the Downtown location,
// same pattern as src/pages/soccerone/worthington/index.astro:11-41.
async function fetchOpenSeasons(audience: 'adult' | 'youth') {
  try {
    const url = new URL('/api/public/seasons', Astro.url);
    // Prod (single-org cutover 2026-06-11) resolves gosoccerone.com to the
    // single Aspire org, whose location slugs are bare (`worthington`,
    // `downtown` — see src/lib/organization/soccerone-routing.ts:5-11 and
    // rent.astro's locationSlug). The SoccerOne staging fixture org's seed
    // uses the same bare slug (renamed from the legacy "soccerone-downtown"
    // in seed-e2e-tests.ts stage 12a), so this stays correct on both.
    url.searchParams.set('location', 'downtown');
    url.searchParams.set('audience', audience);
    // Dev-only guard: Astro.url reconstructs from the forwarded Host header,
    // so a port-less Host (e.g. `curl -H "Host: soccerone.localhost"`) yields
    // port 80 and the self-fetch misses the dev server. Pin the dev port.
    // Do NOT rewrite the hostname to localhost: undici silently drops an
    // explicit Host header (forbidden fetch header), so the tenant must stay
    // in the URL or org resolution falls back to the default org.
    if (url.hostname.endsWith('.localhost') && !url.port) url.port = '4321';
    const res = await fetch(url, {
      headers: { Host: Astro.request.headers.get('host') ?? '' },
    });
    if (!res.ok) return [];
    const body = await res.json();
    const todayIso = new Date().toISOString().slice(0, 10);
    return (body.seasons ?? [])
      .filter((s: any) => s.signupMode !== 'interest')
      .filter((s: any) => !s.startDate || String(s.startDate).slice(0, 10) >= todayIso);
  } catch (err) {
    console.error('[soccerone/downtown] failed to load ' + audience + ' seasons', err);
    return [];
  }
}

const adultSeasons = await fetchOpenSeasons('adult');

// The hero's priority register CTA and the fully-live Fall Leagues block
// both need "a fall season" specifically — Downtown's catalog can also
// carry non-fall seasons with no dayOfWeek (e.g. the individual-only
// "Adult Coed — Spring 2026" fixture), which lack deposit/team pricing and
// would render an incoherent Fall block if picked. Prefer the earliest
// dayOfWeek-scheduled (fall) season; fall back to any open adult season so
// the CTA still has somewhere to send players if no fall season exists yet.
const fallCandidates = adultSeasons.filter((s: any) => s.dayOfWeek);
const featured = fallCandidates[0] ?? adultSeasons[0] ?? null;

// registrationCloses is a timestamp (full ISO instant): display the
// deadline in the org's local timezone, not the server's.
const featuredCloses = featured?.registrationCloses
  ? new Date(featured.registrationCloses).toLocaleDateString('en-US', {
      weekday: 'short', month: 'short', day: 'numeric', timeZone: 'America/New_York',
    })
  : null;

// No early-bird promo here — that's a Worthington-only founder decision
// ($1,000/team thru Aug 3). Downtown prints only live-catalog pricing.

// Guarded price strings for the fall pricing block — never render "$null"
// when a field is unset. Thousands-separated to match team-price formatting
// (mirrors src/pages/soccerone/worthington/index.astro:70-73).
const fmtPrice = (n: number) => `$${n.toLocaleString('en-US')}`;
const teamPriceStr = featured?.teamPrice != null ? fmtPrice(featured.teamPrice) : null;
const soloPriceStr = featured?.price != null ? fmtPrice(featured.price) : null;
const depositStr = featured?.deposit != null ? fmtPrice(featured.deposit) : null;

// Every fall-date mention on the page derives from the live featured season
// (no hardcoded calendar dates). startDate/endDate are date-only columns
// ("YYYY-MM-DD"): parsing yields UTC midnight, so format in UTC —
// America/New_York would shift the date back a day.
const formatSeasonDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', timeZone: 'UTC',
  });
const fallKickoffDate = featured?.startDate ? formatSeasonDate(featured.startDate) : null;
const fallEndDate = featured?.endDate ? formatSeasonDate(featured.endDate) : null;

// What's Happening — "THE FALL RHYTHM" list groups the fetched adult
// seasons by dayOfWeek (Sunday→Saturday) and joins each day's season
// names + a formatted startTime–endTime range. Never fabricate: only
// names/days pulled straight from the API. Unlike Worthington, NO static
// night rows are appended here — Downtown has no founder-documented
// weekly rhythm yet, so the list is exclusively live rows and the whole
// fall tab hides when the catalog has no dayOfWeek-scheduled seasons.
const DAY_ORDER = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'] as const;
const DAY_NAMES: Record<string, string> = {
  sun: 'Sunday', mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday',
  thu: 'Thursday', fri: 'Friday', sat: 'Saturday',
};

function formatTimeRange(start?: string | null, end?: string | null): string | null {
  if (!start || !end) return null;
  const toHour12 = (t: string) => {
    const h = parseInt(t.slice(0, 2), 10) % 24;
    const suffix = h >= 12 ? 'pm' : 'am';
    const h12 = h % 12 === 0 ? 12 : h % 12;
    return { h12, suffix };
  };
  const s = toHour12(start);
  const e = toHour12(end);
  return s.suffix === e.suffix
    ? `${s.h12}–${e.h12}${e.suffix}`
    : `${s.h12}${s.suffix}–${e.h12}${e.suffix}`;
}

const seasonsByDay = new Map<string, typeof adultSeasons>();
for (const season of adultSeasons) {
  if (!season.dayOfWeek) continue;
  const list = seasonsByDay.get(season.dayOfWeek) ?? [];
  list.push(season);
  seasonsByDay.set(season.dayOfWeek, list);
}

// Hide the fall tab + list entirely when the catalog carries no
// dayOfWeek-scheduled adult seasons yet (summer state only).
const hasFallSchedule = seasonsByDay.size > 0;

const liveFallRows = DAY_ORDER
  .filter((day) => seasonsByDay.has(day))
  .map((day) => {
    const daySeasons = seasonsByDay.get(day) ?? [];
    const names = daySeasons.map((s: any) => s.name).join(', ');
    const hasFutsal = daySeasons.some((s: any) => /futsal/i.test(s.name ?? ''));
    const timeStr = formatTimeRange(daySeasons[0]?.startTime, daySeasons[0]?.endTime);
    const text = timeStr ? `${names} · ${timeStr}` : names;
    return { day: DAY_NAMES[day], text, tag: hasFutsal ? 'LEAGUES + FUTSAL' : 'LEAGUES', hasFutsal };
  });

import { setMarketingEdgeCache } from '@/lib/http/edge-cache';
setMarketingEdgeCache(Astro); // after fetches; a degraded (empty-seasons) render may cache for 60s — SWR refreshes it
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title="Soccer ONE Indoor Soccer — Downtown Columbus | SoccerOne · 980 E Starr Ave"
  description="Soccer ONE Indoor Soccer, Downtown Columbus — one fast 130×45 field built for 6v6, minutes from downtown offices. After-work pickup, leagues, and field rentals. 980 E Starr Ave. Open 4pm–12am daily."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(DOWNTOWN_JSONLD)} />
  </Fragment>

  <SoccerOneHeader currentFacility="downtown" />

  <main class="facility-main">

    <!-- ============================================================
         HERO — typographic (no Starr Ave footage yet), field-motif SVG,
         priority CTAs
    ============================================================ -->
    <section class="f-hero" aria-label="Downtown hero">
      <div class="f-hero-bg" aria-hidden="true">
        <!-- video slot: swap for a <video> element (see the f-hero-video
             pattern in src/pages/soccerone/worthington/index.astro) once a
             5-minute Starr Ave phone shoot exists — wide field w/ players,
             entrance, one detail. -->
        <svg
          class="f-hero-motif"
          viewBox="0 0 1300 450"
          preserveAspectRatio="xMidYMid slice"
          fill="none"
          aria-hidden="true"
        >
          <rect x="60" y="60" width="1180" height="330" rx="10" stroke="rgba(163,230,53,0.22)" stroke-width="2"/>
          <line x1="650" y1="60" x2="650" y2="390" stroke="rgba(163,230,53,0.16)" stroke-width="1.5"/>
          <circle cx="650" cy="225" r="60" stroke="rgba(163,230,53,0.16)" stroke-width="1.5"/>
          <rect x="60" y="150" width="46" height="150" stroke="rgba(255,255,255,0.14)" stroke-width="1.5"/>
          <rect x="1194" y="150" width="46" height="150" stroke="rgba(255,255,255,0.14)" stroke-width="1.5"/>
          <text x="650" y="44" fill="rgba(163,230,53,0.4)" font-family="monospace" font-size="15" text-anchor="middle" letter-spacing="4">130 FT</text>
          <text x="34" y="225" fill="rgba(163,230,53,0.4)" font-family="monospace" font-size="15" text-anchor="middle" letter-spacing="4" transform="rotate(-90 34 225)">45 FT</text>
        </svg>
      </div>

      <div class="f-hero-inner">
        <nav class="f-breadcrumb" aria-label="Breadcrumb"><a href="/">Locations</a> / Downtown</nav>
        <h1 class="f-title">Downtown</h1>
        <p class="f-sub">
          SoccerOne in the city — one fast <b>130×45 field built for 6v6</b>, minutes from
          downtown offices. After-work pickup, leagues, and rentals on Starr Ave.
        </p>

        <div class="f-cta-row">
          {featured && (
            <a
              href={`/register/${featured.id}`}
              class="f-cta f-cta--primary"
              data-so-register-cta
              data-season-id={featured.id}
              data-level={featured.skillLevel ?? 'open'}
              data-gender={featured.divisionGender ?? 'unknown'}
              data-venue={featured.location?.slug ?? ''}
              data-term={featured.termSlug ?? ''}
              data-mode={featured.signupModes?.includes('team') ? 'team' : 'individual'}
            >
              <span class="f-cta-label">Register for Fall Leagues →</span>
              {featuredCloses && (
                <span class="f-cta-note">CLOSES {featuredCloses.toUpperCase()}</span>
              )}
            </a>
          )}
          <a href="/pickup?facility=downtown" class="f-cta f-cta--secondary">
            <span class="f-cta-label">Play Pickup</span>
            <span class="f-cta-note">AFTER WORK · SEE THIS WEEK'S SESSIONS</span>
          </a>
          <a href="/rent?facility=downtown" class="f-cta f-cta--tertiary">
            <span class="f-cta-label">Book the Field</span>
            <span class="f-cta-note">BY THE HOUR · ONLINE IN TWO MINUTES</span>
          </a>
        </div>

        <div class="f-fact-line">
          <span><b>980 E Starr Ave</b>, Columbus OH · Milo-Grogan</span>
          <span class="ffl-div"></span>
          <span>OPEN 4PM–12AM DAILY</span>
          <span class="ffl-div"></span>
          <span><b>FREE LOT AT THE BUILDING</b></span>
          <span class="ffl-div"></span>
          <span>SAME ACCOUNT AS WORTHINGTON</span>
        </div>
      </div>
    </section>

    <!-- ============================================================
         WHAT'S HAPPENING — live-only fall rows, honest summer state
    ============================================================ -->
    <section class="sec happening" id="happening" aria-label="What's happening">
      <div class="sec-inner">
        <div class="hap-head">
          <div>
            <div class="kicker-bar"></div>
            <h2 class="sec-title">What's Happening</h2>
            <p class="sec-desc">The Starr Ave rhythm — pickup after work, leagues in season, the field yours by the hour in between.</p>
          </div>
          {hasFallSchedule && (
            <div class="hap-toggle">
              <button class="hap-tab hap-tab--on" id="tabNow" type="button">NOW · SUMMER</button>
              <button class="hap-tab" id="tabFall" type="button">THE FALL RHYTHM</button>
            </div>
          )}
        </div>

        <div class="now-grid">
          <div class="now-card">
            <span class="now-when">EVENINGS · AFTER WORK</span>
            <span class="now-what">Drop-In Pickup</span>
            <p class="now-note">Show up and play — balanced teams on the fast 6v6 field. Live session times from the schedule.</p>
            <a href="/pickup?facility=downtown" class="now-link">See sessions →</a>
          </div>
          <div class="now-card">
            <span class="now-when">ANY DAY · BY THE HOUR</span>
            <span class="now-what">Field Rental</span>
            <p class="now-note">Book the field for training, a private game, or a company night — online in two minutes.</p>
            <a href="/rent?facility=downtown" class="now-link">Book the field →</a>
          </div>
          {featured && (
            <div class="now-card">
              <span class="now-when">OPEN NOW{featuredCloses && ` · CLOSES ${featuredCloses.toUpperCase()}`}</span>
              <span class="now-what">Fall Registration</span>
              <p class="now-note">Downtown divisions from the live catalog. Card renders only when a season is open here.</p>
              <a href="#fall" class="now-link">Grab your spot →</a>
            </div>
          )}
        </div>

        {hasFallSchedule && (
          <Fragment>
            <div class="week-list">
              {liveFallRows.map((row) => (
                <div class="week-row"><span class="wr-day">{row.day}</span><span class="wr-what">{row.text}</span><span class={row.hasFutsal ? 'wr-tag wr-tag--futsal' : 'wr-tag'}>{row.tag}</span></div>
              ))}
            </div>
            <p class="hap-note">Season dates and deadlines derive from the live catalog — same plumbing as Worthington.</p>
          </Fragment>
        )}
      </div>
    </section>

    <!-- ============================================================
         THE FIELD — real, owner-confirmed specs only
    ============================================================ -->
    <section class="sec building" aria-label="The field">
      <div class="sec-inner">
        <div class="kicker-bar"></div>
        <h2 class="sec-title">The Field</h2>
        <p class="sec-desc">One field, built for speed. Tight dimensions mean quick touches, constant involvement, and nowhere to hide.</p>

        <div class="build-grid">
          <div>
            <div class="spec-cards">
              <div class="spec-card">
                <div class="spec-num">130×45</div>
                <div class="spec-name">One indoor field</div>
                <p class="spec-note">Long and tight — the shape that makes 6v6 fast. More touches per player than any big-field format.</p>
              </div>
              <div class="spec-card">
                <div class="spec-num">6v6</div>
                <div class="spec-name">The Starr Ave format</div>
                <p class="spec-note">Built for it. Small squads, short shifts, everyone involved in every play.</p>
              </div>
              <div class="spec-card">
                <div class="spec-num">4–12</div>
                <div class="spec-name">Open every day</div>
                <p class="spec-note">4pm to midnight — after-work pickup to late-night runs.</p>
              </div>
              <div class="spec-card">
                <div class="spec-num">1</div>
                <div class="spec-name">Account for both venues</div>
                <p class="spec-note">Your SoccerOne account and membership work here and at Worthington.</p>
              </div>
            </div>

            <div class="field-figure" aria-label="Field diagram">
              <svg viewBox="0 0 560 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="20" y="25" width="520" height="130" rx="8" stroke="#a3e635" stroke-width="2" fill="rgba(163,230,53,0.04)"/>
                <line x1="280" y1="25" x2="280" y2="155" stroke="rgba(163,230,53,0.35)" stroke-width="1.5"/>
                <circle cx="280" cy="90" r="26" stroke="rgba(163,230,53,0.35)" stroke-width="1.5"/>
                <rect x="20" y="65" width="20" height="50" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>
                <rect x="520" y="65" width="20" height="50" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>
                <text x="280" y="16" fill="rgba(255,255,255,0.6)" font-family="monospace" font-size="11" text-anchor="middle">130 FT</text>
                <text x="10" y="90" fill="rgba(255,255,255,0.6)" font-family="monospace" font-size="11" text-anchor="middle" transform="rotate(-90 10 90)">45 FT</text>
                <text x="280" y="172" fill="rgba(163,230,53,0.7)" font-family="monospace" font-size="10" text-anchor="middle">BUILT FOR 6V6</text>
              </svg>
              <p class="field-caption">THE STARR AVE FIELD · FAST BY DESIGN</p>
            </div>
          </div>

          <div class="diff-list">
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">The after-work field</div>
              <p class="diff-copy">Minutes from downtown offices — on the field by 6, home at a human hour.</p>
            </div></div>
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">6v6 means more ball</div>
              <p class="diff-copy">Tighter field, smaller squads — you touch the ball every minute, not every quarter.</p>
            </div></div>
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">Quiet pocket, easy in-and-out</div>
              <p class="diff-copy">Tucked in Milo-Grogan with a lot at the door — no downtown parking hunt.</p>
            </div></div>
            <div class="diff-item"><span class="diff-dot"></span><div>
              <div class="diff-title">Rated 4.7 on Google</div>
              <p class="diff-copy">The Starr Ave building is the original SoccerOne — clean, friendly, and reviewed to prove it.</p>
            </div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SOCIAL PROOF — the 4.7 Google listing IS this building
         (reuses home-reviews.ts / the homepage proof-section pattern)
    ============================================================ -->
    {HOME_GOOGLE_RATING && HOME_REVIEWS.length > 0 && (
      <section class="sec proof-section" aria-label="Player reviews">
        <div class="proof-inner">
          <div class="proof-head">
            <div>
              <div class="kicker-bar"></div>
              <h2 class="sec-title">Players Rate This Place</h2>
            </div>
            <div class="proof-rating">
              <span class="proof-score">{HOME_GOOGLE_RATING.score}</span>
              <span class="proof-stars">
                <span class="stars" aria-hidden="true">★★★★★</span>
                {/* This location's own listing (980 E Starr Ave) — not the
                    aggregate "GOOGLE REVIEWS · COLUMBUS" source line the
                    homepage shows, since that copy spans both venues. */}
                <span class="proof-source">GOOGLE REVIEWS · THIS LOCATION</span>
              </span>
            </div>
          </div>
          <div class="proof-grid">
            {HOME_REVIEWS.map((r) => (
              <div class="review-card">
                <span class="rc-stars" aria-label={`${r.stars} stars`}>{'★'.repeat(r.stars)}</span>
                <p class="rc-quote">"{r.quote}"</p>
                <div class="rc-byline">
                  <span class="rc-name">{r.name}</span>
                  <span class="rc-context">{r.context}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- media strip lands when Starr Ave footage exists (see Worthington's for the pattern) -->

    <!-- ============================================================
         FALL LEAGUES — fully live from the downtown catalog
    ============================================================ -->
    {featured && (
      <section class="sec fall-block" id="fall" aria-label="Fall leagues pricing">
        <div class="sec-inner">
          <div class="fall-grid">
            <div>
              <h2 class="fall-title">
                {fallKickoffDate ? <>Fall leagues<br />kick off {fallKickoffDate}.</> : 'Fall leagues are coming.'}
              </h2>
              <p class="fall-copy">
                Division names, night, and format straight from the live catalog — 6v6 on the fast field.
                <b>7 games in 7 weeks, every team plays every week, no playoffs.</b>
              </p>
              <div class="fall-facts">
                {fallKickoffDate && fallEndDate && (
                  <span class="fall-fact">{`${fallKickoffDate} – ${fallEndDate}`.toUpperCase()}</span>
                )}
                <span class="fall-fact">6V6 FORMAT</span>
                <span class="fall-fact">REFS RATED EVERY GAME</span>
              </div>
            </div>
            <div class="price-card">
              <span class="price-dock">OPEN{featuredCloses && ` · CLOSES ${featuredCloses.toUpperCase()}`}</span>
              <div class="price-rows">
                {teamPriceStr && (
                  <div class="price-row"><span class="pr-label">Team</span><span class="pr-val">{teamPriceStr}</span></div>
                )}
                {soloPriceStr && (
                  <div class="price-row"><span class="pr-label">Solo / free agent</span><span class="pr-val">{soloPriceStr}</span></div>
                )}
                {depositStr && (
                  <div class="price-row"><span class="pr-label">Hold your spot</span><span class="pr-val">{depositStr} <small>deposit</small></span></div>
                )}
              </div>
              <a
                href={`/register/${featured.id}`}
                class="price-cta"
                data-so-register-cta
                data-season-id={featured.id}
                data-level={featured.skillLevel ?? 'open'}
                data-gender={featured.divisionGender ?? 'unknown'}
                data-venue={featured.location?.slug ?? ''}
                data-term={featured.termSlug ?? ''}
                data-mode={featured.signupModes?.includes('team') ? 'team' : 'individual'}
              >Register →</a>
              <p class="price-note">Secure checkout · powered by Aspire Sports</p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ============================================================
         GOOD TO KNOW
    ============================================================ -->
