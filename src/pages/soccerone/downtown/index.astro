  <script>
    import { trackDivisionRegisterClicked } from "@/lib/analytics/events";

    // Conversion analytics on the server-rendered register CTAs (hero + fall block).
    document.querySelectorAll<HTMLAnchorElement>("[data-so-register-cta]").forEach((el) => {
      el.addEventListener("click", () => {
        trackDivisionRegisterClicked({
          seasonId: el.dataset.seasonId ?? "",
          level: el.dataset.level ?? "open",
          gender: el.dataset.gender ?? "unknown",
          venue: el.dataset.venue ?? "",
          mode: el.dataset.mode === "team" ? "team" : "individual",
          term: el.dataset.term ?? "",
        });
      });
    });
  </script>

  <script is:inline>
    // What's Happening toggle — plain class flip, click-driven only (no
    // window keydown listeners). No-ops when the fall tab is hidden
    // (summer-only state, no dayOfWeek-scheduled seasons yet).
    (function () {
      var hap = document.getElementById("happening");
      var tabNow = document.getElementById("tabNow");
      var tabFall = document.getElementById("tabFall");
      if (!hap || !tabNow || !tabFall) return;
      tabNow.addEventListener("click", function () {
        hap.classList.remove("show-fall");
        tabNow.classList.add("hap-tab--on");
        tabFall.classList.remove("hap-tab--on");
      });
      tabFall.addEventListener("click", function () {
        hap.classList.add("show-fall");
        tabFall.classList.add("hap-tab--on");
        tabNow.classList.remove("hap-tab--on");
      });
    })();
  </script>

  <script is:inline>
    // Respect prefers-reduced-motion — no autoplay video exists on this page
    // yet (typographic hero), but this stays wired so a future video slot
    // (see the f-hero-bg comment above) inherits the guard for free, exactly
    // like Worthington's.
    (function () {
      if (!window.matchMedia || !window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      document.querySelectorAll("video[autoplay]").forEach(function (video) {
        video.pause();
        video.removeAttribute("autoplay");
      });
    })();
  </script>
</BaseLayout>
