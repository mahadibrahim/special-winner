---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoccerOneHeader from '@/components/soccerone/SoccerOneHeader.astro';
import SoccerOneFooter from '@/components/soccerone/SoccerOneFooter.astro';
import { SOCCERONE_CONTACT_EMAIL } from '@/lib/soccerone/contact';
import { setMarketingEdgeCache } from '@/lib/http/edge-cache';
setMarketingEdgeCache(Astro);
---

<BaseLayout
  favicon="/soccerone-favicon.svg"
  title="Downtown Columbus — SoccerOne | Indoor Soccer · 980 E Starr Ave"
  description="SoccerOne Downtown Columbus: 1 FIFA-approved indoor turf field in the heart of the city. After-work pickup, corporate leagues, and field rentals. 980 E Starr Ave. Open 4pm–12am."
  navigation={false}
  footer={false}
  bodyClass="min-h-screen flex flex-col bg-[#0a0a0d] text-white antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <SoccerOneHeader currentFacility="downtown" />

  <main class="facility-main">

    <!-- ============================================================
         FACILITY HERO — urban downtown aesthetic, late-night energy
    ============================================================ -->
    <section class="f-hero f-hero--downtown" aria-label="Downtown Columbus facility">
      <div class="f-hero-bg" aria-hidden="true">
        <img
          src="https://images.unsplash.com/photo-1763775594018-4a84eeadd83d?w=2000&q=80&fm=jpg"
          alt="Downtown Columbus facility — indoor futsal court"
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/65 to-black"></div>
        <div class="f-hero-bottom-stripe"></div>
      </div>

      <div class="f-hero-content">
        <!-- Breadcrumb -->
        <nav class="f-breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="fbc-link">SoccerOne</a>
          <span class="fbc-sep" aria-hidden="true">—</span>
          <span class="fbc-current">Downtown Columbus</span>
        </nav>

        <div class="f-hero-block">
          <div class="f-hero-left">
            <div class="f-hero-tag-row">
              <span class="f-tag f-tag--urban">URBAN</span>
              <span class="f-tag f-tag--live">
                <span class="live-dot"></span>
                OPEN NOW
              </span>
            </div>
            <h1 class="f-hero-title">
              <span class="fht-sub">DOWNTOWN</span>
              COLUMBUS
            </h1>
            <div class="f-field-count">
              <span class="fc-num">1</span>
              <span class="fc-label">INDOOR FIELD</span>
            </div>
            <div class="f-hero-address">
              980 E Starr Ave, Columbus, OH 43201
            </div>
            <div class="f-hero-hours mono">Open daily — 4:00 PM – 12:00 AM</div>

            <!-- Downtown differentiators -->
            <div class="dt-chips">
              <span class="dt-chip">After-work pickup</span>
              <span class="dt-chip">Corporate leagues</span>
              <span class="dt-chip">Downtown location</span>
            </div>
          </div>

          <div class="f-hero-right">
            <div class="f-hero-stats">
              <div class="fhs-item">
                <span class="fhs-num">FIFA</span>
                <span class="fhs-label">Approved turf</span>
              </div>
              <div class="fhs-div" aria-hidden="true"></div>
              <div class="fhs-item">
                <span class="fhs-num">7PM+</span>
                <span class="fhs-label">Peak pickups</span>
              </div>
              <div class="fhs-div" aria-hidden="true"></div>
              <div class="fhs-item">
                <span class="fhs-num">2 min</span>
                <span class="fhs-label">From I-670</span>
              </div>
            </div>
            <div class="f-hero-ctas">
              <a href="/rent?facility=downtown" class="f-cta-primary">Book the Field</a>
              <a href="/pickup?facility=downtown" class="f-cta-secondary">View Pickup</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         DOWNTOWN STORY — asymmetric layout
    ============================================================ -->
    <section class="dt-story" aria-label="About Downtown location">
      <div class="dt-story-inner">
        <div class="dt-story-text">
          <span class="section-num-sm">01.</span>
          <h2 class="dt-story-title">After-work.<br />On lunch.<br />Late-night.</h2>
          <p class="dt-story-body">
            Downtown Columbus runs on momentum. Our East Starr Ave location was built for players who want to get on the field without a 30-minute drive to the suburbs.
          </p>
          <p class="dt-story-body">
            One field. Full turf. Stadium lighting. Book it in under two minutes and walk here from your office.
          </p>

          <div class="dt-callout">
            <div class="dtc-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <circle cx="14" cy="14" r="12" stroke="#a3e635" stroke-width="1.5" fill="none"/>
                <path d="M14 8v6l4 4" stroke="#a3e635" stroke-width="1.75" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="dtc-text">
              <strong>Book at 5:00 PM, play at 6:00 PM.</strong>
              Same-day bookings open at 7am. After-work time slots typically available Monday–Friday.
            </div>
          </div>
        </div>

        <!-- Big number visual -->
        <div class="dt-story-visual" aria-hidden="true">
          <div class="dt-big-num">1</div>
          <div class="dt-big-label">FIELD IN THE HEART OF COLUMBUS</div>
          <div class="dt-feature-list">
            <div class="dtf-item">
              <span class="dtf-num mono">200 × 85</span>
              <span class="dtf-label">Full-size indoor field (ft)</span>
            </div>
            <div class="dtf-item">
              <span class="dtf-num mono">700+</span>
              <span class="dtf-label">Lux LED lighting</span>
            </div>
            <div class="dtf-item">
              <span class="dtf-num mono">$80</span>
              <span class="dtf-label">Per hour standard rate</span>
            </div>
            <div class="dtf-item">
              <span class="dtf-num mono">$64</span>
              <span class="dtf-label">Per hour — Founder members</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         THIS WEEK'S SCHEDULE
    ============================================================ -->
    <section class="schedule-section" aria-label="Downtown schedule">
      <div class="schedule-inner">
        <div class="schedule-header">
          <div class="sh-left">
            <span class="section-num-sm">02.</span>
            <h2 class="schedule-title">This Week</h2>
          </div>
          <div class="sh-right">
            <span class="schedule-date mono">A typical week</span>
            <a href="/pickup?facility=downtown" class="view-all-link">All pickup games →</a>
          </div>
        </div>

        <div class="schedule-board">
          <div class="sb-header-row">
            <div class="sbh-time">TIME</div>
            <div class="sbh-col">THE FIELD</div>
          </div>

          <div class="sb-row">
            <div class="sb-time mono">4:00 PM</div>
            <div class="sb-cell sb-cell--open">
              <span class="sbc-type">OPEN</span>
              <span class="sbc-name">Available for rental</span>
              <a href="/rent?facility=downtown" class="sb-book-link">Book →</a>
            </div>
          </div>

          <div class="sb-row">
            <div class="sb-time mono">5:00 PM</div>
            <div class="sb-cell sb-cell--pickup">
              <span class="sbc-type">PICKUP</span>
              <span class="sbc-name">Early Pickup — Open to all levels</span>
            </div>
          </div>

          <div class="sb-row">
            <div class="sb-time mono">6:00 PM</div>
            <div class="sb-cell sb-cell--open">
              <span class="sbc-type">OPEN</span>
              <span class="sbc-name">Available for rental</span>
              <a href="/rent?facility=downtown" class="sb-book-link">Book →</a>
            </div>
          </div>

          <div class="sb-row sb-row--prime">
            <div class="sb-time mono">7:30 PM</div>
            <div class="sb-cell sb-cell--pickup">
              <span class="sbc-type">PICKUP</span>
              <span class="sbc-name">After-Work Pickup (Competitive)</span>
            </div>
          </div>

          <div class="sb-row sb-row--prime">
            <div class="sb-time mono">9:00 PM</div>
            <div class="sb-cell sb-cell--league">
              <span class="sbc-type">LEAGUE</span>
              <span class="sbc-name">Corporate Coed League — Match Night</span>
            </div>
          </div>

          <div class="sb-row">
            <div class="sb-time mono">10:30 PM</div>
            <div class="sb-cell sb-cell--pickup">
              <span class="sbc-type">PICKUP</span>
              <span class="sbc-name">Late-Night Open Pickup</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         FIELD SPECS
    ============================================================ -->
    <section class="specs-section" aria-label="Field specs">
      <div class="specs-inner">
        <div class="specs-header-row">
          <div class="specs-left">
            <span class="section-num-sm">03.</span>
            <h2 class="specs-title">Field Specs</h2>
          </div>
          <a href="/rent?facility=downtown" class="specs-book-btn">Book the Field</a>
        </div>

        <div class="dt-specs-grid">
          <div class="dt-spec-block">
            <span class="dsb-label">SURFACE</span>
            <span class="dsb-val">FieldTurf® Revolution 360</span>
            <span class="dsb-sub">FIFA Quality Pro certified</span>
          </div>
          <div class="dt-spec-block">
            <span class="dsb-label">SIZE</span>
            <span class="dsb-val mono">200 × 85 ft</span>
            <span class="dsb-sub">Full-size indoor</span>
          </div>
          <div class="dt-spec-block">
            <span class="dsb-label">LIGHTING</span>
            <span class="dsb-val">700+ lux LED</span>
            <span class="dsb-sub">Color-corrected for video</span>
          </div>
          <div class="dt-spec-block">
            <span class="dsb-label">SCOREBOARD</span>
            <span class="dsb-val">Digital + shot clock</span>
            <span class="dsb-sub">Per-match display</span>
          </div>
          <div class="dt-spec-block">
            <span class="dsb-label">STANDARD RATE</span>
            <span class="dsb-val accent mono">$80/hr</span>
            <span class="dsb-sub">Member rates from $64/hr</span>
          </div>
          <div class="dt-spec-block">
            <span class="dsb-label">BOOKING WINDOW</span>
            <span class="dsb-val mono">7 days ahead</span>
            <span class="dsb-sub">30 days for Founder members</span>
          </div>
        </div>

        <!-- Included amenities -->
        <div class="dt-amenities">
          <div class="dta-heading">Every rental includes:</div>
          <div class="dta-list">
            <span class="dta-item"><span class="dta-check">✓</span> Locker room access</span>
            <span class="dta-item"><span class="dta-check">✓</span> Free street parking validated</span>
            <span class="dta-item"><span class="dta-check">✓</span> Scoreboard + shot clock</span>
            <span class="dta-item"><span class="dta-check">✓</span> Field equipment (cones, vests)</span>
            <span class="dta-item"><span class="dta-check">✓</span> Referee available upon request (+$40)</span>
            <span class="dta-item"><span class="dta-check">✓</span> Concierge scheduling support</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CORPORATE LEAGUE CTA
    ============================================================ -->
    <section class="corp-league" aria-label="Corporate leagues">
      <div class="corp-inner">
        <div class="corp-text">
          <span class="corp-eyebrow">CORPORATE LEAGUES</span>
          <h2 class="corp-title">Team bonding<br />that actually works.</h2>
          <p class="corp-desc">
            Columbus's top companies already play here. Our corporate coed league runs Tuesday and Thursday evenings — 7–10pm. Teams of 8–12 players. Season includes jerseys, referees, and end-of-season awards.
          </p>
          <div class="corp-stats">
            <div class="corp-stat">
              <span class="cs-num mono">12</span>
              <span class="cs-label">Corporate teams active</span>
            </div>
            <div class="corp-stat">
              <span class="cs-num mono">8</span>
              <span class="cs-label">Week seasons</span>
            </div>
            <div class="corp-stat">
              <span class="cs-num mono">$1,200</span>
              <span class="cs-label">Team entry fee</span>
            </div>
          </div>
          <a href="/leagues?facility=downtown" class="corp-cta">View Corporate League</a>
        </div>
        <div class="corp-visual" aria-hidden="true">
          <!-- Diagonal accent with text -->
          <div class="corp-visual-bg">
            <div class="cv-big-text">CORP.</div>
            <div class="cv-sub-text">COLUMBUS</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         HOURS & DIRECTIONS
    ============================================================ -->
    <section class="info-section" aria-label="Hours and directions">
      <div class="info-inner">
        <div class="info-hours">
          <span class="section-num-sm">04.</span>
          <h2 class="info-title">Hours &amp; Directions</h2>
          <div class="hours-grid">
            <div class="hours-row">
              <span class="hours-day">Monday – Friday</span>
              <span class="hours-time mono">4:00 PM – 12:00 AM</span>
            </div>
            <div class="hours-row">
              <span class="hours-day">Saturday</span>
              <span class="hours-time mono">4:00 PM – 12:00 AM</span>
            </div>
            <div class="hours-row">
              <span class="hours-day">Sunday</span>
              <span class="hours-time mono">4:00 PM – 12:00 AM</span>
            </div>
            <div class="hours-note">Peak hours Mon–Fri 5pm–10pm. Recommended to book in advance.</div>
          </div>
          <div class="info-address-block">
            <div class="iab-name">SoccerOne Downtown Columbus</div>
            <div class="iab-addr">980 E Starr Ave<br />Columbus, OH 43201</div>
            <div class="iab-parking">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="flex-shrink:0;margin-top:2px">
                <rect x="1" y="1" width="12" height="12" rx="2" stroke="rgba(163,230,53,0.5)" stroke-width="1.2"/>
                <path d="M5 10V4h3a2 2 0 0 1 0 4H5" stroke="rgba(163,230,53,0.7)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Validated parking at North Bank Garage (2 hrs with purchase)
            </div>
            <div class="iab-links">
              <a href="https://maps.google.com/?q=980+E+Starr+Ave,+Columbus,+OH+43201" target="_blank" rel="noopener noreferrer" class="iab-link">Get Directions →</a>
              <a href={`mailto:${SOCCERONE_CONTACT_EMAIL}`} class="iab-link">{SOCCERONE_CONTACT_EMAIL}</a>
            </div>
          </div>
        </div>

        <!-- Map placeholder for downtown -->
        <div class="info-map">
          <div class="map-placeholder">
            <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="map-svg">
              <rect width="400" height="300" fill="#080c18"/>
              <!-- Streets - downtown grid -->
              <line x1="0" y1="150" x2="400" y2="150" stroke="rgba(163,230,53,0.15)" stroke-width="4"/>
              <line x1="200" y1="0" x2="200" y2="300" stroke="rgba(163,230,53,0.15)" stroke-width="4"/>
              <line x1="0" y1="100" x2="400" y2="100" stroke="rgba(255,255,255,0.06)" stroke-width="2"/>
              <line x1="0" y1="200" x2="400" y2="200" stroke="rgba(255,255,255,0.06)" stroke-width="2"/>
              <line x1="100" y1="0" x2="100" y2="300" stroke="rgba(255,255,255,0.06)" stroke-width="2"/>
              <line x1="300" y1="0" x2="300" y2="300" stroke="rgba(255,255,255,0.06)" stroke-width="2"/>
              <!-- Dense downtown blocks -->
              <rect x="5" y="5" width="90" height="90" rx="2" fill="rgba(100,130,200,0.06)" stroke="rgba(100,130,200,0.12)" stroke-width="1"/>
              <rect x="105" y="5" width="90" height="90" rx="2" fill="rgba(100,130,200,0.05)" stroke="rgba(100,130,200,0.1)" stroke-width="1"/>
              <rect x="205" y="5" width="90" height="90" rx="2" fill="rgba(100,130,200,0.07)" stroke="rgba(100,130,200,0.12)" stroke-width="1"/>
              <rect x="305" y="5" width="90" height="90" rx="2" fill="rgba(100,130,200,0.05)" stroke="rgba(100,130,200,0.1)" stroke-width="1"/>
              <rect x="5" y="105" width="90" height="40" rx="2" fill="rgba(100,130,200,0.05)" stroke="rgba(100,130,200,0.1)" stroke-width="1"/>
              <rect x="305" y="105" width="90" height="40" rx="2" fill="rgba(100,130,200,0.06)" stroke="rgba(100,130,200,0.12)" stroke-width="1"/>
              <rect x="5" y="205" width="90" height="90" rx="2" fill="rgba(100,130,200,0.05)" stroke="rgba(100,130,200,0.1)" stroke-width="1"/>
              <rect x="105" y="205" width="90" height="90" rx="2" fill="rgba(100,130,200,0.06)" stroke="rgba(100,130,200,0.12)" stroke-width="1"/>
              <rect x="305" y="205" width="90" height="90" rx="2" fill="rgba(100,130,200,0.05)" stroke="rgba(100,130,200,0.1)" stroke-width="1"/>
              <!-- SoccerOne marker -->
              <rect x="155" y="115" width="90" height="55" rx="4" fill="#a3e635"/>
              <text x="200" y="142" text-anchor="middle" font-size="9" font-weight="bold" fill="#0a0a0d" font-family="monospace">SOCCERONE</text>
              <text x="200" y="158" text-anchor="middle" font-size="7" fill="#0a0a0d" font-family="monospace">DOWNTOWN</text>
              <!-- Location pin -->
              <circle cx="200" cy="108" r="8" fill="#a3e635"/>
              <circle cx="200" cy="108" r="3" fill="#0a0a0d"/>
              <!-- Street labels -->
              <text x="200" y="170" text-anchor="middle" font-size="7" fill="rgba(163,230,53,0.5)" font-family="monospace">E STARR AVE</text>
              <text x="15" y="148" font-size="6" fill="rgba(255,255,255,0.3)" font-family="monospace">DOWNTOWN CBus</text>
            </svg>
            <div class="map-overlay-label">
              <div class="mol-name">SoccerOne Downtown</div>
              <div class="mol-addr">980 E Starr Ave</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CTA STRIP
    ============================================================ -->
    <section class="facility-cta-strip" aria-label="Get started">
      <div class="fcs-inner">
        <div class="fcs-text">
          <h2 class="fcs-title">Book the Downtown field.</h2>
          <p class="fcs-sub">Available today. Walk here from anywhere downtown.</p>
        </div>
        <div class="fcs-buttons">
          <a href="/rent?facility=downtown" class="fcs-btn-primary">
            Book a Field Now
          </a>
          <a href="/pickup?facility=downtown" class="fcs-btn-secondary">
            See Pickup Games
          </a>
          <a href="/memberships" class="fcs-btn-ghost">
            Memberships
          </a>
        </div>
      </div>
    </section>

  </main>

  <SoccerOneFooter />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: var(--so-lime);
      --bg: var(--so-ink);
      --bg-2: var(--so-surface);
      --white: #ffffff;
      --muted: rgba(255,255,255,0.45);
      --border: rgba(255,255,255,0.08);
    }
    .mono { font-family: var(--so-font-mono); }

    .facility-main { flex: 1; font-family: var(--so-font-body); }

    /* ---- HERO ---- */
    .f-hero {
      position: relative;
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      overflow: hidden;
      background: #060812;
    }

    .f-hero-bg { position: absolute; inset: 0; z-index: 0; }

    .f-hero-bottom-stripe {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--so-lime) 0%, var(--so-lime-a30) 40%, transparent 80%);
    }

    .f-hero-content {
      position: relative;
      z-index: 10;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      padding: 2.5rem 2rem 4rem;
    }

    .f-breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin-bottom: 2.5rem;
      animation: fadeUp 0.8s ease-out 0.1s both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fbc-link { font-size: 0.8125rem; font-weight: 500; color: var(--so-lime-a60); text-decoration: none; transition: color 0.15s; }
    .fbc-link:hover { color: var(--so-lime); }
    .fbc-sep { color: rgba(255,255,255,0.2); font-size: 0.75rem; }
    .fbc-current { font-size: 0.8125rem; color: rgba(255,255,255,0.4); }

    .f-hero-block {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .f-hero-left { animation: fadeUp 0.8s ease-out 0.2s both; }
    .f-hero-right { animation: fadeUp 0.8s ease-out 0.4s both; }

    .f-hero-tag-row {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin-bottom: 0.75rem;
    }

    .f-tag {
      font-family: var(--so-font-mono);
      font-size: 0.5625rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      padding: 3px 8px;
      border-radius: 3px;
    }
    .f-tag--urban {
      background: rgba(100,160,255,0.1);
      color: #93c5fd;
      border: 1px solid rgba(100,160,255,0.2);
    }
    .f-tag--live {
      display: flex;
      align-items: center;
      gap: 5px;
      background: rgba(74,222,128,0.1);
      color: #86efac;
      border: 1px solid rgba(74,222,128,0.2);
    }
    .live-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #86efac;
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .f-hero-title {
      font-family: var(--so-font-display);
      font-size: clamp(3.5rem, 8vw, 7.5rem);
