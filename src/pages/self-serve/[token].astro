---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SelfServe from "@/components/self-serve/SelfServe";
import { buildSelfServeContext } from "@/lib/self-serve/build-context";

export const prerender = false;

const token = Astro.params.token;
if (!token) return Astro.redirect("/");

// When opened from a kiosk, ?kiosk=<location-slug> lets the completion
// screen offer a "Done" link back. Validated to a slug shape — the value
// is reflected into a /kiosk/ href.
const rawKiosk = Astro.url.searchParams.get("kiosk");
const kioskSlug =
  rawKiosk && /^[a-z0-9]+(?:-[a-z0-9]+)*$/i.test(rawKiosk) ? rawKiosk : null;

let context: any = null;
let error: string | null = null;

// Call the context builder directly instead of fetch()-ing our own
// `/api/self-serve/[token]` route — that self-HTTP round-trip re-ran the
// entire middleware chain for a request that never left this process. The
// API route still exists (and still returns this exact shape) for the
// PayCard's client-side polling.
try {
  const result = await buildSelfServeContext(token);
  if (result.status === 410 || result.status === 404) {
    error = "This link has expired or is invalid. Please ask the front desk for a new one.";
  } else if (!result.ok) {
    error = `Couldn't load this link (${result.status}).`;
  } else {
    context = result.body;
  }
} catch (err) {
  error = "Couldn't reach the server.";
}
---

<BaseLayout
  title="Finish your booking — Aspire Sports"
  navigation={false}
  footer={false}
>
  <main class="min-h-screen bg-cream flex items-start justify-center p-4 pt-8">
    <div class="w-full max-w-2xl">
      {error ? (
        <div class="p-6 rounded-xl border border-border bg-paper text-ink">
          <h1 class="font-semibold text-lg mb-2">Link unavailable</h1>
          <p class="text-sm">{error}</p>
        </div>
      ) : (
        <SelfServe
          client:load
          token={token}
          context={context}
          kioskSlug={kioskSlug}
          publishableKey={import.meta.env.STRIPE_PUBLISHABLE_KEY ?? ""}
        />
      )}
    </div>
  </main>
</BaseLayout>
