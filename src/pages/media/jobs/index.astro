---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { JobsList } from '../../../components/media/jobs-list';

// Middleware guarantees user is authenticated for /media routes.
const user = Astro.locals.user!;
---

<BaseLayout title="My Jobs — Aspire Media">
  <main id="main-content" class="mx-auto max-w-5xl p-6">
    <header class="mb-6 flex items-center justify-between">
      <h1 class="font-serif text-3xl">My jobs</h1>
      <a href="/media/history" class="text-sm underline">History</a>
    </header>
    <JobsList client:load />
  </main>
</BaseLayout>
