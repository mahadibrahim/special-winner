---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MediaLayout } from '@/components/media/media-layout';
import { JobsList } from '@/components/media/jobs-list';

export const prerender = false;

// Middleware guarantees user is authenticated for /media routes.
const user = Astro.locals.user!;
const roleNames = (Astro.locals.userRoles ?? []).map((r) => r.name);
---

<BaseLayout title="My Jobs — Aspire Media" navigation={false} footer={false}>
  <MediaLayout
    client:load
    currentPath="/media/jobs"
    roleNames={roleNames}
    user={{ firstName: user.firstName, lastName: user.lastName, email: user.email }}
  >
    <JobsList client:load />
  </MediaLayout>
</BaseLayout>
