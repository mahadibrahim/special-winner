---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { JobDetail } from '../../../components/media/job-detail';

// Middleware guarantees user is authenticated for /media routes.
const user = Astro.locals.user!;
const id = Astro.params.id as string;
---

<BaseLayout title="Shoot — Aspire Media">
  <main id="main-content" class="mx-auto max-w-3xl p-6">
    <JobDetail client:load sessionId={id} />
  </main>
</BaseLayout>
