---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MediaHistory } from '../../components/media/media-history';

// Middleware guarantees user is authenticated for /media routes.
const user = Astro.locals.user!;
---

<BaseLayout title="History — Aspire Media">
  <main id="main-content" class="mx-auto max-w-3xl p-6">
    <h1 class="font-serif text-3xl">History</h1>
    <MediaHistory client:load />
  </main>
</BaseLayout>
