---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { db } from "@/lib/db";
import { locations, programs, seasons, organizations } from "@/lib/db/schema";
import { eq, and } from "drizzle-orm";
import { breadcrumbJsonLd } from "@/lib/seo/breadcrumbs";
import { venueAddress } from "@/lib/seo/venue-address";
import { getVenueFacts } from "@/lib/locations/venue-facts";
import {
  summarizeOpenLeagues,
  summarizeUpcomingTerms,
} from "@/lib/locations/season-summary";
import { divisionSlugMap, divisionNaming } from "@/lib/leagues/division-slug";
import VenueMap from "@/components/locations/VenueMap.astro";
import StayInLoop from "@/components/locations/StayInLoop.astro";
import { ASPIRE_CANONICAL_ORIGIN } from "@/lib/seo/canonical";

// SSR — request-time queries against the catalog. Each location's open
// programs change as seasons open and close.

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/programs");
}

interface LocationRow {
  id: string;
  name: string;
  slug: string;
  city: string | null;
  state: string | null;
  addressLine1: string | null;
  addressLine2: string | null;
  postalCode: string | null;
}

let location: LocationRow | null = null;
let openSeasonCount = 0;

try {
  if (db) {
    const rows = await db
      .select({
        id: locations.id,
        name: locations.name,
        slug: locations.slug,
        city: locations.city,
        state: locations.state,
        addressLine1: locations.addressLine1,
        addressLine2: locations.addressLine2,
        postalCode: locations.postalCode,
      })
      .from(locations)
      .innerJoin(organizations, eq(organizations.id, locations.organizationId))
      .where(and(eq(locations.slug, slug), eq(organizations.status, "active")))
      .limit(1);
    location = rows[0] ?? null;

    if (location) {
      const counted = await db
        .select({ id: seasons.id })
        .from(seasons)
        .innerJoin(programs, eq(seasons.programId, programs.id))
        .where(
          and(
            eq(programs.locationId, location.id),
            eq(seasons.status, "open"),
            eq(seasons.isTest, false),
            eq(programs.isTest, false),
          ),
        );
      openSeasonCount = counted.length;
    }
  }
} catch (err) {
  console.error("[locations/[slug]] db error", err);
}

if (!location) {
  // Unknown/removed location slug → 404, NOT a 302 to /programs. A redirect
  // is a "temporary" signal that keeps dead URLs indexed; junk test-data
  // location pages ("loc-g00dqku7") lingered in Google because of this.
  return Astro.rewrite("/404");
}

const displayLocationName = location.name;
const cityState = [location.city, location.state].filter(Boolean).join(", ");

// Venue-first data plumbing — hand-written facility facts (Task 1) plus
// live season data scoped to this venue (Task 2 summarizer).
const facts = getVenueFacts(slug);

// Live seasons for this venue — same-origin fetch, the [term].astro pattern.
let venueSeasons: any[] = [];
try {
  const res = await fetch(
    `${Astro.url.origin}/api/public/seasons?location=${encodeURIComponent(slug)}`,
    { headers: { cookie: Astro.request.headers.get("cookie") ?? "" } },
  );
  if (res.ok) venueSeasons = (await res.json()).seasons ?? [];
} catch (err) {
  console.error("[locations/[slug]] seasons fetch failed", err);
}
const leagueSummary = summarizeOpenLeagues(venueSeasons);
// Omitting ?status= now returns open/active/forming (see api/public/seasons.ts),
// so this must stay scoped to status "open" — otherwise "X open now" would
// count active (already-started) or forming (not-yet-open) seasons too.
const youthOpenCount = venueSeasons.filter(
  (s) => s.status === "open" && (s.ageGroup?.maxAge ?? 99) < 18,
).length;

// "Later": forming future terms beyond the one the main card shows.
const upcomingTerms = summarizeUpcomingTerms(
  venueSeasons,
  leagueSummary?.termSlug ?? null,
);

// Live pickup: next upcoming session at this venue. Wired, not curated —
// the card must never claim a cadence the schedule doesn't back up.
let nextPickup: { label: string; upcomingCount: number } | null = null;
if (facts?.offerings.pickup) {
  try {
    const res = await fetch(
      `${Astro.url.origin}/api/dropin/sessions?location=${encodeURIComponent(slug)}`,
      { headers: { cookie: Astro.request.headers.get("cookie") ?? "" } },
    );
    if (res.ok) {
      const sessions: Array<{ startsAt: string }> =
        (await res.json()).sessions ?? [];
      const now = Date.now();
      const upcoming = sessions
        .filter((s) => new Date(s.startsAt).getTime() > now)
        .sort((a, b) => a.startsAt.localeCompare(b.startsAt));
      if (upcoming.length > 0) {
        const label = new Date(upcoming[0].startsAt).toLocaleString("en-US", {
          weekday: "short",
          hour: "numeric",
          minute: "2-digit",
          timeZone: "America/New_York",
        });
        nextPickup = { label, upcomingCount: upcoming.length };
      }
    }
  } catch (err) {
    console.error("[locations/[slug]] dropin sessions fetch failed", err);
  }
}

const fullAddress = [location.addressLine1, location.addressLine2, cityState, location.postalCode]
  .filter(Boolean)
  .join(", ");
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${location.name} ${fullAddress}`,
)}`;
const fmtCloses = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : null;

// JSON-LD: SportsActivityLocation with parent org pointer. Address and geo
// resolve through VENUE_ADDRESSES first (GBP-sourced, complete) and fall back
// to the nullable DB columns for venues not listed there — the same precedence
// venue-address.ts documents. `geo` is emitted only when verified coordinates
// exist; it materially helps local/map surfacing, so omitting it for the two
// known venues was leaving real signal on the table.
const venueNap = venueAddress(slug);
const venueSchema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: displayLocationName,
  url: `https://aspiresportsohio.com/locations/${slug}`,
  sport: "Soccer",
  address: venueNap?.address ?? {
    "@type": "PostalAddress",
    streetAddress: location.addressLine1 || undefined,
    addressLocality: location.city || "Columbus",
    addressRegion: location.state || "OH",
    postalCode: location.postalCode || undefined,
    addressCountry: "US",
  },
  ...(venueNap ? { geo: venueNap.geo } : {}),
  parentOrganization: {
    "@type": "SportsOrganization",
    name: "Aspire Sports",
    url: "https://aspiresportsohio.com",
  },
};

const ORIGIN = ASPIRE_CANONICAL_ORIGIN;
const breadcrumbSchema = breadcrumbJsonLd([
  { name: "Home", url: `${ORIGIN}/` },
  { name: "Locations", url: `${ORIGIN}/locations` },
  { name: displayLocationName, url: `${ORIGIN}/locations/${slug}` },
]);

// ---- Venue-led adult-league SEO section ------------------------------------
// City-generic search intent, venue-angled ("adult soccer league worthington").
// Division links are term-scoped (never open+forming aggregates) and reuse the
// same slug builder as the division pages, so URLs can't drift.
const adultSoccerRows = venueSeasons.filter(
  (s) =>
    s.sport?.slug === "soccer" &&
    (s.ageGroup == null || (s.ageGroup.minAge ?? 18) >= 18) &&
    leagueSummary?.termSlug != null &&
    s.termSlug === leagueSummary.termSlug,
);
const venueDivisionLinks = [...divisionSlugMap(adultSoccerRows).entries()].map(([dSlug, s]) => ({
  href: `/adult/leagues/soccer/${s.termSlug}/${dSlug}`,
  ...divisionNaming(s, "Soccer", s.termLabel ?? ""),
  day: s.dayOfWeek as string | null,
}));
const DAY_LONG: Record<string, string> = {
  mon: "Monday", tue: "Tuesday", wed: "Wednesday", thu: "Thursday",
  fri: "Friday", sat: "Saturday", sun: "Sunday",
};
const nightGroups = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
  .filter((d) => venueDivisionLinks.some((l) => l.day === d))
  .map((d) => ({ label: `${DAY_LONG[d]}s`, items: venueDivisionLinks.filter((l) => l.day === d) }));

const ageRows = adultSoccerRows.filter((s) => s.minAge != null && s.minAge >= 30);
const ageDays = [...new Set(ageRows.map((s) => (s.dayOfWeek ? DAY_LONG[s.dayOfWeek] : null)).filter(Boolean))];

// FAQ — the four questions people actually type (live search-terms report)
// plus the venue Q&A this page already answered; one FAQPage schema over all.
const priceAnswer =
  leagueSummary?.soloPrice != null && leagueSummary?.teamPrice != null
    ? `At ${displayLocationName}, solo players pay $${leagueSummary.soloPrice.toLocaleString()} for the season — no deposit. Team registration is $${leagueSummary.teamPrice.toLocaleString()} total, and a deposit holds a team's spot with the balance due before game 1. Exact per-division pricing is on each season page.`
    : "Each season page lists solo and team pricing before you register — nothing is hidden behind a signup form.";
const goodToKnow = [
  {
    q: "What ages do you serve?",
    a: facts?.offerings.youth
      ? "Youth programs from U6 through U18, plus adult leagues 18 and up."
      : "Adult programming — 18 and up.",
  },
  {
    q: "Can I come alone?",
    a: "Yes — register solo and we place you on a team, or drop into pickup where offered.",
  },
  { q: "Do you run year-round?", a: "Yes — fully indoor. No weather cancellations, no seasonal gaps." },
  {
    q: "Where can adults play soccer near Columbus?",
    a: `Adult indoor soccer leagues run here at ${displayLocationName}${fullAddress ? ` (${fullAddress})` : ""} and at our ${slug === "worthington" ? "Downtown / OSU venue in Milo-Grogan" : "Worthington venue off I-270"}. Games are in evening slots between 6 and 11 pm, and every league is 7 games in 7 weeks with two 24-minute halves.`,
  },
  {
    q: "Can I join a soccer team as an individual?",
    a: "Yes — that's the Sign Up Solo path. Register as an individual and we place you on a balanced team by skill level and schedule. No team required.",
  },
  { q: "What does an adult soccer league cost?", a: priceAnswer },
  {
    q: "Are there over-30 leagues?",
    a: ageRows.length
      ? `Yes — this season ${displayLocationName} has ${ageRows.length} age-qualified division${ageRows.length === 1 ? "" : "s"} (30+ and 40+ where marked)${ageDays.length ? ` playing ${ageDays.join(" and ")}` : ""}.`
      : "Age-qualified 30+ divisions run in most seasons — check the current season page for what's scheduled right now.",
  },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: goodToKnow.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={`Soccer at ${displayLocationName} — Aspire Sports, Columbus`}
  description={`Aspire Sports youth and adult soccer programs at ${displayLocationName}${cityState ? ` (${cityState})` : ""}. ${openSeasonCount > 0 ? `${openSeasonCount} program${openSeasonCount === 1 ? "" : "s"} open for registration.` : "Year-round indoor leagues and programs."}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(venueSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main id="main-content">
    {/* 1 · Hero — photo background + ink wash, like the [term].astro hero pattern */}
    <section
      class="relative text-cream pt-24 pb-10 px-6 bg-cover bg-center"
      style={`background-image:linear-gradient(180deg,oklch(0.2 0.03 100/0.72),oklch(0.2 0.03 100/0.9)),url('${facts?.heroPoster ?? "/media/soccerone/still-action.jpg"}')`}
    >
      <div class="max-w-[1080px] mx-auto">
        <p class="font-mono text-[11px] tracking-widest uppercase opacity-80">Aspire Sports · {cityState}</p>
        <h1 class="font-display text-5xl md:text-6xl mt-2 mb-2">
          Aspire in <em class="text-primary-orange-bright font-display italic">{displayLocationName}.</em>
        </h1>
        {facts && <p class="max-w-xl text-cream/90">{facts.tagline}</p>}
        <div class="flex flex-wrap gap-3 mt-5">
          {leagueSummary && (
            <a
              href={leagueSummary.termHref}
              class="font-sans font-semibold text-[13px] bg-primary text-cream px-5 py-3 rounded-md"
              data-testid="loc-hero-adult"
            >
              Adult leagues →
            </a>
          )}
          {facts?.offerings.youth && (
            <a href="/youth" class="font-sans font-semibold text-[13px] border border-cream/40 text-cream px-5 py-3 rounded-md">
              Youth programs
            </a>
          )}
          {facts?.offerings.pickup && (
            <a href="/adult/pickup" class="font-sans font-semibold text-[13px] border border-cream/40 text-cream px-5 py-3 rounded-md">
              Play pickup
            </a>
          )}
        </div>
      </div>
    </section>

    {/* facts ticker */}
    <div class="bg-ink text-cream/90 font-mono text-[11px] tracking-wider uppercase px-6 py-2.5">
      <div class="max-w-[1080px] mx-auto flex flex-wrap gap-x-8 gap-y-1">
        <span>{fullAddress}</span>
        {facts?.ticker.map((t) => <span>{t}</span>)}
      </div>
    </div>

    {/* 2 · What's happening — live cards; a card renders only when real */}
    <section class="py-16 px-6" aria-label="What's happening">
      <div class="max-w-[1080px] mx-auto">
        <h2 class="font-display text-3xl text-ink mb-1">What's happening</h2>
        <p class="text-ink-muted text-sm mb-8">Live from the season catalog.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-testid="whats-happening">
          {leagueSummary && (
            <a href={leagueSummary.termHref} class="block p-5 rounded-xl border border-border bg-paper hover:border-primary/40">
              <p class="font-mono text-[10px] tracking-widest uppercase text-primary font-bold">
                {leagueSummary.hasOpen
                  ? `Open now${fmtCloses(leagueSummary.closes) ? ` · closes ${fmtCloses(leagueSummary.closes)}` : ""}`
                  : "Forming — join the interest list"}
              </p>
              <h3 class="font-display text-xl text-ink mt-1">Adult leagues</h3>
              <p class="text-sm text-ink-2 mt-1">
                {leagueSummary.divisionCount} divisions · {leagueSummary.nights.join(" & ")} nights
                {leagueSummary.soloPrice != null ? ` · from $${leagueSummary.soloPrice}/player` : ""}
              </p>
              <span class="text-sm font-semibold text-primary mt-2 inline-block">
                {leagueSummary.hasOpen ? "See divisions & register →" : "Get notified →"}
              </span>
            </a>
          )}
          {facts?.offerings.youth && (
            <a href="/youth" class="block p-5 rounded-xl border border-border bg-paper hover:border-primary/40">
              <p class="font-mono text-[10px] tracking-widest uppercase text-ink-muted font-bold">Weekly · U6–U18</p>
              <h3 class="font-display text-xl text-ink mt-1">Youth programs</h3>
              <p class="text-sm text-ink-2 mt-1">
                Age-banded sessions, same coaches week over week.{youthOpenCount ? ` ${youthOpenCount} open now.` : ""}
              </p>
              <span class="text-sm font-semibold text-primary mt-2 inline-block">Browse youth programs →</span>
            </a>
          )}
          {facts?.offerings.pickup && (
            <a href="/adult/pickup" class="block p-5 rounded-xl border border-border bg-paper hover:border-primary/40">
              <p class="font-mono text-[10px] tracking-widest uppercase text-ink-muted font-bold">
                {nextPickup ? `Next session · ${nextPickup.label}` : "Show up & play"}
              </p>
              <h3 class="font-display text-xl text-ink mt-1">Drop-in pickup</h3>
              <p class="text-sm text-ink-2 mt-1">
                {nextPickup
                  ? `${nextPickup.upcomingCount} upcoming session${nextPickup.upcomingCount === 1 ? "" : "s"} — balanced teams, pay per session.`
                  : "Balanced teams, pay per session. Sessions post weekly — see the schedule."}
              </p>
              <span class="text-sm font-semibold text-primary mt-2 inline-block">
                {nextPickup ? "Grab a spot →" : "See the schedule →"}
              </span>
            </a>
          )}
        </div>

        {/* "Later" — forming future terms, wired from the same catalog. */}
        {upcomingTerms.length > 0 && (
          <div class="mt-10" data-testid="coming-up">
            <h3 class="font-mono text-[11px] tracking-widest uppercase text-ink-muted mb-3">Coming up</h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {upcomingTerms.map((t) => (
                <a href={t.termHref} class="flex items-baseline justify-between gap-3 p-4 rounded-xl border border-dashed border-border bg-paper hover:border-primary/40">
                  <span>
                    <span class="font-display text-lg text-ink">{t.termLabel}</span>
                    <span class="block text-xs text-ink-muted mt-0.5">
                      {t.count} division{t.count === 1 ? "" : "s"}
                      {fmtCloses(t.startDate) ? ` · starts ${fmtCloses(t.startDate)}` : ""}
                    </span>
                  </span>
                  <span class="text-xs font-semibold text-primary whitespace-nowrap">Get notified →</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    {/* 3 · The facility — spec tiles + features + coming-soon chip */}
    {facts && (
      <section class="bg-cream-2 border-y border-ink/10 py-16 px-6" aria-label="The facility">
        <div class="max-w-[1080px] mx-auto">
          <h2 class="font-display text-3xl text-ink mb-8">The facility</h2>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" data-testid="facility-specs">
            {facts.specs.map((sp) => (
              <div class="p-5 rounded-xl border border-border bg-paper">
                <div class="font-display text-3xl text-ink">{sp.n}</div>
                <div class="font-mono text-[10px] tracking-widest uppercase text-ink-muted mt-1">{sp.label}</div>
              </div>
            ))}
          </div>
          <ul class="mt-8 grid sm:grid-cols-2 gap-x-10 gap-y-3">
            {facts.features.map((f) => (
              <li class="text-ink-2 text-sm flex gap-2">
                <span class="text-primary">→</span>{f}
              </li>
            ))}
          </ul>
          {facts.comingSoon.length > 0 && (
            <p class="mt-6 inline-block font-mono text-[11px] tracking-wider uppercase bg-primary/10 text-primary px-3 py-1.5 rounded-full">
              Coming soon: {facts.comingSoon.join(" · ")}
            </p>
          )}
        </div>
      </section>
    )}

    {/* 4 · Inside the building */}
    {facts && facts.photos.length > 0 && (
      <section class="py-14 px-6" aria-label="Inside the building">
        <div class="max-w-[1080px] mx-auto grid grid-cols-1 sm:grid-cols-[2fr_1fr_1fr] gap-3">
          {facts.photos.map((p) => (
            <img src={p.src} alt={p.alt} loading="lazy" class="rounded-xl object-cover w-full h-44" />
          ))}
        </div>
      </section>
    )}

    {/* 5 · Season pricing band — only while a term is open (not forming) */}
    {leagueSummary && leagueSummary.hasOpen && (
      <section class="bg-ink text-cream py-16 px-6" aria-label="Season pricing">
        <div class="max-w-[1080px] mx-auto lg:grid lg:grid-cols-[1.2fr_1fr] gap-10 items-center">
          <div>
            <h2 class="font-display text-4xl mb-3">Leagues are open at {displayLocationName}.</h2>
            <p class="text-cream/80 max-w-md">
              {leagueSummary.divisionCount} divisions · {leagueSummary.nights.join(" & ")} nights
              {fmtCloses(leagueSummary.closes) ? ` · registration closes ${fmtCloses(leagueSummary.closes)}` : ""}.
            </p>
          </div>
          <div class="mt-8 lg:mt-0 rounded-2xl bg-cream/5 border border-cream/15 p-6">
            {leagueSummary.soloPrice != null && (
              <div class="flex justify-between py-2 border-b border-cream/15">
                <span>Solo / free agent</span><b>${leagueSummary.soloPrice}</b>
              </div>
            )}
            {leagueSummary.teamPrice != null && (
              <div class="flex justify-between py-2 border-b border-cream/15">
                <span>Per team</span><b>${leagueSummary.teamPrice.toLocaleString()}</b>
              </div>
            )}
            <a href={leagueSummary.termHref} class="mt-5 block text-center font-sans font-semibold text-[13px] bg-primary text-cream px-5 py-3 rounded-md">
              Register →
            </a>
          </div>
        </div>
      </section>
    )}

    {/* 5b · Adult leagues by night — venue-led city-search section. Renders
        only when the featured term actually has adult soccer divisions here;
        every link lands on that division's own indexable guide page. */}
    {nightGroups.length > 0 && (
      <section class="py-16 px-6" aria-label="Adult soccer leagues by night">
        <div class="max-w-[1080px] mx-auto">
          <h2 class="font-display text-3xl text-ink mb-1">
            Adult soccer leagues in {location.city ?? displayLocationName}, Ohio
          </h2>
          <p class="text-ink-muted text-sm mb-8">
            Skill-matched divisions at {displayLocationName} — pick a night, see prices and dates, register solo or bring a team.
          </p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6">
            {nightGroups.map((g) => (
              <div>
                <h3 class="font-mono text-[11px] tracking-widest uppercase text-ink-muted mb-2">{g.label}</h3>
                <ul class="space-y-1.5 text-[14.5px]">
                  {g.items.map((l) => (
                    <li>
                      <a href={l.href} class="text-ink-2 hover:text-primary">{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="text-[13px] text-ink-muted mt-8">
            Full Columbus league guide — both venues, all divisions:{" "}
            <a href="https://aspiresportsohio.com/adult-soccer-leagues-columbus" class="underline hover:text-primary">
              aspiresportsohio.com/adult-soccer-leagues-columbus
            </a>
          </p>
        </div>
      </section>
    )}

    {/* 6 · Good to know — venue Q&A + the city-search questions people
        actually type; FAQPage JSON-LD in the head mirrors this list. */}
    <section class="py-16 px-6" aria-label="Good to know">
      <div class="max-w-[1080px] mx-auto">
        <h2 class="font-display text-3xl text-ink mb-8">Good to know</h2>
        <div class="grid sm:grid-cols-2 gap-x-12 gap-y-7 max-w-3xl">
          {goodToKnow.map((item) => (
            <div>
              <h3 class="font-display italic text-lg text-ink mb-1.5">{item.q}</h3>
              <p class="text-sm text-ink-2">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 7 · Getting here */}
    <section class="bg-cream-2 border-y border-ink/10 py-16 px-6" aria-label="Getting here">
      <div class="max-w-[1080px] mx-auto grid lg:grid-cols-2 gap-10">
        <div class="space-y-5 text-sm text-ink-2">
          <div>
            <p class="font-mono text-[10px] tracking-widest uppercase text-ink-muted mb-1">Address</p>
            {fullAddress}
          </div>
          {facts && facts.directions.length > 0 && (
            <div>
              <p class="font-mono text-[10px] tracking-widest uppercase text-ink-muted mb-1">Directions</p>
              <ol class="list-decimal ml-4 space-y-1">
                {facts.directions.map((d) => <li>{d}</li>)}
              </ol>
            </div>
          )}
          <a
            href={mapsHref}
            target="_blank"
            rel="noopener"
            class="inline-block font-sans font-semibold text-[13px] border border-ink text-ink px-5 py-2.5 rounded-md hover:bg-ink hover:text-cream transition-colors"
            data-testid="maps-link"
          >
            Open in Google Maps →
          </a>
        </div>
        {slug === "worthington" || slug === "downtown" ? (
          <VenueMap slug={slug} />
        ) : (
          <img
            src={facts?.photos[0]?.src ?? "/media/soccerone/still-entrance.jpg"}
            alt={`${displayLocationName} facility`}
            loading="lazy"
            class="rounded-2xl object-cover w-full h-64 lg:h-auto"
          />
        )}
      </div>
    </section>

    {/* 8 · Bottom CTA band */}
    <section class="py-16 px-6 bg-ink text-cream text-center" aria-label="Get started">
      <h2 class="font-display text-4xl mb-6">Ready to play at {displayLocationName}?</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {leagueSummary && (
          <a href={leagueSummary.termHref} class="font-sans font-semibold text-[13px] bg-primary text-cream px-6 py-3 rounded-md">
            Register for leagues →
          </a>
        )}
        {facts?.offerings.youth && (
          <a href="/youth" class="font-sans font-semibold text-[13px] border border-cream/40 px-6 py-3 rounded-md">
            Youth programs
          </a>
        )}
        {facts?.offerings.pickup && (
          <a href="/adult/pickup" class="font-sans font-semibold text-[13px] border border-cream/40 px-6 py-3 rounded-md">
            Play pickup
          </a>
        )}
      </div>
    </section>

    {/* 9 · Stay in the loop — email now, WhatsApp when the group goes live */}
    <StayInLoop locationSlug={slug} />
  </main>
</BaseLayout>
