---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { db } from "@/lib/db";
import { locations, programs, seasons, organizations } from "@/lib/db/schema";
import { eq, and } from "drizzle-orm";

// SSR — request-time queries against the catalog. Each location's open
// programs change as seasons open and close.

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/programs");
}

interface LocationRow {
  id: string;
  name: string;
  slug: string;
  description: string | null;
  city: string | null;
  state: string | null;
  addressLine1: string | null;
  addressLine2: string | null;
  postalCode: string | null;
}

let location: LocationRow | null = null;
let openSeasonCount = 0;

try {
  if (db) {
    const rows = await db
      .select({
        id: locations.id,
        name: locations.name,
        slug: locations.slug,
        description: locations.description,
        city: locations.city,
        state: locations.state,
        addressLine1: locations.addressLine1,
        addressLine2: locations.addressLine2,
        postalCode: locations.postalCode,
      })
      .from(locations)
      .innerJoin(organizations, eq(organizations.id, locations.organizationId))
      .where(and(eq(locations.slug, slug), eq(organizations.status, "active")))
      .limit(1);
    location = rows[0] ?? null;

    if (location) {
      const counted = await db
        .select({ id: seasons.id })
        .from(seasons)
        .innerJoin(programs, eq(seasons.programId, programs.id))
        .where(
          and(
            eq(programs.locationId, location.id),
            eq(seasons.status, "open"),
            eq(seasons.isTest, false),
            eq(programs.isTest, false),
          ),
        );
      openSeasonCount = counted.length;
    }
  }
} catch (err) {
  console.error("[locations/[slug]] db error", err);
}

if (!location) {
  // Unknown/removed location slug → 404, NOT a 302 to /programs. A redirect
  // is a "temporary" signal that keeps dead URLs indexed; junk test-data
  // location pages ("loc-g00dqku7") lingered in Google because of this.
  return Astro.rewrite("/404");
}

const displayLocationName = location.name;
const cityState = [location.city, location.state].filter(Boolean).join(", ");
const fullAddress = [
  location.addressLine1,
  location.addressLine2,
  cityState,
  location.postalCode,
]
  .filter(Boolean)
  .join(", ");

// Per-venue hand-written copy. Update slug keys when partner facility
// names finalize; falls back to a generic copy block for unknown slugs.
const LOCATION_COPY: Record<string, {
  audienceSummary: string;
  neighborhoods: string[];
  adultPitch: string;
  youthPitch: string;
  amenities: string[];
  faq: Array<{ q: string; a: string }>;
}> = {
  worthington: {
    audienceSummary: "Family-friendly. Suburban. Youth development by day, adult leagues on weeknights and weekends.",
    neighborhoods: [
      "Worthington",
      "Powell",
      "Dublin",
      "Linworth",
      "Westerville",
      "North Columbus suburbs",
    ],
    adultPitch: "Adult co-ed soccer at the Worthington facility, scheduled around real adult lives — after-work and weekend slots, never before 6 PM on weeknights. Free parking, indoor turf, post-game space.",
    youthPitch: "The Worthington venue is the youth-programming home. Age-banded sessions from U6 through U18 on a published weekly schedule. Same coaches week over week, same field, same time.",
    amenities: [
      "Indoor turf — year-round, no weather cancellations",
      "Free on-site parking",
      "Family-friendly viewing area",
      "Restrooms + locker rooms",
      "{{TBD — concession / cafe details when partnership confirms}}",
    ],
    faq: [
      {
        q: "Where exactly is the Worthington venue?",
        a: "Worthington, Ohio — north of downtown Columbus, off I-270. Specific address publishes once partnership terms finalize. Free on-site parking.",
      },
      {
        q: "Is there parking?",
        a: "Yes — free on-site parking. The venue is designed for family drop-off and afternoon-into-evening pickup.",
      },
      {
        q: "What ages does the Worthington facility serve?",
        a: "Youth programs from U6 through U18, plus adult co-ed leagues for ages 18 and up. Family-friendly hours across the week.",
      },
      {
        q: "Do you run year-round?",
        a: "Yes — fully indoor. No weather cancellations, no seasonal gaps between sessions.",
      },
    ],
  },
  downtown: {
    audienceSummary: "Urban core. Adult-focused. Designed for the 22–40 weeknight league crowd.",
    neighborhoods: [
      "Short North",
      "Italian Village",
      "German Village",
      "Clintonville",
      "Grandview",
      "Victorian Village",
      "OSU campus area",
    ],
    adultPitch: "Aspire's flagship adult venue — co-ed 7v7 indoor soccer on weeknight evenings, walk-in pickup games, and a post-game scene that's a short walk from the field. Built for the after-work league night that actually feels like a night out.",
    youthPitch: "Selective youth programming at the downtown venue when scheduling permits — primarily clinics and camps for families already in the core. The Worthington facility is our family-programming home.",
    amenities: [
      "Indoor turf, year-round operation",
      "Walking distance to post-game bars + restaurants",
      "Locker rooms + showers",
      "{{TBD — specific transit / parking details when partner facility confirms}}",
    ],
    faq: [
      {
        q: "Where is the Downtown venue?",
        a: "Central Columbus, near the OSU campus. Walkable from Short North, Italian Village, and Victorian Village. Specific address publishes once partnership terms finalize.",
      },
      {
        q: "Is this the adult-league venue?",
        a: "Yes — this is the home of Aspire's adult co-ed soccer leagues. Selective youth clinics also run here when scheduling permits, but the family programming lives in Worthington.",
      },
      {
        q: "What about parking and transit?",
        a: "Parking and transit guidance for the downtown venue will publish once the partner facility agreement finalizes. Most adult-league players arrive by car, bike, or rideshare; the venue is in the urban core for walkability after the game.",
      },
      {
        q: "Can I drop in for pickup soccer?",
        a: "Yes — drop-in pickup is part of the downtown offer. Walk-in registration runs through the kiosk at the front desk; sign the waiver on your phone, pay for the session, and you're on the field.",
      },
    ],
  },
};

const copy = LOCATION_COPY[slug] ?? {
  audienceSummary: "Aspire Sports programs for kids and adults.",
  neighborhoods: [] as string[],
  adultPitch: `Aspire adult programs at ${displayLocationName}.`,
  youthPitch: `Aspire youth programs at ${displayLocationName}.`,
  amenities: [
    "{{TBD — amenities for this venue}}",
  ],
  faq: [] as Array<{ q: string; a: string }>,
};

// JSON-LD: SportsActivityLocation with parent org pointer. We omit `geo`
// and `streetAddress` until the partnership terms publish the final
// address; locality + region are safe to ship now.
const venueSchema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: displayLocationName,
  url: `https://aspiresportsohio.com/locations/${slug}`,
  sport: "Soccer",
  address: {
    "@type": "PostalAddress",
    streetAddress: location.addressLine1 || undefined,
    addressLocality: location.city || "Columbus",
    addressRegion: location.state || "OH",
    postalCode: location.postalCode || undefined,
    addressCountry: "US",
  },
  parentOrganization: {
    "@type": "SportsOrganization",
    name: "Aspire Sports",
    url: "https://aspiresportsohio.com",
  },
};

const faqSchema = copy.faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: copy.faq.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    }
  : null;
---

<BaseLayout
  title={`Soccer at ${displayLocationName} — Aspire Sports, Columbus`}
  description={`Aspire Sports youth and adult soccer programs at ${displayLocationName}${cityState ? ` (${cityState})` : ""}. ${openSeasonCount > 0 ? `${openSeasonCount} program${openSeasonCount === 1 ? "" : "s"} open for registration.` : "Year-round indoor, captain-first operations."}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(venueSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <main id="main-content" class="bg-cream">
    {/* Hero */}
    <section class="relative pt-24 pb-12 lg:pt-32 lg:pb-16">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        <div class="flex items-center justify-between py-6 border-b border-ink/15 mb-12">
          <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted">
            Aspire Sports {cityState && `· ${cityState}`}
          </span>
          <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted hidden sm:inline">
            {displayLocationName}
          </span>
        </div>

        <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-primary-orange mb-6 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-primary-orange"></span>
          {openSeasonCount > 0 ? `${openSeasonCount} program${openSeasonCount === 1 ? "" : "s"} open` : "Aspire Venue"}
        </p>

        <h1
          class="font-display text-ink leading-tight mb-8"
          style="font-size: clamp(2.5rem, 7vw, 5.5rem); letter-spacing: -0.03em;"
        >
          Aspire in <span class="italic text-primary-orange">{displayLocationName}.</span>
        </h1>

        <p class="text-lg sm:text-xl text-ink-2 max-w-2xl leading-relaxed mb-10">
          {location.description ?? copy.audienceSummary}
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#adult"
            class="inline-flex items-center gap-3 bg-ink text-cream px-7 py-4 text-sm font-medium tracking-wide uppercase hover:bg-primary-orange transition-colors"
            style="letter-spacing: 0.08em;"
          >
            Adult leagues here →
          </a>
          <a
            href="#youth"
            class="inline-flex items-center gap-3 border border-ink text-ink px-7 py-4 text-sm font-medium tracking-wide uppercase hover:border-primary-orange hover:text-primary-orange transition-colors"
            style="letter-spacing: 0.08em;"
          >
            Youth programs here →
          </a>
        </div>
      </div>
    </section>

    {/* Venue facts */}
    <section class="bg-cream-2 border-y border-ink/10">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted mb-2">
              Address
            </p>
            <p class="text-ink leading-snug">
              {fullAddress || `${cityState || "Columbus, OH"} — full address publishing soon.`}
            </p>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted mb-2">
              Open programs
            </p>
            <p class="text-ink leading-snug">
              {openSeasonCount > 0
                ? `${openSeasonCount} season${openSeasonCount === 1 ? "" : "s"} accepting registrations`
                : "Catalog updates regularly — check back soon"}
            </p>
          </div>
          <div>
            <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted mb-2">
              Audiences
            </p>
            <p class="text-ink leading-snug">Kids · Adults 18+</p>
          </div>
        </div>
      </div>
    </section>

    {/* Adult section */}
    <section id="adult" class="py-20 lg:py-28">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        <div class="grid grid-cols-12 gap-8 lg:gap-16">
          <div class="col-span-12 lg:col-span-7">
            <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-primary-orange mb-4">
              Adult
            </p>
            <h2 class="font-display text-3xl lg:text-5xl text-ink leading-tight mb-6">
              Adult leagues at {displayLocationName}.
            </h2>
            <p class="text-lg text-ink-2 leading-relaxed mb-6 max-w-prose">
              {copy.adultPitch}
            </p>
            <a
              href={`/programs?location=${slug}&audience=adult`}
              class="inline-flex items-center gap-3 bg-ink text-cream px-7 py-4 text-sm font-medium tracking-wide uppercase hover:bg-primary-orange transition-colors"
              style="letter-spacing: 0.08em;"
            >
              See open adult programs →
            </a>
          </div>
          <aside class="col-span-12 lg:col-span-5 lg:pl-8 lg:border-l lg:border-ink/15">
            <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted mb-4">
              Neighborhoods served
            </p>
            {copy.neighborhoods.length > 0 ? (
              <ul class="flex flex-wrap gap-2 mb-6">
                {copy.neighborhoods.map((n) => (
                  <li class="text-sm text-ink-2 bg-cream-2 border border-ink/15 px-3 py-1 rounded-full">
                    {n}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-ink-muted italic mb-6">
                {`{{TBD — neighborhoods served}}`}
              </p>
            )}
            <p class="text-sm text-ink-muted leading-relaxed">
              We're a neighborhood-anchored operator — the captains and players here are from the
              surrounding zip codes, and the schedule is built around their week.
            </p>
          </aside>
        </div>
      </div>
    </section>

    {/* Youth section */}
    <section id="youth" class="bg-cream-2 border-y border-ink/10 py-20 lg:py-28">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        <div class="grid grid-cols-12 gap-8 lg:gap-16">
          <div class="col-span-12 lg:col-span-7">
            <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-primary-orange mb-4">
              Youth
            </p>
            <h2 class="font-display text-3xl lg:text-5xl text-ink leading-tight mb-6">
              Youth programs at {displayLocationName}.
            </h2>
            <p class="text-lg text-ink-2 leading-relaxed mb-6 max-w-prose">
              {copy.youthPitch}
            </p>
            <a
              href={`/programs?location=${slug}&audience=youth`}
              class="inline-flex items-center gap-3 bg-ink text-cream px-7 py-4 text-sm font-medium tracking-wide uppercase hover:bg-primary-orange transition-colors"
              style="letter-spacing: 0.08em;"
            >
              See open youth programs →
            </a>
          </div>
          <aside class="col-span-12 lg:col-span-5 lg:pl-8 lg:border-l lg:border-ink/15">
            <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted mb-4">
              At this venue
            </p>
            <ul class="space-y-3 text-base text-ink-2 leading-relaxed">
              {copy.amenities.map((a) => (
                <li class="flex gap-3">
                  <span class="text-primary-orange font-display italic shrink-0">→</span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {/* What you get */}
    <section class="py-20 lg:py-28">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        <h2 class="font-display text-3xl lg:text-4xl text-ink mb-10 max-w-2xl leading-tight">
          What you get at {displayLocationName}.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
          <div>
            <h3 class="font-display text-lg italic text-ink mb-3">Local team</h3>
            <p class="text-ink-muted leading-relaxed">
              Coaches and refs who live in or near {displayLocationName}, who know the captains
              and families, and who keep the same faces on the field across the season.
            </p>
          </div>
          <div>
            <h3 class="font-display text-lg italic text-ink mb-3">Reliable schedules</h3>
            <p class="text-ink-muted leading-relaxed">
              Same time, same field, every week. Schedules publish before you pay — and once
              they're up, they don't move.
            </p>
          </div>
          <div>
            <h3 class="font-display text-lg italic text-ink mb-3">One Aspire account</h3>
            <p class="text-ink-muted leading-relaxed">
              Your registrations, your kid's history, your adult-league rosters — all on one
              account. Sign up once; we remember you.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* FAQ */}
    {copy.faq.length > 0 && (
      <section class="bg-cream-2 border-y border-ink/10 py-20 lg:py-28">
        <div class="max-w-[1100px] mx-auto px-6 sm:px-10 lg:px-16">
          <h2 class="font-display text-3xl lg:text-4xl text-ink mb-10">
            About {displayLocationName}
          </h2>
          <dl class="space-y-8">
            {copy.faq.map((item) => (
              <div>
                <dt class="font-display text-lg italic text-ink mb-2">{item.q}</dt>
                <dd class="text-ink-muted leading-relaxed">{item.a}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {/* CTA */}
    <section class="py-20 lg:py-24 bg-ink text-cream">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 text-center">
        <h2 class="font-display text-3xl lg:text-5xl mb-6">
          See what's open at {displayLocationName}.
        </h2>
        <a
          href={`/programs?location=${slug}`}
          class="inline-flex items-center gap-3 bg-cream text-ink px-8 py-4 text-sm font-medium tracking-wide uppercase hover:bg-primary-orange hover:text-cream transition-colors"
          style="letter-spacing: 0.08em;"
        >
          Browse {displayLocationName} programs →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
