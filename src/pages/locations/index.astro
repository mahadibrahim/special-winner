---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublicLocations } from "@/lib/programs/public-filters";
import { setMarketingEdgeCache } from "@/lib/http/edge-cache";
import { getVenueFacts } from "@/lib/locations/venue-facts";
import { summarizeOpenLeagues } from "@/lib/locations/season-summary";
import StayInLoop from "@/components/locations/StayInLoop.astro";
import { breadcrumbJsonLd } from "@/lib/seo/breadcrumbs";
import { ASPIRE_CANONICAL_ORIGIN } from "@/lib/seo/canonical";

const ORIGIN = ASPIRE_CANONICAL_ORIGIN;
const breadcrumbSchema = breadcrumbJsonLd([
  { name: "Aspire Sports", url: `${ORIGIN}/` },
  { name: "Locations", url: `${ORIGIN}/locations` },
]);

const orgId = Astro.locals.organization?.id ?? null;
const locations = orgId ? await getPublicLocations(orgId) : [];

const enriched = await Promise.all(
  locations.map(async (loc) => {
    let seasons: any[] = [];
    try {
      const res = await fetch(
        `${Astro.url.origin}/api/public/seasons?location=${encodeURIComponent(loc.slug)}`,
        { headers: { cookie: Astro.request.headers.get("cookie") ?? "" } },
      );
      if (res.ok) seasons = (await res.json()).seasons ?? [];
    } catch { /* card renders without live chip */ }
    const league = summarizeOpenLeagues(seasons);
    // Omitting ?status= now returns open/active/forming, so the raw array
    // length is no longer a safe proxy for "open" — count seasons actually
    // in status "open" directly. Do NOT borrow league.divisionCount: that
    // includes forming divisions (which aren't open) and, at a mixed venue,
    // would drop open non-league (youth) seasons from the chip's count.
    const openCount = seasons.filter((s) => s.status === "open").length;
    return {
      ...loc,
      facts: getVenueFacts(loc.slug),
      openCount,
      league,
    };
  }),
);

setMarketingEdgeCache(Astro);
---

<BaseLayout
  title="Locations — Indoor Soccer & Flag Football Venues in Columbus, Ohio | Aspire Sports"
  description="Aspire Sports venues in central Ohio: indoor turf in Worthington and Downtown / OSU. Addresses, parking, what's on at each venue, and the leagues running there now."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main id="main-content" class="flex-1 pt-28 pb-16">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-ink mb-3" style="font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -0.025em;">Where we play.</h1>
      <p class="text-lg text-ink-muted max-w-2xl mb-10">Indoor venues across central Ohio — year-round, rain or shine.</p>

      {
        locations.length === 0 ? (
          <p class="text-ink-muted">Locations are being finalized — check back soon.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {enriched.map((loc) => (
              <div class="rounded-2xl border border-border bg-paper overflow-hidden">
                <a href={`/locations/${loc.slug}`}>
                  <img src={loc.facts?.photos[0]?.src ?? "/media/soccerone/still-action.jpg"} alt={`${loc.name} facility`} loading="lazy" class="w-full h-44 object-cover" />
                </a>
                <div class="p-6">
                  <a href={`/locations/${loc.slug}`} class="font-display text-2xl text-ink hover:text-primary">{loc.name}</a>
                  <p class="font-mono text-[10px] tracking-widest uppercase text-ink-muted mt-1">
                    {[loc.city, loc.state].filter(Boolean).join(", ")}
                  </p>
                  <div class="flex flex-wrap gap-2 mt-4">
                    {loc.openCount > 0 && <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-sage/15 text-sage">● {loc.openCount} programs open</span>}
                    {loc.facts?.specs.slice(0, 2).map((sp) => (
                      <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-cream-2 text-ink-2">{sp.n} {sp.label.split("·")[0].trim().toLowerCase()}</span>
                    ))}
                  </div>
                  <div class="flex flex-wrap gap-2.5 mt-5">
                    {loc.league ? (
                      <a href={loc.league.termHref} class="font-sans font-semibold text-xs bg-primary-bright text-primary-foreground px-4 py-2.5 rounded-md">Adult leagues →</a>
                    ) : loc.facts?.offerings.pickup ? (
                      <a href="/adult/pickup" class="font-sans font-semibold text-xs bg-primary-bright text-primary-foreground px-4 py-2.5 rounded-md">Play pickup →</a>
                    ) : null}
                    <a href={`/locations/${loc.slug}`} class="font-sans font-semibold text-xs border border-border text-ink px-4 py-2.5 rounded-md hover:border-primary/40">Venue page</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>

    <div class="mt-16">
      <StayInLoop />
    </div>
  </main>
</BaseLayout>
