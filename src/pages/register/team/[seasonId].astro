---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { db } from "@/lib/db";
import { seasons, programs, sports, locations } from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import CreateTeamForm from "@/components/create-team-form";

const { seasonId } = Astro.params;

if (!seasonId) {
  return Astro.redirect("/programs");
}

interface SeasonContext {
  id: string;
  name: string;
  price: number;
  programName: string;
  sportName: string;
  locationName: string;
}

let context: SeasonContext | null = null;

try {
  if (db) {
    const rows = await db
      .select({
        season: seasons,
        program: programs,
        sport: sports,
        location: locations,
      })
      .from(seasons)
      .innerJoin(programs, eq(seasons.programId, programs.id))
      .innerJoin(sports, eq(programs.sportId, sports.id))
      .innerJoin(locations, eq(programs.locationId, locations.id))
      .where(eq(seasons.id, seasonId))
      .limit(1);
    if (rows.length > 0) {
      const r = rows[0]!;
      context = {
        id: r.season.id,
        name: r.season.name,
        price: r.season.priceCents / 100,
        programName: r.program.name,
        sportName: r.sport.name,
        locationName: r.location.name,
      };
    }
  }
} catch (err) {
  console.error("[register/team/[seasonId]] db error", err);
}

if (!context) {
  return Astro.redirect("/programs");
}

const user = Astro.locals.user;
---

<BaseLayout
  title={`Create a team for ${context.name} — Aspire Sports`}
  description={`Register a team for ${context.name} at Aspire Sports. Captain creates the team, players join via the shared link.`}
>
  <main id="main-content" class="bg-cream">
    {/* Hero */}
    <section class="relative pt-24 pb-12 lg:pt-32 lg:pb-16">
      <div class="max-w-[1100px] mx-auto px-6 sm:px-10 lg:px-16">
        <div class="flex items-center justify-between py-6 border-b border-ink/15 mb-12">
          <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted">
            Aspire Sports · Team Registration
          </span>
          <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-ink-muted hidden sm:inline">
            {context.sportName}
          </span>
        </div>

        <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-primary-orange mb-6 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-primary-orange"></span>
          Captain registration
        </p>

        <h1
          class="font-display text-ink leading-tight mb-6"
          style="font-size: clamp(2.25rem, 6vw, 4.5rem); letter-spacing: -0.03em;"
        >
          Bring the <span class="italic text-primary-orange">whole squad.</span>
        </h1>

        <p class="text-lg sm:text-xl text-ink-2 max-w-2xl leading-relaxed mb-2">
          You're registering a team for <strong class="text-ink">{context.name}</strong>.
        </p>
        <p class="text-ink-muted leading-relaxed">
          {context.programName} · {context.locationName.replace(/^Soccer One\s+/i, "")} · ${context.price}/player
        </p>
      </div>
    </section>

    {/* How it works */}
    <section class="bg-cream-2 border-y border-ink/10">
      <div class="max-w-[1100px] mx-auto px-6 sm:px-10 lg:px-16 py-10">
        <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-primary-orange mb-4">
          How it works
        </p>
        <ol class="space-y-3 text-ink-2 leading-relaxed">
          <li><strong class="text-ink">①</strong> You name the team and submit your contact info below.</li>
          <li><strong class="text-ink">②</strong> We give you a shareable team link.</li>
          <li><strong class="text-ink">③</strong> Send the link to your players. Each one clicks it, registers, and pays their share.</li>
          <li><strong class="text-ink">④</strong> Sign up yourself as captain and join your team's roster.</li>
        </ol>
        <p class="text-sm text-ink-muted mt-4 italic">
          v1: each player pays their own portion at registration. Captain auto-charge for unpaid balances ships in a future update.
        </p>
      </div>
    </section>

    {/* Form */}
    <section class="py-16 lg:py-24">
      <div class="max-w-[700px] mx-auto px-6 sm:px-10 lg:px-16">
        <CreateTeamForm
          seasonId={context.id}
          seasonName={context.name}
          defaultCaptainName={user ? `${user.firstName ?? ""} ${user.lastName ?? ""}`.trim() : ""}
          defaultCaptainEmail={user?.email ?? ""}
          client:load
        />
      </div>
    </section>
  </main>
</BaseLayout>
