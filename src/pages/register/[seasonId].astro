---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import RegistrationWizard from '../../components/registration/registration-wizard';

const { seasonId } = Astro.params;

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect(`/signin?redirect=/register/${seasonId}`);
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Register - Aspire Sports</title>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4">
      <div class="container mx-auto">
        <RegistrationWizard seasonId={seasonId!} client:load />
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
