---
// NOT prerendered: org/catalog data is request-scoped via middleware so we
// can't freeze it at build time without leaking one tenant's catalog to all.
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import ProgramsDirectory from '../../components/programs-directory';
import { db } from '../../lib/db';
import { sports, locations } from '../../lib/db/schema';
import { eq, asc } from 'drizzle-orm';

// Fetch sports and locations
let sportsList: any[] = [];
let locationsList: any[] = [];

try {
  // Fetch sports
  const allSports = await db
    .select({
      id: sports.id,
      name: sports.name,
      slug: sports.slug,
      icon: sports.icon,
      color: sports.color,
    })
    .from(sports)
    .where(eq(sports.active, true))
    .orderBy(asc(sports.sortOrder), asc(sports.name));

  sportsList = allSports;

  // Fetch locations
  const allLocations = await db
    .select({
      id: locations.id,
      name: locations.name,
      slug: locations.slug,
      city: locations.city,
      state: locations.state,
    })
    .from(locations)
    .orderBy(asc(locations.name));

  locationsList = allLocations;
} catch (error) {
  console.error('Error fetching data:', error);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Programs — Aspire Sports</title>
    <meta name="description" content="Browse and register for sports programs including leagues, camps, clinics, and training." />
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main class="flex-1 pt-20">
      <!-- Hero Section -->
      <div class="bg-gradient-to-b from-primary/10 to-transparent py-16 px-4">
        <div class="max-w-7xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-ink mb-4">
            Our Programs
          </h1>
          <p class="text-xl text-ink-muted max-w-2xl mx-auto">
            Find the perfect program for your athlete. From youth leagues to advanced training, we have something for everyone.
          </p>
        </div>
      </div>

      <!-- Programs Directory -->
      <div class="max-w-7xl mx-auto px-4 pb-16">
        <ProgramsDirectory
          client:load
          sports={sportsList}
          locations={locationsList}
        />
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
