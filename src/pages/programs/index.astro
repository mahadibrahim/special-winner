---
// SSR — catalog data is request-scoped via middleware; can't prerender
// without leaking one tenant's catalog to all.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProgramsCatalog from '@/components/programs/programs-catalog';

// Audience preselect from query param: ?audience=youth | adult | team
const rawAudience = Astro.url.searchParams.get("audience");
const audience: "youth" | "adult" | "team" | null =
  rawAudience === "adult" ? "adult"
  : rawAudience === "team" ? "team"
  : rawAudience === "youth" ? "youth"
  : null;

// Program-type preselect from query param: ?type=league|camp|clinic|tournament|training
const rawType = Astro.url.searchParams.get("type");
const VALID_TYPES = ["league", "camp", "clinic", "tournament", "training"] as const;
const programType =
  rawType && (VALID_TYPES as readonly string[]).includes(rawType)
    ? (rawType as (typeof VALID_TYPES)[number])
    : null;

const canonicalUrl = audience
  ? `${Astro.url.origin}/programs?audience=${audience}`
  : `${Astro.url.origin}/programs`;

const pageTitle = audience === "adult"
  ? "Adult Programs — Aspire Sports"
  : audience === "team"
  ? "Team Registration — Aspire Sports"
  : audience === "youth"
  ? "Youth Programs — Aspire Sports"
  : "Programs — Aspire Sports";

const pageDescription = audience === "adult"
  ? "Browse adult sports leagues. Sign up solo, with friends, or as a full team — Aspire Sports in central Ohio."
  : audience === "team"
  ? "Register your team for an Aspire Sports league. Captain creates and invites; players each pay their share."
  : audience === "youth"
  ? "Browse Aspire Sports youth programs — leagues, camps, clinics for kids ages 4–18 in central Ohio."
  : "Sports programs for kids and adults in central Ohio. Aspire Sports — built on real frameworks, taught by coaches who played the game.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
  </Fragment>

  <main id="main-content" class="flex-1 pt-24 pb-16">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-10">
        <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-primary mb-3 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-primary"></span>
          Now enrolling · Summer 2026
        </p>
        <h1
          class="font-display text-ink mb-4"
          style="font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; letter-spacing: -0.025em;"
        >
          Find your program.
        </h1>
        <p class="text-lg text-ink-muted max-w-2xl">
          Pick your audience, narrow with the chips, browse what's curated, or scroll the full catalog at the bottom.
        </p>
      </header>

      <ProgramsCatalog client:load initialAudience={audience} initialType={programType} />
    </div>
  </main>
</BaseLayout>
