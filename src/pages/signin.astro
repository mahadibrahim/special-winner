---
// NOT prerendered: the "already logged in" check below needs request-time
// access to Astro.locals.user. With prerender=true the page was served as
// static HTML and the redirect never fired for authenticated visitors.
import '../styles/globals.css';
import Navigation from '../components/navigation';
import Footer from '../components/footer';
import { SignInForm } from '../components/auth/signin-form';
import PostHog from '../components/posthog.astro';

// Redirect if already logged in
const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/dashboard');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Sign In — Aspire Sports</title>
    <PostHog />
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main class="flex-1 flex items-center justify-center py-12 px-4 pt-24">
      <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-cream-2 border border-border rounded-2xl p-8">
          <!-- Header -->
          <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-ink mb-2">Welcome Back</h1>
            <p class="text-ink-muted">
              Sign in to manage registrations and view schedules
            </p>
          </div>

          <!-- Form -->
          <SignInForm client:load />

          <!-- Sign up link -->
          <div class="mt-6 text-center">
            <p class="text-ink-faint text-sm">
              Don't have an account?{' '}
              <a
                href={`/signup${Astro.url.search}`}
                class="text-primary hover:text-primary/80 font-medium"
              >
                Create one
              </a>
            </p>
          </div>
        </div>
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
