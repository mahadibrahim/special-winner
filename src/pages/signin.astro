---
// NOT prerendered: needs request-time Astro.locals.user so the middleware
// "already logged in" bounce to /dashboard fires correctly.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SignInForm } from '../components/auth/signin-form';

// Authenticated users are redirected to /dashboard by middleware — no check needed here.
---

<BaseLayout title="Sign In — Aspire Sports">
  <main id="main-content" class="flex-1 flex items-center justify-center py-12 px-4 pt-24">
    <div class="w-full max-w-md">
      <!-- Card -->
      <div class="bg-cream-2 border border-border rounded-2xl p-8">
        <!-- Header -->
        <div class="text-center mb-8">
          <h1 class="text-2xl font-bold text-ink mb-2">Sign in</h1>
          <p class="text-ink-muted">
            Enter your email and we'll send a one-tap sign-in link.
          </p>
        </div>

        <!-- Form -->
        <SignInForm client:load />

        <!-- Sign up link -->
        <div class="mt-6 text-center">
          <p class="text-ink-faint text-sm">
            Don't have an account?{' '}
            <a
              href={`/signup${Astro.url.search}`}
              class="text-primary hover:text-primary/80 font-medium"
            >
              Create one
            </a>
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
