---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Middleware guarantees auth on /dashboard routes — no prerender.

// /youth/classes is Aspire's youth funnel — SoccerOne hosts must not grow a
// link into it. `Astro.locals.brandId` is the host-derived brand key set by
// middleware for every request (see src/env.d.ts); family.astro gates its
// own "Weekly classes" Explore card the same way.
const isAspire = Astro.locals.brandId === "aspire";
---

<BaseLayout title="Get Started — Aspire Sports">
  <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
    <div class="max-w-3xl mx-auto">
      <header class="mb-10">
        <p class="text-[11px] font-semibold tracking-[0.15em] uppercase text-primary mb-3 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-primary"></span>
          Welcome
        </p>
        <h1 class="font-display text-ink mb-3" style="font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.1; letter-spacing: -0.02em;">
          What would you like to do?
        </h1>
        <p class="text-base text-ink-muted max-w-xl">
          Choose a path to get started. You can always come back and do both.
        </p>
      </header>

      <div class:list={["grid grid-cols-1 sm:grid-cols-2 gap-5", { "lg:grid-cols-3": isAspire }]}>
        <!-- Youth card -->
        <a
          href="/programs?audience=youth"
          class="block p-6 rounded-2xl bg-gradient-to-br from-primary/10 via-primary/5 to-transparent border border-primary/20 hover:border-primary/40 transition-all group"
        >
          <div class="w-10 h-10 rounded-xl bg-primary/15 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h2 class="font-semibold text-ink text-lg mb-2">Register a child for youth programs</h2>
          <p class="text-sm text-ink-faint mb-4">
            Leagues, camps, and clinics for kids. Browse by sport, age group, or program type.
          </p>
          <span class="text-xs font-medium text-primary inline-flex items-center gap-1 group-hover:gap-2 transition-all">
            Browse youth programs →
          </span>
        </a>

        <!-- Adult card -->
        <a
          href="/programs?audience=adult"
          class="block p-6 rounded-2xl bg-gradient-to-br from-navy/10 via-navy/5 to-transparent border border-navy/20 hover:border-navy/40 transition-all group"
        >
          <div class="w-10 h-10 rounded-xl bg-navy/15 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h2 class="font-semibold text-ink text-lg mb-2">Join an adult league or pickup</h2>
          <p class="text-sm text-ink-faint mb-4">
            Sign up solo, with friends, or as a full team. Recreational and competitive options available.
          </p>
          <span class="text-xs font-medium text-navy inline-flex items-center gap-1 group-hover:gap-2 transition-all">
            Browse adult programs →
          </span>
        </a>

        {isAspire && (
          <a
            href="/youth/classes"
            class="block p-6 rounded-2xl bg-gradient-to-br from-ochre/10 via-ochre/5 to-transparent border border-ochre/20 hover:border-ochre/40 transition-all group"
          >
            <div class="w-10 h-10 rounded-xl bg-ochre/15 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-ochre" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <h2 class="font-semibold text-ink text-lg mb-2">Try a weekly class</h2>
            <p class="text-sm text-ink-faint mb-4">
              Small-group skill classes for every age, all sports. The first class is always a free trial.
            </p>
            <span class="text-xs font-medium text-ochre inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Discover classes →
            </span>
          </a>
        )}
      </div>
    </div>
  </main>
</BaseLayout>
