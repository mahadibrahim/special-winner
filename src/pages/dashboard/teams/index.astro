---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MyTeams from "@/components/dashboard/teams/MyTeams";

// Middleware guarantees user is authenticated for /dashboard routes.
const user = Astro.locals.user!;
---

<BaseLayout title="My Teams — Aspire Sports">
  <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
    <div class="max-w-3xl mx-auto fade-in">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-ink-faint mb-6">
        <a href="/dashboard" class="hover:text-ink transition-colors">Dashboard</a>
        <span>/</span>
        <span class="text-ink">My Teams</span>
      </nav>

      <div class="mb-6">
        <h1 class="text-2xl font-bold text-ink">My Teams</h1>
        <p class="text-sm text-ink-muted mt-1">
          Teams you captain — invite teammates, track shares, follow the season.
        </p>
      </div>

      <MyTeams client:load />
    </div>
  </main>
</BaseLayout>
