---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import PostHog from '../../components/posthog.astro';
import UpcomingEvents from '../../components/dashboard/upcoming-events';
import ChildrenOverview from '../../components/dashboard/children-overview';
import CoachNotes from '../../components/dashboard/coach-notes';
import PaymentsSummary from '../../components/dashboard/payments-summary';
import { Announcements } from '../../components/dashboard/announcements';
import { EmailVerificationBanner } from '../../components/dashboard/email-verification-banner';
import { TeamGroupsPanel } from '../../components/dashboard/team-groups-panel';
import { TelegramConnectBanner } from '../../components/dashboard/telegram-connect-banner';
import { PaymentSuccessBanner } from '../../components/dashboard/payment-success-banner';
import { Button } from '../../components/ui/button';
import { resolveExternalStore } from '../../lib/organization/external-store';
import { getDb } from '../../lib/db';
import { userNudgeState } from '../../lib/db/schema';
import { and, eq } from 'drizzle-orm';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/signin?redirect=/dashboard');
}

const paymentStatus = Astro.url.searchParams.get('payment');
const registrationIdParam = Astro.url.searchParams.get('registration');
const showPaymentSuccessBanner = paymentStatus === 'success' && !!registrationIdParam;

const organization = Astro.locals.organization;
const externalStore = resolveExternalStore(null, organization as any);

// Fetch nudge state for Telegram connect banner
const db = getDb();
const telegramNudge = await db.query.userNudgeState.findFirst({
  where: and(
    eq(userNudgeState.userId, user.id),
    eq(userNudgeState.nudgeKey, 'telegram_connect_banner'),
  ),
});
const hasLinkedTelegram = !!(user as unknown as { telegramChatId?: string | null }).telegramChatId;
const telegramNudgeLastDismissedAt = telegramNudge?.lastDismissedAt?.toISOString() ?? null;

// Get current hour for greeting
const hour = new Date().getHours();
let greeting = "Good morning";
if (hour >= 12 && hour < 17) greeting = "Good afternoon";
else if (hour >= 17) greeting = "Good evening";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Dashboard — Aspire Sports</title>
    <PostHog />
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4 editorial-bg-radial">
      <div class="max-w-7xl mx-auto">
        <!-- Payment Success Banner -->
        {showPaymentSuccessBanner && (
          <PaymentSuccessBanner registrationId={registrationIdParam!} client:load />
        )}

        <!-- Header Section -->
        <header class="mb-10 fade-slide-in">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
            <div class="flex items-center gap-4">
              <!-- Avatar with gradient ring -->
              <div class="relative">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary via-primary to-orange-500 p-0.5">
                  <div class="w-full h-full rounded-2xl bg-cream flex items-center justify-center">
                    <span class="text-xl font-bold text-ink">
                      {user?.firstName?.[0] || 'U'}{user?.lastName?.[0] || ''}
                    </span>
                  </div>
                </div>
                <!-- Online indicator -->
                <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 rounded-full border-4 border-cream"></div>
              </div>

              <div>
                <p class="text-sm text-ink-faint mb-0.5">{greeting}</p>
                <h1 class="text-2xl sm:text-3xl font-bold text-ink">
                  {user?.firstName || 'there'}!
                </h1>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="flex flex-wrap gap-2">
              <Button variant="outline" size="sm" className="border-border text-ink-muted hover:text-ink hover:bg-cream-2" asChild>
                <a href="/dashboard/schedule">Full Schedule</a>
              </Button>
              <Button size="sm" asChild>
                <a href="/programs">Browse Programs</a>
              </Button>
            </div>
          </div>
        </header>

        <!-- Telegram Connect Banner -->
        <div class="mb-6">
          <TelegramConnectBanner
            client:load
            hasLinkedTelegram={hasLinkedTelegram}
            lastDismissedAt={telegramNudgeLastDismissedAt}
          />
        </div>

        <!-- Email Verification Banner -->
        <div class="mb-6">
          <EmailVerificationBanner
            client:load
            email={user.email}
            emailVerified={user.emailVerified}
          />
        </div>

        <!-- Phone Verification Banner -->
        {!(user as unknown as { phoneVerified?: boolean }).phoneVerified && (
          <div class="mb-6">
            <a
              href="/dashboard/settings/verify-phone"
              class="block p-4 rounded-xl bg-gradient-to-r from-blue-500/10 via-blue-500/5 to-transparent border border-blue-500/20 hover:border-blue-500/40 transition-all group"
            >
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg bg-blue-500/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-ink text-sm">Verify your phone for text updates</h3>
                  <p class="text-xs text-ink-faint mt-0.5">
                    Get schedule changes, reminders, and coach messages by text. Reply to us anytime — no app install needed.
                  </p>
                </div>
                <span class="text-xs font-medium text-blue-400 flex-shrink-0 group-hover:translate-x-0.5 transition-transform">
                  Verify →
                </span>
              </div>
            </a>
          </div>
        )}

        <!-- Main Dashboard Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
          <!-- Left Column - Events & Children (Primary Focus) -->
          <div class="lg:col-span-8 space-y-8 fade-slide-in-stagger">
            <!-- Upcoming Events - Most Important -->
            <section class="fade-slide-in">
              <UpcomingEvents client:visible />
            </section>

            <!-- Children Overview -->
            <section class="fade-slide-in">
              <ChildrenOverview client:visible />
            </section>
          </div>

          <!-- Right Column - Announcements, Coach Notes & Payments -->
          <div class="lg:col-span-4 space-y-8 fade-slide-in-stagger">
            <!-- Announcements -->
            <section class="fade-slide-in">
              <Announcements client:visible />
            </section>

            <!-- Team Groups -->
            <section class="fade-slide-in">
              <TeamGroupsPanel client:load />
            </section>

            <!-- Coach Notes - Key Differentiator -->
            <section class="fade-slide-in">
              <CoachNotes client:visible />
            </section>

            <!-- Payments Summary -->
            <section class="fade-slide-in">
              <PaymentsSummary client:visible />
            </section>

            <!-- Shop Team Gear card -->
            {externalStore && (
              <section class="fade-slide-in">
                <a
                  href={externalStore.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block p-5 rounded-2xl bg-cream-2 border border-border hover:border-primary/40 transition-all group"
                >
                  <h3 class="font-semibold text-ink mb-2 flex items-center gap-2">
                    <span class="text-lg">🛍️</span>
                    {externalStore.label}
                  </h3>
                  <p class="text-sm text-ink-faint mb-3">
                    Shop team gear and spirit-wear from our partner store.
                  </p>
                  <span class="text-xs font-medium text-primary inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                    Shop now →
                  </span>
                </a>
              </section>
            )}

            <!-- How we teach card -->
            <section class="fade-slide-in">
              <a href="/guides" class="block p-5 rounded-2xl bg-gradient-to-br from-primary/10 via-primary/5 to-transparent border border-primary/20 hover:border-primary/40 transition-all group">
                <h3 class="font-semibold text-ink mb-2 flex items-center gap-2">
                  <span class="text-lg">📘</span>
                  How we coach
                </h3>
                <p class="text-sm text-ink-faint mb-3">
                  See our complete development framework for every sport we offer — the philosophy, skill progressions, and standards every Aspire coach shares.
                </p>
                <span class="text-xs font-medium text-primary inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                  Read the coaching guides →
                </span>
              </a>
            </section>

            <!-- Help & Support Card -->
            <section class="fade-slide-in">
              <div class="p-5 rounded-2xl bg-cream-2 border border-border">
                <h3 class="font-semibold text-ink mb-2 flex items-center gap-2">
                  <span class="text-lg">💬</span>
                  Need Help?
                </h3>
                <p class="text-sm text-ink-faint mb-4">
                  Questions about programs, schedules, or your account? We're here to help.
                </p>
                <div class="flex gap-2">
                  <Button variant="outline" size="sm" className="flex-1 border-border text-ink-muted hover:text-ink hover:bg-cream-2" asChild>
                    <a href="/#faq">FAQ</a>
                  </Button>
                  <Button variant="outline" size="sm" className="flex-1 border-border text-ink-muted hover:text-ink hover:bg-cream-2" asChild>
                    <a href="mailto:hello@aspiresports.com?subject=Parent%20Dashboard%20Support">Contact</a>
                  </Button>
                </div>
              </div>
            </section>
          </div>
        </div>

        <!-- Bottom Actions Bar (Mobile) -->
        <div class="fixed bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-cream via-cream/95 to-transparent lg:hidden">
          <div class="flex gap-3 max-w-lg mx-auto">
            <Button className="flex-1" asChild>
              <a href="/programs">Register Now</a>
            </Button>
          </div>
        </div>

        <!-- Bottom Spacer for Mobile Fixed Bar -->
        <div class="h-20 lg:hidden"></div>
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
