---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DashboardShell from "@/components/dashboard/shell/DashboardShell.astro";
import DashboardSection from "@/components/dashboard/shell/DashboardSection.astro";
import PlayAttention from "@/components/dashboard/play/PlayAttention";
import PlayUpcoming from "@/components/dashboard/play/PlayUpcoming";
import PlayMembership from "@/components/dashboard/play/PlayMembership";
import PlayExplore from "@/components/dashboard/play/PlayExplore";
import MyTeamsCard from "@/components/dashboard/teams/MyTeamsCard";
import MyDropInBookings from "@/components/dashboard/MyDropInBookings";
import MyFieldRentals from "@/components/dashboard/MyFieldRentals";
import MembershipCard from "@/components/dashboard/MembershipCard";
import { MyPickupAlerts } from "@/components/dropin/PickupAlertSignup";
import { getDashboardDestinations } from "@/lib/dashboard/persona";
import { writeLastVisited } from "@/lib/dashboard/last-visited";
import { currentBusinessHour } from "@/lib/time/business-timezone";

// Middleware guarantees user is authenticated for /dashboard routes.
const user = Astro.locals.user!;

// Record last-visited destination
writeLastVisited(Astro.cookies, "play");

// Greeting hour in the business timezone — this page renders server-side.
const hour = currentBusinessHour();
let greeting = "Good morning";
if (hour >= 12 && hour < 17) greeting = "Good afternoon";
else if (hour >= 17) greeting = "Good evening";

// Destination tabs visibility
const { hasFamily, hasPlay } = await getDashboardDestinations(user.id);
---

<BaseLayout title="My Play Dashboard — Aspire Sports">
  <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
    <div class="max-w-7xl mx-auto">
      <DashboardShell
        user={user}
        greeting={greeting}
        active="play"
        hasFamily={hasFamily}
        hasPlay={hasPlay}
      >
        <div class="space-y-10 mt-8">

          {/* Needs your attention (self-contained — no DashboardSection wrapper) */}
          <PlayAttention client:load />

          {/* What's coming up */}
          <DashboardSection icon="calendar" title="What's coming up" accent="default">
            <div class="mt-1">
              <PlayUpcoming client:visible />
            </div>
          </DashboardSection>

          {/* What you're part of */}
          <DashboardSection icon="shield" title="What you're part of" accent="default">
            <div class="flex flex-col gap-8 mt-1">
              <MyTeamsCard client:load />
              <PlayMembership client:visible />
              <MembershipCard client:load />
              <MyDropInBookings client:visible />
              <MyFieldRentals client:visible />
            </div>
          </DashboardSection>

          {/* Pickup alerts — text me when games need players */}
          <DashboardSection icon="bell" title="Pickup alerts" accent="default">
            <div class="mt-1">
              <MyPickupAlerts client:load />
            </div>
          </DashboardSection>

          {/* Explore */}
          <DashboardSection icon="compass" title="Explore" accent="explore">
            <div class="mt-1">
              <PlayExplore client:visible />
            </div>
          </DashboardSection>

        </div>
      </DashboardShell>
    </div>
  </main>
</BaseLayout>
