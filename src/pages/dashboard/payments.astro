---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import PaymentHistory from '../../components/dashboard/payment-history';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/signin?redirect=/dashboard/payments');
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Payment History - Aspire Sports</title>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4">
      <div class="max-w-5xl mx-auto">
        <PaymentHistory client:load />
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
