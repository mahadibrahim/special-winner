---
import '../../../styles/globals.css';
import Navigation from '../../../components/navigation';
import Footer from '../../../components/footer';
import ChildProfile from '../../../components/dashboard/child-profile';

// Middleware guarantees user is authenticated for /dashboard routes.
const user = Astro.locals.user!;

// Get child ID from URL
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/dashboard');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Child Profile — Aspire Sports</title>
    <style>
      /* Background pattern */
      .profile-bg {
        background-image:
          radial-gradient(ellipse 60% 40% at 50% 0%, rgba(204, 68, 44, 0.06), transparent),
          radial-gradient(circle at 90% 90%, rgba(34, 197, 94, 0.04), transparent);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink antialiased">
    <Navigation client:load />

    <main id="main-content" class="flex-1 pt-24 pb-16 px-4 profile-bg">
      <div class="max-w-7xl mx-auto fade-in">
        <ChildProfile client:load childId={id} />
      </div>
    </main>

    <Footer client:idle />
  </body>
</html>
