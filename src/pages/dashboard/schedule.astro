---
import '../../styles/globals.css';
import Navigation from '../../components/navigation';
import Footer from '../../components/footer';
import FullSchedule from '../../components/dashboard/full-schedule';

// Get user from middleware locals
const user = Astro.locals.user;

// Redirect if not logged in
// TEMPORARILY DISABLED FOR TESTING
// if (!user) {
//   return Astro.redirect('/signin?redirect=/dashboard/schedule');
// }
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Schedule - Aspire Sports</title>
    <style>
      /* Page load animation */
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .schedule-content {
        animation: fadeIn 0.4s ease-out forwards;
      }

      /* Background pattern */
      .schedule-bg {
        background-image:
          radial-gradient(ellipse 60% 40% at 50% 0%, rgba(204, 68, 44, 0.06), transparent),
          radial-gradient(circle at 90% 80%, rgba(147, 51, 234, 0.04), transparent);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-16 px-4 schedule-bg">
      <div class="max-w-6xl mx-auto schedule-content">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
          <a href="/dashboard" class="hover:text-white transition-colors">Dashboard</a>
          <span>/</span>
          <span class="text-white">Schedule</span>
        </nav>

        <FullSchedule client:load />
      </div>
    </main>

    <Footer client:load />
  </body>
</html>
