---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FullSchedule from '../../components/dashboard/full-schedule';

// Middleware guarantees user is authenticated for /dashboard routes.
const user = Astro.locals.user!;
---

<BaseLayout title="Schedule — Aspire Sports">
  <Fragment slot="head">
    <style>
      /* Background pattern */
      .schedule-bg {
        background-image:
          radial-gradient(ellipse 60% 40% at 50% 0%, rgba(204, 68, 44, 0.06), transparent),
          radial-gradient(circle at 90% 80%, rgba(147, 51, 234, 0.04), transparent);
      }
    </style>
  </Fragment>

  <main id="main-content" class="flex-1 pt-24 pb-16 px-4 schedule-bg">
    <div class="max-w-6xl mx-auto fade-in">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-ink-faint mb-6">
        <a href="/dashboard" class="hover:text-ink transition-colors">Dashboard</a>
        <span>/</span>
        <span class="text-ink">Schedule</span>
      </nav>

      <FullSchedule client:load />
    </div>
  </main>
</BaseLayout>
