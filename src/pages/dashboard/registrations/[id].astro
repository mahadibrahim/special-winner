---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RegistrationDetail from '../../../components/dashboard/registration-detail';

// Middleware guarantees user is authenticated for /dashboard routes.
const user = Astro.locals.user!;

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/dashboard');
}
---

<BaseLayout title="Registration Details — Aspire Sports">
  <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
    <div class="max-w-4xl mx-auto">
      <RegistrationDetail client:load registrationId={id} />
    </div>
  </main>
</BaseLayout>
