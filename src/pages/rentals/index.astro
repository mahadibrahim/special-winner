---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RentalBooking from '@/components/rentals/RentalBooking';
import { getDb } from '@/lib/db';
import { venues, locations } from '@/lib/db/schema';
import { eq, and } from 'drizzle-orm';
import { renterWaiverOnFile } from '@/lib/rentals/waiver-on-file';

// SSR — depends on org context resolved by middleware.
export const prerender = false;

const org = Astro.locals.organization;

let rentalVenues: { id: string; name: string; fieldCount: number }[] = [];

if (org) {
  const db = getDb();
  const rows = await db
    .select({
      id: venues.id,
      name: venues.name,
      fieldCount: venues.fieldCount,
    })
    .from(venues)
    .innerJoin(locations, eq(venues.locationId, locations.id))
    .where(
      and(
        eq(locations.organizationId, org.id),
        eq(venues.rentalEnabled, true),
        eq(venues.active, true),
      ),
    )
    .orderBy(venues.name);

  rentalVenues = rows.map((r) => ({
    id: r.id,
    name: r.name,
    fieldCount: r.fieldCount ?? 1,
  }));
}

// Annual liability waiver: a signed-in renter already covered for this org
// should not be asked to re-sign — POST /api/rentals/bookings stamps the
// on-file attribution when no signature arrives (and records one honestly if
// it does, which is precisely what asking again would pointlessly produce).
// Resolved here (server-side, read-only) rather than by a client probe so the
// form never flashes a checkbox it is about to remove. Guests are never
// covered (no account, no person row), so this is false for them by
// construction.
const waiverOnFile = await renterWaiverOnFile(
  Astro.locals.user?.id,
  org?.id,
);
---

<BaseLayout
  title="Request a Field — Aspire Sports"
  description="Request an indoor field at Aspire Sports for practice, pickup, or events. Pick a venue and date, submit your request, and we'll email you a secure pay link once it's approved."
>
  <main id="main-content" class="flex-1 pt-24 pb-16 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-stone-900">Request a Field</h1>
        <p class="mt-2 text-stone-600">
          Request a field for practice, pickup, or events. Select a venue and
          date to see available time slots — your slot is held while we
          review the request, and we'll email you a secure link to pay once
          it's approved. Requests open 48 hours ahead; call us for anything
          sooner.
        </p>
      </div>
      <RentalBooking client:load venues={rentalVenues} signedIn={!!Astro.locals.user} waiverOnFile={waiverOnFile} timeZone={org?.timezone ?? "America/New_York"} />
    </div>
  </main>
</BaseLayout>
