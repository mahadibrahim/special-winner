---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountShell from '@/components/account/AccountShell.astro';
import { ProfileSettings } from '@/components/dashboard/profile-settings';

// Middleware guarantees the user is authenticated for /account routes.
---

<BaseLayout title="Profile — Account — Aspire Sports">
  <main id="main-content" class="flex-1 pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4">
      <AccountShell active="profile" title="Profile">
        <ProfileSettings client:load />
      </AccountShell>
    </div>
  </main>
</BaseLayout>
