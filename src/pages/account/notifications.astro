---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountShell from '@/components/account/AccountShell.astro';
import { NotificationSettings } from '@/components/dashboard/notification-settings';
import { MessagingSettings } from '@/components/dashboard/messaging-settings';

// Middleware guarantees the user is authenticated for /account routes.
---

<BaseLayout title="Notifications — Account — Aspire Sports">
  <main id="main-content" class="flex-1 pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4">
      <AccountShell active="notifications" title="Notifications">
        <div class="space-y-6">
          <NotificationSettings client:load />
          <MessagingSettings client:load />
        </div>
      </AccountShell>
    </div>
  </main>
</BaseLayout>
