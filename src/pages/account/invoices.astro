---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountShell from '@/components/account/AccountShell.astro';
import PaymentHistory from '@/components/dashboard/payment-history';
import PaymentsSummary from '@/components/dashboard/payments-summary';

// Middleware guarantees the user is authenticated for /account routes.
---

<BaseLayout title="Invoices — Account — Aspire Sports">
  <main id="main-content" class="flex-1 pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4">
      <AccountShell active="invoices" title="Invoices">
        <div class="space-y-8">
          <PaymentsSummary client:visible />
          <PaymentHistory client:load />
        </div>
      </AccountShell>
    </div>
  </main>
</BaseLayout>
