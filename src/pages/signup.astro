---
// NOT prerendered: needs request-time Astro.url.search to pass the redirect=
// param through to the "Sign in" link below.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SignUpForm } from '../components/auth/signup-form';

// Authenticated users are redirected to /dashboard by middleware — no check needed here.
---

<BaseLayout title="Create Account — Aspire Sports">
  <main id="main-content" class="flex-1 flex items-center justify-center py-12 px-4 pt-24">
    <div class="w-full max-w-md">
      <!-- Card -->
      <div class="bg-cream-2 border border-border rounded-2xl p-8">
        <!-- Header -->
        <div class="text-center mb-8">
          <h1 class="text-2xl font-bold text-ink mb-2">Create Your Account</h1>
          <p class="text-ink-muted">
            Join Aspire Sports to register for programs and manage your family's activities
          </p>
        </div>

        <!-- Form -->
        <SignUpForm client:load />

        <!-- Sign in link -->
        <div class="mt-6 text-center">
          <p class="text-ink-faint text-sm">
            Already have an account?{' '}
            <a
              href={`/signin${Astro.url.search}`}
              class="text-primary hover:text-primary/80 font-medium"
            >
              Sign in
            </a>
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
