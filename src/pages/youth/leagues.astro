---
// src/pages/youth/leagues.astro
// SSR — the islands fetch host-scoped public endpoints client-side.
//
// This page is the SPORT PICKER for youth leagues — each live card links to
// that sport's own page. Recomposed (Phase 2) in the youth band grammar
// (docs/design-system.md "Youth band grammar"): banded hero, sticky jump bar,
// navy sport cards with slot graphics, statement-card facts, numbered
// how-it-works band, red booking flood with the paper-sheet finder overlap.
// Leagues surfaces stay FACTS pages — no Director of Coaching, no coach
// section (owner decision; coaching-as-product lives on classes/camps).
import BaseLayout from "@/layouts/BaseLayout.astro"
import CategoryFinder from "@/components/landing/category-finder.tsx"
import TileFactsLine from "@/components/landing/tile-facts-line"
import SeasonCalendarBand, { type CalendarTermConfig } from "@/components/landing/season-calendar-band.tsx"
import LandingFaq, { type LandingFaqItem } from "@/components/landing/landing-faq.tsx"
import SectionJumpBar from "@/components/youth/bands/section-jump-bar.astro"
import FeatureBand from "@/components/youth/bands/feature-band.astro"
import StatementCards from "@/components/youth/bands/statement-cards.astro"
import SlotGraphic from "@/components/youth/bands/slot-graphic.astro"
import { setMarketingEdgeCache } from "@/lib/http/edge-cache"

const HERO_IMAGE = "/images/stock/team-huddle.jpg"
setMarketingEdgeCache(Astro)

// Sport cards — the picker's whole job. Gradients are token-composed (no
// literal oklch()), mirroring the classes pathway-card CARD_PHOTO approach so
// the two card families read as one system. Basketball has no page yet; its
// card routes interest to the calendar band's notify form instead of dead-ending.
interface SportCard {
  label: string
  meta: string
  photo: string
  href: string
  status: "live" | "coming_soon"
}
const SPORTS: SportCard[] = [
  {
    label: "Soccer",
    meta: "Season leagues · U6 – U19",
    photo:
      "linear-gradient(135deg, color-mix(in oklch, var(--emerald), var(--navy-deep) 15%), var(--navy-deep))",
    href: "/youth/leagues/soccer",
    status: "live",
  },
  {
    label: "Futsal",
    meta: "Indoor, small-sided",
    photo: "linear-gradient(135deg, var(--royal), var(--navy-deep))",
    href: "/youth/leagues/futsal",
    status: "live",
  },
  {
    label: "Basketball",
    meta: "Interested? Leave your email below",
    photo:
      "linear-gradient(135deg, color-mix(in oklch, var(--brand-red), var(--navy-deep) 8%), var(--navy-deep))",
    href: "#calendar",
    status: "coming_soon",
  },
]

const JUMP_ITEMS = [
  { href: "#sports", label: "Pick a sport" },
  { href: "#facts", label: "Game day" },
  { href: "#how", label: "How it works" },
  { href: "#open", label: "Book now" },
  { href: "#calendar", label: "Calendar" },
  { href: "#faq", label: "FAQs" },
]

// Game-day facts row (statement cards). Facts already established on this
// page and in the FAQs below — no new claims.
const FACT_CARDS = [
  {
    label: "Game days",
    statement: "Saturdays and Sundays.",
    body: "Games are scheduled between 7am and 8pm — your team's exact times come with the schedule before week 1.",
  },
  {
    label: "Age groups",
    statement: "Kids play their own age.",
    body: "Divisions run U6 to U19, so kids play against kids their own age. Every program card shows its exact range.",
  },
  {
    label: "The seasons",
    statement: "Back-to-back, all year.",
    body: "Winter play for club teams, developmental seasons the rest of the year — there's always a next season on the calendar.",
  },
]

// How-it-works, in the numbered-card band shape the classes page uses for its
// development loop — copy carried over from the retired HowItWorksStrip.
const HOW_STEPS = [
  {
    num: "1",
    numClass: "text-royal-bright",
    title: "Pick the age group.",
    body: "Every program shows its ages right on the card — or use the birthday lookup on each sport's page.",
  },
  {
    num: "2",
    numClass: "text-emerald-bright",
    title: "Three-minute signup.",
    body: "Register your kid and pay online — no account or password needed up front.",
  },
  {
    num: "3",
    numClass: "text-brand-red",
    title: "You're set.",
    body: "Schedule, coach intro, and any updates land by email and text before week 1.",
  },
]

// Authored future-term cells for the calendar band — live terms from the
// catalog replace any cell they match. Months are authored estimates until
// upcoming seasons exist in the DB (see the follow-up note in
// season-calendar-band.tsx).
const calendarTerms: CalendarTermConfig[] = [
  { name: "Winter I", months: "Dec–Feb", match: "winter-i" },
  { name: "Winter II", months: "Feb–Apr", match: "winter-ii" },
  { name: "Spring", months: "Apr–Jun", match: "spring" },
]

const faqs: LandingFaqItem[] = [
  {
    question: "What ages can play?",
    answer:
      "Youth programs run for ages 3 through 18, organized into age divisions so kids play against kids their own age. Every program card shows its exact age range.",
  },
  {
    question: "When are games?",
    answer:
      "Every game is on a Saturday or Sunday, scheduled between 7am and 8pm. Your team's exact game times come with the schedule before week 1.",
  },
  {
    question: "Could a game's location change?",
    answer:
      "Your division's home venue is set before the season. If a game ever moves to our other location, we notify every family by text and email as soon as it's scheduled — never day-of.",
  },
  {
    question: "What's the refund policy?",
    answer:
      "Cancel 14 or more days before the season starts for a full refund. Inside 14 days, we review case by case — the default is a prorated credit toward a future season.",
    linkHref: "/refund-policy",
    linkLabel: "Read the full refund policy",
  },
  {
    question: "What does my kid need to bring?",
    answer:
      "Basic equipment is provided for most programs — players bring their own athletic shoes and apparel. Anything program-specific is listed on the program page.",
  },
]
---

<BaseLayout
  title="Youth Leagues — Aspire Sports"
  description="Youth sports leagues in Columbus and central Ohio. Vetted coaches, organized seasons, sorted by your kid's age."
>
  <Fragment slot="head">
    <link rel="canonical" href={`${Astro.url.origin}/youth/leagues`} />
  </Fragment>

  <main id="main-content" class="flex-1">
    {/* ---------- Hero -------------------------------------------------- */}
    <section class="relative text-cream px-6 sm:px-9 py-20 sm:py-[88px] overflow-hidden bg-navy-deep">
      <div class="graded graded--emerald graded--fill z-0" aria-hidden="true">
        <img src={HERO_IMAGE} alt="" />
      </div>
      <div class="relative z-10 max-w-[1080px] mx-auto">
        <h1
          class="font-display font-semibold tracking-tight max-w-[14ch]"
          style="font-size:clamp(3rem,6.5vw,4.6rem);line-height:.98;letter-spacing:-0.015em"
        >
          Game day, every weekend.
        </h1>
        <p class="mt-[18px] text-[17.5px] text-cream/92 max-w-[540px]">
          Season leagues with <b class="font-bold text-cream">vetted coaches and tight logistics</b> —
          pick your kid's sport, find their age group, and go.
        </p>
        <div class="flex flex-wrap gap-3 mt-[30px]">
          <a
            href="#open"
            data-youth-cta="leagues-hero-open"
            class="inline-block font-semibold text-[14.5px] px-[22px] py-[13px] rounded-[10px] bg-brand-red text-cream no-underline"
          >
            See what's open →
          </a>
          <a
            href="#sports"
            data-youth-cta="leagues-hero-sports"
            class="inline-block font-semibold text-[14.5px] px-[22px] py-[13px] rounded-[10px] border-[1.5px] border-cream/50 text-cream no-underline"
          >
            Pick a sport
          </a>
        </div>
      </div>
    </section>

    <SectionJumpBar items={JUMP_ITEMS} />

    {/* ---------- Sport picker ------------------------------------------ */}
    <section id="sports" class="px-6 sm:px-9 py-[76px] pb-[68px]">
      <div class="max-w-[1080px] mx-auto">
        <h2
          class="font-display font-semibold tracking-tight text-ink"
          style="font-size:clamp(2.1rem,3.8vw,2.9rem);letter-spacing:-0.015em"
        >
          Which sport, <span class="text-brand-red">this season?</span>
        </h2>
        <p class="text-[15.5px] text-ink-2 max-w-[580px] mt-3">
          Each sport has its own page — age groups, open divisions and the season calendar, all in one
          place.
        </p>

        <div class="grid gap-[18px] mt-[38px]" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
          {
            SPORTS.map((sport, i) => (
              <a
                href={sport.href}
                data-youth-cta={`leagues-sport-${sport.label.toLowerCase()}`}
                class="bg-navy-deep text-cream rounded-[18px] overflow-hidden flex flex-col no-underline group"
              >
                <div class="relative overflow-hidden h-[150px]" style={`background:${sport.photo}`}>
                  <SlotGraphic variant={i} />
                </div>
                <div class="px-6 pt-[22px] pb-6 flex-1 flex flex-col">
                  <h3 class="font-display font-semibold text-[26px]">{sport.label}</h3>
                  <div
                    class={`font-mono text-[10.5px] tracking-[0.16em] uppercase mt-1.5 ${
                      sport.status === "live" ? "text-emerald-bright" : "text-cream/60"
                    }`}
                  >
                    {sport.status === "live" ? "● Now enrolling" : "Coming soon"}
                  </div>
                  <p class="text-[13.5px] text-cream/85 mt-2.5 flex-1">{sport.meta}</p>
                  <div class="mt-[18px]">
                    <span class="inline-block bg-cream text-ink font-semibold text-[13px] px-4 py-[9px] rounded-[8px] group-hover:bg-cream/90">
                      {sport.status === "live" ? `Youth ${sport.label.toLowerCase()} →` : "Get notified ↓"}
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- Game-day facts ---------------------------------------- */}
    <section id="facts" class="px-6 sm:px-9 pb-[76px]">
      <div class="max-w-[1080px] mx-auto">
        <h2
          class="font-display font-semibold tracking-tight text-ink"
          style="font-size:clamp(2.1rem,3.8vw,2.9rem);letter-spacing:-0.015em"
        >
          What game day <span class="text-brand-red">looks like.</span>
        </h2>
        <div class="mt-[38px]">
          <StatementCards cards={FACT_CARDS} />
        </div>
      </div>
    </section>

    {/* ---------- How it works — numbered navy band ---------------------- */}
    <section id="how" class="bg-navy-deep text-cream px-6 sm:px-9 py-[76px]">
      <div class="max-w-[1080px] mx-auto">
        <h2
          class="font-display font-semibold tracking-tight max-w-[22ch]"
          style="font-size:clamp(2.1rem,3.8vw,2.9rem);letter-spacing:-0.015em"
        >
          How it works, <span class="text-emerald-bright">for parents.</span>
        </h2>
        <div class="grid gap-[14px] mt-10" style="grid-template-columns:repeat(auto-fit,minmax(230px,1fr))">
          {
            HOW_STEPS.map((s) => (
              <div class="rounded-[14px] p-6" style="background:color-mix(in oklch, var(--navy-deep), var(--royal) 12%)">
                <div class={`font-display font-semibold text-[44px] leading-none ${s.numClass}`}>{s.num}</div>
                <h4 class="font-display font-semibold text-[19px] mt-2.5">{s.title}</h4>
                <p class="text-[13.5px] text-cream/85 mt-2">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- Book it right here — red flood + overlapping finder ----- */}
    <section id="open" class="bg-brand-red text-cream text-center px-6 sm:px-9 pt-16 pb-[140px]">
      <div class="max-w-[1080px] mx-auto">
        <h2
          class="font-display font-semibold tracking-tight"
          style="font-size:clamp(2.2rem,4.5vw,3.2rem);letter-spacing:-0.015em"
        >
          Book it right here.
        </h2>
        {/* Live status line, computed client-side — this page is edge-cached
            marketing HTML (setMarketingEdgeCache above), so the line must not
            be baked in at render time. Scoped to the same query as the finder
            below so the two always agree. */}
        <TileFactsLine client:visible audience="youth" programTypes={["league"]} tone="cream" />
      </div>
    </section>
    <div class="-mt-[88px] pb-[76px] px-6 sm:px-9">
      {/* The overlap element is a paper SHEET, not the bare finder — the
          finder's ink heading must never straddle the red/cream boundary
          (owner-flagged on classes; same contract here). sectionId is
          "open-leagues", distinct from the red band's id="open" which the
          jump bar and hero CTA anchor to. */}
      <div class="max-w-[1080px] mx-auto bg-paper border border-cream-3 rounded-2xl shadow-xl">
        <CategoryFinder
          client:load
          audience="youth"
          programTypes={["league"]}
          title="Open leagues"
          descriptor="Season leagues, sorted by age group — every card shows its dates, venue and price."
          ageChips
          sectionId="open-leagues"
          cardVariant="youth-band"
          headerHidden
        />
      </div>
    </div>

    {/* ---------- Calendar ------------------------------------------------ */}
    <div id="calendar">
      <SeasonCalendarBand
        client:visible
        audience="youth"
        programTypes={["league"]}
        pageKey="youth-leagues"
        cardsSectionId="open-leagues"
        heading="The season calendar."
        descriptor="Seasons run back-to-back all year — leave your email and you'll hear the moment the next one opens."
        futureTerms={calendarTerms}
      />
    </div>

    {/* ---------- FAQs ---------------------------------------------------- */}
    <LandingFaq client:visible id="faq" heading="Questions parents ask." items={faqs} />

    {/* ---------- Cross-promo: classes & camps ---------------------------- */}
    <FeatureBand
      tone="emerald"
      graphicVariant={1}
      kicker="Also at Aspire"
      title="Training between seasons."
      body="Small-group classes from 18 months to nineteen years — a coach who explains, and one pathway so your kid never has to start over."
      cta={{ href: "/youth/classes", label: "See youth classes →" }}
    />
    <FeatureBand
      tone="red"
      graphicVariant={4}
      kicker="Also at Aspire"
      title="Camps, all year long."
      body="Day camps on school breaks, plus specialty camps through the year — coached rather than supervised, by the same people they see all year."
      cta={{ href: "/youth/camps", label: "See camp dates →" }}
    />

    {/* ---------- Close --------------------------------------------------- */}
    <section class="bg-navy-deep text-cream text-center px-6 sm:px-9 py-20" aria-labelledby="youth-leagues-close-h">
      <div class="max-w-[1080px] mx-auto">
        <h2
          id="youth-leagues-close-h"
          class="font-display font-semibold tracking-tight"
          style="font-size:clamp(2rem,4vw,2.8rem)"
        >
          See you on <span class="text-emerald-bright">game day.</span>
        </h2>
        <p class="mt-2.5 text-cream/90">Find their league and register — it takes a few minutes.</p>
        <div class="flex justify-center gap-3 mt-6">
          <a
            href="#open"
            data-youth-cta="leagues-close-book"
            class="inline-block font-semibold text-[14.5px] px-[22px] py-[13px] rounded-[10px] bg-brand-red text-cream no-underline"
          >
            Find their league →
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { track } from "@/lib/analytics/track"

  // Same event the other youth band pages fire — sections are prefixed
  // "leagues-" so the picker's CTAs stay distinguishable in the funnel.
  document.querySelectorAll<HTMLAnchorElement>("[data-youth-cta]").forEach((el) => {
    el.addEventListener("click", () =>
      track("youth_hub_section_cta_clicked", { section: el.dataset.youthCta ?? "" }),
    )
  })
</script>
