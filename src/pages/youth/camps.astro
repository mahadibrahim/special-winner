---
// Youth camps. Like classes, this is a coaching surface — the owner's split
// puts the Director of Coaching prominent here, never on league pages. The
// lede names the actual reason people buy camps: there's no school and they
// still have work.
//
// Copy rules (owner-directed): no eyebrow text, no format claims, no
// oppositional language, facility not a selling point. No authored age
// ranges or day structures here — those were flagged unverified, so the
// finder cards carry each camp's real ages and dates instead.
import BaseLayout from "@/layouts/BaseLayout.astro"
import CategoryFinder from "@/components/landing/category-finder.tsx"
import YouthCoachSection from "@/components/youth/youth-coach-section.astro"
import CTABanner from "@/components/cta-banner"
import { CAMPS } from "@/lib/youth/landing-content"
import { setMarketingEdgeCache } from "@/lib/http/edge-cache"

// youth-training.jpg is also the hub hero — acceptable reuse; the alternative
// stock shots (night stadium, adult pickup) read wrong for daytime kids camps.
const HERO_IMAGE = "/images/stock/youth-training.jpg"
setMarketingEdgeCache(Astro)
---

<BaseLayout
  title="Youth Camps — Aspire Sports"
  description="Youth sports camps in central Ohio — school-break and summer day camps, coached rather than supervised."
>
  <Fragment slot="head">
    <link rel="canonical" href={`${Astro.url.origin}/youth/camps`} />
  </Fragment>

  <main id="main-content" class="flex-1">
    <section class="relative text-cream px-6 sm:px-9 py-20 overflow-hidden bg-navy-deep">
      <div class="graded graded--emerald graded--fill z-0" aria-hidden="true">
        <img src={HERO_IMAGE} alt="" />
      </div>
      <div class="relative z-10 max-w-[1080px] mx-auto">
        <h1 class="font-display font-semibold tracking-tight" style="font-size:clamp(2.4rem,6vw,3.6rem);line-height:1">
          School&rsquo;s out.<br />They&rsquo;re covered.
        </h1>
        <p class="mt-4 text-base text-cream/90 max-w-[480px] leading-relaxed">{CAMPS.lede}</p>
        <p class="mt-5 text-sm text-cream/75">
          Looking for a season instead?
          <a href="/youth/leagues" class="underline underline-offset-2 hover:text-cream transition-colors">Youth leagues →</a>
        </p>
      </div>
    </section>

    {/* ---------- Why an Aspire camp --------------------------------------- */}
    <section class="px-6 sm:px-9 py-12 border-b border-border" aria-labelledby="camps-why-h">
      <div class="max-w-[1080px] mx-auto">
        <h2 id="camps-why-h" class="font-display text-3xl text-ink tracking-tight">
          Coached, not supervised.
        </h2>
        <p class="text-[13.5px] text-ink-2 leading-relaxed mt-2 max-w-[560px]">
          A camp day here is run by the same coaches, on the same curriculum,
          as the rest of the year — so a school-break week moves your kid
          forward instead of just filling the time. Drop-off and pick-up run
          on time, because we know the day doesn&rsquo;t end when yours does.
        </p>
      </div>
    </section>

    <YouthCoachSection headingId="camps-coach-h" />

    {/* ---------- What's open ---------------------------------------------- */}
    <CategoryFinder
      client:load
      audience="youth"
      programTypes={["camp"]}
      title="Open now"
      descriptor="Filter by age and venue — every camp shows its dates on the card."
      ageChips
      sectionId="youth-camps"
    />

    <CTABanner client:visible />
  </main>
</BaseLayout>
