---
// Youth camps hub — Broadsheet (v2) band conversion of the four-family
// menu. Camps is a coaching surface like classes (owner split: Director of
// Coaching IS prominent here, never on league pages). Band language follows
// the design canvas "Aspire Classes & Camps" 2a, composed for this page:
// notice banner (ochre — the tertiary-highlight role; the orange budget is
// spent on the in-page nav and the closer) → product row (ink-lift) → hero
// (photo + scrim, four door tiles) → in-page nav (orange) → four family
// bands alternating sand/ink → camp day (paper) → coaching (ink) → book &
// dates (sand) → calendar (paper) → FAQs → cross-links (ink-lift) →
// closer (orange).
//
// Content and every placeholder fact live in ONE registry:
// src/lib/youth/camp-page-content.ts (the owner-tuning surface).
// Launch reality: the catalog has zero camp seasons, so the finder renders
// its banded notify empty state and the authored calendar carries the dates
// story. Cards appear automatically as camps are seeded — no code change.
//
// Copy rules (owner-directed): no oppositional language, facility not a
// selling point, camps are NOT school-break-only, no invented dollar figures.
// The family kickers (when it runs) render BELOW each band's headline —
// they carry real info but the no-eyebrow rule bans the above-headline slot.
import BaseLayout from "@/layouts/BaseLayout.astro"
import CategoryFinder from "@/components/landing/category-finder.tsx"
import TileFactsLine from "@/components/landing/tile-facts-line"
import { EmptyNotifyForm } from "@/components/landing/empty-notify-form"
import LandingFaq from "@/components/landing/landing-faq.tsx"
import ProductRow from "@/components/youth/bands/product-row.astro"
import InpageNav from "@/components/youth/bands/inpage-nav.astro"
import CoachBand from "@/components/youth/bands/coach-band.astro"
import SlotGraphic from "@/components/youth/bands/slot-graphic.astro"
import { CAMPS } from "@/lib/youth/landing-content"
import {
  CAMP_TYPES,
  CAMP_DAY_FACTS,
  CAMP_DAY_FACTS_NOTE,
  CAMP_BANNER,
  CAMP_CALENDAR,
  CAMP_HUB_FAQS,
  CAMP_FINDER_EMPTY_BODY,
} from "@/lib/youth/camp-page-content"
import { faqPageJsonLd } from "@/lib/seo/faq-jsonld"
import { setMarketingEdgeCache } from "@/lib/http/edge-cache"

const HERO_IMAGE = "/images/stock/youth-training.jpg"
setMarketingEdgeCache(Astro)

const NAV_ITEMS = [
  { href: "#camp-schools-out", label: "The camps" },
  { href: "#day", label: "The camp day" },
  { href: "#coach", label: "Coaching" },
  { href: "#open", label: "Book & dates" },
  { href: "#calendar", label: "Calendar" },
  { href: "#faqs", label: "FAQs" },
]
---

<BaseLayout
  title="Youth Sports Camps in Columbus & Worthington, Ohio — Aspire Sports"
  description="Youth camps in Columbus and Worthington, Ohio — day camps when school's out, skills and specialty camps through the year. Coached rather than supervised. See dates and book online."
>
  <Fragment slot="head">
    {/* FAQPage rich-result schema — mirrors the LandingFaq items rendered
        below, nothing more (issue #575). Canonical comes from BaseLayout. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPageJsonLd(CAMP_HUB_FAQS))} />
  </Fragment>
  <main id="main-content" class="flex-1">
    {/* ---------- Notice banner — owner-editable copy (CAMP_BANNER); static
        until camps are seeded, then revisit to a live line. Ochre = the
        tertiary-highlight role; the orange band budget belongs to the
        in-page nav and the closer. pt clears the fixed site header — this
        is the page's first flow element. ---------------------------------- */}
    <div class="bg-ochre text-ink px-6 sm:px-12 pt-16 lg:pt-20" data-testid="camps-banner">
      <div class="max-w-[1080px] mx-auto flex items-center justify-between gap-4 flex-wrap py-3">
        <span class="text-[13.5px] font-semibold">{CAMP_BANNER.message}</span>
        <a
          href="#calendar"
          data-youth-cta="camps-banner"
          class="label no-underline text-ink border-b-2 border-ink pb-0.5 whitespace-nowrap"
        >
          {CAMP_BANNER.cta}
        </a>
      </div>
    </div>

    <ProductRow active="camps" />

    {/* ---------- Hero — photo, ink scrim, four square door tiles ---------- */}
    <section class="band-ink relative overflow-hidden">
      <img
        src={HERO_IMAGE}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-[center_30%]"
        style="filter:grayscale(1) contrast(1.08) brightness(.96)"
      />
      <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
      <div class="relative max-w-[1080px] mx-auto px-6 sm:px-12 pt-16 pb-14 flex flex-col gap-5">
        <h1 class="display-xl text-on-ink max-w-[700px]">Camp, all year long.</h1>
        <p class="body-l text-on-ink-2 max-w-[560px]" style="text-wrap:pretty">{CAMPS.lede}</p>
        <div class="grid gap-3.5 pt-2" style="grid-template-columns:repeat(auto-fit,minmax(228px,1fr))">
          {
            CAMP_TYPES.map((t) => (
              <a
                href={`#camp-${t.slug}`}
                data-youth-cta={`camps-tile-${t.slug}`}
                class="relative bg-ink-lift border border-rule-on-ink px-5 pt-4 pb-4 no-underline block"
              >
                {/* Not a heading: the band below carries this name as the real
                    section <h2>; doubling it here gave the page eight H2s,
                    four duplicated (issue #576). Tiles are navigation. The
                    name leads; the when-line (real info) sits under it. */}
                <span class="display-s block text-on-ink">{t.name}</span>
                <span class="data block mt-1.5 text-primary-bright">{t.tileMeta}</span>
                <span class="absolute right-4 bottom-3 font-bold text-lg text-on-ink-2" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
        <p class="text-[13.5px] text-on-ink-muted">
          Looking for a weekly season instead?
          <a href="/youth/leagues" class="text-primary-bright underline underline-offset-2">Youth leagues →</a>
          · Year-round training?
          <a href="/youth/classes" class="text-primary-bright underline underline-offset-2">Classes →</a>
        </p>
      </div>
    </section>

    <InpageNav
      items={NAV_ITEMS}
      cta={{ href: "#calendar", label: "Get notified ↗", youthCta: "camps-nav-notify" }}
    />

    {/* ---------- Camp-family bands — one per family, alternating sand/ink.
        The v1 tone-colored floods retire; the family is carried by content
        and band order, per the Broadsheet rhythm. ------------------------- */}
    {
      CAMP_TYPES.map((t, i) => {
        const onInk = i % 2 === 1
        return (
          <section
            id={`camp-${t.slug}`}
            class:list={[onInk ? "band-ink" : "band-sand", "scroll-mt-36 px-6 sm:px-12 py-16"]}
          >
            <div class="max-w-[1080px] mx-auto grid gap-11 items-center md:grid-cols-[1.15fr_1fr]">
              <div>
                <h2 class="display-l">{t.name}</h2>
                <div class:list={["data mt-2.5", onInk ? "text-primary-bright" : "text-primary-text"]}>
                  {t.kicker}{t.agesLine ? ` · ${t.agesLine}` : ""}
                </div>
                <p class:list={["body-copy mt-3.5", onInk ? "text-on-ink-2" : "text-on-sand-2"]}>{t.body}</p>
                <div class:list={["font-mono text-[12px] mt-4 leading-loose", onInk ? "text-on-ink-2" : "text-on-sand-2"]}>
                  {t.windows}
                </div>
                {t.teaser && (
                  <div class:list={["mt-4 border-t pt-3.5", onInk ? "border-rule-on-ink" : "border-rule"]}>
                    <div class:list={["label", onInk ? "text-on-ink-muted" : "text-on-sand-muted"]}>
                      {t.teaser.label}
                    </div>
                    <p class:list={["body-s mt-1.5", onInk ? "text-on-ink-2" : "text-on-sand-2"]}>{t.teaser.text}</p>
                  </div>
                )}
                {t.namedCamps.length > 0 && (
                  <div class="grid gap-2.5 mt-[18px]" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
                    {t.namedCamps.map((c) => (
                      <div class:list={["border px-3.5 py-3 font-semibold text-[13.5px]", onInk ? "border-rule-on-ink text-on-ink" : "border-rule bg-paper text-on-sand"]}>
                        {c.name}
                        <small class:list={["data block font-normal mt-1", onInk ? "text-on-ink-muted" : "text-on-sand-muted"]} style="font-size:0.625rem">
                          {c.hook}
                        </small>
                      </div>
                    ))}
                  </div>
                )}
                <div class="flex flex-wrap gap-2.5 mt-[22px]">
                  <a
                    href={`/youth/camps/${t.slug}`}
                    data-youth-cta={`camps-band-${t.slug}`}
                    class="btn btn--primary no-underline"
                  >
                    Everything about {t.slug === "summer" ? "summer camp" : t.name.toLowerCase()}
                  </a>
                  {t.slug === "specialty" ? (
                    <a
                      href="#calendar"
                      data-youth-cta={`camps-band-${t.slug}-notify`}
                      class:list={["btn no-underline", onInk ? "btn--on-ink" : "btn--outline"]}
                    >
                      Get notified when one drops
                    </a>
                  ) : (
                    <a
                      href="#open"
                      data-youth-cta={`camps-band-${t.slug}-dates`}
                      class:list={["btn no-underline", onInk ? "btn--on-ink" : "btn--outline"]}
                    >
                      See dates
                    </a>
                  )}
                </div>
              </div>
              <div
                class:list={["relative overflow-hidden min-h-[240px]", onInk ? "bg-ink-lift" : "bg-ink"]}
              >
                <SlotGraphic variant={i} />
              </div>
            </div>
          </section>
        )
      })
    }

    {/* ---------- The camp day, up front — placeholder facts, one constant */}
    <section id="day" class="band-paper scroll-mt-36 border-y border-rule px-6 sm:px-12 pt-14 pb-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <h2 class="display-l">The camp day, up front</h2>
        <div class="grid gap-x-8 gap-y-[26px]" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
          {
            CAMP_DAY_FACTS.map((f) => (
              <div>
                <div class="label text-on-sand-muted">{f.label}</div>
                {/* Times are VALUES → mono; phrases and names stay sans (the
                    mono rule). A digit in the value is the discriminator —
                    every measured fact here carries one. */}
                <div
                  class:list={[
                    "mt-1.5 leading-tight text-on-sand",
                    /\d/.test(f.value) ? "font-mono text-[15px]" : "font-semibold text-[16px]",
                  ]}
                >
                  {f.value}
                </div>
              </div>
            ))
          }
        </div>
        <p class="text-[13px] text-on-sand-muted">{CAMP_DAY_FACTS_NOTE}</p>
      </div>
    </section>

    {/* ---------- Coaching — shared Broadsheet band (owner split) --------- */}
    <CoachBand headingId="camps-coach-h" />

    {/* ---------- Book & dates — sand band, live finder -------------------- */}
    <section id="open" class="band-sand scroll-mt-36 px-6 sm:px-12 py-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-6">
        <div class="flex flex-col gap-2.5 max-w-[640px]">
          <h2 class="display-l">Book a camp</h2>
          <p class="body-copy text-on-sand-2">
            Every camp shows its dates, ages, venue and price on the card.
          </p>
          {/* Live facts line — edge-cached page, so status is computed
              client-side from the shared catalog fetch (classes precedent).
              Renders blank while the catalog has no camps; never invents. */}
          <TileFactsLine client:visible audience="youth" programTypes={["camp"]} tone="ink" />
        </div>
        {/* sectionId stays "youth-camps" — the e2e empty-notify capture id
            (#empty-finder-youth-camps-email) and signup attribution depend
            on it. Empty state = the banded "Be first in when it opens." card. */}
        <CategoryFinder
          client:load
          audience="youth"
          programTypes={["camp"]}
          title="Open camps"
          descriptor="Every camp shows its dates, ages, venue and price on the card."
          ageChips
          sectionId="youth-camps"
          cardVariant="youth-band"
          headerHidden
          emptyBody={CAMP_FINDER_EMPTY_BODY}
        />
      </div>
    </section>

    {/* ---------- The camp calendar — authored windows + notify ----------- */}
    <section id="calendar" class="band-paper scroll-mt-36 border-t border-rule px-6 sm:px-12 py-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <div class="flex flex-col gap-2.5 max-w-[640px]">
          <h2 class="display-l">The camp calendar</h2>
          <p class="body-copy text-on-sand-2">
            Planned windows for the year — leave your email and you'll hear the moment a window's
            dates open for booking.
          </p>
        </div>
        <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
          {
            CAMP_CALENDAR.map((c) => (
              <div class="bg-sand border border-rule p-5 flex flex-col items-start gap-1.5">
                <h3 class="display-s">{c.name}</h3>
                <div class="font-mono text-[11px] text-on-sand-muted">{c.meta}</div>
                {/* Chips are the one place radius survives. */}
                <a
                  href="#camps-notify"
                  data-youth-cta={`camps-calendar-${c.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
                  class="chip no-underline mt-2"
                >
                  Get notified
                </a>
              </div>
            ))
          }
        </div>
        <div id="camps-notify" class="bg-sand border border-rule p-6 scroll-mt-36">
          <p class="text-[14.5px] text-on-sand-2">
            Any window, any camp — leave your email and you'll hear the moment dates open.
          </p>
          <EmptyNotifyForm client:visible audience="parent" source="camps-calendar" />
        </div>
      </div>
    </section>

    {/* ---------- FAQs — orange accent per the Broadsheet page accent ------ */}
    <LandingFaq client:visible id="faqs" heading="Questions parents ask." items={CAMP_HUB_FAQS} />

    {/* ---------- Cross-links — ink-lift pair ------------------------------ */}
    <section class="band-ink-lift border-t border-rule-on-ink" aria-label="More at Aspire">
      <div class="grid sm:grid-cols-2 gap-px bg-rule-on-ink">
        <div class="bg-ink-lift px-6 sm:px-12 py-11 flex flex-col gap-3">
          <h2 class="display-m">Ready for game day?</h2>
          <p class="body-s text-on-ink-muted max-w-[420px]">
            Youth leagues run by age group from U6 to U19 — developmental seasons where we build the
            teams, and competitive winter play.
          </p>
          <a href="/youth/leagues" data-youth-cta="crosslink-leagues" class="label no-underline pt-1">
            See youth leagues →
          </a>
        </div>
        <div class="bg-ink-lift px-6 sm:px-12 py-11 flex flex-col gap-3">
          <h2 class="display-m">Training that runs all year</h2>
          <p class="body-s text-on-ink-muted max-w-[420px]">
            Small-group classes from 18 months to nineteen years — one pathway, one curriculum, the
            same coaches they'll see at camp.
          </p>
          <a href="/youth/classes" data-youth-cta="crosslink-classes" class="label no-underline pt-1">
            See classes →
          </a>
        </div>
      </div>
    </section>

    {/* ---------- Closer — the orange band --------------------------------- */}
    <section class="band-orange px-6 sm:px-12 py-16" aria-labelledby="youth-camps-close-h">
      <div class="max-w-[1080px] mx-auto flex flex-wrap items-center justify-between gap-8">
        <div class="flex flex-col gap-2.5">
          <h2 id="youth-camps-close-h" class="display-xl" style="font-size:clamp(2.5rem,5vw,4rem)">
            The best week of their year.
          </h2>
          <p class="body-l font-medium text-ink">
            Dates go fast when they drop — grab yours early, or get notified the moment they open.
          </p>
        </div>
        <div class="flex flex-col items-start sm:items-end gap-3">
          <a href="#open" data-youth-cta="camps-close-book" class="btn btn--ink no-underline whitespace-nowrap !text-primary-bright hover:!text-ink">
            Book a camp
          </a>
          <a href="#calendar" data-youth-cta="camps-close-notify" class="label no-underline text-ink border-b-2 border-ink pb-0.5">
            Get notified →
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { track } from "@/lib/analytics/track"

  // Delegated on document (not a one-time querySelectorAll) so CTAs that
  // land in the DOM after this script runs — e.g. a client:load island's
  // async-hydrated markup — still get tracked (classes-page precedent).
  document.addEventListener("click", (e) => {
    const el = e.target instanceof Element ? e.target.closest<HTMLElement>("[data-youth-cta]") : null
    if (!el) return
    track("youth_hub_section_cta_clicked", { section: el.dataset.youthCta ?? "" })
  })
</script>
