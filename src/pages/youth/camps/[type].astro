---
// Camp-type detail page — "what specifically happens at this camp," in the
// Broadsheet (v2) band language. One registry-driven route for the four
// families (schools-out / summer / skills / specialty). The hub carries the
// menu; this page carries the full story: the hour-by-hour day (or the
// named camps, for specialty), who it's for, the logistics, and this
// family's dates from the catalog.
//
// The v1 per-family tone heroes retire (camps-hub precedent): the family is
// carried by content, the chrome is the band system — photo hero + scrim,
// sand/ink/paper alternation, orange closer.
//
// Content contract: everything here renders from CAMP_TYPES — see
// src/lib/youth/camp-page-content.ts for the owner-tuning surface and the
// program-slug seeding contract.
import BaseLayout from "@/layouts/BaseLayout.astro"
import CategoryFinder from "@/components/landing/category-finder.tsx"
import LandingFaq from "@/components/landing/landing-faq.tsx"
import {
  CAMP_TYPES,
  CAMP_DAY_FACTS,
  CAMP_DAY_FACTS_NOTE,
  CAMP_FINDER_EMPTY_BODY,
} from "@/lib/youth/camp-page-content"
import { faqPageJsonLd } from "@/lib/seo/faq-jsonld"
import { setMarketingEdgeCache } from "@/lib/http/edge-cache"

const { type } = Astro.params
const camp = CAMP_TYPES.find((t) => t.slug === type)
if (!camp) {
  // Unknown slug → 404, not a redirect (dead URLs must fall out of the index
  // — adult-soccer-leagues-[suburb].astro precedent).
  return Astro.rewrite("/404")
}
setMarketingEdgeCache(Astro)

const siblings = CAMP_TYPES.filter((t) => t.slug !== camp.slug)

const HERO_IMAGE = "/images/stock/youth-training.jpg"
---

<BaseLayout title={camp.seoTitle} description={camp.heroSub}>
  <Fragment slot="head">
    {/* FAQPage rich-result schema — mirrors this family's LandingFaq items
        rendered below, nothing more (issue #575). Canonical is BaseLayout's. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPageJsonLd(camp.faqs))} />
  </Fragment>
  <main id="main-content" class="flex-1">
    {/* ---------- Hero — photo + scrim; breadcrumb back to the hub --------- */}
    <section class="band-ink relative overflow-hidden">
      <img
        src={HERO_IMAGE}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-[center_30%]"
        style="filter:grayscale(1) contrast(1.08) brightness(.96)"
      />
      <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
      <div class="relative max-w-[1080px] mx-auto px-6 sm:px-12 pt-24 lg:pt-28 pb-[52px] flex flex-col gap-4">
        <p class="label m-0">
          <a href="/youth/camps" class="text-primary-bright no-underline hover:underline">← All camps</a>
        </p>
        <h1 class="display-xl text-on-ink max-w-[760px]" style="font-size:clamp(2.6rem,5.5vw,4.2rem)">
          {camp.name}
        </h1>
        {camp.agesLine && (
          <div class="data text-primary-bright">{camp.agesLine} · Worthington Fieldhouse</div>
        )}
        <p class="body-l text-on-ink-2 max-w-[560px]" style="text-wrap:pretty">{camp.heroSub}</p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#open" data-youth-cta={`camp-${camp.slug}-hero-book`} class="btn btn--primary no-underline">
            See dates &amp; book
          </a>
          <a href="#day" data-youth-cta={`camp-${camp.slug}-hero-day`} class="btn btn--on-ink no-underline">
            {camp.schedule.length > 0 ? "What the day looks like ↓" : "What we run ↓"}
          </a>
        </div>
        <div class="font-mono text-[12px] text-on-ink-2 leading-loose">{camp.windows}</div>
      </div>
    </section>

    {/* ---------- The schedule — timetable, or the named camps ------------- */}
    <section id="day" class="band-sand scroll-mt-24 px-6 sm:px-12 py-16">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <div class="flex flex-col gap-2.5 max-w-[640px]">
          <h2 class="display-l">{camp.scheduleHeading}</h2>
          <p class="body-copy text-on-sand-2">{camp.scheduleLede}</p>
        </div>

        {
          camp.schedule.length > 0 ? (
            // A real <table> — the timetable is genuinely tabular (time /
            // activity), and row/header association is what screen readers
            // get from table semantics that a div grid can't give (issue
            // #576). Times are VALUES → mono in --primary-text (the mono
            // rule); the header row is visually hidden but read aloud.
            <div class="border-[1.5px] border-ink bg-paper overflow-hidden">
              <table class="w-full border-collapse">
                <caption class="sr-only">{camp.scheduleHeading}</caption>
                <thead class="sr-only">
                  <tr>
                    <th scope="col">Time</th>
                    <th scope="col">What happens</th>
                  </tr>
                </thead>
                <tbody>
                  {camp.schedule.map((row) => (
                    <tr class="border-b border-rule last:border-b-0 even:bg-sand">
                      <th
                        scope="row"
                        class="align-baseline text-left font-mono text-[13px] text-primary-text font-medium pl-6 pr-0 py-4 sm:w-[150px] whitespace-nowrap"
                      >
                        {row.time}
                      </th>
                      <td class="align-baseline px-6 py-4">
                        <span class="font-semibold text-[15px] text-on-sand">{row.what}</span>
                        <span class="block text-[13px] text-on-sand-muted mt-0.5">{row.why}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
              {camp.namedCamps.map((c) => (
                <div class="step-card step-card--invert flex flex-col gap-2">
                  <h3 class="display-s m-0">{c.name}</h3>
                  <div class="data text-primary-bright">{c.hook}</div>
                  <p class="body-s text-on-ink-2 m-0">{c.blurb}</p>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </section>

    {/* ---------- Who it's for — ink band, accent quadrant grid ------------ */}
    <section class="band-ink px-6 sm:px-12 py-16">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <h2 class="display-l">Who it's for</h2>
        <div class="quadrants quadrants--accent grid-cols-1 sm:grid-cols-3">
          {
            camp.whoCards.map((c) => (
              <div class="flex flex-col gap-2 p-6">
                <div class="font-black text-[19px] uppercase" style="font-stretch:84%">{c.title}</div>
                <div class="label text-on-ink-muted" style="font-size:0.65rem">{c.label}</div>
                <p class="body-s text-on-ink-muted m-0">{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- Know before you book — shared facts, one constant -------- */}
    <section class="band-paper border-b border-rule px-6 sm:px-12 pt-14 pb-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <h2 class="display-l">Know before you book</h2>
        <div class="grid gap-x-8 gap-y-[26px]" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
          {
            CAMP_DAY_FACTS.map((f) => (
              <div>
                <div class="label text-on-sand-muted">{f.label}</div>
                {/* Times are VALUES → mono; phrases and names stay sans (the
                    mono rule; digit-discriminated, camps-hub precedent). */}
                <div
                  class:list={[
                    "mt-1.5 leading-tight text-on-sand",
                    /\d/.test(f.value) ? "font-mono text-[15px]" : "font-semibold text-[16px]",
                  ]}
                >
                  {f.value}
                </div>
              </div>
            ))
          }
        </div>
        <p class="text-[13px] text-on-sand-muted m-0">{CAMP_DAY_FACTS_NOTE}</p>
      </div>
    </section>

    {/* ---------- Dates & booking — this family only ----------------------- */}
    <section id="open" class="band-sand scroll-mt-24 px-6 sm:px-12 py-16">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-6">
        <div class="flex flex-col gap-2.5 max-w-[640px]">
          <h2 class="display-l">Dates &amp; booking</h2>
          <p class="body-copy text-on-sand-2">
            Live from the catalog — cards appear the moment a camp opens.
          </p>
        </div>
        <CategoryFinder
          client:load
          audience="youth"
          programTypes={["camp"]}
          programSlugs={camp.programSlugs}
          title={`Open ${camp.name.toLowerCase()}`}
          descriptor="Every camp shows its dates, ages, venue and price on the card."
          ageChips
          sectionId={`youth-camps-${camp.slug}`}
          cardVariant="youth-band"
          headerHidden
          emptyBody={CAMP_FINDER_EMPTY_BODY}
        />
      </div>
    </section>

    {/* ---------- Family FAQ ------------------------------------------------ */}
    <LandingFaq client:visible id="faqs" heading="Questions parents ask." items={camp.faqs} />

    {/* ---------- The other camps — ink-lift grid --------------------------- */}
    <section class="band-ink-lift border-t border-rule-on-ink" aria-label="The other camps">
      <div class="grid sm:grid-cols-3 gap-px bg-rule-on-ink">
        {
          siblings.map((s) => (
            <a
              href={`/youth/camps/${s.slug}`}
              data-youth-cta={`camp-${camp.slug}-other-${s.slug}`}
              class="relative bg-ink-lift px-6 sm:px-10 py-9 no-underline block"
            >
              <h3 class="display-s text-on-ink m-0">{s.name}</h3>
              <div class="data text-on-ink-muted mt-1.5">{s.tileMeta}</div>
              <span class="absolute right-5 bottom-4 font-bold text-lg text-on-ink-2" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </section>

    {/* ---------- Closer — the orange band ---------------------------------- */}
    <section class="band-orange px-6 sm:px-12 py-16" aria-labelledby={`camp-${camp.slug}-close-h`}>
      <div class="max-w-[1080px] mx-auto flex flex-wrap items-center justify-between gap-8">
        <div class="flex flex-col gap-2.5">
          <h2 id={`camp-${camp.slug}-close-h`} class="display-xl" style="font-size:clamp(2.5rem,5vw,4rem)">
            {camp.closeHeading}
          </h2>
          <p class="body-l font-medium text-ink">{camp.closeSub}</p>
        </div>
        <div class="flex flex-col items-start sm:items-end gap-3">
          <a href="#open" data-youth-cta={`camp-${camp.slug}-close-book`} class="btn btn--ink no-underline whitespace-nowrap !text-primary-bright hover:!text-ink">
            See dates
          </a>
          <a href="/youth/camps" data-youth-cta={`camp-${camp.slug}-close-all`} class="label no-underline text-ink border-b-2 border-ink pb-0.5">
            All camps →
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { track } from "@/lib/analytics/track"

  // Delegated so island-hydrated CTAs still get tracked (classes precedent).
  document.addEventListener("click", (e) => {
    const el = e.target instanceof Element ? e.target.closest<HTMLElement>("[data-youth-cta]") : null
    if (!el) return
    track("youth_hub_section_cta_clicked", { section: el.dataset.youthCta ?? "" })
  })
</script>
