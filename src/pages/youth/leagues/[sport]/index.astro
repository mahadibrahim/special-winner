---
// Youth sport league landing page — one dynamic route for every sport in the
// registry (/youth/leagues/soccer, /youth/leagues/futsal, …). The former
// static soccer/ and futsal/ copies differed only in slug, hero copy and SEO
// metadata, all of which now come from YOUTH_LEAGUE_SPORTS; everything
// structural lives in YouthSportLeaguePage.
//
// Unknown sport → the soccer page, completing the degradation chain the
// deeper routes already follow: unknown division → term page, empty term →
// sport page, unknown sport → soccer. Every step lands on a real page.
// (Straight to /youth/leagues/soccer, not /youth/leagues — that URL is itself
// a 302 to soccer now, and a double hop is a wasted round trip.)
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import YouthSportLeaguePage from "@/components/youth/youth-sport-league-page.astro";
import { breadcrumbJsonLd } from "@/lib/seo/breadcrumbs";
import { getYouthLeagueSport } from "@/lib/leagues/youth-sports";
import { YOUTH_LEAGUE_FAQS } from "@/lib/leagues/youth-league-content";
import { fetchYouthLeaguePageData } from "@/lib/leagues/youth-league-page-data";
import { setMarketingEdgeCache } from "@/lib/http/edge-cache";

const sport = getYouthLeagueSport(Astro.params.sport);
if (!sport) {
  return Astro.redirect("/youth/leagues/soccer");
}

const ORIGIN = import.meta.env.PUBLIC_APP_URL || "https://aspiresportsohio.com";
// Breadcrumbs mirror the URL's real navigable ancestors. /youth/leagues has
// been a 302 to the soccer page since 2026-08-18 (two-path recompose), so it
// is no longer one — a BreadcrumbList tier pointing at a redirect is a crumb
// Google resolves away. The youth ancestor is /youth, already the tier above,
// so the leagues tier is dropped rather than duplicated. Matches the chain in
// DivisionPageLayout.astro and [term].astro: / → /youth → sport → term.
const breadcrumbSchema = breadcrumbJsonLd([
  { name: "Home", url: `${ORIGIN}/` },
  { name: "Youth", url: `${ORIGIN}/youth` },
  { name: sport.name, url: `${ORIGIN}/youth/leagues/${sport.slug}` },
]);
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: YOUTH_LEAGUE_FAQS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

// The catalog read lives in PAGE frontmatter, not inside YouthSportLeaguePage:
// response headers are already flushed by the time a child component renders,
// so a setMarketingEdgeCache call down there silently no-ops.
const data = await fetchYouthLeaguePageData({
  origin: Astro.url.origin,
  cookie: Astro.request.headers.get("cookie") ?? "",
  sportSlug: sport.slug,
});

// Last statement, per setMarketingEdgeCache's contract: only opt into edge
// caching once the catalog fetch succeeded, so a transient failure (which
// suppresses the banner and the inline rows) is never the response that gets
// cached and served.
if (data.catalogOk) setMarketingEdgeCache(Astro);
---

<BaseLayout
  title={`Youth ${sport.name} Leagues — Aspire Sports`}
  description={sport.metaDescription}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <YouthSportLeaguePage sportSlug={sport.slug} heroTitle={sport.heroTitle} data={data} />
</BaseLayout>
