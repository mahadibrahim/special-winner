---
// Youth classes — Broadsheet (v2) band conversion. The home of the training
// pathway: where the league pages are facts pages (which group, what's open,
// when, where), this page sells coaching, because in a class the coaching IS
// the product. That split is an explicit owner decision: the Director of
// Coaching is prominent here and on camps, never on league surfaces.
//
// Band composition follows the design canvas "Aspire Classes & Camps",
// option 2a (the reference page that produced the Broadsheet system — see
// docs/design-system.md "Band rhythm"): product row (ink-lift) → hero
// (photo + scrim) → in-page nav (orange) → pathway (sand) → philosophy
// (ink) → what it's like (sand) → coaching (ink) → pricing (sand) →
// schedule (paper) → open classes (sand) → FAQs → cross-links (ink-lift) →
// closer (orange). Deviations from the canvas, on purpose:
//   - Pricing and schedule stay LIVE ISLANDS (ClassPurchaseLadder /
//     ClassSchedule) — the canvas's static membership band carries
//     placeholder rates, and the owner-decided contract (2026-08-18) is
//     rate-card-driven, never invented figures. The page is edge-cached
//     marketing HTML (setMarketingEdgeCache), so live pricing/capacity can
//     only live in the client.
//   - FAQs keep the LandingFaq accordion (a11y + interaction already built,
//     and the canvas's decorative FAQ numerals lose to the doc's numeral
//     rule anyway). Its light band keeps the rhythm legal: sand → sand →
//     ink-lift → orange.
//   - The canvas's per-step detail bands are dropped — 2a carries the
//     pathway in the step cards alone.
//
// Copy rules (owner-directed): no oppositional language, facility not a
// selling point, no format claims, pricing indicative only except where a
// card states today's true model. Pathway names are locked — see
// docs/superpowers/specs/2026-08-17-youth-pathway-naming-decision.md.
import BaseLayout from "@/layouts/BaseLayout.astro"
import CategoryFinder from "@/components/landing/category-finder.tsx"
import TileFactsLine from "@/components/landing/tile-facts-line"
import LandingFaq, { type LandingFaqItem } from "@/components/landing/landing-faq.tsx"
import ClassSchedule from "@/components/youth/class-schedule"
import TrialBooking from "@/components/youth/trial-booking"
import ClassPurchaseLadder from "@/components/youth/class-purchase-ladder"
import { PATHWAY, COACH, SPORTS } from "@/lib/youth/landing-content"
import { faqPageJsonLd } from "@/lib/seo/faq-jsonld"
import { setMarketingEdgeCache } from "@/lib/http/edge-cache"

const HERO_IMAGE = "/images/stock/youth-training.jpg"
setMarketingEdgeCache(Astro)

// Split COACH.quote on the emphasis phrase so it can carry the canvas's
// orange <em> — same approach as youth-coach-section.astro (which camps
// still renders; this page carries its own Broadsheet coaching band).
const EMPHASIS = "full potential"
const quoteParts = COACH.quote.split(EMPHASIS)

const NAV_ITEMS = [
  { href: "#pathway", label: "Pathway" },
  { href: "#philosophy", label: "Philosophy" },
  { href: "#feel", label: "What it's like" },
  { href: "#coach", label: "Coaching" },
  { href: "#pricing", label: "Pricing" },
  { href: "#schedule", label: "Schedule" },
  { href: "#open", label: "Book" },
  { href: "#faqs", label: "FAQs" },
]

// Philosophy quadrants (canvas 2a / quadrant grid). No numerals — the
// design system's numeral rule retires the numbered loop-step cards.
const QUADRANTS = [
  {
    title: "It's written down",
    body: "Every group's sessions come from one curriculum, authored by our Director of Coaching — not whatever tonight's coach feels like running.",
  },
  {
    title: "Coaches train on it",
    body: "Your kid's coach is trained on that curriculum, so a session means the same thing whichever night you come.",
  },
  {
    title: "Kids stay in the game",
    body: "Small groups and small-sided play — the whole session is touches and decisions, not waiting in line.",
  },
  {
    title: "You see the progress",
    body: "After sessions, coaches share what clicked and what's next — so progress is something you watch, not something you take on faith.",
  },
]

// "What a class here feels like" (canvas 2a three-up).
const FEEL_CARDS = [
  {
    label: "The group",
    statement: "Small enough that nobody waits",
    body: "Small groups and small-sided play — the whole session is touches, not lines.",
  },
  {
    label: "The coaching",
    statement: "Explained while it happens",
    body: "Coaches talk kids through the game in the moment, not just at the end.",
  },
  {
    label: "The feedback",
    statement: "Praised for the right things",
    body: "Specific praise for real effort — confidence built on what they can actually do.",
  },
]

// FAQ copy carried over unchanged — the cost answer describes the real
// block-pricing model, not the canvas's placeholder annual-fee sample.
const faqs: LandingFaqItem[] = [
  {
    question: "What age can my kid start?",
    answer:
      "At 18 months, in Aspire Micros — you're on the floor with them. From age 3 they train without you.",
  },
  {
    question: "How do they move up?",
    answer: "On their coach's word, when they're ready — there's no tryout between steps.",
  },
  {
    question: "What days do classes run?",
    answer:
      "Sessions run throughout the week — every class card above shows its day and time, next to what's open.",
  },
  {
    question: "Where are classes held?",
    answer:
      "Today's classes meet at the Worthington Fieldhouse — serving families across Worthington, Powell, Dublin, Westerville and north Columbus. Every class card shows its venue.",
  },
  {
    question: "Do classes run all year?",
    answer:
      "Yes — the pathway runs year-round, and a monthly membership carries straight across, so there's never a season where your kid has nowhere to train.",
  },
  {
    question: "What does it cost?",
    answer:
      "There's no single price — you pick how much you commit, and every option carries its own price on the card before you book. Your first class is a free trial for new families, and a monthly membership covers a set number of classes each month; depending on what's scheduled you can also buy a pack of classes, take a block (a fixed run of weeks on the same night), or pay for one class and just come once. The pricing section on this page lists everything that's open right now. Nothing is quoted over the phone.",
  },
  {
    question: "Do I have to commit to a block?",
    answer:
      "No — a block is one option, never the only one. Plenty of families are on a monthly membership instead, and the pricing section on this page shows every way in that's open right now. If you do join a block part-way through, you only pay for the weeks that are left.",
  },
]

const PRODUCT_ROW = [
  { href: "/youth/classes", label: "Classes", sub: "Weekly training, all year · 18mo–19", active: true },
  { href: "/youth/camps", label: "Camps", sub: "School breaks & summer weeks", active: false },
  { href: "/youth/leagues", label: "Leagues", sub: "Game-day seasons · U6–U19", active: false },
]
---

<BaseLayout
  title="Youth Sports Classes in Columbus & Worthington, Ohio — Aspire Sports"
  description="Youth sports classes in Columbus and Worthington, Ohio for 18 months to 19 years — small groups, real coaching, one pathway. See what's open and book online."
>
  <Fragment slot="head">
    {/* FAQPage rich-result schema — mirrors the LandingFaq items rendered
        below, nothing more (issue #575). Canonical comes from BaseLayout. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPageJsonLd(faqs))} />
  </Fragment>

  <main id="main-content" class="flex-1">
    {/* ---------- Youth product row — ink-lift band under the header ------ */}
    {/* pt clears the fixed site header (h-16 lg:h-20) — this band is the
        page's first content and would otherwise start underneath it. */}
    <nav aria-label="Youth programs" class="band-ink-lift border-b border-rule-on-ink pt-16 lg:pt-20">
      <div class="grid grid-cols-3 gap-px bg-rule-on-ink">
        {
          PRODUCT_ROW.map((p) => (
            <a
              href={p.href}
              aria-current={p.active ? "page" : undefined}
              class:list={[
                "flex flex-col gap-0.5 px-5 sm:px-10 py-[15px] no-underline",
                p.active ? "bg-ink-lift shadow-[inset_0_-3px_0_var(--primary)]" : "bg-ink",
              ]}
            >
              <span class="label text-on-ink">{p.label}</span>
              <span class="hidden sm:block text-[13px] text-on-ink-muted">{p.sub}</span>
            </a>
          ))
        }
      </div>
    </nav>

    {/* ---------- Hero — photo, ink scrim, display-xl ---------------------- */}
    <section class="relative bg-ink-deep overflow-hidden">
      <img
        src={HERO_IMAGE}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-[center_30%]"
        style="filter:grayscale(1) contrast(1.08) brightness(.96)"
      />
      <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
      <div class="relative max-w-[1080px] mx-auto px-6 sm:px-12 py-20 sm:py-[88px] flex flex-col gap-5">
        <h1 class="display-xl text-on-ink max-w-[760px]">
          Their first coach is the one that counts.
        </h1>
        <p class="body-l text-on-ink-2 max-w-[520px]" style="text-wrap:pretty">
          Small-group classes from <strong class="font-bold text-on-ink">18 months to nineteen years</strong>
          — a coach who explains, and one pathway so your kid never has to start over.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#open" data-youth-cta="hero-open" class="btn btn--primary no-underline">See what's open</a>
          <a href="#philosophy" data-youth-cta="hero-philosophy" class="btn btn--on-ink no-underline">
            How we develop players
          </a>
        </div>
      </div>
    </section>

    {/* ---------- In-page nav — the orange band, sticky ------------------- */}
    {/* Sticks just below the fixed site header (h-16 lg:h-20). */}
    <nav aria-label="On this page" class="inpage-nav sticky top-16 lg:top-20 z-40 overflow-x-auto px-2 sm:px-6">
      {NAV_ITEMS.map((item) => <a href={item.href} data-jump-link class="no-underline text-ink hover:text-ink">{item.label}</a>)}
      <a href="#schedule" data-youth-cta="nav-free-trial" class="ml-auto font-extrabold no-underline text-ink hover:text-ink">
        First class free ↗
      </a>
    </nav>

    {/* ---------- Pathway — five locked steps, step cards ------------------ */}
    <section id="pathway" class="band-sand scroll-mt-36 px-6 sm:px-12 py-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <div class="flex flex-col gap-2.5 max-w-[600px]">
          <h2 class="display-l">Five steps, one pathway</h2>
          <p class="body-copy text-on-sand-2">
            Every kid enters where they are and moves up when they're ready — on their coach's word,
            not a tryout's.
          </p>
        </div>
        <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
          {
            PATHWAY.map((step, i) => {
              const invert = i === PATHWAY.length - 1
              return (
                <div class:list={["step-card flex flex-col gap-2.5", invert && "step-card--invert"]}>
                  <h3 class="display-s">{step.name.replace("Aspire ", "")}</h3>
                  <div class:list={["data", invert ? "text-primary-bright" : "text-primary-text"]}>
                    {step.ages}
                  </div>
                  <p class:list={["body-s", invert ? "text-on-ink-2" : "text-on-sand-2"]}>{step.blurb}</p>
                </div>
              )
            })
          }
        </div>
      </div>
    </section>

    {/* ---------- Philosophy — ink band, accent quadrant grid -------------- */}
    <section id="philosophy" class="band-ink scroll-mt-36 px-6 sm:px-12 py-16">
      <div class="max-w-[1080px] mx-auto grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="flex flex-col gap-4">
          <h2 class="display-l">Development here is a system, not a vibe</h2>
          <p class="body-copy text-on-ink-2">
            The same written curriculum runs every group on the pathway, so what your kid learns on
            Tuesday builds on what they learned last month — and follows them up every step.
          </p>
          <a href="/youth/philosophy" data-youth-cta="philosophy-full" class="label no-underline pt-1.5">
            Read the full development philosophy →
          </a>
        </div>
        <div class="quadrants quadrants--accent grid-cols-1 sm:grid-cols-2">
          {
            QUADRANTS.map((q) => (
              <div class="flex flex-col gap-2 p-6">
                <div class="font-black text-[19px] uppercase" style="font-stretch:84%">{q.title}</div>
                <p class="body-s text-on-ink-muted">{q.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- What it's like — sand band, three ruled cards ------------ */}
    <section id="feel" class="band-sand scroll-mt-36 px-6 sm:px-12 py-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <h2 class="display-l max-w-[620px]">What a class here feels like</h2>
        <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
          {
            FEEL_CARDS.map((c) => (
              <div class="bg-paper border-l-[5px] border-ink px-6 py-7 flex flex-col gap-2.5">
                <div class="label text-primary-text">{c.label}</div>
                <div class="display-s" style="font-size:1.5rem">{c.statement}</div>
                <p class="text-[15px] leading-relaxed text-on-sand-2">{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- Coaching — ink band, DoC. The quote is owner-commissioned
        (2026-08-18, COACH.quote) and renders as a real quotation. Camps
        still renders the shared YouthCoachSection; this page carries its
        own Broadsheet composition of the same COACH source. ---------------- */}
    <section id="coach" class="band-ink scroll-mt-36 px-6 sm:px-12 py-16" aria-labelledby="classes-coach-h">
      <div class="max-w-[1080px] mx-auto grid gap-12 lg:grid-cols-[0.62fr_1fr] items-start">
        <div class="flex flex-col">
          <img
            src="/images/staff/saad-abdul-salaam.webp"
            alt={`${COACH.name}, ${COACH.role}`}
            class="w-full h-[380px] object-cover object-top"
            style="filter:grayscale(1) contrast(1.08) brightness(.96)"
            loading="lazy"
          />
          <div class="bg-primary-bright px-5 py-4 flex flex-col gap-0.5">
            <div class="display-s text-ink">{COACH.name}</div>
            <div class="text-[13px] font-bold text-ink/70">
              {COACH.role}{SPORTS.length > 1 ? ` — ${COACH.sport}` : ""}
            </div>
          </div>
        </div>
        <div class="flex flex-col gap-6">
          <h2 id="classes-coach-h" class="display-l">How we coach</h2>
          <blockquote class="text-2xl leading-snug font-medium text-on-ink m-0" style="text-wrap:pretty">
            “{quoteParts.length === 2 ? (
              <>
                {quoteParts[0]}<em class="text-primary-bright">{EMPHASIS}</em>{quoteParts[1]}
              </>
            ) : (
              COACH.quote
            )}”
          </blockquote>
          {/* Credential grid — the one numeral-bearing block on the page:
              these counts ARE the information (the numeral rule's carve-out). */}
          <div class="quadrants grid-cols-2 sm:grid-cols-4">
            {
              COACH.credits.map((c) => (
                <div class="flex flex-col gap-1 p-4">
                  <div class="font-black text-[32px] leading-none text-primary-bright whitespace-nowrap" style="font-stretch:78%">
                    {c.value}
                  </div>
                  <div class="label text-on-ink-muted" style="font-size:0.6875rem">{c.label}</div>
                </div>
              ))
            }
          </div>
          <p class="text-[15px] leading-relaxed text-on-ink-muted" style="text-wrap:pretty">{COACH.bio}</p>
        </div>
      </div>
    </section>

    {/* ---------- Pricing — the purchase ladder, rate-card-driven ----------
        Owner-decided contract (2026-08-18): this band is rate-card-driven,
        never invented figures — which is also why the canvas's static
        membership band (placeholder rates) is NOT reproduced here.
        ClassPurchaseLadder fetches the packs / block / tiers / schedule
        catalogs client-side and renders one rung per way into a class, each
        with its own wired checkout. Must be an island: the page is
        edge-cached marketing HTML (setMarketingEdgeCache above). */}
    <section id="pricing" class="band-sand scroll-mt-36 px-6 sm:px-12 py-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <div class="flex flex-col gap-2.5 max-w-[640px]">
          {/* Neutral by design: the header must not COUNT or NAME the doors —
              rungs only exist when the catalog carries them. The island
              prints the real enumeration under this lede. */}
          <h2 class="display-l">Pick your commitment</h2>
          <p class="body-copy text-on-sand-2">
            Start wherever it suits you and change your mind later — every option below carries its
            own price on the card, before you book.
          </p>
        </div>
        <ClassPurchaseLadder client:load />
      </div>
    </section>

    {/* ---------- This week's classes — live schedule ----------------------
        Live slot/capacity data must live in the island, not the frontmatter
        (edge-cached page) — see ClassSchedule's doc comment. --------------- */}
    <section id="schedule" class="band-paper scroll-mt-36 border-t border-rule px-6 sm:px-12 py-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <div class="flex flex-col gap-2.5 max-w-[560px]">
          <h2 class="display-l">This week's classes</h2>
          <p class="body-copy text-on-sand-2">
            Every open slot for the week, with what's left to book — pick one below.
          </p>
        </div>
        <ClassSchedule client:load />
      </div>
    </section>

    {/* ---------- Open classes — sand band, live finder -------------------- */}
    <section id="open" class="band-sand scroll-mt-36 px-6 sm:px-12 py-[60px]">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-6">
        <div class="flex flex-col gap-2.5 max-w-[600px]">
          <h2 class="display-l">Open classes</h2>
          <p class="body-copy text-on-sand-2">Every class shows its dates, venue and price on the card.</p>
          {/* Live status line, computed client-side from the catalog (edge-
              cached page); scoped to this page's open-classes query so it
              always agrees with the finder below. */}
          <TileFactsLine client:visible audience="youth" programTypes={["training", "clinic"]} tone="ink" />
        </div>
        <CategoryFinder
          client:load
          audience="youth"
          programTypes={["training", "clinic"]}
          title="Open classes"
          descriptor="Every class shows its dates, venue and price on the card."
          ageChips
          sectionId="open-classes"
          cardVariant="youth-band"
          headerHidden
        />
      </div>
    </section>

    {/* ---------- FAQs — LandingFaq accordion (kept over the canvas's static
        numbered list: interaction + a11y already built, and the decorative
        numerals lose to the numeral rule). Orange accent per the canvas —
        the Broadsheet page accent. -------------------------------------- */}
    <LandingFaq client:visible id="faqs" heading="Questions parents ask." items={faqs} />

    {/* ---------- Cross-links — ink-lift pair ------------------------------ */}
    <section class="band-ink-lift border-t border-rule-on-ink" aria-label="More at Aspire">
      <div class="grid sm:grid-cols-2 gap-px bg-rule-on-ink">
        <div class="bg-ink-lift px-6 sm:px-12 py-11 flex flex-col gap-3">
          <h2 class="display-m">Ready for game day?</h2>
          <p class="body-s text-on-ink-muted max-w-[420px]">
            Youth leagues run by age group from U6 to U19 — developmental seasons where we build the
            teams, and competitive winter play.
          </p>
          <a href="/youth/leagues" data-youth-cta="crosslink-leagues" class="label no-underline pt-1">
            See youth leagues →
          </a>
        </div>
        <div class="bg-ink-lift px-6 sm:px-12 py-11 flex flex-col gap-3">
          <h2 class="display-m">Camps, all year long</h2>
          <p class="body-s text-on-ink-muted max-w-[420px]">
            Day camps on school breaks, plus specialty camps through the year — coached rather than
            supervised, by the same people they see all year.
          </p>
          <a href="/youth/camps" data-youth-cta="crosslink-camps" class="label no-underline pt-1">
            See camp dates →
          </a>
        </div>
      </div>
    </section>

    {/* ---------- Closer — the orange band --------------------------------- */}
    <section class="band-orange px-6 sm:px-12 py-16" aria-labelledby="youth-classes-close-h">
      <div class="max-w-[1080px] mx-auto flex flex-wrap items-center justify-between gap-8">
        <div class="flex flex-col gap-2.5">
          <h2 id="youth-classes-close-h" class="display-xl" style="font-size:clamp(2.5rem,5vw,4rem)">
            Ready when they are.
          </h2>
          <p class="body-l font-medium text-ink">Find their group and book — it takes a few minutes.</p>
        </div>
        <a href="#open" data-youth-cta="close-book" class="btn btn--ink no-underline whitespace-nowrap !text-primary-bright hover:!text-ink">
          Book a class
        </a>
      </div>
    </section>

    {/* ---------- Free trial booking modal --------------------------------
        Its own island, mounted once at the page level — it listens for the
        `youth:trial-requested` CustomEvent that ClassSchedule's "Book a
        free trial" CTAs dispatch on window, so where it mounts doesn't
        matter; it renders nothing until that event fires. ----------------- */}
    <TrialBooking client:load />
  </main>
</BaseLayout>

<script>
  import { track } from "@/lib/analytics/track"

  // Delegated on document (not a one-time querySelectorAll) so CTAs that
  // land in the DOM after this script runs — e.g. a client:load island's
  // async-hydrated markup — still get tracked.
  document.addEventListener("click", (e) => {
    const el = e.target instanceof Element ? e.target.closest<HTMLElement>("[data-youth-cta]") : null
    if (!el) return
    track("youth_hub_section_cta_clicked", { section: el.dataset.youthCta ?? "" })
  })
</script>
