---
/**
 * Baseball Coaching Guide
 * Print-ready comprehensive coaching reference
 */
import '../../styles/print-guide.css';
import { db } from '../../lib/db';
import { skills, skillDomains, developmentStages } from '../../lib/db/schema/curriculum';
import { sports } from '../../lib/db/schema/sports';
import { eq, and } from 'drizzle-orm';
import { coachingPhilosophy, sportSpecificNotes, programStructures } from '../../data/coaching-philosophy';

// Fetch baseball skills from database
const [baseball] = await db.select().from(sports).where(eq(sports.slug, 'baseball'));

const baseballSkills = baseball ? await db.query.skills.findMany({
  where: and(
    eq(skills.sportId, baseball.id),
    eq(skills.active, true)
  ),
  with: {
    domain: true,
    stage: true,
  },
  orderBy: (skills, { asc }) => [asc(skills.sortOrder)],
}) : [];

// Group skills by domain
const skillsByDomain = baseballSkills.reduce((acc, skill) => {
  const domain = skill.domain?.name || 'other';
  if (!acc[domain]) acc[domain] = [];
  acc[domain].push(skill);
  return acc;
}, {} as Record<string, typeof baseballSkills>);

const domainOrder = ['technical', 'tactical', 'physical', 'psychological'];
const domainDisplayNames: Record<string, string> = {
  technical: 'Technical Skills',
  tactical: 'Tactical Understanding',
  physical: 'Physical Development',
  psychological: 'Psychological Growth',
};

const sport = sportSpecificNotes.baseball;
const philosophy = coachingPhilosophy;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Baseball Coaching Guide | Aspire Sports</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="preview-mode">
    <article class="coaching-guide guide-baseball">

      <!-- COVER PAGE -->
      <section class="guide-cover">
        <!-- Aspire Sports Logo -->
        <img
          src="/images/logo.svg"
          alt="Aspire Sports"
          class="guide-cover-logo"
        />

        <!-- Sport Badge -->
        <div class="guide-cover-sport-badge">
          {sport.icon} Baseball
        </div>

        <!-- Title -->
        <h1 class="guide-cover-title">
          Coaching<br />Guide
        </h1>
        <p class="guide-cover-subtitle">
          Complete Development Reference
        </p>

        <!-- Tagline Box -->
        <div class="guide-cover-description">
          <p class="guide-cover-tagline">
            A research-based approach to youth baseball development
            emphasizing skill, character, and love of the game.
          </p>
        </div>

        <!-- Footer -->
        <div class="guide-cover-footer">
          <p class="guide-cover-brand">
            Development-Focused Youth Athletics
          </p>
          <p class="guide-cover-edition">
            {currentYear} Edition
          </p>
        </div>
      </section>

      <!-- TABLE OF CONTENTS -->
      <section class="guide-section">
        <h2 class="guide-h2" style={`color: ${sport.primaryColor}; border-color: ${sport.primaryColor}`}>
          Contents
        </h2>
        <nav style="font-size: 11pt; line-height: 2.4;">
          <ol style="list-style: none; padding: 0; margin: 0;">
            <!-- Part 1: Philosophy -->
            <li style="margin-top: 1em;">
              <span class="guide-mono" style="font-size: 9pt; color: var(--ink-light); text-transform: uppercase; letter-spacing: 0.1em;">Part One: Coaching Philosophy</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>1. Core Beliefs</span>
              <span class="guide-mono" style="color: var(--ink-light);">4</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>2. The Double-Goal Coach</span>
              <span class="guide-mono" style="color: var(--ink-light);">6</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>3. The ELM Framework</span>
              <span class="guide-mono" style="color: var(--ink-light);">8</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>4. Age-Appropriate Development</span>
              <span class="guide-mono" style="color: var(--ink-light);">10</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>5. Arm Care Guidelines</span>
              <span class="guide-mono" style="color: var(--ink-light);">12</span>
            </li>

            <!-- Part 2: Skills -->
            <li style="margin-top: 1.5em;">
              <span class="guide-mono" style="font-size: 9pt; color: var(--ink-light); text-transform: uppercase; letter-spacing: 0.1em;">Part Two: Skills Reference</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>6. Technical Skills</span>
              <span class="guide-mono" style="color: var(--ink-light);">14</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>7. Tactical Skills</span>
              <span class="guide-mono" style="color: var(--ink-light);">20</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>8. Physical Development</span>
              <span class="guide-mono" style="color: var(--ink-light);">26</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>9. Psychological Growth</span>
              <span class="guide-mono" style="color: var(--ink-light);">32</span>
            </li>

            <!-- Part 3: Programs -->
            <li style="margin-top: 1.5em;">
              <span class="guide-mono" style="font-size: 9pt; color: var(--ink-light); text-transform: uppercase; letter-spacing: 0.1em;">Part Three: Program Structures</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>10. Recreational League Season</span>
              <span class="guide-mono" style="color: var(--ink-light);">38</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>11. Skills Development Classes</span>
              <span class="guide-mono" style="color: var(--ink-light);">44</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>12. Childcare Programs</span>
              <span class="guide-mono" style="color: var(--ink-light);">50</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>13. Summer Camps</span>
              <span class="guide-mono" style="color: var(--ink-light);">56</span>
            </li>

            <!-- Part 4: Resources -->
            <li style="margin-top: 1.5em;">
              <span class="guide-mono" style="font-size: 9pt; color: var(--ink-light); text-transform: uppercase; letter-spacing: 0.1em;">Part Four: Resources</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>14. Session Planning</span>
              <span class="guide-mono" style="color: var(--ink-light);">62</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>15. Parent Communication</span>
              <span class="guide-mono" style="color: var(--ink-light);">66</span>
            </li>
            <li style="display: flex; justify-content: space-between; border-bottom: 1px dotted #e5e5e5; padding: 0.35em 0; padding-left: 1em;">
              <span>16. Quick Reference Cards</span>
              <span class="guide-mono" style="color: var(--ink-light);">70</span>
            </li>
          </ol>
        </nav>

        <div class="guide-box guide-box-accent" style="margin-top: 2em;">
          <p class="guide-box-title">Baseball-Specific Philosophy</p>
          <p class="guide-body" style="margin: 0; font-style: italic;">
            "{sport.keyPhilosophy}"
          </p>
          <ul class="guide-list" style="margin-top: 1em;">
            {sport.uniqueConsiderations.map(consideration => (
              <li>{consideration}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- PART ONE: COACHING PHILOSOPHY - SECTION DIVIDER -->
      <section class="section-divider">
        <p class="section-divider-number">Part One</p>
        <h1 class="section-divider-title">Coaching<br/>Philosophy</h1>
        <p class="section-divider-subtitle">
          The principles, frameworks, and age-appropriate strategies that guide
          development-focused youth coaching.
        </p>
        <div class="section-divider-icon">{sport.icon}</div>
      </section>

      <!-- SECTION 1: CORE BELIEFS -->
      <section class="guide-section">
        <h2 class="guide-h2" style={`color: ${sport.primaryColor}; border-color: ${sport.primaryColor}`}>
          1. Core Beliefs
        </h2>

        <p class="guide-lead">
          Great youth coaches understand that their role extends far beyond teaching
          skills. They shape young athletes' relationship with sport—and often with
          challenge, effort, and perseverance itself.
        </p>

        {philosophy.coreBeliefs.map(belief => (
          <div class="avoid-break" style="margin-bottom: 1.5em;">
            <h3 class="guide-h3">{belief.title}</h3>
            <p class="guide-body">{belief.description}</p>
            <div class="guide-pullquote" style={`border-color: ${sport.primaryColor}; color: ${sport.primaryColor}`}>
              {belief.quote}
            </div>
          </div>
        ))}
      </section>

      <!-- SECTION 2: DOUBLE-GOAL COACH -->
      <section class="guide-section">
        <h2 class="guide-h2" style={`color: ${sport.primaryColor}; border-color: ${sport.primaryColor}`}>
          2. {philosophy.doubleGoalCoach.title}
        </h2>
        <p class="guide-h4" style="color: var(--ink-medium); margin-bottom: 1em;">
          {philosophy.doubleGoalCoach.subtitle}
        </p>

        <p class="guide-body" style="white-space: pre-line;">
          {philosophy.doubleGoalCoach.description}
        </p>

        <div class="guide-columns" style="margin-top: 1.5em;">
          {philosophy.doubleGoalCoach.principles.map(principle => (
            <div class="guide-box avoid-break">
              <h4 class="guide-h4" style={`color: ${sport.primaryColor}`}>{principle.name}</h4>
              <p class="guide-body" style="margin: 0;">{principle.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION 3: ELM FRAMEWORK -->
      <section class="guide-section">
        <h2 class="guide-h2" style={`color: ${sport.primaryColor}; border-color: ${sport.primaryColor}`}>
          3. {philosophy.elmFramework.title}
        </h2>
        <p class="guide-h4" style="color: var(--ink-medium); margin-bottom: 1em;">
          {philosophy.elmFramework.subtitle}
        </p>

        <p class="guide-body">{philosophy.elmFramework.description}</p>

        {philosophy.elmFramework.components.map(component => (
          <div class="guide-box guide-box-accent avoid-break" style="margin-bottom: 1em;">
            <div style="display: flex; align-items: flex-start; gap: 1em;">
              <div style={`
                font-family: var(--guide-font-display);
                font-size: 32pt;
                font-weight: 700;
                line-height: 1;
                color: ${sport.primaryColor};
              `}>
                {component.letter}
              </div>
              <div style="flex: 1;">
                <h4 class="guide-h4" style="margin-top: 0.25em;">{component.name}</h4>
                <p class="guide-body">{component.description}</p>
                <p class="guide-small" style="font-weight: 600; margin-bottom: 0.25em;">Example phrases:</p>
                <ul class="guide-list" style="margin: 0;">
                  {component.examples.map(example => (
                    <li style="font-style: italic; font-size: 10pt;">{example}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}

        <div class="guide-box" style="text-align: center; margin-top: 1.5em;">
          <p class="guide-h3" style={`color: ${sport.primaryColor}; margin-bottom: 0.25em;`}>
            The Magic Ratio: {philosophy.elmFramework.magicRatio.ratio}
          </p>
          <p class="guide-body" style="margin: 0;">
            {philosophy.elmFramework.magicRatio.description}
          </p>
        </div>
      </section>

      <!-- SECTION 4: AGE-APPROPRIATE DEVELOPMENT -->
      <section class="guide-section">
        <h2 class="guide-h2" style={`color: ${sport.primaryColor}; border-color: ${sport.primaryColor}`}>
          4. {philosophy.ageGuidelines.title}
        </h2>

        {philosophy.ageGuidelines.stages.map(stage => (
          <div class="avoid-break" style="margin-bottom: 2em;">
            <div style="display: flex; align-items: baseline; gap: 0.75em; margin-bottom: 0.5em;">
              <h3 class="guide-h3" style="margin: 0;">{stage.name}</h3>
              <span class="skill-domain-badge" style={`background: ${sport.primaryColor}20; color: ${sport.primaryColor};`}>
                {stage.ages}
              </span>
            </div>
            <p class="guide-body" style="font-style: italic; color: var(--ink-medium);">
              Focus: {stage.focus}
            </p>

            <div class="guide-columns">
              <div>
                <p class="guide-h4" style={`color: ${sport.primaryColor};`}>Do This</p>
                <ul class="guide-list">
                  {stage.principles.map(p => <li>{p}</li>)}
                </ul>
              </div>
              <div>
                <p class="guide-h4" style="color: var(--ink-light);">Avoid This</p>
                <ul class="guide-list">
                  {stage.avoid.map(a => <li>{a}</li>)}
                </ul>
              </div>
            </div>

            <p class="guide-small" style="margin-top: 0.75em;">
              <strong>Coach's Role:</strong> {stage.coachRole}
            </p>
          </div>
        ))}
      </section>

      <!-- SECTION 5: ARM CARE GUIDELINES (Baseball-Specific) -->
      <section class="guide-section">
        <h2 class="guide-h2" style={`color: ${sport.primaryColor}; border-color: ${sport.primaryColor}`}>
          5. Arm Care Guidelines
        </h2>

        <p class="guide-lead" style="margin-bottom: 1em;">
          Protecting young arms is the most important responsibility of youth baseball coaches.
          These guidelines are based on research from the American Sports Medicine Institute (ASMI),
          Little League International, and MLB Pitch Smart.
        </p>

        <div class="guide-box guide-box-accent" style="margin: 1.5em 0;">
          <p class="guide-box-title" style={`color: ${sport.primaryColor};`}>Critical Principle</p>
          <p class="guide-body" style="margin: 0; font-weight: 600;">
            A young arm that's protected today can pitch for decades. An arm that's overused today may never pitch again.
          </p>
        </div>

        <h3 class="guide-h3">Pitch Count Limits by Age</h3>
        <table class="guide-table guide-table-striped" style="margin-bottom: 1.5em;">
          <thead>
            <tr>
              <th>Age</th>
              <th>Max Pitches/Day</th>
              <th>Required Rest</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>7-8</td>
              <td>50</td>
              <td>1 day (1-20), 2 days (21-35), 3 days (36-50)</td>
            </tr>
            <tr>
              <td>9-10</td>
              <td>75</td>
              <td>1 day (1-20), 2 days (21-35), 3 days (36-50), 4 days (51-75)</td>
            </tr>
            <tr>
              <td>11-12</td>
              <td>85</td>
              <td>1 day (1-20), 2 days (21-35), 3 days (36-50), 4 days (51-85)</td>
            </tr>
            <tr>
              <td>13-14</td>
              <td>95</td>
              <td>1 day (1-20), 2 days (21-35), 3 days (36-50), 4 days (51-95)</td>
            </tr>
          </tbody>
        </table>

        <h3 class="guide-h3">Warning Signs</h3>
        <div class="guide-columns">
          <div class="guide-box" style="border-color: #ef4444;">
            <p class="guide-h4" style="color: #ef4444;">Stop Immediately If:</p>
            <ul class="guide-list" style="margin: 0;">
              <li>Pain in elbow or shoulder</li>
              <li>Decreased velocity</li>
              <li>Altered mechanics</li>
              <li>Fatigue complaints</li>
              <li>Soreness lasting 48+ hours</li>
            </ul>
          </div>
          <div class="guide-box">
            <p class="guide-h4" style={`color: ${sport.primaryColor};`}>Healthy Arm Habits:</p>
            <ul class="guide-list" style="margin: 0;">
              <li>Dynamic warm-up before throwing</li>
              <li>Gradual buildup of intensity</li>
              <li>No curveballs until age 14</li>
              <li>Year-round rest periods (2-4 months)</li>
              <li>Play multiple positions</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- PART TWO: SKILLS REFERENCE - SECTION DIVIDER -->
      <section class="section-divider">
        <p class="section-divider-number">Part Two</p>
        <h1 class="section-divider-title">Skills<br/>Reference</h1>
        <p class="section-divider-subtitle">
          Detailed progression charts for each baseball skill, organized by domain.
          Use these to assess players, track development, and plan targeted coaching.
        </p>
        <div class="section-divider-icon">{sport.icon}</div>
      </section>

      <!-- SECTION 6: SKILLS REFERENCE -->
      <section class="guide-section">
        <h2 class="guide-h2" style={`color: ${sport.primaryColor}; border-color: ${sport.primaryColor}`}>
          6. Skills Overview
        </h2>

        <p class="guide-lead" style="margin-bottom: 1.5em;">
          Baseball development spans four interconnected domains. Each skill in this guide
          includes a 5-level progression from Emerging to Advanced.
        </p>

        <!-- Skills Overview Table -->
        <h3 class="guide-h3">Skills Overview by Domain</h3>
        <table class="guide-table guide-table-striped" style="margin-bottom: 2em;">
          <thead>
            <tr>
              <th>Domain</th>
              <th>Skills</th>
              <th>Count</th>
            </tr>
          </thead>
          <tbody>
            {domainOrder.map(domain => (
              skillsByDomain[domain] && (
                <tr>
                  <td style="font-weight: 600;">{domainDisplayNames[domain]}</td>
                  <td>{skillsByDomain[domain].map(s => s.name).join(', ')}</td>
                  <td class="guide-mono">{skillsByDomain[domain].length}</td>
                </tr>
              )
            ))}
          </tbody>
        </table>

        <!-- Individual Skill Cards -->
        {domainOrder.map(domain => (
          skillsByDomain[domain] && (
            <div>
              <h3 class="guide-h3" style={`
                color: ${sport.primaryColor};
                padding-bottom: 0.5em;
                border-bottom: 2px solid ${sport.primaryColor};
                margin-bottom: 1.5em;
              `}>
                {domainDisplayNames[domain]}
              </h3>

              {skillsByDomain[domain].map(skill => (
                <div class="skill-progression avoid-break" style="margin-bottom: 2em;">
                  <div class="skill-header">
                    <h4 class="skill-name">{skill.name}</h4>
                    <span class="skill-domain-badge">{skill.stage?.name || 'Fundamentals'}</span>
                  </div>

                  {skill.description && (
                    <p class="skill-description">{skill.description}</p>
                  )}

                  <!-- Level Progression Table -->
                  {skill.comprehensiveGuide?.levelDetails && (
                    <div class="level-table">
                      {[1, 2, 3, 4, 5].map(level => {
                        const levelData = skill.comprehensiveGuide?.levelDetails?.[level];
                        const levelName = levelData?.name ||
                          ['', 'Emerging', 'Developing', 'Competent', 'Proficient', 'Advanced'][level];
                        const description = levelData?.description ||
                          skill.progressionLevels?.[level as 1|2|3|4|5] || '';

                        return (
                          <div class="level-row">
                            <div class="level-indicator">
                              <span class="level-number" style={`background: ${sport.primaryColor}`}>{level}</span>
                              <span class="level-name">{levelName}</span>
                            </div>
                            <div class="level-content">
                              {description}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}

                  <!-- Coaching Tips -->
                  {skill.coachingTips && skill.coachingTips.length > 0 && (
                    <div class="coaching-tips" style={`background: ${sport.primaryColor}10;`}>
                      <p class="guide-h4" style="margin-bottom: 0.5em;">Coaching Cues</p>
                      {skill.coachingTips.slice(0, 4).map(tip => (
                        <div class="coaching-tip">
                          <span class="coaching-tip-icon" style={`color: ${sport.primaryColor};`}>→</span>
                          <span>{tip}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )
        ))}

        {baseballSkills.length === 0 && (
          <div class="guide-box" style="text-align: center; padding: 2em;">
            <p class="guide-body" style="margin: 0; color: var(--ink-medium);">
              Baseball skills curriculum is in development. Check back soon for detailed skill progressions.
            </p>
          </div>
        )}
      </section>

      <!-- PART THREE: PROGRAM STRUCTURES - SECTION DIVIDER -->
      <section class="section-divider">
        <p class="section-divider-number">Part Three</p>
        <h1 class="section-divider-title">Program<br/>Structures</h1>
        <p class="section-divider-subtitle">
          Templates and schedules for leagues, development classes, childcare programs,
          and summer camps—organized by age group.
        </p>
        <div class="section-divider-icon">{sport.icon}</div>
      </section>

      <!-- SECTION 10: RECREATIONAL LEAGUE -->
      <section class="guide-section">
        <h2 class="guide-h2" style={`color: ${sport.primaryColor}; border-color: ${sport.primaryColor}`}>
          10. {programStructures.league.title}
        </h2>
        <p class="guide-h4" style="color: var(--ink-medium); margin-bottom: 1.5em;">
          {programStructures.league.subtitle}
        </p>

        <p class="guide-body" style="margin-bottom: 2em;">
          {programStructures.league.description}
        </p>

        <!-- Discovery Age Group -->
        <div class="program-card">
          <div class="program-card-header">
            <span class="age-badge age-badge-discovery">Ages 4-6</span>
            <div>
              <h3 class="program-card-title">{programStructures.league.byAge.discovery.name}</h3>
            </div>
          </div>
          <div class="program-card-body">
            <div class="metrics-grid" style="margin-bottom: 1.5em;">
              <div class="metric-box">
                <div class="metric-value">{programStructures.league.byAge.discovery.format.duration.split('-')[0]}</div>
                <div class="metric-label">Weeks</div>
              </div>
              <div class="metric-box">
                <div class="metric-value">{programStructures.league.byAge.discovery.format.practiceDuration}</div>
                <div class="metric-label">Practice</div>
              </div>
              <div class="metric-box">
