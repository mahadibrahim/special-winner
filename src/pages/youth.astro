---
// Youth hub. SSR + edge-cached; carries no live inventory by design — see the
// header comment in landing-content.ts for the copy rules this page follows.
//
// Structure is "what before why": a graded hero, then the three ways in as
// hub doors, then the offerings in full, then the coaching story. That
// ordering matches how Lil' Kickers, Soccer Shots and TOCA all build their
// landing pages.
//
// Built on the design system rather than hand-rolled: CategoryCard supplies
// the aurora doors, BenefitTrio the why-trio, .graded--emerald the hero
// treatment, and every accent is emerald because the system assigns emerald
// to youth. See docs/design-system.md.
import BaseLayout from "@/layouts/BaseLayout.astro";
import NextUpCard from "@/components/marketing/next-up-card.astro";
import CategoryCard from "@/components/landing/category-card.astro";
import BenefitTrio from "@/components/marketing/benefit-trio";
import YouthCoachSection from "@/components/youth/youth-coach-section.astro";
import { getActiveSiteAnnouncement } from "@/lib/marketing/site-announcement";
import { setMarketingEdgeCache } from "@/lib/http/edge-cache";
import {
  AGE_SPAN, SPORTS, HERO, WAYS_IN, BENEFITS, LEAGUE_KINDS, CLASSES, CAMPS,
  TESTIMONIALS, PRICING,
} from "@/lib/youth/landing-content";

const announcement = getActiveSiteAnnouncement(Astro.locals.organization, "youth");
setMarketingEdgeCache(Astro);

// Emerald on every offering rule. The design system assigns emerald to youth
// and orange to adult; the previous pass used adult's palette here by mistake.
const YOUTH_ACCENT = "var(--color-emerald-600, #059669)";

// Brand-graded hero. Marketing photography never appears raw — the emerald
// grade is the youth variant. See docs/design-system.md "Graded imagery".
const HERO_IMAGE = "/images/stock/youth-training.jpg";
---

<BaseLayout
  title="Youth Programs — Aspire Sports"
  description={`Youth leagues, classes and camps in Worthington and central Ohio, for ${AGE_SPAN}. Small groups, real coaching, and a lot of touches.`}
>
  <Fragment slot="head">
    <link rel="canonical" href={`${Astro.url.origin}/youth`} />
  </Fragment>

  <main id="main-content" class="flex-1">
    {/* ---------- Hero: graded photo, headline, and the sports we run ------
        First consumer of `.graded` in the codebase — it shipped with CSS, a
        React wrapper and docs but no adopter. `graded--fill` was added to
        globals.css for this: `.graded` is unlayered and beats Tailwind's
        `absolute` utility, so positioning it from the class list silently
        fails. bg-navy-deep is the fallback ground if the photo is ever
        missing, so cream text never lands on cream. */}
    <section class="relative text-cream px-6 sm:px-9 py-20 sm:py-24 overflow-hidden bg-navy-deep">
      <div class="graded graded--emerald graded--fill z-0" aria-hidden="true">
        <img src={HERO_IMAGE} alt="" />
      </div>
      <div class="relative z-10 max-w-[1080px] mx-auto">
        <h1
          class="font-display font-semibold tracking-tight"
          style="font-size:clamp(2.4rem,6vw,3.6rem);line-height:1"
        >
          {HERO.title}
        </h1>
        <p class="mt-4 text-base text-cream/90 max-w-[480px] leading-relaxed">
          {HERO.subhead}
        </p>
        {SPORTS.length > 0 && (
          <p class="mt-5 font-mono text-[11px] tracking-widest uppercase text-cream/75">
            {SPORTS.join(" · ")}
          </p>
        )}
      </div>
    </section>

    {/* ---------- The three ways in, as hub doors -------------------------- */}
    <section class="max-w-[1080px] mx-auto px-6 sm:px-9 pt-8 pb-4 grid grid-cols-1 md:grid-cols-3 gap-4">
      {WAYS_IN.map((w) => (
        <CategoryCard
          href={w.href}
          cta={w.cta}
          palette={w.palette}
          title={w.label}
          blurb={w.meta}
          statusLabel={w.statusLabel}
          live={true}
          ctaLabel={w.ctaLabel}
        />
      ))}
    </section>

    {/* ---------- Why, in the documented trio pattern ---------------------- */}
    <BenefitTrio benefits={BENEFITS} />

    {announcement && (
      <div class="max-w-[1080px] mx-auto px-6 sm:px-9 pt-6">
        <NextUpCard announcement={announcement} />
      </div>
    )}

    {/* ---------- 1. Leagues — two kinds ---------------------------------- */}
    <section class="px-6 sm:px-9 py-12 border-b border-border" aria-labelledby="youth-leagues-h">
      <div class="max-w-[1080px] mx-auto">
        <div class="h-[3px] w-11 rounded-sm mb-4" style={`background:${YOUTH_ACCENT}`}></div>
        <h2 id="youth-leagues-h" class="font-display text-3xl text-ink tracking-tight">Leagues</h2>
        <p class="text-[13.5px] text-ink-2 leading-relaxed mt-2 max-w-[520px]">
          Two kinds, depending on the time of year and what your player needs.
        </p>

        <div class="grid md:grid-cols-2 gap-3 mt-6">
          {LEAGUE_KINDS.map((k) => (
            <div class="rounded-xl border border-border bg-paper p-5">
              <p class="font-mono text-[10px] tracking-widest uppercase text-ink-2">{k.when}</p>
              <h3 class="font-display text-xl text-ink mt-1.5">{k.name}</h3>
              <p class="text-[13px] text-ink-2 leading-relaxed mt-2">{k.body}</p>
              <dl class="flex gap-6 mt-4 pt-3 border-t border-cream-2 text-[12px]">
                {k.facts.map((f) => (
                  <div>
                    <dt class="text-ink-2">{f.label}</dt>
                    <dd class="text-ink font-semibold mt-0.5">{f.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>

        <a
          href="/youth/leagues"
          data-youth-cta="leagues"
          class="inline-block mt-6 font-sans font-semibold text-[13px] bg-navy-deep text-cream px-4 py-2.5 rounded-lg"
        >
          See the leagues →
        </a>
      </div>
    </section>

    {/* ---------- 2. Classes ---------------------------------------------- */}
    <section class="px-6 sm:px-9 py-12 border-b border-border" aria-labelledby="youth-classes-h">
      <div class="max-w-[1080px] mx-auto">
        <div class="h-[3px] w-11 rounded-sm mb-4" style={`background:${YOUTH_ACCENT}`}></div>
        <h2 id="youth-classes-h" class="font-display text-3xl text-ink tracking-tight">Classes</h2>
        <p class="text-[13.5px] text-ink-2 leading-relaxed mt-2 max-w-[520px]">{CLASSES.lede}</p>
        <ul class="mt-4 space-y-1.5 text-[13px] text-ink-2 list-disc pl-5 max-w-[520px]">
          {CLASSES.points.map((p) => <li>{p}</li>)}
        </ul>
        <a
          href="/youth/classes"
          data-youth-cta="classes"
          class="inline-block mt-6 font-sans font-semibold text-[13px] bg-navy-deep text-cream px-4 py-2.5 rounded-lg"
        >
          See the pathway →
        </a>
      </div>
    </section>

    {/* ---------- 3. Camps ------------------------------------------------ */}
    <section class="px-6 sm:px-9 py-12 border-b border-border" aria-labelledby="youth-camps-h">
      <div class="max-w-[1080px] mx-auto">
        <div class="h-[3px] w-11 rounded-sm mb-4" style={`background:${YOUTH_ACCENT}`}></div>
        <h2 id="youth-camps-h" class="font-display text-3xl text-ink tracking-tight">Camps</h2>
        <p class="text-[13.5px] text-ink-2 leading-relaxed mt-2 max-w-[520px]">{CAMPS.lede}</p>
        <a
          href="/youth/camps"
          data-youth-cta="camps"
          class="inline-block mt-6 font-sans font-semibold text-[13px] bg-navy-deep text-cream px-4 py-2.5 rounded-lg"
        >
          See camp dates →
        </a>
      </div>
    </section>

    {/* ---------- 4. How we coach — the why, after the what ---------------- */}
    <YouthCoachSection />

    {/* ---------- 5. Testimonials — renders only when we have real ones ---- */}
    {TESTIMONIALS.length > 0 && (
      <section class="px-6 sm:px-9 py-12 border-b border-border" aria-labelledby="youth-parents-h">
        <div class="max-w-[1080px] mx-auto">
          <h2 id="youth-parents-h" class="font-display text-3xl text-ink tracking-tight">What parents say</h2>
          <div class="grid md:grid-cols-3 gap-3 mt-6">
            {TESTIMONIALS.map((t) => (
              <figure class="rounded-xl border border-border bg-paper p-5 m-0">
                <blockquote class="text-[13px] text-ink-2 leading-relaxed">{t.quote}</blockquote>
                <figcaption class="font-mono text-[10.5px] tracking-wide uppercase text-ink-2 mt-3">
                  {t.attribution}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ---------- 6. Pricing — indicative only ----------------------------- */}
    <section class="px-6 sm:px-9 py-12" aria-labelledby="youth-cost-h">
      <div class="max-w-[1080px] mx-auto">
        <h2 id="youth-cost-h" class="font-display text-3xl text-ink tracking-tight">{PRICING.heading}</h2>
        <p class="text-[13.5px] text-ink-2 leading-relaxed mt-2 max-w-[560px]">{PRICING.body}</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { track } from "@/lib/analytics/track";

  // Legacy age-band anchors (pre-Phase-2 bookmarks) → leagues category page.
  const anchorMap: Record<string, string> = {
    "ages-4-8": "/youth/leagues",
    "ages-9-12": "/youth/leagues",
    "ages-13-18": "/youth/leagues",
  };
  const hash = location.hash.slice(1);
  if (Object.hasOwn(anchorMap, hash)) location.replace(anchorMap[hash]);

  // Hero doors and section CTAs are tracked separately: the hero measures
  // "which offering did they pick before reading anything", the section CTAs
  // measure "which section actually convinced them".
  document.querySelectorAll<HTMLAnchorElement>("[data-youth-way]").forEach((el) => {
    el.addEventListener("click", () =>
      track("youth_hub_way_clicked", { way: el.dataset.youthWay ?? "" }),
    );
  });
  document.querySelectorAll<HTMLAnchorElement>("[data-youth-cta]").forEach((el) => {
    el.addEventListener("click", () =>
      track("youth_hub_section_cta_clicked", { section: el.dataset.youthCta ?? "" }),
    );
  });
</script>
