---
// Youth hub — SPORT-FIRST, in the Broadsheet (v2) band language. SSR +
// edge-cached; live facts on the tiles are client-side (TileFactsLine) so
// the CDN copy never freezes stale inventory.
//
// A parent's first decision is the sport, so the hero tiles are sports
// (YOUTH_SPORT_PAGES registry), tinted with the sport's canonical color —
// sport tint answers "which game" (sport-colors.ts) and survives the v2
// conversion; the band chrome around it is Broadsheet ink/sand/orange.
// The hub's remaining job is to sell Aspire (benefit trio with the
// coaching proof) and route; everything an offering needs to explain lives
// on the sport pages (/youth/soccer, /youth/futsal) and the offering pages
// below them.
import BaseLayout from "@/layouts/BaseLayout.astro";
import NextUpCard from "@/components/marketing/next-up-card.astro";
import BenefitTrio from "@/components/marketing/benefit-trio";
import TileFactsLine from "@/components/landing/tile-facts-line";
import LandingFaq, { type LandingFaqItem } from "@/components/landing/landing-faq.tsx";
import { getActiveSiteAnnouncement } from "@/lib/marketing/site-announcement";
import { setMarketingEdgeCache } from "@/lib/http/edge-cache";
import { sportColor } from "@/lib/design/sport-colors";
import { YOUTH_SPORT_PAGES } from "@/lib/youth/sport-pages";
import {
  AGE_SPAN, HERO, INTRO, BENEFITS, PATHWAY, PRICING, TESTIMONIALS,
} from "@/lib/youth/landing-content";

const announcement = getActiveSiteAnnouncement(Astro.locals.organization, "youth");
setMarketingEdgeCache(Astro);

const sports = Object.values(YOUTH_SPORT_PAGES);

// Hub FAQs — the questions a parent decides on, answered from real facts
// (pricing prose is PRICING.body verbatim so the two can't drift). Same
// pattern as /adult/leagues: copy lives in the page frontmatter.
const faqs: LandingFaqItem[] = [
  {
    question: "What ages do you take?",
    answer:
      "18 months to 19 years. Classes start at 18 months with a grown-up on the floor, and leagues run by age group from U6 to U19.",
  },
  {
    question: "What sports do you run?",
    answer:
      "Soccer and futsal are enrolling today. The sport tiles above always show what is open — when a new sport launches, it appears there first.",
  },
  {
    question: "Does my kid need a team — or experience?",
    answer:
      "No. Developmental leagues are built for individual players — we build the teams — and classes meet every kid where they are, from first touch upward.",
  },
  {
    question: "What does it cost?",
    answer: PRICING.body,
  },
  {
    question: "How do I know which group my kid is in?",
    answer:
      "Leagues group by age — each sport's league page has a birthday lookup that places your kid in the right group. For classes, coaches place kids by readiness and move them up on the coach's word.",
  },
];

const HERO_IMAGE = "/images/stock/youth-training.jpg";
---

<BaseLayout
  title="Youth Programs — Aspire Sports"
  description={`Youth leagues, classes and camps in central Ohio, for ${AGE_SPAN}. Small groups, real coaching, and a lot of touches.`}
>

  <main id="main-content" class="flex-1">
    {/* ---------- Hero: pick your sport ------------------------------------
        The fold answers "what can my kid do right now". One tile per sport
        in the registry, tinted with the sport's canonical color
        (sport-colors.ts — never inline a sport color); live facts computed
        client-side. Tiles keep explicit text utilities so the band link
        rule never repaints them. */}
    <section class="band-ink relative overflow-hidden">
      <img
        src={HERO_IMAGE}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-[center_30%]"
        style="filter:grayscale(1) contrast(1.08) brightness(.96)"
      />
      <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
      <div class="relative max-w-[1080px] mx-auto px-6 sm:px-12 pt-28 lg:pt-32 pb-12 flex flex-col gap-5">
        <h1 class="display-xl text-on-ink max-w-[760px]">{HERO.title}</h1>
        <p class="body-l text-on-ink-2 max-w-[520px]" style="text-wrap:pretty">{HERO.subhead}</p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3.5 pt-2">
          {sports.map((s) => (
            <a
              href={`/youth/${s.slug}`}
              data-landing-cta={`youth-hub-${s.slug}`}
              class="relative p-5 text-ink overflow-hidden no-underline block"
              style={`background:${sportColor({ slug: s.slug })}`}
            >
              <div class="data text-ink/80">● {s.statusLabel}</div>
              <div class="display-s text-ink mt-1.5" style="font-size:1.5rem">{s.name}</div>
              <div class="font-mono text-xs text-ink mt-1">{s.tileMeta}</div>
              <TileFactsLine client:visible audience="youth" sport={s.slug} tone="ink" />
              <span class="absolute right-4 bottom-4 font-bold text-lg text-ink" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <p class="text-sm text-on-ink-muted">
          Or browse by programme:
          <a href="/youth/leagues" class="text-primary-bright underline underline-offset-2">Leagues</a>
          ·
          <a href="/youth/classes" class="text-primary-bright underline underline-offset-2">Classes</a>
          ·
          <a href="/youth/camps" class="text-primary-bright underline underline-offset-2">Camps</a>
        </p>
        <p class="text-sm text-on-ink-muted -mt-3">
          Playing yourself?
          <a href="/adult" class="text-primary-bright underline underline-offset-2">See adult programs →</a>
        </p>
      </div>
    </section>

    {/* ---------- Crawlable intro — the hub's one prose block --------------- */}
    <section class="band-sand border-b border-rule px-6 sm:px-12 py-10" aria-label="About Aspire youth sports">
      <div class="max-w-[1080px] mx-auto">
        <p class="body-copy text-on-sand-2 max-w-[640px]">{INTRO}</p>
      </div>
    </section>

    {/* ---------- Why Aspire, in the documented trio pattern --------------- */}
    <BenefitTrio benefits={BENEFITS} />

    {announcement && (
      <div class="max-w-[1080px] mx-auto px-6 sm:px-12 py-6">
        <NextUpCard announcement={announcement} />
      </div>
    )}

    {/* ---------- One pathway — the differentiator, on ink ------------------
        Answers "is there something for my kid's age" in one glance. Names
        only (blurbs live on the sport pages). Colour arrives through the
        structure: the quadrant grid's rules go orange. */}
    <section class="band-ink px-6 sm:px-12 py-14" aria-labelledby="youth-pathway-strip-h">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
        <div class="flex flex-col gap-2.5 max-w-[620px]">
          <h2 id="youth-pathway-strip-h" class="display-l">
            One pathway, eighteen months to nineteen years
          </h2>
          <p class="body-s text-on-ink-2">
            Five named steps, so nobody starts over and nobody stands still.
          </p>
        </div>
        <div class="quadrants quadrants--accent grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
          {PATHWAY.map((s) => (
            <div class="flex flex-col gap-1.5 p-4">
              <p class="display-s text-on-ink m-0" style="font-size:1.125rem">{s.name.replace("Aspire ", "")}</p>
              <p class="data text-on-ink-muted m-0">{s.ages}</p>
            </div>
          ))}
        </div>
        <div>
          <a href="/youth/classes" data-youth-cta="pathway" class="btn btn--on-ink no-underline">
            See the pathway
          </a>
        </div>
      </div>
    </section>

    {/* ---------- Testimonials — renders only when we have real ones ------- */}
    {TESTIMONIALS.length > 0 && (
      <section class="band-sand px-6 sm:px-12 py-14" aria-labelledby="youth-parents-h">
        <div class="max-w-[1080px] mx-auto flex flex-col gap-8">
          <h2 id="youth-parents-h" class="display-l">What parents say</h2>
          <div class="grid md:grid-cols-3 gap-3.5">
            {TESTIMONIALS.map((t) => (
              <figure class="bg-paper border border-rule p-5 m-0">
                <blockquote class="body-s text-on-sand-2 m-0">{t.quote}</blockquote>
                <figcaption class="label text-on-sand-muted mt-3" style="font-size:0.65rem">
                  {t.attribution}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ---------- FAQs — objection handling --------------------------------- */}
    <LandingFaq client:visible id="faq" heading="Youth program FAQs" items={faqs} />

    {/* ---------- Closer — the orange band, routing into the sport pages ---- */}
    <section class="band-orange px-6 sm:px-12 py-16" aria-labelledby="youth-close-h">
      <div class="max-w-[1080px] mx-auto flex flex-wrap items-center justify-between gap-8">
        <div class="flex flex-col gap-2.5">
          <h2 id="youth-close-h" class="display-xl" style="font-size:clamp(2.5rem,5vw,4rem)">
            Ready when they are.
          </h2>
          <p class="body-l font-medium text-ink">
            Pick the sport and see what's open — registration takes a few minutes.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          {sports.map((s) => (
            <a
              href={`/youth/${s.slug}`}
              data-landing-cta={`youth-close-${s.slug}`}
              class="btn btn--ink no-underline whitespace-nowrap !text-primary-bright hover:!text-ink"
            >
              Youth {s.name.toLowerCase()}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { track } from "@/lib/analytics/track";

  // Legacy age-band anchors (pre-Phase-2 bookmarks) → leagues category page.
  const anchorMap: Record<string, string> = {
    "ages-4-8": "/youth/leagues",
    "ages-9-12": "/youth/leagues",
    "ages-13-18": "/youth/leagues",
  };
  const hash = location.hash.slice(1);
  if (Object.hasOwn(anchorMap, hash)) location.replace(anchorMap[hash]);

  // Delegated so island-hydrated CTAs still get tracked (classes precedent).
  document.addEventListener("click", (e) => {
    const el = e.target instanceof Element ? e.target.closest<HTMLElement>("[data-landing-cta], [data-youth-cta]") : null;
    if (!el) return;
    if (el.dataset.landingCta) track("landing_hero_cta_click", { cta: el.dataset.landingCta });
    else track("youth_hub_section_cta_clicked", { section: el.dataset.youthCta ?? "" });
  });
</script>
