---
import '../styles/globals.css';
import Navigation from '../components/navigation';
import { StaffInbox } from '../components/messages/staff-inbox';

// Require authentication
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/signin?redirect=/messages');
}

// Admin / coach gate — the staff inbox is only for staff. Parents don't have
// their own inbox view in Phase 1; they interact via SMS and email.
const roles = (Astro.locals as unknown as { roles?: string[] }).roles ?? [];
const isAdmin = roles.some((r) => r === 'super_admin' || r === 'location_admin');
const isCoach = roles.includes('coach');

if (!isAdmin && !isCoach) {
  return Astro.redirect('/dashboard');
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Messages — Aspire Sports</title>
    <style>
      @keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .page-content { animation: fadeSlideIn 0.4s ease-out forwards; }

      .messages-bg {
        background-image:
          radial-gradient(ellipse 70% 40% at 50% -10%, rgba(59, 130, 246, 0.05), transparent),
          radial-gradient(circle at 85% 85%, rgba(59, 130, 246, 0.03), transparent);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0f] text-white">
    <Navigation client:load />

    <main class="flex-1 pt-24 pb-6 px-4 messages-bg">
      <div class="max-w-[1600px] mx-auto page-content">
        <header class="mb-6">
          <h1 class="text-2xl sm:text-3xl font-bold text-white">Messages</h1>
          <p class="text-sm text-gray-500 mt-1">
            Parent conversations routed to {isAdmin ? 'the admin inbox' : 'your coach inbox'}.
            The bot handles most messages automatically — everything you see here needed a human.
          </p>
        </header>

        <StaffInbox client:load currentUserId={user.id} isAdmin={isAdmin} />
      </div>
    </main>
  </body>
</html>
