# secrets.local.csv.example
#
# Copy to secrets.local.csv, fill in real values, then:
#   node scripts/bws-load-secrets.mjs
#   rm secrets.local.csv
#
# Format: KEY,VALUE  (one per line; first comma splits, so values may
# contain commas). Lines starting with '#' are ignored — delete the '#'
# on a row once you have a value for it. Keep this list trimmed to what
# you actually need; the runner injects every secret in the project.

# ---- Required to boot the dev server ----
# DATABASE_URL is the Railway connection string (point local dev at STAGING,
# not prod). Use Railway's PUBLIC proxy host (e.g. *.proxy.rlwy.net:PORT),
# NOT the internal *.railway.internal host — the latter only resolves inside
# Railway's network and will fail from your laptop.
DATABASE_URL,postgresql://USER:PASS@HOST.proxy.rlwy.net:PORT/railway
PUBLIC_APP_URL,http://localhost:4321
STRIPE_SECRET_KEY,sk_test_...
STRIPE_PUBLISHABLE_KEY,pk_test_...
STRIPE_WEBHOOK_SECRET,whsec_...
RESEND_API_KEY,re_...
RESEND_FROM_EMAIL,noreply@example.com

# ---- Dev convenience (any long random string) ----
CRON_SECRET,devsecret
INTERNAL_JOB_SECRET,change-me-random
MARKETING_UNSUBSCRIBE_SECRET,change-me-random

# ---- Optional / feature-gated — uncomment as you enable each feature ----
# STRIPE_CONNECT_WEBHOOK_SECRET,whsec_...
# STRIPE_KIOSK_PMC_ID,pmc_...
# RESEND_INBOUND_WEBHOOK_SECRET,
# CLOUDINARY_CLOUD_NAME,
# CLOUDINARY_API_KEY,
# CLOUDINARY_API_SECRET,
# TWILIO_ACCOUNT_SID,AC...
# TWILIO_AUTH_TOKEN,
# TWILIO_PHONE_NUMBER,+1...
# TWILIO_MESSAGING_SERVICE_SID,MG...
# TWILIO_WEBHOOK_AUTH_TOKEN,
# ANTHROPIC_API_KEY,sk-ant-...
# ANTHROPIC_CLASSIFIER_MODEL,
# MAGIC_LINK_BASE_URL,
# TELEGRAM_BOT_TOKEN,
# TELEGRAM_BOT_USERNAME,
# TELEGRAM_WEBHOOK_SECRET,
# TELEGRAM_DRY_RUN,true
# FOUNDER_ALERT_EMAIL,
# DISABLE_RATE_LIMIT,
# E2E_TEST_ENDPOINTS,
# R2_ACCOUNT_ID,
# R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY,
# R2_BUCKET,aspire-media-dev
# R2_PUBLIC_URL,
# PUBLIC_GTM_CONTAINER_SOCCERONE,
# PUBLIC_POSTHOG_PROJECT_TOKEN,
# PUBLIC_POSTHOG_HOST,
# POSTHOG_PROJECT_TOKEN,
# POSTHOG_HOST,
# GA4_MEASUREMENT_ID,G-XXXXXXXXXX
# GA4_API_SECRET,
# FB_PIXEL_ID,
# FB_CAPI_TOKEN,
# FB_PIXEL_ID_SOCCERONE,
# FB_CAPI_TOKEN_SOCCERONE,
# MEDIA_AUTH_HARD_BLOCK,
# PUBLIC_TURNSTILE_SITE_KEY,
# TURNSTILE_SECRET_KEY,
