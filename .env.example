# ============================================================
# Aspire Sports — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values for local dev,
# or set these in the Netlify dashboard for production.

# ------------------------------------------------------------
# Core (required)
# ------------------------------------------------------------

# PostgreSQL connection string (Railway)
DATABASE_URL=postgresql://user:password@host:5432/database

# 32+ character random string for Lucia session cookies
# Generate via: openssl rand -base64 32
AUTH_SECRET=your-random-32-character-secret-here

# Public base URL of the app (e.g. https://aspiresports.com)
PUBLIC_APP_URL=http://localhost:4321

# ------------------------------------------------------------
# Stripe (required for payments)
# ------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------
# Email — Resend (required)
# ------------------------------------------------------------

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Optional — enables Resend inbound webhooks for the Phase 1
# bidirectional email conversation feature. Set this to the
# shared secret Resend uses to sign inbound webhook payloads.
RESEND_INBOUND_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Image upload — Cloudinary (optional)
# ------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# Phase 1 — Messaging layer
# ============================================================

# ------------------------------------------------------------
# SMS — Twilio (required for Phase 1 pilot launch)
# ------------------------------------------------------------
# Obtain from https://console.twilio.com
# NOTE: US SMS requires 10DLC brand + campaign registration
# before sending production traffic. See Twilio Trust Hub.

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
TWILIO_MESSAGING_SERVICE_SID=MG...

# The authentication token used to verify Twilio inbound webhooks.
# Same value as TWILIO_AUTH_TOKEN in most setups; separated here
# in case you rotate it independently.
TWILIO_WEBHOOK_AUTH_TOKEN=

# ------------------------------------------------------------
# LLM — Anthropic (required for bot intent classification)
# ------------------------------------------------------------
# Obtain from https://console.anthropic.com
# Used by the bot intent classifier for parent message routing.
# Cost is negligible — classification runs at <$0.001 per message.

ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the model used for classification.
# Defaults to claude-haiku-4-5 (recommended — cheap, fast, accurate).
ANTHROPIC_CLASSIFIER_MODEL=

# ------------------------------------------------------------
# Magic-link auth
# ------------------------------------------------------------
# Base URL for magic-link redemption. Defaults to
# `${PUBLIC_APP_URL}/m` if unset. Override if you want magic
# links on a dedicated short domain (e.g., https://aspire.sh/m).
MAGIC_LINK_BASE_URL=

# ------------------------------------------------------------
# Telegram (Phase 1 fast-follow, post-pilot-launch)
# ------------------------------------------------------------
# Leave unset until Telegram channel rollout begins.
# Obtain via @BotFather on Telegram.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
