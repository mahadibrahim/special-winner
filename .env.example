# ============================================================
# Aspire Sports — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values for local dev,
# or set these in the Netlify dashboard for production.

# ------------------------------------------------------------
# Core (required)
# ------------------------------------------------------------

# PostgreSQL connection string (Railway)
DATABASE_URL=postgresql://user:password@host:5432/database

# Public base URL of the app (e.g. https://aspiresports.com)
PUBLIC_APP_URL=http://localhost:4321

# ------------------------------------------------------------
# Stripe (required for payments)
# ------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Required if Stripe Connect is in use — the signing secret for the
# separate Connect webhook endpoint. Without it, POST /api/webhooks/
# stripe-connect rejects every event with a 400.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Optional. A Stripe Payment Method Configuration id used only for the
# kiosk walk-in PaymentIntent — create one with Card on and Link off so a
# shared kiosk tablet never surfaces another customer's Link account.
# Mode-specific: a test-mode pmc_... locally, the live-mode pmc_... in
# prod. Unset → the walk-in falls back to card-only payment_method_types.
STRIPE_KIOSK_PMC_ID=pmc_...

# ------------------------------------------------------------
# Email — Resend (required)
# ------------------------------------------------------------

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Optional — enables Resend inbound webhooks for the Phase 1
# bidirectional email conversation feature. Set this to the
# shared secret Resend uses to sign inbound webhook payloads.
RESEND_INBOUND_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Image upload — Cloudinary (optional)
# ------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# Phase 1 — Messaging layer
# ============================================================

# ------------------------------------------------------------
# SMS — Twilio (required for Phase 1 pilot launch)
# ------------------------------------------------------------
# Obtain from https://console.twilio.com
# NOTE: US SMS requires 10DLC brand + campaign registration
# before sending production traffic. See Twilio Trust Hub.

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
TWILIO_MESSAGING_SERVICE_SID=MG...

# The authentication token used to verify Twilio inbound webhooks.
# Same value as TWILIO_AUTH_TOKEN in most setups; separated here
# in case you rotate it independently.
TWILIO_WEBHOOK_AUTH_TOKEN=

# ------------------------------------------------------------
# LLM — Anthropic (required for bot intent classification)
# ------------------------------------------------------------
# Obtain from https://console.anthropic.com
# Used by the bot intent classifier for parent message routing.
# Cost is negligible — classification runs at <$0.001 per message.

ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the model used for classification.
# Defaults to claude-haiku-4-5 (recommended — cheap, fast, accurate).
ANTHROPIC_CLASSIFIER_MODEL=

# ------------------------------------------------------------
# Magic-link auth
# ------------------------------------------------------------
# Base URL for magic-link redemption. Defaults to
# `${PUBLIC_APP_URL}/m` if unset. Override if you want magic
# links on a dedicated short domain (e.g., https://aspire.sh/m).
MAGIC_LINK_BASE_URL=

# ------------------------------------------------------------
# Telegram (Phase 1 fast-follow, post-pilot-launch)
# ------------------------------------------------------------
# Leave unset until Telegram channel rollout begins.
# Obtain via @BotFather on Telegram.

TELEGRAM_BOT_TOKEN=

# Your bot's username (without the @). Used in t.me deep links for
# parent account binding. Example: aspiresports_bot
TELEGRAM_BOT_USERNAME=

# Shared secret used to verify Telegram webhook requests. Set the same
# value when calling telegramSetWebhook(..., secretToken).
TELEGRAM_WEBHOOK_SECRET=

# Optional — when "true", Telegram group sends are logged instead of
# actually dispatched. Useful for local dev / staging.
TELEGRAM_DRY_RUN=

# ------------------------------------------------------------
# Cron / scheduled tasks
# ------------------------------------------------------------
# Shared secret for the day-before reminder cron endpoint.
# External scheduler must send this in the x-cron-secret header when
# hitting POST /api/cron/day-before-reminders.
CRON_SECRET=

# HMAC secret for signing marketing-email unsubscribe links. Must be stable
# (rotating it invalidates every existing unsubscribe link). Any long random string.
MARKETING_UNSUBSCRIBE_SECRET=

# Founder's email for operational alerts (Stripe dispute filed, etc).
# Routed through Resend like any other transactional email. NOT a
# marketing channel — only fires on system events that need human
# attention. The dispute webhook handler is fail-soft if this is unset
# (the dispute state still records on the payment row, but no email
# fires and an error is logged).
FOUNDER_ALERT_EMAIL=

# Required — bearer token gating internal job endpoints (e.g. the
# media-thumbnail worker at POST /api/jobs/media-thumbnail). In prod
# the job endpoint refuses unauthenticated requests when this is unset.
INTERNAL_JOB_SECRET=

# CI/dev only — set to "1" to disable IP rate limiting. NEVER set this
# in production.
DISABLE_RATE_LIMIT=

# CI/dev only — set to "yes" to enable the /api/test/** fixture endpoints
# (tenant-scoping suites use them to discover Org B resource IDs). NEVER
# set this in production.
E2E_TEST_ENDPOINTS=

# ------------------------------------------------------------
# Cloudflare R2 (media storage)
# ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aspire-media-dev
R2_PUBLIC_URL=

# ------------------------------------------------------------
# SoccerOne brand GTM container (optional)
# ------------------------------------------------------------
# SoccerOne brand GTM container. Optional — falls back to the Aspire
# container when unset. Set this once Marketing has provisioned a
# SoccerOne-specific GTM container.
PUBLIC_GTM_CONTAINER_SOCCERONE=

# ------------------------------------------------------------
# PostHog — analytics + error tracking + session replay
# ------------------------------------------------------------
# Browser-side (PUBLIC_ prefix exposes it to the client bundle).
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=

# Server-side (used from API routes / cron / webhooks).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# ------------------------------------------------------------
# GA4 Measurement Protocol (server-side purchase tracking)
# ------------------------------------------------------------
# Backup conversion fire from the Stripe webhook. Recovers
# purchase events lost to ad blockers / iOS Intelligent Tracking
# Prevention. Both values come from GA4 Admin → Data Streams →
# (your stream) → Measurement Protocol API secrets. Soft-required
# in prod: missing values disable the server-side fire only.

GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=

# ------------------------------------------------------------
# Media authorization rollout (consents/waivers feature)
# ------------------------------------------------------------
# When "true", the publish endpoint hard-blocks media assets that lack
# explicit media-authorization consent. When unset or "false", the
# endpoint logs the missing list as a soft warning but allows the publish.
# Flip to "true" after the soft-warn window (~2 weeks post-launch).
MEDIA_AUTH_HARD_BLOCK=

# ------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA on /signup)
# ------------------------------------------------------------
# Real keys come from the Cloudflare dashboard once the account is set up.
# Until then, leave both unset — the client falls back to Cloudflare's
# documented sandbox site key (1x00000000000000000000AA) and the server
# verifier fails OPEN in non-prod (and fails CLOSED in prod, so a
# forgotten-secret deploy blocks signups instead of letting bots through).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# Minibook PDF generation (optional)
# ------------------------------------------------------------
# Base URL the scripts/generate-minibook-pdfs.ts script renders
# against. Defaults to http://localhost:4321 when unset.
MINIBOOK_BASE_URL=

# ------------------------------------------------------------
# Zernio publish webhook (marketing engine — social writeback)
# ------------------------------------------------------------
# Receives Zernio "post.published"/"post.failed" webhooks at
# POST /api/webhooks/zernio and writes the result back to the marketing
# Content Calendar in Notion. Leave unset until the founder connects Zernio.

# HMAC-SHA256 signing secret. Captured when the webhook URL is registered
# with Zernio (POST /webhooks/settings). The route verifies the
# X-Zernio-Signature header against this; a missing value 500s in prod.
ZERNIO_WEBHOOK_SECRET=

# Notion internal-integration token, scoped to the Content Calendar DB ONLY.
# Provision in Notion (Settings → Connections), then share that single
# database with the integration. Used by the webhook to write Live URL /
# Status / Sync error back onto the matched row.
NOTION_TOKEN=

# Content Calendar data source id. Accepts the collection:// prefix or a raw
# UUID (the code strips the prefix). Current value:
# collection://074e4309-ad17-46b4-9b65-a70f63305be7
NOTION_CONTENT_CALENDAR_DS=
