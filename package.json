{
  "name": "aspire-sports",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node -r dotenv/config ./node_modules/.bin/astro dev",
    "dev:local": "NETLIFY_DEV=1 R2_MOCK=1 CRON_SECRET=devsecret node -r dotenv/config ./node_modules/.bin/astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "stripe:listen": "stripe listen --forward-to localhost:4321/api/webhooks/stripe --events checkout.session.completed,payment_intent.succeeded,payment_intent.payment_failed",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:bootstrap": "tsx scripts/db-migrate-bootstrap.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed:e2e": "tsx src/lib/db/seeds/seed-e2e-tests.ts",
    "db:seed:phase1-demo": "tsx src/lib/db/seeds/seed-phase1-demo.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:api": "vitest run --config vitest.config.ts --project api",
    "test:api:watch": "vitest --config vitest.config.ts --project api",
    "test:api:ui": "vitest --ui --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --project unit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@astrojs/netlify": "^6.6.3",
    "@astrojs/react": "^4.4.2",
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@hookform/resolvers": "^5.2.2",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/components": "^1.0.4",
    "@sentry/astro": "^10.50.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "argon2": "^0.44.0",
    "astro": "^5.16.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.8.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "exifr": "^7.1.3",
    "idb": "^8.0.3",
    "lucia": "^3.2.2",
    "lucide-react": "^0.554.0",
    "postgres": "^3.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "resend": "^6.7.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^20.1.2",
    "svix": "^1.92.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "twilio": "^5.13.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
